// spec 5.2 / 변경점 663: `const fn` — compile-time evaluatable pure fn.
const fn double(x: i32) -> i32 {
    return x * 2;
}

const SIX: i32 = double(3);

fn main() -> i32 {
    rok_print_i32(SIX + double(3));
    return 0;
}
