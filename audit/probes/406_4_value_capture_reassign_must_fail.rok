// spec 4.6.4: 값 캡처된 외부 변수를 클로저 본체에서 재할당 시도하면
// 컴파일 에러. [ref count] 명시 강제. 통과되면 spec 위반.
fn main() -> i32 {
    let count = 0;
    let f = || { count = count + 1 };  // ERROR per spec 4.6.4
    f();
    return 0;
}
