// spec: 005.06.9-variant-visibility
// probe: negative-must-fail
// expect-error: is private to module

// spec 5.6.9: a variant follows its enum's visibility — a private enum's
// variants can't be named outside its module, even through `use`.
mod shapes {
    enum Shape { Dot(i32), Line }
}

fn main() -> i32 {
    let s = shapes::Shape::Dot(1);
    return 0;
}
