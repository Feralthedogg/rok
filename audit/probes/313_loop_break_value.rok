// spec: 003.13.1-loop-break-value
// probe: positive
// expect-exit: 0
// expect-stdout:
// 50

// spec 3.13.1: loop 의 break value 로 값 반환.
fn main() -> i32 {
    let n = 0;
    let result = loop {
        n = n + 10;
        if n >= 50 {
            break n;
        }
    };
    println(f"{result}");
    return 0;
}
