// spec: 006.02-derive-eq
// probe: positive
// expect-exit: 0
// expect-stdout:
// equal

// spec 6.2: `#[derive(PartialEq, Eq)]` — field-wise equality.
#[derive(PartialEq, Eq)]
struct Pt { x: i32; y: i32; }

fn main() -> i32 {
    let a = Pt { x: 1, y: 2 };
    let b = Pt { x: 1, y: 2 };
    if a == b { rok_print_str("equal"); }
    return 0;
}
