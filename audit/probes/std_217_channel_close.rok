// spec: std 217-channel §2.17.2 / §2.17.3 / §2.17.4
// probe: positive
// expect-exit: 0
// expect-stdout:
// try_recv empty: none
// 1 2 3
// after close: none none
// send after close: Closed(9)
// bounded full: Full(8)
// mpsc total 30

// spec 2.17.3: after every sender `close()`s, buffered values still drain,
// then `recv()` returns none; `try_recv` is none when empty. 2.17.2: a
// closed sender's `send` throws `SendError::Closed(v)`; a full bounded
// channel's `try_send` throws `TrySendError::Full(v)`. 2.17.4: cloned
// senders feed one receiver, which closes once all senders closed.
fn show(v: i32 | none) -> str {
    match v { x: i32 => f"{x}", none => "none" }
}

fn main() {
    let (tx, rx) = channel::<i32>();
    println(f"try_recv empty: {show(rx.try_recv())}");
    try! tx.send(1);
    try! tx.send(2);
    try! tx.send(3);
    tx.close();
    println(f"{show(rx.recv())} {show(rx.recv())} {show(rx.recv())}");
    println(f"after close: {show(rx.recv())} {show(rx.try_recv())}");
    try tx.send(9) catch e {
        match e { SendError::Closed(v) => println(f"send after close: Closed({v})") };
    };

    let (btx, brx) = channel_bounded::<i32>(1);
    try! btx.send(7);
    try btx.try_send(8) catch e {
        match e {
            TrySendError::Full(v) => println(f"bounded full: Full({v})"),
            TrySendError::Closed(v) => println(f"bounded closed: {v}"),
        };
    };

    let (a, r) = channel::<i32>();
    let b = a.clone();
    try! a.send(10);
    try! b.send(20);
    a.close();
    b.close();
    let total = 0;
    for v in r { total += v; }
    println(f"mpsc total {total}");
}
