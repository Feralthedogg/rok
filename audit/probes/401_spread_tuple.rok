// spec: 004.01-spread-tuple
// probe: positive
// expect-exit: 0
// expect-stdout:
// 6

// spec 4.1 / 변경점 838-841: `f(..args)` spread — tuple 을 펼쳐서 positional.
fn add3(a: i32, b: i32, c: i32) -> i32 {
    return a + b + c;
}

fn main() -> i32 {
    let args = (1, 2, 3);
    println(f"{add3(..args)}");
    return 0;
}
