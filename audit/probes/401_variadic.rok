// spec: 004.01-variadic
// probe: positive
// expect-exit: 0
// expect-stdout:
// 6

// spec 4.2.5: `fn f(xs: ...T)` variadic — the call's trailing arguments
// are a stack array (`[T; N]`, implicit const N).
fn sum(xs: ...i32) -> i32 {
    let total = 0;
    for x in xs {
        total = total + x;
    }
    return total;
}

fn main() -> i32 {
    rok_print_i32(sum(1, 2, 3));
    return 0;
}
