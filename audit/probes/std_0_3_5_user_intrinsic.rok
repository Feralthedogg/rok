// spec: std-000.03.5-user-intrinsic
// probe: negative-must-fail
// expect-error: the intrinsic attribute is for the standard library only

// stdlib spec 0.3.5: `#[intrinsic]` is a compiler ↔ stdlib boundary;
// user code can't attach it.
struct Meters { m: i32; }
impl Add for Meters {
    #[intrinsic("rok.add.i32")]
    fn add(self, rhs: Meters) -> Meters { return Meters { m: self.m + rhs.m }; }
}

fn main() -> i32 { return 0; }
