// spec: 004.06.1-value-capture-snapshot
// probe: positive
// expect-exit: 21

// spec 4.6 / i-want 1437-1450: closure 의 기본 캡처는 value snapshot
// (생성 시점). 외부 변수가 그 후 바뀌어도 closure 는 옛 값을 가짐.
// f1 은 i=1 에 묶이고, f2 는 i=2 에 묶임. i 가 99 로 바뀌어도 영향 없음.
fn main() -> i32 {
    let i = 1;
    let f1 = || { i };
    i = 2;
    let f2 = || { i };
    i = 99;
    return f1() + f2() * 10;
}
