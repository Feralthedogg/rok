// spec: 003.09-branch-unify-sum
// probe: positive
// expect-exit: 0
// expect-stdout:
// from_int

// D1 (2026-10-12): 분기 타입이 달라도 합 타입을 자동 추론하지 않는다.
// 슬롯에 합 타입을 적으면 각 분기 값이 그 합으로 들어간다.
// 생략하면 에러 — `309_branch_types_differ` probe.
fn pick(b: i32) -> i32 | f64 {
    let v: i32 | f64 = if b == 1 { 7 } else { 3.14 };
    return v;
}

fn main() -> i32 {
    let r = pick(1);
    match r {
        n: i32 => rok_print_str("from_int"),
        d: f64 => rok_print_str("from_float"),
    };
    return 0;
}
