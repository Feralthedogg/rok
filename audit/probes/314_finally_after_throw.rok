// spec: 003.14.3-finally-after-throw
// probe: positive
// expect-exit: 0
// expect-stdout:
// finally_ran
// propagated

// spec 314.3: throw 발생 시에도 finally는 실행되어야 (전파되는 에러가
// 함수를 빠져나가기 전에).
fn f() throws (i32) {
    try {
        throw 1;
    } finally {
        println("finally_ran");
    };
}

fn main() -> i32 {
    try f() catch _ { println("propagated"); };
    return 0;
}
