// spec: 002.09.3-multi-impl-blocks
// probe: positive
// expect-exit: 0
// expect-stdout:
// 5
// 25

// spec 2.9.3: 같은 타입에 대한 여러 impl 블록 — 시각적/조직적 묶음.
struct V { n: i32; }

impl V {
    fn first(self) -> i32 { return self.n; }
}

impl V {
    fn squared(self) -> i32 { return self.n * self.n; }
}

fn main() -> i32 {
    let v = V { n: 5 };
    rok_print_i32(v.first());
    rok_print_i32(v.squared());
    return 0;
}
