// spec: 005.01-let-redeclare
// probe: negative-must-fail
// expect-error: is already declared in this scope

// 변경점 라인 238-239: 같은 스코프에서 untyped→typed 전환 금지.
// `let x = 1; let x: i32 = 5;` 가 redeclaration → 컴파일 에러.
fn main() -> i32 {
    let x = 1;
    let x: i32 = 5;    // ERROR: redeclaration in same scope
    return x;
}
