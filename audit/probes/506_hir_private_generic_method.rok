// spec: 005.06-visibility
// probe: negative-must-fail
// generic impl 의 비공개 메서드도 외부 호출 → 에러.
// expect-error: method `secret` is private to module `a`

mod a {
    pub struct S<T> { pub x: T; }
    impl<T> S<T> { fn secret(self) -> T { return self.x; } }
}

fn main() -> i32 { let s: a::S<i32> = a::S { x: 1 }; return s.secret(); }
