// spec: 005.08-reexport
// probe: positive
// expect-exit: 0
// expect-stdout:
// 7

// spec 5.8: `pub use` 재내보내기. inner 모듈의 struct 가 alias 경로로
// 노출되어 root 에서 `Point { x: 7 }` 식으로 직접 생성 가능해야.
mod inner {
    pub struct Point { x: i32; }
}

pub use inner::Point;

fn main() -> i32 {
    let p = Point { x: 7 };
    rok_print_i32(p.x);
    return 0;
}
