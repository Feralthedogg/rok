// spec: 004.04.6-send-fn-closure
// probe: negative-must-fail
// expect-error: captures don't meet

// spec 4.4.6: a closure in a `fn() + Send` slot must capture only
// `Send` values.
struct Tok { v: i32; }
impl !Send for Tok {}

fn main() -> i32 {
    let t = Tok { v: 1 };
    let f: fn() -> i32 + Send = || t.v;
    return f();
}
