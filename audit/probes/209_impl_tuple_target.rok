// spec: 002.09.1-impl-tuple-target
// probe: positive
// expect-exit: 7
// expect-stdout:

// spec 2.9.1: impl_block ::= "impl" generics? type_expr ("for" type_expr)? ...
// type_expr는 임의 타입. 튜플 타입에 trait impl 합법이어야 함.
// 직전 회차까지 silent miscompile (build OK, t.foo() = 0 반환).
// 현재는 명시 거부 (FAIL_CODEGEN).
trait Foo {
    fn foo(self) -> i32;
}

impl Foo for (i32, i32) {
    fn foo(self) -> i32 {
        return 7;
    }
}

fn main() -> i32 {
    let t = (1, 2);
    return t.foo();
}
