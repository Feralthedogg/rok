// spec: 004.06.2-capture-ref
// probe: positive
// expect-exit: 0
// expect-stdout: 2

// spec 4.6.2: [ref x] 캡처 리스트로 참조 캡처.
// 클로저 본체의 재할당이 외부 변수에 반영되어야.
fn main() -> i32 {
    let count = 0;
    let inc = [ref count] || { count = count + 1 };
    inc();
    inc();
    println(f"{count}");
    return 0;
}
