// spec: 003.14-question-postfix
// probe: positive
// expect-exit: 9
// expect-stdout:

// spec 3.14: `expr?` 후위 — `T | none` 에서 none 이면 caller fn 도 none 반환.
// (직전 `try_q.rok` 통합 테스트 비슷, 다른 형태 검증)
fn try_double(x: i32 | none) -> i32 | none {
    let v = x?;
    return v + v;
}

fn main() -> i32 {
    let r = try_double(3) ?? 0;
    return r + 3;       // 6 + 3 = 9
}
