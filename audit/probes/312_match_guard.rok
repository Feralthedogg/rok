// spec: 003.12-match-guard
// probe: positive
// expect-exit: 0
// expect-stdout:
// big
// small
// big

// spec 312: match arm guard `if cond`.
fn classify(n: i32) -> i32 {
    let r = match n {
        x if x > 100 => 1,
        _ => 2,
    };
    return r;
}

fn main() -> i32 {
    if classify(150) == 1 { rok_print_str("big"); }
    if classify(5) == 2 { rok_print_str("small"); }
    if classify(101) == 1 { rok_print_str("big"); }
    return 0;
}
