// spec: 003.13-break
// probe: negative-must-fail
// expect-exit: 0  (루프 밖 / 없는 레이블의 break 는 컴파일 에러 — 이전엔 MIR 이 unreachable 로 대체.)
// expect-error: `break` outside of a loop labelled `'nope`

fn main() -> i32 {
    let t = 0;
    while t < 3 {
        t = t + 1;
        break 'nope;
    }
    return t;
}
