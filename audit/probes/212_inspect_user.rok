// spec: 002.12-inspect
// probe: positive
// expect-exit: 0
// expect-stdout:
// ["id", "name", "email"]
// str
// true
// 42
// id = u64
// name = str
// email = str

// stdlib 2.12.3: the `User` example — an `i32` literal sets a `u64`
// field (it fits) — and `dump_struct` over `T: Inspect`.
#[derive(Inspect)]
struct User {
    id: u64;
    name: str;
    email: str;
}

fn dump_struct<T: Inspect>(x: T) {
    for name in T::field_names() {
        if let v: any = x.get_field(name) {
            rok_print_str(f"{name} = {v.type_name_of()}");
        }
    }
}

let u = User { id: 1, name: "Alice", email: "a@b" };
rok_print_str(f"{User::field_names():?}");
match u.get_field("name") {
    v: any => rok_print_str(v.type_name_of()),
    none => rok_print_str("none"),
}
rok_print_str(f"{u.set_field("id", 42)}");
rok_print_str(f"{u.id}");
dump_struct(u);
