// spec: 002.09-trait-impl
// probe: negative-must-fail
// generic trait impl 은 아직 미지원 — "cannot find type T" 연쇄 대신 명확한 에러.
// expect-error: generic trait impl `impl<..> Show for Box` is not implemented yet

trait Show { fn show(self) -> i32; }
struct Box<T> { v: T; }
impl<T> Show for Box<T> { fn show(self) -> i32 { return 1; } }

fn main() -> i32 { let b: Box<i32> = Box { v: 5 }; return 0; }
