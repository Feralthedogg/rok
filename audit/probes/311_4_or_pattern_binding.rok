// spec: 003.11.4-or-pattern-binding
// probe: positive
// expect-exit: 0
// expect-stdout:
// 5

// spec 311.4: `Ok(x) | OkAlt(x)` 같이 같은 이름·같은 타입으로
// 양쪽 변형에 바인딩하는 or-pattern은 허용되어야 한다.
// 직전 감사의 "미확인" 항목 실증.
enum E {
    A(i32),
    B(i32),
}

fn main() -> i32 {
    let e = E::A(5);
    let n = match e {
        E::A(x) | E::B(x) => x,
    };
    rok_print_i32(n);
    return 0;
}
