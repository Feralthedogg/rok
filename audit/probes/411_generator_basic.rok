// spec: 004.11-generator-basic
// probe: negative-must-fail
// expect-error: cannot be used as a type directly
//                  (`yield` 없는 `fn` 은 제너레이터가 아니고, trait 은 타입이 아님 —
//                  `yield fn counter() -> i32` 가 맞는 형태)

// spec 4.11: 명명된 제너레이터 — yield 문장.
// 실측 의도: 제너레이터가 실제로 동작하는지 (파서만 통과하는지)
fn counter() -> Iterator<i32> {
    yield 1;
    yield 2;
    yield 3;
}

fn main() -> i32 {
    for x in counter() {
        rok_print_i32(x);
    }
    return 0;
}
