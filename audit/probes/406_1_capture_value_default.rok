// spec: 004.06.1-capture-value-default
// probe: positive
// expect-exit: 0
// expect-stdout:
// 1

// spec 4.6.1: 캡처 기본은 값 복사.
// 클로저 생성 시점의 count(=0)가 스냅샷되어야.
// 외부 count를 10으로 바꿔도 클로저 결과는 0+1 = 1.
fn main() -> i32 {
    let count = 0;
    let f = || { count + 1 };
    let _ = count;  // count 사용 시도
    let r = f();
    rok_print_i32(r);
    return 0;
}
