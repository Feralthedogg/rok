// spec: 003.02-unicode-operator
// probe: positive
// expect-exit: 0
// expect-stdout:
// equal
// less

// spec 1.10.3 / 3.2.3: `≡ ≤` are fixed tokens, synonyms of `== <=`.
fn main() -> i32 {
    let a = 5;
    let b = 5;
    if a ≡ b { println("equal"); }
    if a ≤ 10 { println("less"); }
    return 0;
}
