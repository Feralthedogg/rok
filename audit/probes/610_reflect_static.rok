// spec: 006.10-reflect
// probe: positive
// expect-exit: 0
// expect-stdout:
// i32
// 4
// 4
// i32
// i32
// f64
// str

// 6.10.1 / 2.12.2: every type has `Reflect` with no derive — static
// `T::type_name()` / `size()` / `align()`, and `type_name_of()` that
// looks at the variant an `any` / sum value holds.
fn pick() -> i32 | f64 { return 2.5; }

rok_print_str(i32::type_name());
rok_print_str(f"{i32::size()}");
rok_print_str(f"{i32::align()}");
let x: any = 42i32;
rok_print_str(x.type_name_of());
let y: i32 | f64 = 42i32;
rok_print_str(y.type_name_of());
let v: i32 | f64 = pick();
rok_print_str(v.type_name_of());
let z: any = "hello";
rok_print_str(z.type_name_of());
