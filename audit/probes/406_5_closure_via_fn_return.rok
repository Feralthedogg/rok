// spec: 004.04.4-closure-through-fn-return
// probe: positive
// expect-exit: 8

// spec 4.4.2 / 4.4.4: a capturing closure is a value of its `fn` type —
// it can be returned through a `fn(...)` return type (`make_adder`).
fn make_adder(n: i32) -> fn(i32) -> i32 {
    return |x| { x + n };
}

fn main() -> i32 {
    let add5 = make_adder(5);
    return add5(3);
}
