// spec: 005.03-static-mut-storage-pattern
// probe: negative-must-fail
// expect-error: `static mut` is only allowed inside `extern "C"

// 직전 통합 테스트 `static_mut.rok` 가 검증하던 storage 패턴.
// spec 5.3 (i-want-this.txt 라인 656) 은 `static mut` 을 일반 코드에 금지.
// 이 probe 는 negative — build 가 명시 거부되어야 한다.
// `Atomic` / `Mutex` / `Cell` 도입 후 storage 패턴은 그쪽으로 검증.
static mut COUNTER: i32 = 0;

fn bump() -> i32 {
    COUNTER = COUNTER + 7;
    return COUNTER;
}

fn main() -> i32 {
    return bump();
}
