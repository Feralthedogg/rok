// spec: std 209-collections §2.9.2
// probe: positive
// xfail: List has no `extend` / `shrink_to_fit`
// expect-exit: 0
// expect-stdout:
// cap ok true
// [1, 2, 3, 4]
// shrunk true

// spec 2.9.2 lists `extend<I: IntoIterator<Item = T>>` and `shrink_to_fit`
// among List's core methods.
fn main() {
    let xs: List<i32> = List::with_capacity(16);
    println(f"cap ok {xs.capacity() >= 16}");
    xs.push(1);
    xs.extend([2, 3, 4]);
    println(xs.debug());
    xs.shrink_to_fit();
    println(f"shrunk {xs.capacity() >= xs.len()}");
}
