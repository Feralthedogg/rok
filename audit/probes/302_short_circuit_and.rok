// spec: 003.02-short-circuit-and
// probe: positive
// expect-exit: 0
// expect-stdout:
// no_call

// spec: `&&`는 short-circuit. 좌변이 false면 우변 평가 안 함.
// loud()가 호출되면 "called"가 출력되어 stdout이 달라진다.
// (현 impl은 arith.andi → eager 평가, 이 probe로 silent miscompile 노출.)
fn loud() -> i32 {
    println("called");
    return 1;
}

fn main() -> i32 {
    let cond = false;
    if cond && (loud() == 1) {
        println("then");
    }
    println("no_call");
    return 0;
}
