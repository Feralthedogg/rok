// spec: 005.06-visibility
// probe: negative-must-fail
// expect-exit: 0  (비공개 필드 외부 접근 → 에러 (spec 5.6: 필드 기본 비공개).)
// expect-error: field `x` of `a::S` is private to module `a`

mod a {
    pub struct S { x: i32; }
    pub fn mk() -> S { return S { x: 3 }; }
}

fn main() -> i32 { let s = a::mk(); return s.x; }
