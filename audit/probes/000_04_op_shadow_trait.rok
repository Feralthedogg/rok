// spec: 000.04-operator-dispatch
// probe: negative-must-fail
// 사용자가 같은 이름 `Add` trait 을 정의해도 lang slot trait 이 아니므로 `+` 불가.
// expect-error: it needs `impl Add for V`

trait Add { fn add(self, o: V) -> V; }
struct V { x: i32; }
impl Add for V { fn add(self, o: V) -> V { return V { x: self.x + o.x }; } }

fn main() -> i32 { let a = V { x: 1 }; let c = a + V { x: 2 }; return c.x; }
