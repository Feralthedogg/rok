// spec: 005.06-visibility
// probe: negative-must-fail
// expect-exit: 0  (비공개 타입 경로 외부 사용 → 에러.)
// expect-error: type `a::Hidden` is private to module `a`

mod a {
    struct Hidden { x: i32; }
    pub fn f() -> i32 { return 2; }
}

fn g(h: a::Hidden) -> i32 { return 1; }

fn main() -> i32 { return a::f(); }
