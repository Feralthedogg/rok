// spec: 005.05.2-use-multi-import
// probe: positive
// expect-exit: 7
// expect-stdout:

// spec 5.5.2: `use foo::{a, b, c}` 다중 import.
// 단일 path 표현으로 여러 항목 가져오기.
mod m {
    pub fn one() -> i32 { 1i32 }
    pub fn two() -> i32 { 2i32 }
    pub fn four() -> i32 { 4i32 }
}

use m::{one, two, four};

fn main() -> i32 {
    return one() + two() + four();
}
