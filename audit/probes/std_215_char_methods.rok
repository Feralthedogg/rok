// spec: std 215-string §2.15.4
// probe: positive
// xfail: char has no to_lowercase / is_alphabetic / is_ascii / to_digit / len_utf8
// expect-exit: 0
// expect-stdout:
// a true true
// 1 4 3
// 1
// 65 A 5
// surrogate rejected

// spec 2.15.4: `char` methods (`to_lowercase`, `is_alphabetic`, `is_ascii`,
// `to_digit`, `len_utf8`) and conversions (`char::from_u32` rejects
// surrogates with a throw, `char::from_digit`, `c as u32`).
fn main() {
    let c: char = 'A';
    println(f"{c.to_lowercase()} {c.is_alphabetic()} {c.is_ascii()}");
    let e: char = '😀';
    let k: char = '한';
    println(f"{c.len_utf8()} {e.len_utf8()} {k.len_utf8()}");
    println(f"{try '1'.to_digit(10) catch _ { 99u32 }}");
    let n: u32 = c as u32;
    println(f"{n} {try char::from_u32(0x41u32) catch _ { '?' }} {char::from_digit(5u32, 10u32)}");
    let s = try char::from_u32(0xD800u32).to_string() catch _ { "surrogate rejected" };
    println(s);
}
