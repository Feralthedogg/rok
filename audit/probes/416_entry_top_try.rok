// spec: 004.16.4-implicit-main-throws
// probe: positive
// expect-exit: 1
// expect-stderr: `main` returned an uncaught error: bad 7
// expect-stdout:
// 1

// spec 4.16.4: the implicit `main` is `fn main() throws`; an error a
// top-level `try` lets escape is printed (Display) and exits 1.
struct Bad { n: i32; }
impl Display for Bad { fn display(self) -> str { return f"bad {self.n}"; } }
impl Debug for Bad { fn debug(self) -> str { return "Bad"; } }
impl Error for Bad {}

fn parse(x: i32) throws (Bad) -> i32 {
    if x > 0 { throw Bad { n: x }; }
    return 1;
}

let a = try parse(0);
println(f"{a}");
let b = try parse(7);
println(f"{b}");
