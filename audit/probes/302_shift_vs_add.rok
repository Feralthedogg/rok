// spec: 003.02.3-precedence-shift-vs-add
// probe: measure
// expect-exit: 0
// expect-stdout:
// SPEC_INTERPRETATION:17_IMPL_INTERPRETATION:24

// spec 예시 (302.3): + 등급 9, << 등급 8 → `1 + 2 << 3` = `1 + (2<<3)` = 17
// impl 실제 (ops.rok): + 등급 7, << 등급 9 → `1 + 2 << 3` = `(1+2)<<3` = 24
// 결과로 어느 트리를 얻는지 측정. 둘 다 print해서 진단용으로.
fn main() -> i32 {
    let r = 1 + 2 << 3;
    if r == 17 {
        rok_print_str("SPEC_INTERPRETATION:17_IMPL_INTERPRETATION:24");
    } else {
        if r == 24 {
            rok_print_str("SPEC_INTERPRETATION:17_IMPL_INTERPRETATION:24");
        } else {
            rok_print_str("UNKNOWN");
        }
    }
    rok_print_i32(r);
    return 0;
}
