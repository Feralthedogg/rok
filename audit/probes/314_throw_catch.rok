// spec: 003.14.2-try-catch
// probe: positive
// expect-exit: 0
// expect-stdout:
// caught:7

// spec 314.2: try 본체에서 throw → catch 본체로 + 예외 값 바인딩.
// 정상 종료 (exit 0). catch 식의 값은 handler 블록의 값.
fn main() -> i32 {
    let result = try {
        throw 7;
        0
    } catch e {
        if e == 7 { rok_print_str("caught:7"); }
        99
    };
    return result - 99;
}
