// spec: 003.04-compound-assign-lhs-evaluated-once
// probe: positive
// expect-exit: 0
// expect-stdout:
// 99
// 25
// 60

// spec 3.4.3: the left side of a compound assignment is evaluated once.
// `idx()` prints 99 each time it runs; it must run exactly once.
fn idx() -> usize {
    rok_print_i32(99);
    return 1usize;
}

fn main() -> i32 {
    let arr: [i32; 3] = [10, 20, 30];
    arr[idx()] += 5;
    rok_print_i32(arr[1]);
    let i: usize = 2usize;
    arr[i] *= 2;
    rok_print_i32(arr[2]);
    return 0;
}
