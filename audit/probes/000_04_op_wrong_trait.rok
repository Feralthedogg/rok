// spec: 000.04-operator-dispatch
// probe: negative-must-fail
// `+` 는 add_trait (Add) impl 만 dispatch. 다른 trait 의 `add` 는 안 된다.
// expect-error: it needs `impl Add for V`

trait Plus { fn add(self, o: V) -> V; }
struct V { x: i32; }
impl Plus for V { fn add(self, o: V) -> V { return V { x: self.x + o.x }; } }

fn main() -> i32 { let a = V { x: 1 }; let c = a + V { x: 2 }; return c.x; }
