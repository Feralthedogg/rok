// spec: 006.04.6-lang-duplicate-slot
// probe: negative-must-fail
// expect-error: lang slot `oom_fn` is already bound

// spec 6.4.6: 같은 slot에 두 항목 부착하면 컴파일 에러.
#[lang("oom_fn")]
fn a() -> i32 {
    return 1;
}

#[lang("oom_fn")]
fn b() -> i32 {
    return 2;
}

fn main() -> i32 {
    return 0;
}
