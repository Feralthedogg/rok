// spec: 003.04-typo-undeclared
// probe: negative-must-fail
// expect-exit: 0  (build must fail)

// spec 변경점 라인 234-235: let 없이 새 이름 쓰면 에러 (타이포 방지).
// `coutner = ...` 가 declared 안 됐는데 통과되면 spec 위반.
fn main() -> i32 {
    let counter = 0;
    coutner = counter + 1;    // 'coutner' 미선언 — typo
    return counter;
}
