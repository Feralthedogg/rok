// Alloc-heavy: 20M short-lived boxed `any` payloads (48-byte objects).
trait Weigh { fn w(self) -> i64; }
struct Blob { a: i64; b: i64; c: i64; d: i64; }
impl Weigh for Blob { fn w(self) -> i64 { return self.a + self.d; } }

fn make(i: i64) -> any Weigh { return Blob { a: i, b: i, c: i, d: 1 }; }

fn main() -> i32 {
    // Every 16th box stays reachable from a ring, so none is elided.
    let ring: List<any Weigh> = [];
    let total: i64 = 0;
    let i: i64 = 0;
    while i < 20000000 {
        let x = make(i);
        total += x.w();
        if i & 15 == 0 {
            if ring.len() < 1024 { ring.push(x); } else { ring[((i >> 4) & 1023) as usize] = x; }
        }
        i += 1;
    }
    for x in ring { total += x.w(); }
    println(f"{total}");
    return 0;
}
