// rok::bare::ptr — raw pointers (stdlib spec 1.1). A pointer is its
// address; reading / writing through it is `unsafe` (refs-lang 4.15.2).
//
// ponytail: provenance is not tracked — `expose_provenance` /
// `from_exposed_provenance` are the address itself. `map_addr`,
// `align_offset`, `Slice<T>` extraction and the `Ptr<T> | none` null
// niche (it is a tagged sum here) wait for a user.

// Compiler intrinsics over a pointer struct (field 0 = address); `T` is
// the pointer's type argument.
#[intrinsic("rok.ptr.read")]
unsafe fn raw_read<P, T>(p: P) -> T;
#[intrinsic("rok.ptr.write")]
unsafe fn raw_write<P, T>(p: P, value: T);
#[intrinsic("rok.ptr.read_volatile")]
unsafe fn raw_read_volatile<P, T>(p: P) -> T;
#[intrinsic("rok.ptr.write_volatile")]
unsafe fn raw_write_volatile<P, T>(p: P, value: T);

/// Size of `T` in bytes (also `rok::bare::mem::size_of`).
#[intrinsic("rok.size_of")]
pub fn size_of<T>() -> usize;

/// Alignment of `T` in bytes.
#[intrinsic("rok.align_of")]
pub fn align_of<T>() -> usize;

/// A non-null, mutable pointer to one `T` (C `T*`).
pub struct Ptr<T> {
    address: usize;
}

impl<T> Ptr<T> {
    /// Well aligned, never dereferenceable.
    pub fn dangling() -> Ptr<T> { return Ptr { address: align_of::<T>() }; }
    /// Always `none` (a `Ptr` is never null).
    pub fn null() -> Ptr<T> | none { return none; }

    /// The address (provenance is lost).
    pub fn addr(self) -> usize { return self.address; }
    pub fn with_addr(self, addr: usize) -> Ptr<T> { return Ptr { address: addr }; }

    /// `count` elements further (`count * size_of::<T>()` bytes).
    pub fn offset(self, count: isize) -> Ptr<T> {
        return Ptr { address: (self.address as isize + count * size_of::<T>() as isize) as usize };
    }
    pub fn add(self, count: usize) -> Ptr<T> {
        return Ptr { address: self.address + count * size_of::<T>() };
    }
    pub fn sub(self, count: usize) -> Ptr<T> {
        return Ptr { address: self.address - count * size_of::<T>() };
    }
    /// `count` bytes further.
    pub fn byte_offset(self, count: isize) -> Ptr<T> {
        return Ptr { address: (self.address as isize + count) as usize };
    }
    /// `self.addr() - origin.addr()` in elements.
    pub fn distance(self, origin: Ptr<T>) -> isize {
        return (self.address as isize - origin.address as isize) / size_of::<T>() as isize;
    }
    pub fn is_aligned(self) -> bool { return self.address % align_of::<T>() == 0; }

    /// The same address as a pointer to `U` (alignment is the caller's).
    pub fn cast<U>(self) -> Ptr<U> { return Ptr { address: self.address }; }
    pub fn as_const(self) -> ConstPtr<T> { return ConstPtr { address: self.address }; }
    pub fn as_many(self) -> ManyPtr<T> { return ManyPtr { address: self.address }; }

    /// The `T` it points at. UB unless it points at a live, initialized `T`.
    pub unsafe fn read(self) -> T { return raw_read(self); }
    /// Store `value` where it points. UB unless that is writable `T` memory.
    pub unsafe fn write(self, value: T) { raw_write(self, value); }
    pub unsafe fn read_volatile(self) -> T { return raw_read_volatile(self); }
    pub unsafe fn write_volatile(self, value: T) { raw_write_volatile(self, value); }
}

/// A non-null pointer to one `T` that is only read (C `const T*`).
pub struct ConstPtr<T> {
    address: usize;
}

impl<T> ConstPtr<T> {
    pub fn dangling() -> ConstPtr<T> { return ConstPtr { address: align_of::<T>() }; }
    pub fn addr(self) -> usize { return self.address; }
    pub fn with_addr(self, addr: usize) -> ConstPtr<T> { return ConstPtr { address: addr }; }
    pub fn offset(self, count: isize) -> ConstPtr<T> {
        return ConstPtr {
            address: (self.address as isize + count * size_of::<T>() as isize) as usize,
        };
    }
    pub fn add(self, count: usize) -> ConstPtr<T> {
        return ConstPtr { address: self.address + count * size_of::<T>() };
    }
    pub fn sub(self, count: usize) -> ConstPtr<T> {
        return ConstPtr { address: self.address - count * size_of::<T>() };
    }
    pub fn cast<U>(self) -> ConstPtr<U> { return ConstPtr { address: self.address }; }
    pub fn as_many(self) -> ManyPtr<T> { return ManyPtr { address: self.address }; }
    pub unsafe fn read(self) -> T { return raw_read(self); }
    pub unsafe fn read_volatile(self) -> T { return raw_read_volatile(self); }
}

/// A pointer to a run of `T`s of unknown length (C `T*` array).
pub struct ManyPtr<T> {
    address: usize;
}

impl<T> ManyPtr<T> {
    pub fn addr(self) -> usize { return self.address; }
    pub fn with_addr(self, addr: usize) -> ManyPtr<T> { return ManyPtr { address: addr }; }
    pub fn offset(self, count: isize) -> ManyPtr<T> {
        return ManyPtr {
            address: (self.address as isize + count * size_of::<T>() as isize) as usize,
        };
    }
    pub fn add(self, count: usize) -> ManyPtr<T> {
        return ManyPtr { address: self.address + count * size_of::<T>() };
    }
    /// The first element as a single-element pointer.
    pub fn as_one(self) -> Ptr<T> { return Ptr { address: self.address }; }
    pub fn as_const(self) -> ConstPtr<T> { return ConstPtr { address: self.address }; }
    /// Element `idx` (no bounds: the caller knows the length).
    pub unsafe fn read(self, idx: usize) -> T {
        let p: Ptr<T> = Ptr { address: self.address + idx * size_of::<T>() };
        return raw_read(p);
    }
    pub unsafe fn write(self, idx: usize, value: T) {
        let p: Ptr<T> = Ptr { address: self.address + idx * size_of::<T>() };
        raw_write(p, value);
    }
}

/// A C-compatible nullable pointer (`T*` that may be `NULL`).
pub struct CPtr<T> {
    address: usize;
}

impl<T> CPtr<T> {
    pub fn null() -> CPtr<T> { return CPtr { address: 0 }; }
    pub fn from_ptr(p: Ptr<T>) -> CPtr<T> { return CPtr { address: p.address }; }
    pub fn from_const(p: ConstPtr<T>) -> CPtr<T> { return CPtr { address: p.address }; }
    pub fn from_addr(addr: usize) -> CPtr<T> { return CPtr { address: addr }; }
    pub fn is_null(self) -> bool { return self.address == 0; }
    pub fn addr(self) -> usize { return self.address; }
    /// `none` when null.
    pub fn as_ptr(self) -> Ptr<T> | none {
        if self.address == 0 { return none; }
        let p: Ptr<T> = Ptr { address: self.address };
        return p;
    }
    pub fn as_const(self) -> ConstPtr<T> | none {
        if self.address == 0 { return none; }
        let p: ConstPtr<T> = ConstPtr { address: self.address };
        return p;
    }
}

// Raw pointers never cross threads implicitly (E3).
impl<T> !Send for Ptr<T> {}
impl<T> !Sync for Ptr<T> {}
impl<T> !Send for ConstPtr<T> {}
impl<T> !Sync for ConstPtr<T> {}
impl<T> !Send for ManyPtr<T> {}
impl<T> !Sync for ManyPtr<T> {}
impl<T> !Send for CPtr<T> {}
impl<T> !Sync for CPtr<T> {}

/// The same address as a pointer to `U` (spec 1.2.2: `ptr_cast::<U>(p)`;
/// alignment is the caller's problem).
pub fn ptr_cast<U, T>(p: Ptr<T>) -> Ptr<U> { return Ptr { address: p.address }; }

/// `p` as a `Ptr<T>` when its address suits `T`'s alignment (1.2.3).
pub fn align_cast<T>(p: Ptr<u8>) -> Ptr<T> | none {
    if p.address % align_of::<T>() != 0 { return none; }
    let q: Ptr<T> = Ptr { address: p.address };
    return q;
}

/// Drop the `const` (1.2.4): writing through the result is the caller's
/// responsibility.
pub unsafe fn const_cast<T>(p: ConstPtr<T>) -> Ptr<T> { return Ptr { address: p.address }; }

/// The address of `p`, marked as escaping (1.1.2 strict provenance).
pub fn expose_provenance<T>(p: Ptr<T>) -> usize { return p.address; }

/// A pointer at `addr`, assumed to carry an exposed provenance.
pub fn from_exposed_provenance<T>(addr: usize) -> Ptr<T> { return Ptr { address: addr }; }
