// rok::bare tier — base layer.
// Owns: Ptr<T>, ConstPtr<T>, transmute, raw allocation, pin, volatile.
// Depends only on the runtime (`extern "rok"` symbols).
//
// Importing this crate is a danger signal; user code must `use rok::bare::...`
// explicitly.

pub mod alloc;
pub mod ffi;
pub mod mem;
pub mod mlir;
pub mod ptr;

// Spec 1.2: the named casts live at the tier root.
pub use ptr::{align_cast, const_cast, ptr_cast};
pub use mem::{Pod, reinterpret, transmute_unchecked};
