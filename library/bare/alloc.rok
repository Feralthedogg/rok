// rok::bare::alloc — raw allocation outside the GC (stdlib spec 1.4).
// Over the runtime's `rok_alloc_raw` / `rok_realloc_raw` / `rok_free`
// (system malloc); failure is a null `CPtr`, never an abort.
//
// ponytail: `Layout::array` / `from_size_align` don't `throws
// (LayoutError)` yet (they return `Layout | none`), and the typed
// helpers (`alloc_one`, ...) and the RAII `Allocation<T>` wait for a user.

use rok::bare::ptr::{CPtr, Ptr, pointee_align, pointee_size};

extern "C" {
    fn rok_alloc_raw(size: usize, align: usize, zeroed: i32) -> usize;
    fn rok_realloc_raw(ptr: usize, old_size: usize, align: usize, new_size: usize) -> usize;
    fn rok_free(ptr: usize);
}

/// Size and alignment of a raw block.
pub struct Layout {
    size: usize;
    align: usize;
}

impl Layout {
    pub fn size(self) -> usize { return self.size; }
    pub fn align(self) -> usize { return self.align; }
    /// `none` unless `align` is a power of two.
    pub fn from_size_align(size: usize, align: usize) -> Layout | none {
        if align == 0 || (align & (align - 1)) != 0 { return none; }
        return Layout { size: size, align: align };
    }
}

/// The layout of `n` values of what `p` points at (`p` only names the
/// type: rok has no `f::<T>()` call syntax yet; spec 1.4.1
/// `Layout::new::<T>()` / `Layout::array::<T>(n)`).
pub fn layout_for<T>(p: Ptr<T>, n: usize) -> Layout {
    return Layout { size: pointee_size(p) * n, align: pointee_align(p) };
}

pub unsafe fn alloc(layout: Layout) -> CPtr<u8> {
    return CPtr::from_addr(rok_alloc_raw(layout.size, layout.align, 0));
}

pub unsafe fn alloc_zeroed(layout: Layout) -> CPtr<u8> {
    return CPtr::from_addr(rok_alloc_raw(layout.size, layout.align, 1));
}

pub unsafe fn dealloc(ptr: Ptr<u8>, layout: Layout) {
    rok_free(ptr.addr());
}

/// On failure (null) `ptr` is still valid.
pub unsafe fn realloc(ptr: Ptr<u8>, old_layout: Layout, new_size: usize) -> CPtr<u8> {
    return CPtr::from_addr(
        rok_realloc_raw(ptr.addr(), old_layout.size, old_layout.align, new_size),
    );
}
