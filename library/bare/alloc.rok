// rok::bare::alloc — raw allocation outside the GC (stdlib spec 1.4).
// Over the runtime's `rok_alloc_raw` / `rok_realloc_raw` / `rok_free`
// (system malloc); failure is a null `CPtr`, never an abort.
//
// No RAII `Allocation<T>` (3.17) yet.

use rok::bare::ptr::{CPtr, Ptr, align_of, size_of};

extern "rok" {
    fn rok_alloc_raw(size: usize, align: usize, zeroed: i32) -> usize;
    fn rok_realloc_raw(ptr: usize, old_size: usize, align: usize, new_size: usize) -> usize;
    fn rok_free(ptr: usize);
}

/// Why a `Layout` cannot be made.
pub struct LayoutError {
    pub reason: str;
}

/// Size and alignment of a raw block.
pub struct Layout {
    size: usize;
    align: usize;
}

impl Layout {
    /// The layout of one `T`.
    pub fn new<T>() -> Layout { Layout { size: size_of::<T>(), align: align_of::<T>() } }

    /// The layout of `n` `T`s.
    pub fn array<T>(n: usize) throws (LayoutError) -> Layout {
        let size = size_of::<T>();
        // usize::MAX without overflowing on the way.
        let half = 1usize << (size_of::<usize>() * 8usize - 1usize);
        let max = half - 1usize + half;
        if size != 0 && n > max / size {
            throw LayoutError { reason: "array size overflows usize" };
        }
        Layout { size: size * n, align: align_of::<T>() }
    }

    /// `align` must be a power of two.
    pub fn from_size_align(size: usize, align: usize) throws (LayoutError) -> Layout {
        if align == 0 || (align & (align - 1)) != 0 {
            throw LayoutError { reason: "align is not a power of two" };
        }
        Layout { size, align }
    }

    pub fn size(self) -> usize { self.size }
    pub fn align(self) -> usize { self.align }
}

pub unsafe fn alloc(layout: Layout) -> CPtr<u8> {
    CPtr::from_addr(rok_alloc_raw(layout.size, layout.align, 0))
}

pub unsafe fn alloc_zeroed(layout: Layout) -> CPtr<u8> {
    CPtr::from_addr(rok_alloc_raw(layout.size, layout.align, 1))
}

pub unsafe fn dealloc(ptr: Ptr<u8>, layout: Layout) {
    rok_free(ptr.addr());
}

/// On failure (null) `ptr` is still valid.
pub unsafe fn realloc(ptr: Ptr<u8>, old_layout: Layout, new_size: usize) -> CPtr<u8> {
    CPtr::from_addr(
        rok_realloc_raw(ptr.addr(), old_layout.size, old_layout.align, new_size),
    )
}

pub unsafe fn alloc_one<T>() -> CPtr<T> {
    CPtr::from_addr(rok_alloc_raw(size_of::<T>(), align_of::<T>(), 0))
}

pub unsafe fn alloc_array<T>(n: usize) -> CPtr<T> {
    CPtr::from_addr(rok_alloc_raw(size_of::<T>() * n, align_of::<T>(), 0))
}

pub unsafe fn dealloc_one<T>(ptr: Ptr<T>) { rok_free(ptr.addr()); }

pub unsafe fn dealloc_array<T>(ptr: Ptr<T>, n: usize) { rok_free(ptr.addr()); }
