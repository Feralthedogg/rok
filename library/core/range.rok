// Range / RangeInclusive / RangeFrom / RangeTo / RangeFull (stdlib 2.7.4,
// refs-lang 3.7).
//
// A range expression is a value of these types (`let r = 0..5;`); the
// compiler builds the struct. `for i in a..b` with the range written in
// the loop header keeps a direct counting loop.

/// One step forward / back (2.7.3). Integers implement it; floats don't,
/// so `Range<f64>` is no iterator.
pub trait Step {
    fn forward_checked(self, count: usize) -> Self | none;
    fn backward_checked(self, count: usize) -> Self | none;
    fn steps_between(start: Self, end: Self) -> usize | none;
}

pub struct Range<T> {
    pub start: T;
    pub end: T;
}

pub struct RangeInclusive<T> {
    pub start: T;
    pub end: T;
    /// Set once the last item (`end`) is taken (from either side).
    pub exhausted: bool = false;
}

pub struct RangeFrom<T> {
    pub start: T;
}

pub struct RangeTo<T> {
    pub end: T;
}

pub struct RangeFull;

impl<T: Step> Iterator for Range<T> {
    type Item = T;
    fn next(ref self) -> T | none {
        if self.start < self.end {
            let cur = self.start;
            match self.start.forward_checked(1) {
                n: T => {
                    self.start = n;
                }
                none => {
                    self.start = self.end;
                }
            }
            return cur;
        }
        return none;
    }
}

impl<T: Step> DoubleEndedIterator for Range<T> {
    fn next_back(ref self) -> T | none {
        if self.start < self.end {
            match self.end.backward_checked(1) {
                p: T => {
                    self.end = p;
                    return p;
                }
                none => return none,
            }
        }
        return none;
    }
}

impl<T: Step> Iterator for RangeInclusive<T> {
    type Item = T;
    fn next(ref self) -> T | none {
        if self.exhausted || self.start > self.end {
            return none;
        }
        let cur = self.start;
        if self.start == self.end {
            self.exhausted = true;
        } else {
            match self.start.forward_checked(1) {
                n: T => {
                    self.start = n;
                }
                none => {
                    self.exhausted = true;
                }
            }
        }
        return cur;
    }
}

impl<T: Step> DoubleEndedIterator for RangeInclusive<T> {
    fn next_back(ref self) -> T | none {
        if self.exhausted || self.start > self.end {
            return none;
        }
        let cur = self.end;
        if self.start == self.end {
            self.exhausted = true;
        } else {
            match self.end.backward_checked(1) {
                p: T => {
                    self.end = p;
                }
                none => {
                    self.exhausted = true;
                }
            }
        }
        return cur;
    }
}

impl<T: Step> Iterator for RangeFrom<T> {
    type Item = T;
    /// Stops (without yielding it) at the type's maximum (2.7.4).
    fn next(ref self) -> T | none {
        let cur = self.start;
        match self.start.forward_checked(1) {
            n: T => {
                self.start = n;
                return cur;
            }
            none => return none,
        }
    }
}

// Step for the integer primitives (generated: one impl per type).
// ponytail: a `count` above the type's maximum is `none` even where the
// step would fit (signed types walking up from below zero).

impl Step for i8 {
    fn forward_checked(self, count: usize) -> i8 | none {
        if count > 127i8 as usize {
            return none;
        }
        let k = count as i8;
        if self > 127i8 - k {
            return none;
        }
        return self + k;
    }
    fn backward_checked(self, count: usize) -> i8 | none {
        if count > 127i8 as usize {
            return none;
        }
        let k = count as i8;
        if self < (-127i8 - 1) + k {
            return none;
        }
        return self - k;
    }
    fn steps_between(start: i8, end: i8) -> usize | none {
        if start > end {
            return none;
        }
        if start >= 0 || end < 0 {
            return (end - start) as usize;
        }
        return end as usize + (-(start + 1)) as usize + 1;
    }
}

