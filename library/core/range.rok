// Range / RangeInclusive / RangeFrom / RangeTo / RangeFull (spec 3.7).
//
// `0..5` → `Range::new(0, 5)`, etc. once the `#[literal(...)]` consumer
// for ranges lands. Stage-1 keeps range expressions as a built-in AST
// node (`ExprKind::Range`) and the for-loop lowering hardcodes
// `start..end`. These trait/struct declarations exist so a future
// pass can swap that for trait dispatch.

pub struct Range<T> {
    pub start: T;
    pub end: T;
}

pub struct RangeInclusive<T> {
    pub start: T;
    pub end: T;
}

pub struct RangeFrom<T> {
    pub start: T;
}

pub struct RangeTo<T> {
    pub end: T;
}

pub struct RangeFull;
