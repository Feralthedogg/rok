// Iterator + IntoIterator + FromIterator (stdlib spec 2.7).
//
// `for pat in xs` desugars to
//   let it = xs.into_iter();
//   loop { match it.next() { v: T => { let pat = v; body } none => break } }
// (integer ranges and arrays keep a direct counting loop).
//
// `next` takes `ref self` (2.7.1): an iterator's state lives in its
// fields, written back into the caller's binding after each call.
//
// The default methods' bodies don't name `Item` (only their signatures
// get it replaced by the impl's type); they hand off to the generic
// helpers at the bottom, whose item type comes from the arguments or
// the expected return type.

#[lang("iterator_trait")]
pub trait Iterator {
    type Item;
    fn next(ref self) -> Item | none;

    // ---- lazy adapters ----

    /// Apply `f` to each item.
    fn map<U>(self, f: fn(Item) -> U) -> Map<Self, Item, U> {
        return Map { it: self, f: f };
    }

    /// Keep the items `pred` accepts.
    fn filter(self, pred: fn(Item) -> bool) -> Filter<Self, Item> {
        return Filter { it: self, pred: pred };
    }

    /// `(index, item)` pairs.
    fn enumerate(self) -> Enumerate<Self, Item> {
        return Enumerate { it: self, i: 0 };
    }

    /// This iterator's items, then `other`'s.
    fn chain<J>(self, other: J) -> Chain<Self, J, Item> {
        return Chain { a: self, b: other, first: true };
    }

    /// At most the first `n` items.
    fn take(self, n: usize) -> Take<Self, Item> {
        return Take { it: self, left: n };
    }

    /// All but the first `n` items.
    fn skip(self, n: usize) -> Skip<Self, Item> {
        return Skip { it: self, n: n };
    }

    // ---- eager consumers ----

    fn count(self) -> usize {
        return count_of(self);
    }

    /// The items added up; `0` for none.
    fn sum(self) -> Item {
        return sum_of(self);
    }

    /// The items multiplied; `1` for none.
    fn product(self) -> Item {
        return product_of(self);
    }

    fn fold<B>(self, init: B, f: fn(B, Item) -> B) -> B {
        return fold_of(self, init, f);
    }

    fn any(self, pred: fn(Item) -> bool) -> bool {
        return any_of(self, pred);
    }

    fn all(self, pred: fn(Item) -> bool) -> bool {
        return all_of(self, pred);
    }

    fn find(self, pred: fn(Item) -> bool) -> Item | none {
        return find_of(self, pred);
    }

    fn position(self, pred: fn(Item) -> bool) -> usize | none {
        return position_of(self, pred);
    }

    fn min(self) -> Item | none {
        return min_of(self);
    }

    fn max(self) -> Item | none {
        return max_of(self);
    }

    fn last(self) -> Item | none {
        return last_of(self);
    }

    /// The `n`th remaining item (0-based), consuming the ones before it.
    fn nth(ref self, n: usize) -> Item | none {
        let i: usize = 0;
        while i < n {
            match self.next() {
                none => return none,
                _ => {}
            }
            i = i + 1;
        }
        return self.next();
    }

    fn for_each(self, f: fn(Item)) {
        for_each_of(self, f);
    }

    /// Gather the items into a `FromIterator` collection (the slot's
    /// type picks it: `let v: List<i32> = it.collect();`).
    fn collect<C>(self) -> C {
        return C::from_iter(self);
    }
}

#[lang("into_iterator_trait")]
pub trait IntoIterator {
    type IntoIter;
    type Item;
    fn into_iter(self) -> IntoIter;
}

/// Every iterator is iterable as itself (2.7.2).
impl<I: Iterator> IntoIterator for I {
    type IntoIter = I;
    fn into_iter(self) -> I {
        return self;
    }
}

/// A collection buildable from an iterator (`collect`, 2.9.9).
pub trait FromIterator<A> {
    fn from_iter<I>(it: I) -> Self;
}

pub struct Map<I, A, U> {
    it: I;
    f: fn(A) -> U;
}

impl<I: Iterator, A, U> Iterator for Map<I, A, U> {
    type Item = U;
    fn next(ref self) -> U | none {
        match self.it.next() {
            x: A => return (self.f)(x),
            none => return none,
        }
    }
}

pub struct Filter<I, A> {
    it: I;
    pred: fn(A) -> bool;
}

impl<I: Iterator, A> Iterator for Filter<I, A> {
    type Item = A;
    fn next(ref self) -> A | none {
        while true {
            match self.it.next() {
                x: A => {
                    if (self.pred)(x) {
                        return x;
                    }
                }
                none => return none,
            }
        }
        return none;
    }
}

pub struct Enumerate<I, A> {
    it: I;
    i: usize;
}

impl<I: Iterator, A> Iterator for Enumerate<I, A> {
    type Item = (usize, A);
    fn next(ref self) -> (usize, A) | none {
        match self.it.next() {
            x: A => {
                let at = self.i;
                self.i = at + 1;
                return (at, x);
            }
            none => return none,
        }
    }
}

pub struct Chain<I, J, A> {
    a: I;
    b: J;
    first: bool;
}

impl<I: Iterator, J: Iterator, A> Iterator for Chain<I, J, A> {
    type Item = A;
    fn next(ref self) -> A | none {
        if self.first {
            match self.a.next() {
                x: A => return x,
                none => {
                    self.first = false;
                }
            }
        }
        return self.b.next();
    }
}

pub struct Take<I, A> {
    it: I;
    left: usize;
}

impl<I: Iterator, A> Iterator for Take<I, A> {
    type Item = A;
    fn next(ref self) -> A | none {
        if self.left == 0 {
            return none;
        }
        self.left = self.left - 1;
        return self.it.next();
    }
}

pub struct Skip<I, A> {
    it: I;
    n: usize;
}

impl<I: Iterator, A> Iterator for Skip<I, A> {
    type Item = A;
    fn next(ref self) -> A | none {
        while self.n > 0 {
            self.n = self.n - 1;
            match self.it.next() {
                none => return none,
                _ => {}
            }
        }
        return self.it.next();
    }
}

fn count_of<I>(it: I) -> usize {
    let n: usize = 0;
    for _ in it {
        n = n + 1;
    }
    return n;
}

fn sum_of<I, T: Zero>(it: I) -> T {
    let acc: T = T::zero();
    for x in it {
        acc = acc + x;
    }
    return acc;
}

fn product_of<I, T: One>(it: I) -> T {
    let acc: T = T::one();
    for x in it {
        acc = acc * x;
    }
    return acc;
}

fn fold_of<I, B, T>(it: I, init: B, f: fn(B, T) -> B) -> B {
    let acc = init;
    for x in it {
        acc = f(acc, x);
    }
    return acc;
}

fn any_of<I, T>(it: I, pred: fn(T) -> bool) -> bool {
    for x in it {
        if pred(x) {
            return true;
        }
    }
    return false;
}

fn all_of<I, T>(it: I, pred: fn(T) -> bool) -> bool {
    for x in it {
        if !pred(x) {
            return false;
        }
    }
    return true;
}

fn find_of<I, T>(it: I, pred: fn(T) -> bool) -> T | none {
    for x in it {
        if pred(x) {
            return x;
        }
    }
    return none;
}

fn position_of<I, T>(it: I, pred: fn(T) -> bool) -> usize | none {
    let i: usize = 0;
    for x in it {
        if pred(x) {
            return i;
        }
        i = i + 1;
    }
    return none;
}

fn min_of<I, T: Ord>(it: I) -> T | none {
    let best: T | none = none;
    for x in it {
        match best {
            b: T => {
                if x.cmp(b).is_lt() {
                    best = x;
                }
            }
            none => {
                best = x;
            }
        }
    }
    return best;
}

fn max_of<I, T: Ord>(it: I) -> T | none {
    let best: T | none = none;
    for x in it {
        match best {
            b: T => {
                if x.cmp(b).is_gt() {
                    best = x;
                }
            }
            none => {
                best = x;
            }
        }
    }
    return best;
}

fn last_of<I, T>(it: I) -> T | none {
    let last: T | none = none;
    for x in it {
        last = x;
    }
    return last;
}

fn for_each_of<I, T>(it: I, f: fn(T)) {
    for x in it {
        f(x);
    }
}
