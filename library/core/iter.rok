// Iterator + IntoIterator + FromIterator (stdlib spec 2.7).
//
// `for pat in xs` desugars to
//   let it = xs.into_iter();
//   loop { match it.next() { v: T => { let pat = v; body } none => break } }
// (integer ranges and arrays keep a direct counting loop).
//
// `next` takes `ref self` (2.7.1): an iterator's state lives in its
// fields, written back into the caller's binding after each call.
//
// The default methods' bodies don't name `Item` (only their signatures
// get it replaced by the impl's type); they hand off to the generic
// helpers at the bottom, whose item type comes from the arguments or
// the expected return type.

#[lang("iterator_trait")]
pub trait Iterator {
    type Item;
    fn next(ref self) -> Item | none;

    // ---- lazy adapters ----

    /// Apply `f` to each item.
    fn map<U>(self, f: fn(Item) -> U) -> Map<Self, U> {
        Map { it: self, f: f }
    }

    /// Keep the items `pred` accepts.
    fn filter(self, pred: fn(Item) -> bool) -> Filter<Self> {
        Filter { it: self, pred: pred }
    }

    /// `(index, item)` pairs.
    fn enumerate(self) -> Enumerate<Self> {
        Enumerate { it: self, i: 0 }
    }

    /// Pairs of this iterator's and `other`'s items, until either ends.
    fn zip<J: Iterator>(self, other: J) -> Zip<Self, J> {
        Zip { a: self, b: other }
    }

    /// This iterator's items, then `other`'s (with the same item type).
    fn chain<J: Iterator<Item = Item>>(self, other: J) -> Chain<Self, J> {
        Chain { a: self, b: other, first: true }
    }

    /// At most the first `n` items.
    fn take(self, n: usize) -> Take<Self> {
        Take { it: self, left: n }
    }

    /// All but the first `n` items.
    fn skip(self, n: usize) -> Skip<Self> {
        Skip { it: self, n: n }
    }

    /// Every `step`th item, starting with the first (`step` > 0).
    fn step_by(self, step: usize) -> StepBy<Self> {
        if step == 0 {
            panic("Iterator::step_by: step must be positive");
        }
        StepBy { it: self, step: step, first: true }
    }

    /// The items back to front (`DoubleEndedIterator` only, 2.7.9).
    fn rev(self) -> Rev<Self> {
        Rev { it: self }
    }

    /// The items of each item (each item is `IntoIterator`).
    fn flatten(self) -> Flatten<Self> {
        Flatten { it: self, cur: none }
    }

    /// The items of each `f(item)` (an `IntoIterator`).
    fn flat_map<U>(self, f: fn(Item) -> U) -> FlatMap<Self, U> {
        FlatMap { it: self, f: f, cur: none }
    }

    /// An iterator that can look at its next item without taking it.
    fn peekable(self) -> Peekable<Self> {
        Peekable { it: self, peeked: none, has: false }
    }

    // ---- eager consumers ----

    fn count(self) -> usize {
        count_of(self)
    }

    /// The items added up; `0` for none.
    fn sum(self) -> Item {
        sum_of(self)
    }

    /// The items multiplied; `1` for none.
    fn product(self) -> Item {
        product_of(self)
    }

    fn fold<B>(self, init: B, f: fn(B, Item) -> B) -> B {
        fold_of(self, init, f)
    }

    /// The items combined left to right with `f`; `none` for none.
    fn reduce(self, f: fn(Item, Item) -> Item) -> Item | none {
        reduce_of(self, f)
    }

    fn any(self, pred: fn(Item) -> bool) -> bool {
        any_of(self, pred)
    }

    fn all(self, pred: fn(Item) -> bool) -> bool {
        all_of(self, pred)
    }

    fn find(self, pred: fn(Item) -> bool) -> Item | none {
        find_of(self, pred)
    }

    fn position(self, pred: fn(Item) -> bool) -> usize | none {
        position_of(self, pred)
    }

    fn min(self) -> Item | none {
        min_of(self)
    }

    fn max(self) -> Item | none {
        max_of(self)
    }

    /// The item with the smallest `key` (the first of equals).
    fn min_by_key<K: Ord>(self, key: fn(Item) -> K) -> Item | none {
        min_by_key_of(self, key)
    }

    /// The item with the largest `key` (the last of equals).
    fn max_by_key<K: Ord>(self, key: fn(Item) -> K) -> Item | none {
        max_by_key_of(self, key)
    }

    fn last(self) -> Item | none {
        last_of(self)
    }

    /// The `n`th remaining item (0-based), consuming the ones before it.
    fn nth(ref self, n: usize) -> Item | none {
        for i in 0..n {
            self.next()?;
        }
        self.next()
    }

    fn for_each(self, f: fn(Item)) {
        for_each_of(self, f);
    }

    /// Gather the items into a `FromIterator` collection (the slot's
    /// type picks it: `let v: List<i32> = it.collect();`).
    fn collect<C>(self) -> C {
        C::from_iter(self)
    }
}

/// An iterator that can also step from the back (2.7.9).
pub trait DoubleEndedIterator: Iterator {
    fn next_back(ref self) -> Item | none;
}

#[lang("into_iterator_trait")]
pub trait IntoIterator {
    type IntoIter;
    type Item;
    fn into_iter(self) -> IntoIter;
}

/// Every iterator is iterable as itself (2.7.2).
impl<I: Iterator> IntoIterator for I {
    type IntoIter = I;
    type Item = I::Item;
    fn into_iter(self) -> I {
        self
    }
}

/// A collection buildable from an iterator (`collect`, 2.9.9).
pub trait FromIterator<A> {
    fn from_iter<I>(it: I) -> Self;
}

pub struct Map<I, U> {
    it: I;
    f: fn(I::Item) -> U;
}

impl<I: Iterator, U> Iterator for Map<I, U> {
    type Item = U;
    fn next(ref self) -> U | none {
        (self.f)(self.it.next()?)
    }
}

impl<I: DoubleEndedIterator, U> DoubleEndedIterator for Map<I, U> {
    fn next_back(ref self) -> U | none {
        (self.f)(self.it.next_back()?)
    }
}

pub struct Filter<I> {
    it: I;
    pred: fn(I::Item) -> bool;
}

impl<I: Iterator> Iterator for Filter<I> {
    type Item = I::Item;
    fn next(ref self) -> I::Item | none {
        while let x: I::Item = self.it.next() {
            if (self.pred)(x) {
                return x;
            }
        }
        none
    }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for Filter<I> {
    fn next_back(ref self) -> I::Item | none {
        while let x: I::Item = self.it.next_back() {
            if (self.pred)(x) {
                return x;
            }
        }
        none
    }
}

pub struct Enumerate<I> {
    it: I;
    i: usize;
}

impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (usize, I::Item);
    fn next(ref self) -> (usize, I::Item) | none {
        let x = self.it.next()?;
        let at = self.i;
        self.i = at + 1;
        (at, x)
    }
}

pub struct Zip<I, J> {
    a: I;
    b: J;
}

impl<I: Iterator, J: Iterator> Iterator for Zip<I, J> {
    type Item = (I::Item, J::Item);
    fn next(ref self) -> (I::Item, J::Item) | none {
        let x = self.a.next()?;
        (x, self.b.next()?)
    }
}

pub struct Chain<I, J> {
    a: I;
    b: J;
    first: bool;
}

impl<I: Iterator, J: Iterator> Iterator for Chain<I, J> {
    type Item = I::Item;
    fn next(ref self) -> I::Item | none {
        if self.first {
            if let x: I::Item = self.a.next() {
                return x;
            }
            self.first = false;
        }
        self.b.next()
    }
}

impl<I: DoubleEndedIterator, J: DoubleEndedIterator> DoubleEndedIterator for Chain<I, J> {
    fn next_back(ref self) -> I::Item | none {
        self.b.next_back() ?? self.a.next_back()
    }
}

pub struct StepBy<I> {
    it: I;
    step: usize;
    first: bool;
}

impl<I: Iterator> Iterator for StepBy<I> {
    type Item = I::Item;
    fn next(ref self) -> I::Item | none {
        if self.first {
            self.first = false;
            return self.it.next();
        }
        self.it.nth(self.step - 1)
    }
}

pub struct Rev<I> {
    it: I;
}

impl<I: DoubleEndedIterator> Iterator for Rev<I> {
    type Item = I::Item;
    fn next(ref self) -> I::Item | none {
        self.it.next_back()
    }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for Rev<I> {
    fn next_back(ref self) -> I::Item | none {
        self.it.next()
    }
}

/// `flatten`: `cur` is the inner iterator being drained.
pub struct Flatten<I> {
    it: I;
    cur: <I::Item as IntoIterator>::IntoIter | none;
}

impl<I: Iterator> Iterator for Flatten<I> {
    type Item = <I::Item as IntoIterator>::Item;
    fn next(ref self) -> <I::Item as IntoIterator>::Item | none {
        while true {
            if let inner: <I::Item as IntoIterator>::IntoIter = self.cur {
                if let x: <I::Item as IntoIterator>::Item = inner.next() {
                    self.cur = inner;
                    return x;
                }
                self.cur = none;
            } else {
                let nx = self.it.next()?;
                self.cur = nx.into_iter();
            }
        }
        none
    }
}

/// `flat_map`: `cur` is the inner iterator being drained.
pub struct FlatMap<I, U> {
    it: I;
    f: fn(I::Item) -> U;
    cur: <U as IntoIterator>::IntoIter | none;
}

impl<I: Iterator, U: IntoIterator> Iterator for FlatMap<I, U> {
    type Item = U::Item;
    fn next(ref self) -> U::Item | none {
        while true {
            if let inner: U::IntoIter = self.cur {
                if let x: U::Item = inner.next() {
                    self.cur = inner;
                    return x;
                }
                self.cur = none;
            } else {
                self.cur = (self.f)(self.it.next()?).into_iter();
            }
        }
        none
    }
}

pub struct Peekable<I> {
    it: I;
    peeked: I::Item | none;
    has: bool;
}

impl<I: Iterator> Peekable<I> {
    /// The next item, left in place for the following `next`.
    pub fn peek(ref self) -> I::Item | none {
        if !self.has {
            self.peeked = self.it.next();
            self.has = true;
        }
        self.peeked
    }
}

impl<I: Iterator> Iterator for Peekable<I> {
    type Item = I::Item;
    fn next(ref self) -> I::Item | none {
        if self.has {
            self.has = false;
            return self.peeked;
        }
        self.it.next()
    }
}

pub struct Take<I> {
    it: I;
    left: usize;
}

impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;
    fn next(ref self) -> I::Item | none {
        if self.left == 0 {
            return none;
        }
        self.left -= 1;
        self.it.next()
    }
}

pub struct Skip<I> {
    it: I;
    n: usize;
}

impl<I: Iterator> Iterator for Skip<I> {
    type Item = I::Item;
    fn next(ref self) -> I::Item | none {
        while self.n > 0 {
            self.n -= 1;
            self.it.next()?;
        }
        self.it.next()
    }
}

fn count_of<I>(it: I) -> usize {
    let n: usize = 0;
    for _ in it {
        n += 1;
    }
    n
}

fn sum_of<I, T: Zero>(it: I) -> T {
    let acc: T = T::zero();
    for x in it {
        acc += x;
    }
    acc
}

fn product_of<I, T: One>(it: I) -> T {
    let acc: T = T::one();
    for x in it {
        acc *= x;
    }
    acc
}

fn fold_of<I, B, T>(it: I, init: B, f: fn(B, T) -> B) -> B {
    let acc = init;
    for x in it {
        acc = f(acc, x);
    }
    acc
}

fn reduce_of<I, T>(it: I, f: fn(T, T) -> T) -> T | none {
    let acc: T | none = none;
    for x in it {
        acc = if let a: T = acc { f(a, x) } else { x };
    }
    acc
}

fn min_by_key_of<I, T, K: Ord>(it: I, key: fn(T) -> K) -> T | none {
    let best: T | none = none;
    let best_key: K | none = none;
    for x in it {
        let k = key(x);
        match best_key {
            b: K => {
                if k.cmp(b).is_lt() {
                    best = x;
                    best_key = k;
                }
            }
            none => {
                best = x;
                best_key = k;
            }
        }
    }
    best
}

fn max_by_key_of<I, T, K: Ord>(it: I, key: fn(T) -> K) -> T | none {
    let best: T | none = none;
    let best_key: K | none = none;
    for x in it {
        let k = key(x);
        match best_key {
            b: K => {
                if !k.cmp(b).is_lt() {
                    best = x;
                    best_key = k;
                }
            }
            none => {
                best = x;
                best_key = k;
            }
        }
    }
    best
}

fn any_of<I, T>(it: I, pred: fn(T) -> bool) -> bool {
    for x in it {
        if pred(x) {
            return true;
        }
    }
    false
}

fn all_of<I, T>(it: I, pred: fn(T) -> bool) -> bool {
    for x in it {
        if !pred(x) {
            return false;
        }
    }
    true
}

fn find_of<I, T>(it: I, pred: fn(T) -> bool) -> T | none {
    for x in it {
        if pred(x) {
            return x;
        }
    }
    none
}

fn position_of<I, T>(it: I, pred: fn(T) -> bool) -> usize | none {
    let i: usize = 0;
    for x in it {
        if pred(x) {
            return i;
        }
        i += 1;
    }
    none
}

fn min_of<I, T: Ord>(it: I) -> T | none {
    let best: T | none = none;
    for x in it {
        match best {
            b: T => {
                if x.cmp(b).is_lt() {
                    best = x;
                }
            }
            none => {
                best = x;
            }
        }
    }
    best
}

fn max_of<I, T: Ord>(it: I) -> T | none {
    let best: T | none = none;
    for x in it {
        match best {
            b: T => {
                if x.cmp(b).is_gt() {
                    best = x;
                }
            }
            none => {
                best = x;
            }
        }
    }
    best
}

fn last_of<I, T>(it: I) -> T | none {
    let last: T | none = none;
    for x in it {
        last = x;
    }
    last
}

fn for_each_of<I, T>(it: I, f: fn(T)) {
    for x in it {
        f(x);
    }
}

// ---- generators (refs-lang 4.11) ----

/// The value of a `yield fn` call / `yield { .. }` block: an iterator
/// over what the body yields. `resume` runs the body to its next `yield`
/// (its env is the coroutine frame, a GC object the body's state lives
/// in, so copies of a `GenIter` share one position).
// ponytail: one library type per coroutine kind instead of a fresh
// anonymous type per coroutine (spec 4.1.11); it only shows in type
// names and identity.
pub struct GenIter<T> {
    resume: fn() -> (T | none);
}

impl<T> Iterator for GenIter<T> {
    type Item = T;
    fn next(ref self) -> T | none {
        (self.resume)()
    }
}

/// A throwing generator (`yield fn f() throws (E) -> T`): the error
/// surfaces at `next` (refs-lang 4.14.10), so a loop over it throws and
/// must be covered: `try for x in g { .. }`.
pub struct TryGenIter<T, E> {
    resume: fn() throws (E) -> (T | none);
}

impl<T, E> TryGenIter<T, E> {
    pub fn next(ref self) throws (E) -> T | none {
        try (self.resume)()
    }
}
