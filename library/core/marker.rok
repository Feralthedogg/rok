// Marker traits used by #[derive(...)] (spec 6.2/6.4) and other
// compiler-driven semantics. Slots follow stdlib spec 0.4 (6.4.8).
// The comparison / hashing traits live in `cmp.rok`.

#[lang("clone_trait")]
pub trait Clone {
    fn clone(self) -> Self;
}

/// A type's default value (`0`, `false`, `'\0'`, `""`, empty
/// collections); `#[derive(Default)]` defaults every field.
pub trait Default {
    fn default() -> Self;
}

/// `T::default()` where only the expected type names `T`
/// (`#[derive(Default)]` field initializers).
pub fn default_of<T: Default>() -> T {
    T::default()
}

impl Default for i8 { fn default() -> i8 { 0 } }
impl Default for i16 { fn default() -> i16 { 0 } }
impl Default for i32 { fn default() -> i32 { 0 } }
impl Default for i64 { fn default() -> i64 { 0 } }
impl Default for isize { fn default() -> isize { 0 } }
impl Default for u8 { fn default() -> u8 { 0 } }
impl Default for u16 { fn default() -> u16 { 0 } }
impl Default for u32 { fn default() -> u32 { 0 } }
impl Default for u64 { fn default() -> u64 { 0 } }
impl Default for usize { fn default() -> usize { 0 } }
impl Default for f32 { fn default() -> f32 { 0.0 } }
impl Default for f64 { fn default() -> f64 { 0.0 } }
impl Default for bool { fn default() -> bool { false } }
impl Default for char { fn default() -> char { '\0' } }
impl Default for str { fn default() -> str { "" } }

/// Bitwise copy is a correct duplicate (stdlib 2.13.3). A marker: every
/// value already copies on `let y = x;`; `#[derive(Copy)]` checks that
/// every field is `Copy` and the type is not `Drop`.
pub trait Copy: Clone {}

// Primitives (and the immutable `(ptr, len)` `str`, 2.13.6) clone by
// copying.
impl Clone for i8 { fn clone(self) -> i8 { self } }
impl Clone for i16 { fn clone(self) -> i16 { self } }
impl Clone for i32 { fn clone(self) -> i32 { self } }
impl Clone for i64 { fn clone(self) -> i64 { self } }
impl Clone for isize { fn clone(self) -> isize { self } }
impl Clone for u8 { fn clone(self) -> u8 { self } }
impl Clone for u16 { fn clone(self) -> u16 { self } }
impl Clone for u32 { fn clone(self) -> u32 { self } }
impl Clone for u64 { fn clone(self) -> u64 { self } }
impl Clone for usize { fn clone(self) -> usize { self } }
impl Clone for f32 { fn clone(self) -> f32 { self } }
impl Clone for f64 { fn clone(self) -> f64 { self } }
impl Clone for bool { fn clone(self) -> bool { self } }
impl Clone for char { fn clone(self) -> char { self } }
impl Clone for c_char { fn clone(self) -> c_char { self } }
impl Clone for str { fn clone(self) -> str { self } }

impl Copy for i8 {}
impl Copy for i16 {}
impl Copy for i32 {}
impl Copy for i64 {}
impl Copy for isize {}
impl Copy for u8 {}
impl Copy for u16 {}
impl Copy for u32 {}
impl Copy for u64 {}
impl Copy for usize {}
impl Copy for f32 {}
impl Copy for f64 {}
impl Copy for bool {}
impl Copy for char {}
impl Copy for c_char {}
impl Copy for str {}

// Stdlib spec 2.13.4. `using` (refs-lang 3.17) calls `drop` on every way
// out of its block. ponytail: no implicit scope-exit drop of plain
// `let`s yet (2.13.4 RAII); `using` is the deterministic path.
pub trait Drop {
    #[lang("drop_method")]
    fn drop(ref self);
}

// Auto (structural) marker traits (E3). The compiler derives them: a
// struct / enum / tuple / array / sum has one iff every component does;
// primitives and `str` have both; a closure has one iff its captures do;
// a `fn` type has the ones it names (`fn() -> T + Send`), and a named
// function (no captures) has both. `unsafe impl Send for T {}` opts in,
// `impl !Send for T {}` opts out (`Cell<T>`, `Ptr<T>` when they land).
// `Send`: safe to move to another thread. `Sync`: safe to read through
// shared references from several threads.
#[lang("send_trait")]
pub trait Send {}

#[lang("sync_trait")]
pub trait Sync {}
