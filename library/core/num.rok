// bool

impl BitAnd for bool {
    type Output = bool;
    #[intrinsic("rok.and.bool")]
    fn bitand(self, rhs: bool) -> bool { self & rhs }
}

impl BitOr for bool {
    type Output = bool;
    #[intrinsic("rok.or.bool")]
    fn bitor(self, rhs: bool) -> bool { self | rhs }
}

impl BitXor for bool {
    type Output = bool;
    #[intrinsic("rok.xor.bool")]
    fn bitxor(self, rhs: bool) -> bool { self ^ rhs }
}

impl Not for bool {
    type Output = bool;
    #[intrinsic("rok.not.bool")]
    fn not(self) -> bool { !self }
}

impl PartialEq for bool {
    #[intrinsic("rok.eq.bool")]
    fn eq(self, rhs: bool) -> bool { self == rhs }
    #[intrinsic("rok.ne.bool")]
    fn ne(self, rhs: bool) -> bool { self != rhs }
}

impl Eq for bool {}

/// `false < true`.
impl PartialOrd for bool {
    fn lt(self, rhs: bool) -> bool { !self && rhs }
    fn gt(self, rhs: bool) -> bool { self && !rhs }
    fn le(self, rhs: bool) -> bool { !self || rhs }
    fn ge(self, rhs: bool) -> bool { self || !rhs }
}

impl Ord for bool {
    fn cmp(self, other: bool) -> Ordering {
        if self == other { return Ordering::Equal; }
        if other { Ordering::Less } else { Ordering::Greater }
    }
}

impl Hash for bool {
    fn hash(self) -> u64 { if self { 1u64 } else { 0u64 } }
}

