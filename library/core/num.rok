impl PartialEq for f64 {
    fn eq(self, rhs: f64) -> bool { return self == rhs; }
    fn ne(self, rhs: f64) -> bool { return self != rhs; }
}

impl PartialOrd for f64 {
    fn lt(self, rhs: f64) -> bool { return self < rhs; }
    fn gt(self, rhs: f64) -> bool { return self > rhs; }
    fn le(self, rhs: f64) -> bool { return self <= rhs; }
    fn ge(self, rhs: f64) -> bool { return self >= rhs; }
}

// bool

impl BitAnd for bool {
    type Output = bool;
    fn bitand(self, rhs: bool) -> bool { return self & rhs; }
}

impl BitOr for bool {
    type Output = bool;
    fn bitor(self, rhs: bool) -> bool { return self | rhs; }
}

impl BitXor for bool {
    type Output = bool;
    fn bitxor(self, rhs: bool) -> bool { return self ^ rhs; }
}

impl Not for bool {
    type Output = bool;
    fn not(self) -> bool { return !self; }
}

impl PartialEq for bool {
    fn eq(self, rhs: bool) -> bool { return self == rhs; }
    fn ne(self, rhs: bool) -> bool { return self != rhs; }
}

impl Eq for bool {}

// char

impl PartialEq for char {
    fn eq(self, rhs: char) -> bool { return self == rhs; }
    fn ne(self, rhs: char) -> bool { return self != rhs; }
}

impl Eq for char {}
