// rok::core::num — the primitive types' operator / comparison trait
// impls (stdlib spec 2.1, 2.3.5, 2.5). They make `T: Add` / `T: Ord`
// bounds accept primitives. Each method is `#[intrinsic("rok.OP.TYPE")]`
// (stdlib spec 0.3): a primitive `a + b` and a by-name call (`x.add(y)`,
// `T::add(a, b)`) both lower to the machine op. The body is the
// fallback (0.3.4) and what a `fn` value of the method runs.
// One block per (type, trait); keep it regular. The inherent methods
// (`checked_add`, `count_ones`, `floor`, ..) live in `ints` / `floats`.

pub mod ints;
pub mod floats;
pub mod bigint;
pub mod bigfloat;
pub mod niche;
pub mod assign;

/// The additive identity — where `Iterator::sum` starts (an empty sum is
/// `0`).
pub trait Zero {
    fn zero() -> Self;
}

/// The multiplicative identity — where `Iterator::product` starts.
pub trait One {
    fn one() -> Self;
}

// i8

impl Zero for i8 {
    fn zero() -> i8 { 0 }
}

impl One for i8 {
    fn one() -> i8 { 1 }
}

impl Add for i8 {
    type Output = i8;
    #[intrinsic("rok.add.i8")]
    fn add(self, rhs: i8) -> i8 { self + rhs }
}

impl Sub for i8 {
    type Output = i8;
    #[intrinsic("rok.sub.i8")]
    fn sub(self, rhs: i8) -> i8 { self - rhs }
}

impl Mul for i8 {
    type Output = i8;
    #[intrinsic("rok.mul.i8")]
    fn mul(self, rhs: i8) -> i8 { self * rhs }
}

impl Div for i8 {
    type Output = i8;
    #[intrinsic("rok.div.i8")]
    fn div(self, rhs: i8) -> i8 { self / rhs }
}

impl Rem for i8 {
    type Output = i8;
    #[intrinsic("rok.rem.i8")]
    fn rem(self, rhs: i8) -> i8 { self % rhs }
}

impl Neg for i8 {
    type Output = i8;
    #[intrinsic("rok.neg.i8")]
    fn neg(self) -> i8 { -self }
}

impl BitAnd for i8 {
    type Output = i8;
    #[intrinsic("rok.and.i8")]
    fn bitand(self, rhs: i8) -> i8 { self & rhs }
}

impl BitOr for i8 {
    type Output = i8;
    #[intrinsic("rok.or.i8")]
    fn bitor(self, rhs: i8) -> i8 { self | rhs }
}

impl BitXor for i8 {
    type Output = i8;
    #[intrinsic("rok.xor.i8")]
    fn bitxor(self, rhs: i8) -> i8 { self ^ rhs }
}

impl Shl for i8 {
    type Output = i8;
    #[intrinsic("rok.shl.i8")]
    fn shl(self, rhs: i8) -> i8 { self << rhs }
}

impl Shr for i8 {
    type Output = i8;
    #[intrinsic("rok.shr.i8")]
    fn shr(self, rhs: i8) -> i8 { self >> rhs }
}

impl BitNot for i8 {
    type Output = i8;
    #[intrinsic("rok.not.i8")]
    fn bitnot(self) -> i8 { ~self }
}

impl PartialEq for i8 {
    #[intrinsic("rok.eq.i8")]
    fn eq(self, rhs: i8) -> bool { self == rhs }
    #[intrinsic("rok.ne.i8")]
    fn ne(self, rhs: i8) -> bool { self != rhs }
}

impl PartialOrd for i8 {
    #[intrinsic("rok.lt.i8")]
    fn lt(self, rhs: i8) -> bool { self < rhs }
    #[intrinsic("rok.gt.i8")]
    fn gt(self, rhs: i8) -> bool { self > rhs }
    #[intrinsic("rok.le.i8")]
    fn le(self, rhs: i8) -> bool { self <= rhs }
    #[intrinsic("rok.ge.i8")]
    fn ge(self, rhs: i8) -> bool { self >= rhs }
}

impl Eq for i8 {}

impl Hash for i8 {
    fn hash(self) -> u64 { self as u64 }
}

impl Ord for i8 {
    fn cmp(self, other: i8) -> Ordering {
        if self < other { return Ordering::Less; }
        if self > other { return Ordering::Greater; }
        Ordering::Equal
    }
}

