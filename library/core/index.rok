// Indexing + slicing traits.
//
// Spec 3.6: `arr[i]`, `arr[i,j]`, `arr[1:3]` all desugar through these
// traits. The compiler currently builds memref-backed array indexing
// directly; once a future pass routes indexing through the LangTable's
// `index_trait` / `index_set_trait` / `slice_trait` slots, user types
// implementing these will participate in `[...]` syntax.

#[lang("index_trait")]
pub trait Index<I> {
    type Output;
    fn index(self, idx: I) -> Output;
}

#[lang("index_set_trait")]
pub trait IndexSet<I> {
    type Value;
    fn index_set(ref self, idx: I, value: Value);
}

#[lang("slice_trait")]
pub trait Slice<R> {
    type Output;
    fn slice(self, range: R) -> Output;
}
