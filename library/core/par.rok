// rok::core::par — data-parallel helpers (stdlib spec 2.19).
//
// Everything below the "pool seam" section is written against three
// internal functions — `fork`, `wait_forked`, `run_chunks` — so the
// work-stealing scheduler (706) can replace the thread-per-call pool
// without touching the public API.
//
// Chunks are claimed from a shared counter by one job per worker.

// ---- pool seam ----
//
// The work runs on the task executor's work-stealing pool
// (`rok::core::task`): inside `block_on` / async code on the running
// pool, from plain sync code on a pool started for the call.

/// Run `f` as a pool task; `wait_forked` its handle.
fn fork(f: fn() + Send) -> Task<bool> {
    task::fork_job(f)
}

/// Wait for a `fork`ed job, running other pool tasks meanwhile.
fn wait_forked(h: Task<bool>) {
    task::help_until(h);
}

/// Run `job(c)` for every `c` in `0..chunks` across the workers (this
/// thread included); returns once all have finished.
fn run_chunks(chunks: usize, job: fn(usize) + Send) {
    task::in_pool(|| {
        let workers = task::workers();
        if workers > chunks {
            workers = chunks;
        }
        let next = Atomic::new(0usize);
        let work = || {
            loop {
                let c = next.fetch_add(1);
                if c >= chunks {
                    break;
                }
                job(c);
            }
        };
        let helpers: List<Task<bool>> = [];
        for _ in 1..workers {
            helpers.push(fork(work));
        }
        work();
        for h in helpers {
            wait_forked(h);
        }
        true
    });
}

/// `(chunk count, chunk length)` for `n` items.
fn chunking(n: usize) -> (usize, usize) {
    let chunks = task::cpu_count() * 4;
    if chunks > n {
        chunks = n;
    }
    if chunks == 0 {
        return (0usize, 0usize);
    }
    (chunks, (n + chunks - 1) / chunks)
}

fn collect_items<I: IntoIterator>(iter: I) -> List<I::Item> {
    let items: List<I::Item> = [];
    for x in iter {
        items.push(x);
    }
    items
}

// ---- public API ----

/// Call `f` on every item, in parallel (order unspecified).
pub fn for_each<I: IntoIterator, T: Send>(iter: I, f: fn(T) + Send + Sync) {
    let items: List<T> = collect_items(iter);
    let n = items.len();
    let (chunks, size) = chunking(n);
    run_chunks(chunks, |c| {
        for i in c * size..n.min((c + 1) * size) {
            f(items[i]);
        }
    });
}

/// `f` of every item, in the items' order.
pub fn map<I: IntoIterator, T: Send, U: Send>(iter: I, f: fn(T) -> U + Send + Sync) -> List<U> {
    let items: List<T> = collect_items(iter);
    let n = items.len();
    let out: GcBuf<U> = buf_new(n);
    let (chunks, size) = chunking(n);
    run_chunks(chunks, |c| {
        for i in c * size..n.min((c + 1) * size) {
            out[i] = f(items[i]);
        }
    });
    let result: List<U> = List::with_capacity(n);
    for i in 0..n {
        result.push(out[i]);
    }
    result
}

/// Fold with an associative `f` (2.19.4): chunks fold in parallel, then
/// `init` and the chunk results fold in order.
pub fn reduce<T: Send + Sync>(iter: List<T>, init: T, f: fn(T, T) -> T + Send + Sync) -> T {
    let n = iter.len();
    let (chunks, size) = chunking(n);
    let partial: GcBuf<T> = buf_new(chunks);
    run_chunks(chunks, |c| {
        let start = c * size;
        let acc = iter[start];
        for i in start + 1..n.min((c + 1) * size) {
            acc = f(acc, iter[i]);
        }
        partial[c] = acc;
    });
    let acc = init;
    for c in 0..chunks {
        acc = f(acc, partial[c]);
    }
    acc
}

/// The items `pred` accepts, in order.
pub fn filter<T: Send>(iter: List<T>, pred: fn(T) -> bool + Send + Sync) -> List<T> {
    let n = iter.len();
    let keep: GcBuf<bool> = buf_new(n);
    let (chunks, size) = chunking(n);
    run_chunks(chunks, |c| {
        for i in c * size..n.min((c + 1) * size) {
            keep[i] = pred(iter[i]);
        }
    });
    let out: List<T> = [];
    for i in 0..n {
        if keep[i] {
            out.push(iter[i]);
        }
    }
    out
}

/// Run both at once; both results.
pub fn join<T1: Send, T2: Send>(f1: fn() -> T1 + Send, f2: fn() -> T2 + Send) -> (T1, T2) {
    let first: GcBuf<T1> = buf_new(1);
    let second: GcBuf<T2> = buf_new(1);
    task::in_pool(|| {
        let h = fork(|| { second[0] = f2(); });
        first[0] = f1();
        wait_forked(h);
        true
    });
    (first[0], second[0])
}

/// Structured spawning (2.19.3): every task `s.spawn`s has finished
/// when `scope` returns.
pub fn scope(f: fn(Scope)) {
    task::in_pool(|| {
        run_scope(f);
        true
    });
}

fn run_scope(f: fn(Scope)) {
    let tasks: List<ScopeTask> = [];
    let s = Scope { tasks: Mutex::new(tasks) };
    f(s);
    // Tasks may spawn more tasks: drain until none is left.
    loop {
        let next: ScopeTask | none = none;
        using g = s.tasks.lock() {
            next = g.get().pop();
        }
        match next {
            t: ScopeTask => t.finish(),
            none => break,
        }
    }
}

struct ScopeTask {
    handle: Task<bool>;
    joined: Once;
}

impl ScopeTask {
    fn finish(self) {
        let h = self.handle;
        // Every caller returns only after the one join has finished.
        self.joined.call_once(|| { wait_forked(h); });
    }
}

/// Spawns tasks that `scope` waits for.
pub struct Scope {
    tasks: Mutex<List<ScopeTask>>;
}

impl Scope {
    pub fn spawn<T: Send>(self, f: fn() -> T + Send) -> ScopeHandle<T> {
        let result: GcBuf<T> = buf_new(1);
        let task = ScopeTask {
            handle: fork(|| { result[0] = f(); }),
            joined: Once::new(),
        };
        using g = self.tasks.lock() {
            g.get().push(task);
        }
        ScopeHandle { task, result }
    }
}

/// One `Scope::spawn`ed task.
pub struct ScopeHandle<T> {
    task: ScopeTask;
    result: GcBuf<T>;
}

impl<T> ScopeHandle<T> {
    /// Wait for the task; its result.
    pub fn join(self) -> T {
        self.task.finish();
        self.result[0]
    }
}
