// rok::core::num::bigint — `int`, the arbitrary-precision integer
// (stdlib spec 2.1.2, 2.1.6, 2.1.7). `#[keyword("int")]` routes the
// lowercase type name here in every package; an unsuffixed integer
// literal in an `int` slot is built by `Int::from_i64` /
// `Int::from_literal` (refs-lang 1.6.3, HIR `lower_literal`).
//
// Representation: a value that fits `i64` lives in `small` (`big` is
// `none`); anything larger is a sign + magnitude (`IntMag`, base-2^32
// limbs). The form is canonical: every result that fits `i64` drops
// back to `small` (spec 2.1.2 says promoted values stay big; canonical
// form keeps `==` / `hash` a field compare and is not observable).
// Values are immutable: a limb buffer is never written once it sits in
// an `Int`, so copies share it (spec 2.13.3: `int` is `Copy`).
//
// Algorithms: schoolbook add / sub, schoolbook multiplication with
// Karatsuba above `KARATSUBA` limbs, Knuth algorithm D division (the
// multiply and divide inner loops are runtime kernels),
// square-and-multiply `pow`, Euclid `gcd`, quadratic radix conversion.
// Numbers of 10^5+ digits would want FFT / Toom-Cook multiplication,
// Burnikel-Ziegler division and divide-and-conquer radix conversion.

use rok::core::collections::raw::{GcBuf, buf_new};

/// Limb count from which `IntMag::mul` splits (Karatsuba).
const KARATSUBA: usize = 40;

/// A magnitude: little-endian base-2^32 limbs `d[0..n]`, no leading
/// zero limb (`n == 0` is zero). `d` may be longer than `n`.
pub(pkg) struct IntMag {
    d: GcBuf<u32>;
    n: usize;
}

impl IntMag {
    fn zero() -> IntMag {
        unsafe {
            IntMag { d: buf_new(0), n: 0 }
        }
    }

    /// `d[0..n]` without its leading zero limbs (shares `d`).
    fn trim(d: GcBuf<u32>, n: usize) -> IntMag {
        unsafe {
            let k = n;
            while k > 0 && d[k - 1] == 0u32 { k -= 1; }
            IntMag { d: d, n: k }
        }
    }

    fn from_u64(v: u64) -> IntMag {
        unsafe {
            let d: GcBuf<u32> = buf_new(2);
            d[0] = v as u32;
            d[1] = (v >> 32u64) as u32;
            IntMag::trim(d, 2)
        }
    }

    /// Limb `i`, zero past the top.
    fn limb(self, i: usize) -> u64 {
        unsafe {
            if i < self.n { self.d[i] as u64 } else { 0u64 }
        }
    }

    /// The low 64 bits.
    fn low64(self) -> u64 { (self.limb(1) << 32u64) | self.limb(0) }

    /// Number of significant bits (0 for zero).
    fn bits(self) -> u64 {
        unsafe {
            if self.n == 0 { return 0u64; }
            (self.n as u64) * 32u64 - (self.d[self.n - 1].leading_zeros() as u64)
        }
    }

    /// `self` vs `b`: -1, 0 or 1.
    fn cmp3(self, b: IntMag) -> i32 {
        unsafe {
            if self.n != b.n { return if self.n < b.n { -1 } else { 1 }; }
            let i = self.n;
            while i > 0 {
                i -= 1;
                if self.d[i] != b.d[i] { return if self.d[i] < b.d[i] { -1 } else { 1 }; }
            }
            0
        }
    }

    fn plus(self, b: IntMag) -> IntMag {
        unsafe {
            if self.n < b.n { return b.plus(self); }
            let r: GcBuf<u32> = buf_new(self.n + 1);
            let carry = 0u64;
            let i = 0usize;
            while i < self.n {
                let s = (self.d[i] as u64) + b.limb(i) + carry;
                r[i] = s as u32;
                carry = s >> 32u64;
                i += 1;
            }
            r[self.n] = carry as u32;
            IntMag::trim(r, self.n + 1)
        }
    }

    /// `self - b`, `self >= b`.
    fn minus(self, b: IntMag) -> IntMag {
        unsafe {
            let r: GcBuf<u32> = buf_new(self.n);
            let borrow = 0u64;
            let i = 0usize;
            while i < self.n {
                let x = self.d[i] as u64;
                let y = b.limb(i) + borrow;
                if x >= y {
                    r[i] = (x - y) as u32;
                    borrow = 0u64;
                } else {
                    r[i] = (x + 0x1_0000_0000u64 - y) as u32;
                    borrow = 1u64;
                }
                i += 1;
            }
            IntMag::trim(r, self.n)
        }
    }

    /// `r[off..] += self` (`r` has room for the carry).
    fn add_to(self, r: GcBuf<u32>, off: usize) {
        unsafe {
            let carry = 0u64;
            let i = 0usize;
            while i < self.n || carry != 0u64 {
                let s = (r[off + i] as u64) + self.limb(i) + carry;
                r[off + i] = s as u32;
                carry = s >> 32u64;
                i += 1;
            }
        }
    }

    /// Limbs `lo..hi` (a copy).
    fn slice(self, lo: usize, hi: usize) -> IntMag {
        unsafe {
            let h = if hi < self.n { hi } else { self.n };
            if lo >= h { return IntMag::zero(); }
            let r: GcBuf<u32> = buf_new(h - lo);
            let i = lo;
            while i < h {
                r[i - lo] = self.d[i];
                i += 1;
            }
            IntMag::trim(r, h - lo)
        }
    }

    fn times(self, b: IntMag) -> IntMag {
        unsafe {
            if self.n < b.n { return b.times(self); }
            if b.n == 0 { return IntMag::zero(); }
            if b.n < KARATSUBA {
                let n = self.n + b.n;
                let r: GcBuf<u32> = buf_new(n);
                rok_nat_mul(r, self.d, self.n, b.d, b.n);
                return IntMag::trim(r, n);
            }
            let r: GcBuf<u32> = buf_new(self.n + b.n + 1);
            if b.n * 2 <= self.n {
                // Unbalanced: `b`-sized pieces of `self`, each balanced.
                let off = 0usize;
                while off < self.n {
                    self.slice(off, off + b.n).times(b).add_to(r, off);
                    off += b.n;
                }
                return IntMag::trim(r, self.n + b.n + 1);
            }
            // Karatsuba: a = a1 B^k + a0, b = b1 B^k + b0;
            // ab = z2 B^2k + ((a0 + a1)(b0 + b1) - z2 - z0) B^k + z0.
            let k = (self.n + 1) / 2;
            let a0 = self.slice(0, k);
            let a1 = self.slice(k, self.n);
            let b0 = b.slice(0, k);
            let b1 = b.slice(k, b.n);
            let z0 = a0.times(b0);
            let z2 = a1.times(b1);
            let z1 = a0.plus(a1).times(b0.plus(b1)).minus(z0).minus(z2);
            z0.add_to(r, 0);
            z1.add_to(r, k);
            z2.add_to(r, 2 * k);
            IntMag::trim(r, self.n + b.n + 1)
        }
    }

    /// `self << s` bits.
    fn shl(self, s: u64) -> IntMag {
        unsafe {
            if self.n == 0 { return self; }
            let limbs = (s / 32u64) as usize;
            let bits = s % 32u64;
            let r: GcBuf<u32> = buf_new(self.n + limbs + 1);
            let carry = 0u64;
            let i = 0usize;
            while i < self.n {
                let v = ((self.d[i] as u64) << bits) | carry;
                r[i + limbs] = v as u32;
                carry = v >> 32u64;
                i += 1;
            }
            r[self.n + limbs] = carry as u32;
            IntMag::trim(r, self.n + limbs + 1)
        }
    }

    /// `self >> s` bits (floor).
    fn shr(self, s: u64) -> IntMag {
        unsafe {
            let limbs = s / 32u64;
            if limbs >= self.n as u64 { return IntMag::zero(); }
            let skip = limbs as usize;
            let bits = s % 32u64;
            let n = self.n - skip;
            let r: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            while i < n {
                let v = ((self.limb(i + skip + 1) << 32u64) | (self.d[i + skip] as u64)) >> bits;
                r[i] = v as u32;
                i += 1;
            }
            IntMag::trim(r, n)
        }
    }

    /// `(self / b, self % b)`, `b != 0`: Knuth TAOCP 4.3.1 algorithm D
    /// on the operands shifted so the divisor's top bit is set.
    fn divmod(self, b: IntMag) -> (IntMag, IntMag) {
        unsafe {
            if self.cmp3(b) < 0 { return (IntMag::zero(), self); }
            if b.n == 1 {
                let q: GcBuf<u32> = buf_new(self.n);
                let rem = rok_nat_divmod_small(q, self.d, self.n, b.d[0]);
                return (IntMag::trim(q, self.n), IntMag::from_u64(rem as u64));
            }
            let n = b.n;
            let m = self.n - n;
            let s = b.d[n - 1].leading_zeros() as u64;
            let vn = b.shl(s).d;
            // `self << s` in `m + n + 1` limbs (the top one may stay zero).
            let un: GcBuf<u32> = buf_new(self.n + 1);
            let sh = self.shl(s);
            let i = 0usize;
            while i < sh.n {
                un[i] = sh.d[i];
                i += 1;
            }
            let q: GcBuf<u32> = buf_new(m + 1);
            rok_nat_divmod(q, un, vn, m, n);
            (IntMag::trim(q, m + 1), IntMag::trim(un, n).shr(s))
        }
    }
}

/// An arbitrary-precision integer (spec 2.1.2). Write it `int`.
#[lang("int_type")]
#[keyword("int")]
pub struct Int {
    small: i64;
    neg: bool;
    big: IntMag | none;
}

/// `(10^9, 9)` for base 10: the largest power of `radix` below 2^32 and
/// its digit count.
fn radix_chunk(radix: u32) -> (u32, u32) {
    let p = radix;
    let k = 1u32;
    while (p as u64) * (radix as u64) < 0x1_0000_0000u64 {
        p = p * radix;
        k += 1u32;
    }
    (p, k)
}

/// Digit value of an ASCII digit or letter (either case).
fn digit_of(c: u8) -> u32 {
    let v = c as u32;
    if v >= 48u32 && v <= 57u32 { return v - 48u32; }
    if v >= 97u32 && v <= 122u32 { return v - 87u32; }
    v - 55u32
}

impl Int {
    /// Zero.
    pub fn new() -> Int { Int::from_i64(0) }
    pub fn from_i64(n: i64) -> Int { Int { small: n, neg: false, big: none } }
    pub fn from_i32(n: i32) -> Int { Int::from_i64(n as i64) }
    pub fn from_u64(n: u64) -> Int { Int::from_parts(false, IntMag::from_u64(n)) }

    /// An integer literal's digits (`_`, `0x` / `0o` / `0b` allowed):
    /// what an unsuffixed literal too big for `i64` in an `int` slot
    /// lowers to.
    pub fn from_literal(s: str) -> Int {
        let t = s.replace("_", "");
        let radix = 10u32;
        if t.starts_with("0x") || t.starts_with("0X") { radix = 16u32; }
        if t.starts_with("0o") || t.starts_with("0O") { radix = 8u32; }
        if t.starts_with("0b") || t.starts_with("0B") { radix = 2u32; }
        if radix != 10u32 { t = t[2:]; }
        match Int::parse_radix(t, radix) {
            v: Int => v,
            none => panic(f"malformed integer literal `{s}`"),
        }
    }

    /// `s` in base `radix` (2..=36): an optional sign, then digits of
    /// either case; `none` otherwise. The grammar is the runtime's, the
    /// same the primitives' `FromStr` reads.
    pub fn parse_radix(s: str, radix: u32) -> Int | none {
        unsafe {
            let out: GcBuf<i64> = buf_new(1);
            let st = rok_str_parse_int(s, radix, 1, 64u32, out);
            if st == 0 { return Int::from_i64(out[0]); }
            if st != 3 { return none; }
            // Past `i64`: fold the checked digits into limbs, `per` at a
            // time: acc = acc * radix^k + chunk.
            let bs = s.as_bytes();
            let n = s.len();
            let neg = bs[0] == 45u8;
            let i = if bs[0] == 45u8 || bs[0] == 43u8 { 1usize } else { 0usize };
            let (_, per) = radix_chunk(radix);
            let acc: GcBuf<u32> = buf_new((n - i) / (per as usize) + 2);
            let len = 0usize;
            while i < n {
                let v = 0u64;
                let mul = 1u64;
                let k = 0u32;
                while k < per && i < n {
                    v = v * (radix as u64) + (digit_of(bs[i]) as u64);
                    mul = mul * (radix as u64);
                    k += 1u32;
                    i += 1;
                }
                // mul <= chunk < 2^32.
                let carry = v;
                let j = 0usize;
                while j < len {
                    let t = (acc[j] as u64) * mul + carry;
                    acc[j] = t as u32;
                    carry = t >> 32u64;
                    j += 1;
                }
                if carry != 0u64 {
                    acc[len] = carry as u32;
                    len += 1;
                }
            }
            Int::from_parts(neg, IntMag::trim(acc, len))
        }
    }

    /// The digits in base `radix` (2..=36, lowercase), `-` first when
    /// negative.
    pub fn to_str_radix(self, radix: u32) -> str {
        unsafe {
            if radix < 2u32 || radix > 36u32 { panic(f"to_str_radix: radix {radix} out of 2..=36"); }
            let (neg, m) = self.parts();
            if m.n == 0 { return "0"; }
            let (chunk, per) = radix_chunk(radix);
            let p = per as usize;
            // Chunks of `per` digits, least significant first, by dividing a
            // scratch copy in place.
            let work: GcBuf<u32> = buf_new(m.n);
            let wn = m.n;
            let i = 0usize;
            while i < wn {
                work[i] = m.d[i];
                i += 1;
            }
            let chunks: GcBuf<u32> = buf_new(m.n * 2 + 1);
            let count = 0usize;
            while wn > 0 {
                chunks[count] = rok_nat_divmod_small(work, work, wn, chunk);
                count += 1;
                while wn > 0 && work[wn - 1] == 0u32 { wn -= 1; }
            }
            // Digits right to left into one byte buffer.
            let total = count * p + 1;
            let out: GcBuf<u8> = buf_new(total);
            let digits = "0123456789abcdefghijklmnopqrstuvwxyz".as_bytes();
            let at = total;
            let c = 0usize;
            while c < count {
                let v = chunks[c];
                let k = 0usize;
                // The leading chunk drops its zeros.
                while k < p && (c + 1 < count || v != 0u32) {
                    at -= 1;
                    out[at] = digits[(v % radix) as usize];
                    v = v / radix;
                    k += 1;
                }
                c += 1;
            }
            if neg {
                at -= 1;
                out[at] = 45u8;
            }
            rok_str_from_buf(out, at, total - at)
        }
    }

    pub fn to_i32(self) -> i32 | none {
        let v = self.to_i64()?;
        if v < -2147483648 || v > 2147483647 { return none; }
        v as i32
    }

    pub fn to_i64(self) -> i64 | none {
        if self.big is none { return self.small; }
        none
    }

    pub fn to_u64(self) -> u64 | none {
        if self.big is none {
            if self.small < 0 { return none; }
            return self.small as u64;
        }
        let (neg, m) = self.parts();
        if neg || m.n > 2 { return none; }
        m.low64()
    }

    /// The nearest `f64` (ties to even; `±inf` past `f64::MAX`).
    pub fn to_f64(self) -> f64 {
        if self.big is none { return self.small as f64; }
        rok::core::num::bigfloat::Float::from_int(self).to_f64()
    }

    pub fn is_zero(self) -> bool { self.big is none && self.small == 0 }
    pub fn is_negative(self) -> bool {
        if self.big is none { self.small < 0 } else { self.neg }
    }
    pub fn is_positive(self) -> bool { !self.is_zero() && !self.is_negative() }

    /// `-1`, `0` or `1`.
    pub fn signum(self) -> Int {
        if self.is_zero() { return Int::from_i64(0); }
        if self.is_negative() { Int::from_i64(-1) } else { Int::from_i64(1) }
    }

    pub fn abs(self) -> Int {
        if self.is_negative() { -self } else { self }
    }

    /// Bits of `|self|` without leading zeros (0 for zero; Python's
    /// `bit_length`).
    pub fn bit_length(self) -> u64 {
        let (_, m) = self.parts();
        m.bits()
    }

    /// `self^exp` (square and multiply).
    pub fn pow(self, exp: u32) -> Int {
        let acc = Int::from_i64(1);
        let base = self;
        let e = exp;
        while e > 0u32 {
            if e & 1u32 == 1u32 { acc = acc * base; }
            e = e >> 1u32;
            if e > 0u32 { base = base * base; }
        }
        acc
    }

    /// The greatest common divisor, never negative (`gcd(0, 0) == 0`).
    /// Euclid on full divisions; huge operands would want Lehmer's.
    pub fn gcd(self, other: Int) -> Int {
        let a = self.abs();
        let b = other.abs();
        while !b.is_zero() {
            let r = a % b;
            a = b;
            b = r;
        }
        a
    }

    /// `(self / rhs, self % rhs)` in one division (truncating, like
    /// `/` and `%`).
    pub fn div_rem(self, rhs: Int) -> (Int, Int) {
        if rhs.is_zero() { panic("attempt to divide an int by zero"); }
        if self.big is none && rhs.big is none && !(self.small == -9223372036854775807 - 1 && rhs.small == -1) {
            return (Int::from_i64(self.small / rhs.small), Int::from_i64(self.small % rhs.small));
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        let (q, r) = am.divmod(bm);
        (Int::from_parts(an != bn, q), Int::from_parts(an, r))
    }

    /// Sign and magnitude.
    pub(pkg) fn parts(self) -> (bool, IntMag) {
        if let m: IntMag = self.big { return (self.neg, m); }
        let v = self.small;
        if v < 0 { (true, IntMag::from_u64(0u64.wrapping_sub(v as u64))) } else { (false, IntMag::from_u64(v as u64)) }
    }

    /// The canonical `int` of sign `neg` and magnitude `m`.
    pub(pkg) fn from_parts(neg: bool, m: IntMag) -> Int {
        if m.n <= 2 {
            let v = m.low64();
            if v <= 0x7FFF_FFFF_FFFF_FFFFu64 { return Int::from_i64(if neg { -(v as i64) } else { v as i64 }); }
            if neg && v == 0x8000_0000_0000_0000u64 { return Int::from_i64(v as i64); }
        }
        Int { small: 0, neg: neg, big: m }
    }

    /// `self` vs `rhs`: -1, 0 or 1.
    fn cmp3(self, rhs: Int) -> i32 {
        if self.big is none && rhs.big is none {
            if self.small < rhs.small { return -1; }
            return if self.small > rhs.small { 1 } else { 0 };
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        if an != bn { return if an { -1 } else { 1 }; }
        let c = am.cmp3(bm);
        if an { -c } else { c }
    }

    /// Two's complement limbs over `n` limbs (`n` past the magnitude).
    fn twos(self, n: usize) -> GcBuf<u32> {
        unsafe {
            let (neg, m) = self.parts();
            let r: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            let carry = 1u64;
            while i < n {
                let v = m.limb(i);
                if neg {
                    let t = ((~(v as u32)) as u64) + carry;
                    r[i] = t as u32;
                    carry = t >> 32u64;
                } else {
                    r[i] = v as u32;
                }
                i += 1;
            }
            r
        }
    }

    /// The `int` of two's complement limbs `r[0..n]` (top bit = sign).
    fn from_twos(r: GcBuf<u32>, n: usize) -> Int {
        unsafe {
            if r[n - 1] & 0x8000_0000u32 == 0u32 { return Int::from_parts(false, IntMag::trim(r, n)); }
            let m: GcBuf<u32> = buf_new(n);
            let carry = 1u64;
            let i = 0usize;
            while i < n {
                let t = ((~r[i]) as u64) + carry;
                m[i] = t as u32;
                carry = t >> 32u64;
                i += 1;
            }
            Int::from_parts(true, IntMag::trim(m, n))
        }
    }

    /// A bitwise op (`op`: 0 and, 1 or, 2 xor) on infinite two's
    /// complement (Python semantics).
    fn bitwise(self, rhs: Int, op: i32) -> Int {
        unsafe {
            if self.big is none && rhs.big is none {
                let a = self.small;
                let b = rhs.small;
                return Int::from_i64(if op == 0 { a & b } else if op == 1 { a | b } else { a ^ b });
            }
            let (_, am) = self.parts();
            let (_, bm) = rhs.parts();
            let n = (if am.n > bm.n { am.n } else { bm.n }) + 1;
            let x = self.twos(n);
            let y = rhs.twos(n);
            let r: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            while i < n {
                r[i] = if op == 0 { x[i] & y[i] } else if op == 1 { x[i] | y[i] } else { x[i] ^ y[i] };
                i += 1;
            }
            Int::from_twos(r, n)
        }
    }
}

impl Add for Int {
    type Output = Int;
    fn add(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_add(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        add_signed(an, am, bn, bm)
    }
}

fn add_signed(an: bool, am: IntMag, bn: bool, bm: IntMag) -> Int {
    if an == bn { return Int::from_parts(an, am.plus(bm)); }
    let c = am.cmp3(bm);
    if c == 0 { return Int::from_i64(0); }
    if c > 0 { Int::from_parts(an, am.minus(bm)) } else { Int::from_parts(bn, bm.minus(am)) }
}

impl Sub for Int {
    type Output = Int;
    fn sub(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_sub(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        add_signed(an, am, !bn, bm)
    }
}

impl Mul for Int {
    type Output = Int;
    fn mul(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_mul(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        Int::from_parts(an != bn, am.times(bm))
    }
}

/// Truncating division (spec 2.1.2: `-7 / 2 == -3`); panics on zero.
impl Div for Int {
    type Output = Int;
    fn div(self, rhs: Int) -> Int {
        let (q, _) = self.div_rem(rhs);
        q
    }
}

/// The remainder of `/`: takes the dividend's sign (`-7 % 2 == -1`).
impl Rem for Int {
    type Output = Int;
    fn rem(self, rhs: Int) -> Int {
        let (_, r) = self.div_rem(rhs);
        r
    }
}

/// `%%`: takes the divisor's sign (`-7 %% 2 == 1`).
impl Modulo for Int {
    type Output = Int;
    fn modulo(self, rhs: Int) -> Int {
        let r = self % rhs;
        if !r.is_zero() && r.is_negative() != rhs.is_negative() { r + rhs } else { r }
    }
}

impl Neg for Int {
    type Output = Int;
    fn neg(self) -> Int {
        if self.big is none {
            if let s: i64 = self.small.checked_neg() { return Int::from_i64(s); }
        }
        let (n, m) = self.parts();
        Int::from_parts(!n, m)
    }
}

impl BitAnd for Int {
    type Output = Int;
    fn bitand(self, rhs: Int) -> Int { self.bitwise(rhs, 0) }
}

impl BitOr for Int {
    type Output = Int;
    fn bitor(self, rhs: Int) -> Int { self.bitwise(rhs, 1) }
}

impl BitXor for Int {
    type Output = Int;
    fn bitxor(self, rhs: Int) -> Int { self.bitwise(rhs, 2) }
}

/// `~x == -x - 1`.
impl BitNot for Int {
    type Output = Int;
    fn bitnot(self) -> Int { -self - Int::from_i64(1) }
}

/// `x << n == x * 2^n`.
impl Shl<u32> for Int {
    type Output = Int;
    fn shl(self, n: u32) -> Int {
        let (neg, m) = self.parts();
        Int::from_parts(neg, m.shl(n as u64))
    }
}

/// `x >> n == floor(x / 2^n)` (an arithmetic shift).
impl Shr<u32> for Int {
    type Output = Int;
    fn shr(self, n: u32) -> Int {
        if self.big is none {
            if n >= 63u32 { return Int::from_i64(if self.small < 0 { -1 } else { 0 }); }
            return Int::from_i64(self.small >> (n as i64));
        }
        let (neg, m) = self.parts();
        if !neg { return Int::from_parts(false, m.shr(n as u64)); }
        // floor(-m / 2^n) = -((m - 1) >> n) - 1.
        let t = m.minus(IntMag::from_u64(1u64)).shr(n as u64);
        Int::from_parts(true, t.plus(IntMag::from_u64(1u64)))
    }
}

impl PartialEq for Int {
    fn eq(self, rhs: Int) -> bool { self.cmp3(rhs) == 0 }
    fn ne(self, rhs: Int) -> bool { self.cmp3(rhs) != 0 }
}

impl Eq for Int {}

impl PartialOrd for Int {
    fn lt(self, rhs: Int) -> bool { self.cmp3(rhs) < 0 }
    fn gt(self, rhs: Int) -> bool { self.cmp3(rhs) > 0 }
    fn le(self, rhs: Int) -> bool { self.cmp3(rhs) <= 0 }
    fn ge(self, rhs: Int) -> bool { self.cmp3(rhs) >= 0 }
}

impl Ord for Int {
    fn cmp(self, rhs: Int) -> Ordering {
        let c = self.cmp3(rhs);
        if c < 0 { Ordering::Less } else if c > 0 { Ordering::Greater } else { Ordering::Equal }
    }
}

/// Equal to `i64`'s hash for values in `i64` range.
impl Hash for Int {
    fn hash(self) -> u64 {
        unsafe {
            if let m: IntMag = self.big {
                let h = if self.neg { 0x9E37_79B9_7F4A_7C15u64 } else { 0u64 };
                let i = 0usize;
                while i < m.n {
                    h = (h ^ (m.d[i] as u64)).wrapping_mul(0x0000_0100_0000_01B3u64);
                    i += 1;
                }
                return h;
            }
            self.small as u64
        }
    }
}

impl Clone for Int {
    fn clone(self) -> Int { self }
}

impl Copy for Int {}

impl Default for Int {
    fn default() -> Int { Int::from_i64(0) }
}

impl Zero for Int {
    fn zero() -> Int { Int::from_i64(0) }
}

impl One for Int {
    fn one() -> Int { Int::from_i64(1) }
}

/// `b o x X` show the sign and magnitude: `int` has no width for a
/// two's complement form (`{-255:x}` is `-ff`, stdlib 2.10.5).
impl Display for Int {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        if self.big is none {
            f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self.small, 1u32, 0u32) };
        } else {
            let t = f.ty();
            let r = if t == 'b' { 2u32 } else if t == 'o' { 8u32 } else if t == 'x' || t == 'X' { 16u32 } else { 10u32 };
            let digits = self.abs().to_str_radix(r);
            f.t = unsafe { rok_fmt_digits(f.t, f.flags, f.counts, if self.is_negative() { 1u32 } else { 0u32 }, digits) };
        }
    }
}

impl Debug for Int {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

impl FromStr for Int {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> Int {
        match Int::parse_radix(s, 10u32) {
            v: Int => v,
            none => throw ParseError { input: s, pos: 0, reason: "invalid digit" },
        }
    }
}

// ---- conversions (stdlib 2.11.8, 2.1.7) ----

fn overflow(ty: str) -> OverflowError { OverflowError { op: "try_from", ty: ty } }

/// The low 64 bits of the two's complement form (`wrapping_into`).
fn low_bits(v: Int) -> u64 {
    if v.big is none { return v.small as u64; }
    let (neg, m) = v.parts();
    let low = m.low64();
    if neg { low.wrapping_neg() } else { low }
}

impl From<i8> for Int { fn from(value: i8) -> Int { Int::from_i64(value as i64) } }
impl From<i16> for Int { fn from(value: i16) -> Int { Int::from_i64(value as i64) } }
impl From<i32> for Int { fn from(value: i32) -> Int { Int::from_i64(value as i64) } }
impl From<i64> for Int { fn from(value: i64) -> Int { Int::from_i64(value) } }
impl From<isize> for Int { fn from(value: isize) -> Int { Int::from_i64(value as i64) } }
impl From<u8> for Int { fn from(value: u8) -> Int { Int::from_i64(value as i64) } }
impl From<u16> for Int { fn from(value: u16) -> Int { Int::from_i64(value as i64) } }
impl From<u32> for Int { fn from(value: u32) -> Int { Int::from_i64(value as i64) } }
impl From<u64> for Int { fn from(value: u64) -> Int { Int::from_u64(value) } }
impl From<usize> for Int { fn from(value: usize) -> Int { Int::from_u64(value as u64) } }

/// Lossy (rounds to nearest), as spec 2.11.8 allows for `int → f64`.
impl From<Int> for f64 { fn from(value: Int) -> f64 { value.to_f64() } }

impl TryFrom<Int> for i8 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> i8 {
        let v = value.to_i64() ?? 128;
        if v < -128 || v > 127 { throw overflow("i8"); }
        v as i8
    }
}
impl TryFrom<Int> for i16 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> i16 {
        let v = value.to_i64() ?? 32768;
        if v < -32768 || v > 32767 { throw overflow("i16"); }
        v as i16
    }
}
impl TryFrom<Int> for i32 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> i32 {
        match value.to_i32() {
            v: i32 => v,
            none => throw overflow("i32"),
        }
    }
}
impl TryFrom<Int> for i64 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> i64 {
        match value.to_i64() {
            v: i64 => v,
            none => throw overflow("i64"),
        }
    }
}
impl TryFrom<Int> for isize {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> isize {
        match value.to_i64() {
            v: i64 => v as isize,
            none => throw overflow("isize"),
        }
    }
}
impl TryFrom<Int> for u8 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> u8 {
        let v = value.to_u64() ?? 256u64;
        if v > 255u64 { throw overflow("u8"); }
        v as u8
    }
}
impl TryFrom<Int> for u16 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> u16 {
        let v = value.to_u64() ?? 65536u64;
        if v > 65535u64 { throw overflow("u16"); }
        v as u16
    }
}
impl TryFrom<Int> for u32 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> u32 {
        let v = value.to_u64() ?? 0x1_0000_0000u64;
        if v > 0xFFFF_FFFFu64 { throw overflow("u32"); }
        v as u32
    }
}
impl TryFrom<Int> for u64 {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> u64 {
        match value.to_u64() {
            v: u64 => v,
            none => throw overflow("u64"),
        }
    }
}
impl TryFrom<Int> for usize {
    type Error = OverflowError;
    fn try_from(value: Int) throws (OverflowError) -> usize {
        match value.to_u64() {
            v: u64 => v as usize,
            none => throw overflow("usize"),
        }
    }
}

/// `value` clamped to `lo..=hi` as an `i64`.
fn clamp_i64(value: Int, lo: i64, hi: i64) -> i64 {
    if value < Int::from_i64(lo) { return lo; }
    if value > Int::from_i64(hi) { return hi; }
    value.small
}

/// `value` clamped to `0..=hi` as a `u64`.
fn clamp_u64(value: Int, hi: u64) -> u64 {
    if value.is_negative() { return 0u64; }
    match value.to_u64() {
        v: u64 => if v > hi { hi } else { v },
        none => hi,
    }
}

impl SaturatingFrom<Int> for i8 { fn saturating_from(value: Int) -> i8 { clamp_i64(value, -128, 127) as i8 } }
impl SaturatingFrom<Int> for i16 { fn saturating_from(value: Int) -> i16 { clamp_i64(value, -32768, 32767) as i16 } }
impl SaturatingFrom<Int> for i32 {
    fn saturating_from(value: Int) -> i32 { clamp_i64(value, -2147483648, 2147483647) as i32 }
}
impl SaturatingFrom<Int> for i64 {
    fn saturating_from(value: Int) -> i64 { clamp_i64(value, -9223372036854775807 - 1, 9223372036854775807) }
}
impl SaturatingFrom<Int> for isize {
    fn saturating_from(value: Int) -> isize {
        clamp_i64(value, -9223372036854775807 - 1, 9223372036854775807) as isize
    }
}
impl SaturatingFrom<Int> for u8 { fn saturating_from(value: Int) -> u8 { clamp_u64(value, 255u64) as u8 } }
impl SaturatingFrom<Int> for u16 { fn saturating_from(value: Int) -> u16 { clamp_u64(value, 65535u64) as u16 } }
impl SaturatingFrom<Int> for u32 { fn saturating_from(value: Int) -> u32 { clamp_u64(value, 0xFFFF_FFFFu64) as u32 } }
impl SaturatingFrom<Int> for u64 {
    fn saturating_from(value: Int) -> u64 { clamp_u64(value, 0xFFFF_FFFF_FFFF_FFFFu64) }
}
impl SaturatingFrom<Int> for usize {
    fn saturating_from(value: Int) -> usize { clamp_u64(value, 0xFFFF_FFFF_FFFF_FFFFu64) as usize }
}

// `wrapping_into` / `as`: the low bits of the two's complement form.
impl WrappingFrom<Int> for i8 { fn wrapping_from(value: Int) -> i8 { low_bits(value) as i8 } }
impl WrappingFrom<Int> for i16 { fn wrapping_from(value: Int) -> i16 { low_bits(value) as i16 } }
impl WrappingFrom<Int> for i32 { fn wrapping_from(value: Int) -> i32 { low_bits(value) as i32 } }
impl WrappingFrom<Int> for i64 { fn wrapping_from(value: Int) -> i64 { low_bits(value) as i64 } }
impl WrappingFrom<Int> for isize { fn wrapping_from(value: Int) -> isize { low_bits(value) as isize } }
impl WrappingFrom<Int> for u8 { fn wrapping_from(value: Int) -> u8 { low_bits(value) as u8 } }
impl WrappingFrom<Int> for u16 { fn wrapping_from(value: Int) -> u16 { low_bits(value) as u16 } }
impl WrappingFrom<Int> for u32 { fn wrapping_from(value: Int) -> u32 { low_bits(value) as u32 } }
impl WrappingFrom<Int> for u64 { fn wrapping_from(value: Int) -> u64 { low_bits(value) } }
impl WrappingFrom<Int> for usize { fn wrapping_from(value: Int) -> usize { low_bits(value) as usize } }
/// `n as f64`: rounds to nearest.
impl WrappingFrom<Int> for f64 { fn wrapping_from(value: Int) -> f64 { value.to_f64() } }
