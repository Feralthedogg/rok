// rok::core::num::ints — the integer primitives' inherent methods and
// limits (stdlib spec 2.1.4): bit operations, byte order, and the
// overflow-explicit `checked_` / `wrapping_` / `saturating_` /
// `overflowing_` families. Plain `+ - *` panic on overflow in debug and
// wrap in release (2.3); these spell the policy out.
//
// `wrapping_add` / `_sub` / `_mul` and the bit counts are intrinsics
// (no overflow check; `llvm.intr.ctpop` ..); everything else is built
// on them. One block per type; keep them regular.
//
// ponytail: spec 2.1.4 lists `fn min() -> i32` / `fn max() -> i32`; a
// zero-argument inherent `min` would shadow `Ord::min(self, rhs)`, so
// the limits are the `MIN` / `MAX` consts (refs-lang 2.13 `i32::MAX`).

// i8

impl i8 {
    pub const MIN: i8 = -127 - 1;
    pub const MAX: i8 = 127;

    #[intrinsic("rok.wrapping_add.i8")]
    pub fn wrapping_add(self, rhs: i8) -> i8 { self.wrapping_add(rhs) }
    #[intrinsic("rok.wrapping_sub.i8")]
    pub fn wrapping_sub(self, rhs: i8) -> i8 { self.wrapping_sub(rhs) }
    #[intrinsic("rok.wrapping_mul.i8")]
    pub fn wrapping_mul(self, rhs: i8) -> i8 { self.wrapping_mul(rhs) }
    #[intrinsic("rok.ctpop.i8")]
    fn ctpop(self) -> i8 { self.ctpop() }
    #[intrinsic("rok.ctlz.i8")]
    fn ctlz(self) -> i8 { self.ctlz() }
    #[intrinsic("rok.cttz.i8")]
    fn cttz(self) -> i8 { self.cttz() }

    pub fn count_ones(self) -> u32 { self.ctpop() as u32 }
    pub fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    pub fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    pub fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    pub fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    pub fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    pub fn rotate_left(self, n: u32) -> i8 { (self as u8).rotate_left(n) as i8 }
    pub fn rotate_right(self, n: u32) -> i8 { (self as u8).rotate_right(n) as i8 }
    pub fn swap_bytes(self) -> i8 { (self as u8).swap_bytes() as i8 }

    // ponytail: little-endian targets only (`to_be` swaps, `to_le` is
    // the identity).
    pub fn to_be(self) -> i8 { self.swap_bytes() }
    pub fn to_le(self) -> i8 { self }
    pub fn from_be(x: i8) -> i8 { x.swap_bytes() }
    pub fn from_le(x: i8) -> i8 { x }
    pub fn to_le_bytes(self) -> [u8; 1] { [self as u8] }
    pub fn to_be_bytes(self) -> [u8; 1] { [self as u8] }
    pub fn to_ne_bytes(self) -> [u8; 1] { self.to_le_bytes() }
    pub fn from_le_bytes(bytes: [u8; 1]) -> i8 { bytes[0] as i8 }
    pub fn from_be_bytes(bytes: [u8; 1]) -> i8 { bytes[0] as i8 }
    pub fn from_ne_bytes(bytes: [u8; 1]) -> i8 { i8::from_le_bytes(bytes) }

    pub fn checked_add(self, rhs: i8) -> i8 | none {
        let r = self.wrapping_add(rhs);
        if (self ^ r) & (rhs ^ r) < 0 { return none; }
        r
    }
    pub fn checked_sub(self, rhs: i8) -> i8 | none {
        let r = self.wrapping_sub(rhs);
        if (self ^ rhs) & (self ^ r) < 0 { return none; }
        r
    }
    pub fn checked_mul(self, rhs: i8) -> i8 | none {
        if self == -1 { return rhs.checked_neg(); }
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: i8) -> i8 | none {
        if rhs == 0 || self == i8::MIN && rhs == -1 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: i8) -> i8 | none {
        if rhs == 0 || self == i8::MIN && rhs == -1 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> i8 | none {
        if self == i8::MIN { return none; }
        -self
    }
    pub fn checked_shl(self, n: u32) -> i8 | none {
        if n >= 8 { return none; }
        self << (n as i8)
    }
    pub fn checked_shr(self, n: u32) -> i8 | none {
        if n >= 8 { return none; }
        self >> (n as i8)
    }
    pub fn checked_pow(self, exp: u32) -> i8 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i8 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 { return self; }
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: i8) -> i8 {
        if rhs == -1 { return 0; }
        self % rhs
    }
    pub fn wrapping_neg(self) -> i8 { i8::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> i8 { self << ((n % 8) as i8) }
    pub fn wrapping_shr(self, n: u32) -> i8 { self >> ((n % 8) as i8) }
    pub fn wrapping_pow(self, exp: u32) -> i8 {
        let base = self;
        let acc: i8 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: i8) -> i8 {
        self.checked_add(rhs) ?? (if rhs > 0 { i8::MAX } else { i8::MIN })
    }
    pub fn saturating_sub(self, rhs: i8) -> i8 {
        self.checked_sub(rhs) ?? (if rhs < 0 { i8::MAX } else { i8::MIN })
    }
    pub fn saturating_mul(self, rhs: i8) -> i8 {
        self.checked_mul(rhs) ?? (if (self < 0) != (rhs < 0) { i8::MIN } else { i8::MAX })
    }
    pub fn saturating_neg(self) -> i8 { self.checked_neg() ?? i8::MAX }
    pub fn saturating_pow(self, exp: u32) -> i8 {
        self.checked_pow(exp) ?? (if self < 0 && exp % 2 == 1 { i8::MIN } else { i8::MAX })
    }

    pub fn overflowing_add(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_div(rhs), self == i8::MIN && rhs == -1)
    }
    pub fn overflowing_rem(self, rhs: i8) -> (i8, bool) {
        (self.wrapping_rem(rhs), self == i8::MIN && rhs == -1)
    }
    pub fn overflowing_neg(self) -> (i8, bool) { (self.wrapping_neg(), self == i8::MIN) }
    pub fn overflowing_shl(self, n: u32) -> (i8, bool) { (self.wrapping_shl(n), n >= 8) }
    pub fn overflowing_shr(self, n: u32) -> (i8, bool) { (self.wrapping_shr(n), n >= 8) }
    pub fn overflowing_pow(self, exp: u32) -> (i8, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> i8 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i8 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs(self) -> i8 { if self < 0 { -self } else { self } }
    pub fn checked_abs(self) -> i8 | none { if self < 0 { self.checked_neg() } else { self } }
    pub fn wrapping_abs(self) -> i8 { if self < 0 { self.wrapping_neg() } else { self } }
    pub fn saturating_abs(self) -> i8 { if self < 0 { self.saturating_neg() } else { self } }
    pub fn unsigned_abs(self) -> u8 { self.wrapping_abs() as u8 }
    pub fn abs_diff(self, rhs: i8) -> u8 {
        if self < rhs {
            (rhs as u8).wrapping_sub(self as u8)
        } else {
            (self as u8).wrapping_sub(rhs as u8)
        }
    }
    /// `-1`, `0` or `1`.
    pub fn signum(self) -> i8 {
        if self > 0 { return 1; }
        if self < 0 { return -1; }
        0
    }
    pub fn is_positive(self) -> bool { self > 0 }
    pub fn is_negative(self) -> bool { self < 0 }
    /// Quotient rounded so that `rem_euclid` is never negative.
    pub fn div_euclid(self, rhs: i8) -> i8 {
        let q = self / rhs;
        if self % rhs < 0 {
            return if rhs > 0 { q - 1 } else { q + 1 };
        }
        q
    }
    /// The remainder in `0..rhs.abs()`.
    pub fn rem_euclid(self, rhs: i8) -> i8 {
        let r = self % rhs;
        if r < 0 {
            return if rhs < 0 { r.wrapping_sub(rhs) } else { r + rhs };
        }
        r
    }
    /// Integer square root; panics on a negative number.
    pub fn isqrt(self) -> i8 {
        if self < 0 { panic("isqrt of a negative number"); }
        (self as u8).isqrt() as i8
    }
    pub fn checked_isqrt(self) -> i8 | none {
        if self < 0 { return none; }
        (self as u8).isqrt() as i8
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: i8) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        7 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: i8) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// i16

impl i16 {
    pub const MIN: i16 = -32767 - 1;
    pub const MAX: i16 = 32767;

    #[intrinsic("rok.wrapping_add.i16")]
    pub fn wrapping_add(self, rhs: i16) -> i16 { self.wrapping_add(rhs) }
    #[intrinsic("rok.wrapping_sub.i16")]
    pub fn wrapping_sub(self, rhs: i16) -> i16 { self.wrapping_sub(rhs) }
    #[intrinsic("rok.wrapping_mul.i16")]
    pub fn wrapping_mul(self, rhs: i16) -> i16 { self.wrapping_mul(rhs) }
    #[intrinsic("rok.ctpop.i16")]
    fn ctpop(self) -> i16 { self.ctpop() }
    #[intrinsic("rok.ctlz.i16")]
    fn ctlz(self) -> i16 { self.ctlz() }
    #[intrinsic("rok.cttz.i16")]
    fn cttz(self) -> i16 { self.cttz() }

    pub fn count_ones(self) -> u32 { self.ctpop() as u32 }
    pub fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    pub fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    pub fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    pub fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    pub fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    pub fn rotate_left(self, n: u32) -> i16 { (self as u16).rotate_left(n) as i16 }
    pub fn rotate_right(self, n: u32) -> i16 { (self as u16).rotate_right(n) as i16 }
    pub fn swap_bytes(self) -> i16 { (self as u16).swap_bytes() as i16 }

    // ponytail: little-endian targets only (`to_be` swaps, `to_le` is
    // the identity).
    pub fn to_be(self) -> i16 { self.swap_bytes() }
    pub fn to_le(self) -> i16 { self }
    pub fn from_be(x: i16) -> i16 { x.swap_bytes() }
    pub fn from_le(x: i16) -> i16 { x }
    pub fn to_le_bytes(self) -> [u8; 2] { [self as u8, (self >> 8) as u8] }
    pub fn to_be_bytes(self) -> [u8; 2] { [(self >> 8) as u8, self as u8] }
    pub fn to_ne_bytes(self) -> [u8; 2] { self.to_le_bytes() }
    pub fn from_le_bytes(bytes: [u8; 2]) -> i16 {
        let x: u16 = 0;
        for i in 0..2 { x = x | (bytes[i] as u16) << (8 * i as u16); }
        x as i16
    }
    pub fn from_be_bytes(bytes: [u8; 2]) -> i16 {
        let x: u16 = 0;
        for i in 0..2 { x = x << 8 | bytes[i] as u16; }
        x as i16
    }
    pub fn from_ne_bytes(bytes: [u8; 2]) -> i16 { i16::from_le_bytes(bytes) }

    pub fn checked_add(self, rhs: i16) -> i16 | none {
        let r = self.wrapping_add(rhs);
        if (self ^ r) & (rhs ^ r) < 0 { return none; }
        r
    }
    pub fn checked_sub(self, rhs: i16) -> i16 | none {
        let r = self.wrapping_sub(rhs);
        if (self ^ rhs) & (self ^ r) < 0 { return none; }
        r
    }
    pub fn checked_mul(self, rhs: i16) -> i16 | none {
        if self == -1 { return rhs.checked_neg(); }
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: i16) -> i16 | none {
        if rhs == 0 || self == i16::MIN && rhs == -1 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: i16) -> i16 | none {
        if rhs == 0 || self == i16::MIN && rhs == -1 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> i16 | none {
        if self == i16::MIN { return none; }
        -self
    }
    pub fn checked_shl(self, n: u32) -> i16 | none {
        if n >= 16 { return none; }
        self << (n as i16)
    }
    pub fn checked_shr(self, n: u32) -> i16 | none {
        if n >= 16 { return none; }
        self >> (n as i16)
    }
    pub fn checked_pow(self, exp: u32) -> i16 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i16 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: i16) -> i16 {
        if self == i16::MIN && rhs == -1 { return self; }
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: i16) -> i16 {
        if rhs == -1 { return 0; }
        self % rhs
    }
    pub fn wrapping_neg(self) -> i16 { i16::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> i16 { self << ((n % 16) as i16) }
    pub fn wrapping_shr(self, n: u32) -> i16 { self >> ((n % 16) as i16) }
    pub fn wrapping_pow(self, exp: u32) -> i16 {
        let base = self;
        let acc: i16 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: i16) -> i16 {
        self.checked_add(rhs) ?? (if rhs > 0 { i16::MAX } else { i16::MIN })
    }
    pub fn saturating_sub(self, rhs: i16) -> i16 {
        self.checked_sub(rhs) ?? (if rhs < 0 { i16::MAX } else { i16::MIN })
    }
    pub fn saturating_mul(self, rhs: i16) -> i16 {
        self.checked_mul(rhs) ?? (if (self < 0) != (rhs < 0) { i16::MIN } else { i16::MAX })
    }
    pub fn saturating_neg(self) -> i16 { self.checked_neg() ?? i16::MAX }
    pub fn saturating_pow(self, exp: u32) -> i16 {
        self.checked_pow(exp) ?? (if self < 0 && exp % 2 == 1 { i16::MIN } else { i16::MAX })
    }

    pub fn overflowing_add(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_div(rhs), self == i16::MIN && rhs == -1)
    }
    pub fn overflowing_rem(self, rhs: i16) -> (i16, bool) {
        (self.wrapping_rem(rhs), self == i16::MIN && rhs == -1)
    }
    pub fn overflowing_neg(self) -> (i16, bool) { (self.wrapping_neg(), self == i16::MIN) }
    pub fn overflowing_shl(self, n: u32) -> (i16, bool) { (self.wrapping_shl(n), n >= 16) }
    pub fn overflowing_shr(self, n: u32) -> (i16, bool) { (self.wrapping_shr(n), n >= 16) }
    pub fn overflowing_pow(self, exp: u32) -> (i16, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> i16 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i16 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs(self) -> i16 { if self < 0 { -self } else { self } }
    pub fn checked_abs(self) -> i16 | none { if self < 0 { self.checked_neg() } else { self } }
    pub fn wrapping_abs(self) -> i16 { if self < 0 { self.wrapping_neg() } else { self } }
    pub fn saturating_abs(self) -> i16 { if self < 0 { self.saturating_neg() } else { self } }
    pub fn unsigned_abs(self) -> u16 { self.wrapping_abs() as u16 }
    pub fn abs_diff(self, rhs: i16) -> u16 {
        if self < rhs {
            (rhs as u16).wrapping_sub(self as u16)
        } else {
            (self as u16).wrapping_sub(rhs as u16)
        }
    }
    /// `-1`, `0` or `1`.
    pub fn signum(self) -> i16 {
        if self > 0 { return 1; }
        if self < 0 { return -1; }
        0
    }
    pub fn is_positive(self) -> bool { self > 0 }
    pub fn is_negative(self) -> bool { self < 0 }
    /// Quotient rounded so that `rem_euclid` is never negative.
    pub fn div_euclid(self, rhs: i16) -> i16 {
        let q = self / rhs;
        if self % rhs < 0 {
            return if rhs > 0 { q - 1 } else { q + 1 };
        }
        q
    }
    /// The remainder in `0..rhs.abs()`.
    pub fn rem_euclid(self, rhs: i16) -> i16 {
        let r = self % rhs;
        if r < 0 {
            return if rhs < 0 { r.wrapping_sub(rhs) } else { r + rhs };
        }
        r
    }
    /// Integer square root; panics on a negative number.
    pub fn isqrt(self) -> i16 {
        if self < 0 { panic("isqrt of a negative number"); }
        (self as u16).isqrt() as i16
    }
    pub fn checked_isqrt(self) -> i16 | none {
        if self < 0 { return none; }
        (self as u16).isqrt() as i16
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: i16) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        15 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: i16) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// i32

impl i32 {
    pub const MIN: i32 = -2147483647 - 1;
    pub const MAX: i32 = 2147483647;

    #[intrinsic("rok.wrapping_add.i32")]
    pub fn wrapping_add(self, rhs: i32) -> i32 { self.wrapping_add(rhs) }
    #[intrinsic("rok.wrapping_sub.i32")]
    pub fn wrapping_sub(self, rhs: i32) -> i32 { self.wrapping_sub(rhs) }
    #[intrinsic("rok.wrapping_mul.i32")]
    pub fn wrapping_mul(self, rhs: i32) -> i32 { self.wrapping_mul(rhs) }
    #[intrinsic("rok.ctpop.i32")]
    fn ctpop(self) -> i32 { self.ctpop() }
    #[intrinsic("rok.ctlz.i32")]
    fn ctlz(self) -> i32 { self.ctlz() }
    #[intrinsic("rok.cttz.i32")]
    fn cttz(self) -> i32 { self.cttz() }

    pub fn count_ones(self) -> u32 { self.ctpop() as u32 }
    pub fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    pub fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    pub fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    pub fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    pub fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    pub fn rotate_left(self, n: u32) -> i32 { (self as u32).rotate_left(n) as i32 }
    pub fn rotate_right(self, n: u32) -> i32 { (self as u32).rotate_right(n) as i32 }
    pub fn swap_bytes(self) -> i32 { (self as u32).swap_bytes() as i32 }

    // ponytail: little-endian targets only (`to_be` swaps, `to_le` is
    // the identity).
    pub fn to_be(self) -> i32 { self.swap_bytes() }
    pub fn to_le(self) -> i32 { self }
    pub fn from_be(x: i32) -> i32 { x.swap_bytes() }
    pub fn from_le(x: i32) -> i32 { x }
    pub fn to_le_bytes(self) -> [u8; 4] { [self as u8, (self >> 8) as u8, (self >> 16) as u8, (self >> 24) as u8] }
    pub fn to_be_bytes(self) -> [u8; 4] { [(self >> 24) as u8, (self >> 16) as u8, (self >> 8) as u8, self as u8] }
    pub fn to_ne_bytes(self) -> [u8; 4] { self.to_le_bytes() }
    pub fn from_le_bytes(bytes: [u8; 4]) -> i32 {
        let x: u32 = 0;
        for i in 0..4 { x = x | (bytes[i] as u32) << (8 * i as u32); }
        x as i32
    }
    pub fn from_be_bytes(bytes: [u8; 4]) -> i32 {
        let x: u32 = 0;
        for i in 0..4 { x = x << 8 | bytes[i] as u32; }
        x as i32
    }
    pub fn from_ne_bytes(bytes: [u8; 4]) -> i32 { i32::from_le_bytes(bytes) }

    pub fn checked_add(self, rhs: i32) -> i32 | none {
        let r = self.wrapping_add(rhs);
        if (self ^ r) & (rhs ^ r) < 0 { return none; }
        r
    }
    pub fn checked_sub(self, rhs: i32) -> i32 | none {
        let r = self.wrapping_sub(rhs);
        if (self ^ rhs) & (self ^ r) < 0 { return none; }
        r
    }
    pub fn checked_mul(self, rhs: i32) -> i32 | none {
        if self == -1 { return rhs.checked_neg(); }
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: i32) -> i32 | none {
        if rhs == 0 || self == i32::MIN && rhs == -1 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: i32) -> i32 | none {
        if rhs == 0 || self == i32::MIN && rhs == -1 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> i32 | none {
        if self == i32::MIN { return none; }
        -self
    }
    pub fn checked_shl(self, n: u32) -> i32 | none {
        if n >= 32 { return none; }
        self << (n as i32)
    }
    pub fn checked_shr(self, n: u32) -> i32 | none {
        if n >= 32 { return none; }
        self >> (n as i32)
    }
    pub fn checked_pow(self, exp: u32) -> i32 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i32 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: i32) -> i32 {
        if self == i32::MIN && rhs == -1 { return self; }
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: i32) -> i32 {
        if rhs == -1 { return 0; }
        self % rhs
    }
    pub fn wrapping_neg(self) -> i32 { i32::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> i32 { self << ((n % 32) as i32) }
    pub fn wrapping_shr(self, n: u32) -> i32 { self >> ((n % 32) as i32) }
    pub fn wrapping_pow(self, exp: u32) -> i32 {
        let base = self;
        let acc: i32 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: i32) -> i32 {
        self.checked_add(rhs) ?? (if rhs > 0 { i32::MAX } else { i32::MIN })
    }
    pub fn saturating_sub(self, rhs: i32) -> i32 {
        self.checked_sub(rhs) ?? (if rhs < 0 { i32::MAX } else { i32::MIN })
    }
    pub fn saturating_mul(self, rhs: i32) -> i32 {
        self.checked_mul(rhs) ?? (if (self < 0) != (rhs < 0) { i32::MIN } else { i32::MAX })
    }
    pub fn saturating_neg(self) -> i32 { self.checked_neg() ?? i32::MAX }
    pub fn saturating_pow(self, exp: u32) -> i32 {
        self.checked_pow(exp) ?? (if self < 0 && exp % 2 == 1 { i32::MIN } else { i32::MAX })
    }

    pub fn overflowing_add(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_div(rhs), self == i32::MIN && rhs == -1)
    }
    pub fn overflowing_rem(self, rhs: i32) -> (i32, bool) {
        (self.wrapping_rem(rhs), self == i32::MIN && rhs == -1)
    }
    pub fn overflowing_neg(self) -> (i32, bool) { (self.wrapping_neg(), self == i32::MIN) }
    pub fn overflowing_shl(self, n: u32) -> (i32, bool) { (self.wrapping_shl(n), n >= 32) }
    pub fn overflowing_shr(self, n: u32) -> (i32, bool) { (self.wrapping_shr(n), n >= 32) }
    pub fn overflowing_pow(self, exp: u32) -> (i32, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> i32 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: i32 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs(self) -> i32 { if self < 0 { -self } else { self } }
    pub fn checked_abs(self) -> i32 | none { if self < 0 { self.checked_neg() } else { self } }
    pub fn wrapping_abs(self) -> i32 { if self < 0 { self.wrapping_neg() } else { self } }
    pub fn saturating_abs(self) -> i32 { if self < 0 { self.saturating_neg() } else { self } }
    pub fn unsigned_abs(self) -> u32 { self.wrapping_abs() as u32 }
    pub fn abs_diff(self, rhs: i32) -> u32 {
        if self < rhs {
            (rhs as u32).wrapping_sub(self as u32)
        } else {
            (self as u32).wrapping_sub(rhs as u32)
        }
    }
    /// `-1`, `0` or `1`.
    pub fn signum(self) -> i32 {
        if self > 0 { return 1; }
        if self < 0 { return -1; }
        0
    }
    pub fn is_positive(self) -> bool { self > 0 }
    pub fn is_negative(self) -> bool { self < 0 }
    /// Quotient rounded so that `rem_euclid` is never negative.
    pub fn div_euclid(self, rhs: i32) -> i32 {
        let q = self / rhs;
        if self % rhs < 0 {
            return if rhs > 0 { q - 1 } else { q + 1 };
        }
        q
    }
    /// The remainder in `0..rhs.abs()`.
    pub fn rem_euclid(self, rhs: i32) -> i32 {
        let r = self % rhs;
        if r < 0 {
            return if rhs < 0 { r.wrapping_sub(rhs) } else { r + rhs };
        }
        r
    }
    /// Integer square root; panics on a negative number.
    pub fn isqrt(self) -> i32 {
        if self < 0 { panic("isqrt of a negative number"); }
        (self as u32).isqrt() as i32
    }
    pub fn checked_isqrt(self) -> i32 | none {
        if self < 0 { return none; }
        (self as u32).isqrt() as i32
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: i32) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        31 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: i32) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

