    pub fn checked_sub(self, rhs: isize) -> isize | none {
        let r = self.wrapping_sub(rhs);
        if (self ^ rhs) & (self ^ r) < 0 { return none; }
        r
    }
    pub fn checked_mul(self, rhs: isize) -> isize | none {
        if self == -1 { return rhs.checked_neg(); }
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: isize) -> isize | none {
        if rhs == 0 || self == isize::MIN && rhs == -1 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: isize) -> isize | none {
        if rhs == 0 || self == isize::MIN && rhs == -1 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> isize | none {
        if self == isize::MIN { return none; }
        -self
    }
    pub fn checked_shl(self, n: u32) -> isize | none {
        if n >= 64 { return none; }
        self << (n as isize)
    }
    pub fn checked_shr(self, n: u32) -> isize | none {
        if n >= 64 { return none; }
        self >> (n as isize)
    }
    pub fn checked_pow(self, exp: u32) -> isize | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: isize = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: isize) -> isize {
        if self == isize::MIN && rhs == -1 { return self; }
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: isize) -> isize {
        if rhs == -1 { return 0; }
        self % rhs
    }
    pub fn wrapping_neg(self) -> isize { isize::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> isize { self << ((n % 64) as isize) }
    pub fn wrapping_shr(self, n: u32) -> isize { self >> ((n % 64) as isize) }
    pub fn wrapping_pow(self, exp: u32) -> isize {
        let base = self;
        let acc: isize = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: isize) -> isize {
        self.checked_add(rhs) ?? (if rhs > 0 { isize::MAX } else { isize::MIN })
    }
    pub fn saturating_sub(self, rhs: isize) -> isize {
        self.checked_sub(rhs) ?? (if rhs < 0 { isize::MAX } else { isize::MIN })
    }
    pub fn saturating_mul(self, rhs: isize) -> isize {
        self.checked_mul(rhs) ?? (if (self < 0) != (rhs < 0) { isize::MIN } else { isize::MAX })
    }
    pub fn saturating_neg(self) -> isize { self.checked_neg() ?? isize::MAX }
    pub fn saturating_pow(self, exp: u32) -> isize {
        self.checked_pow(exp) ?? (if self < 0 && exp % 2 == 1 { isize::MIN } else { isize::MAX })
    }

    pub fn overflowing_add(self, rhs: isize) -> (isize, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: isize) -> (isize, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: isize) -> (isize, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: isize) -> (isize, bool) {
        (self.wrapping_div(rhs), self == isize::MIN && rhs == -1)
    }
    pub fn overflowing_rem(self, rhs: isize) -> (isize, bool) {
        (self.wrapping_rem(rhs), self == isize::MIN && rhs == -1)
    }
    pub fn overflowing_neg(self) -> (isize, bool) { (self.wrapping_neg(), self == isize::MIN) }
    pub fn overflowing_shl(self, n: u32) -> (isize, bool) { (self.wrapping_shl(n), n >= 64) }
    pub fn overflowing_shr(self, n: u32) -> (isize, bool) { (self.wrapping_shr(n), n >= 64) }
    pub fn overflowing_pow(self, exp: u32) -> (isize, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> isize {
        if exp == 0 { return 1; }
        let base = self;
        let acc: isize = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs(self) -> isize { if self < 0 { -self } else { self } }
    pub fn checked_abs(self) -> isize | none { if self < 0 { self.checked_neg() } else { self } }
    pub fn wrapping_abs(self) -> isize { if self < 0 { self.wrapping_neg() } else { self } }
    pub fn saturating_abs(self) -> isize { if self < 0 { self.saturating_neg() } else { self } }
    pub fn unsigned_abs(self) -> usize { self.wrapping_abs() as usize }
    pub fn abs_diff(self, rhs: isize) -> usize {
        if self < rhs {
            (rhs as usize).wrapping_sub(self as usize)
        } else {
            (self as usize).wrapping_sub(rhs as usize)
        }
    }
    /// `-1`, `0` or `1`.
    pub fn signum(self) -> isize {
        if self > 0 { return 1; }
        if self < 0 { return -1; }
        0
    }
    pub fn is_positive(self) -> bool { self > 0 }
    pub fn is_negative(self) -> bool { self < 0 }
    /// Quotient rounded so that `rem_euclid` is never negative.
    pub fn div_euclid(self, rhs: isize) -> isize {
        let q = self / rhs;
        if self % rhs < 0 {
            return if rhs > 0 { q - 1 } else { q + 1 };
        }
        q
    }
    /// The remainder in `0..rhs.abs()`.
    pub fn rem_euclid(self, rhs: isize) -> isize {
        let r = self % rhs;
        if r < 0 {
            return if rhs < 0 { r.wrapping_sub(rhs) } else { r + rhs };
        }
        r
    }
    /// Integer square root; panics on a negative number.
    pub fn isqrt(self) -> isize {
        if self < 0 { panic("isqrt of a negative number"); }
        (self as usize).isqrt() as isize
    }
    pub fn checked_isqrt(self) -> isize | none {
        if self < 0 { return none; }
        (self as usize).isqrt() as isize
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: isize) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        63 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: isize) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// u8

impl u8 {
    pub const MIN: u8 = 0;
    pub const MAX: u8 = 255;

    #[intrinsic("rok.wrapping_add.u8")]
    pub fn wrapping_add(self, rhs: u8) -> u8 { self.wrapping_add(rhs) }
    #[intrinsic("rok.wrapping_sub.u8")]
    pub fn wrapping_sub(self, rhs: u8) -> u8 { self.wrapping_sub(rhs) }
    #[intrinsic("rok.wrapping_mul.u8")]
    pub fn wrapping_mul(self, rhs: u8) -> u8 { self.wrapping_mul(rhs) }
    #[intrinsic("rok.ctpop.u8")]
    fn ctpop(self) -> u8 { self.ctpop() }
    #[intrinsic("rok.ctlz.u8")]
    fn ctlz(self) -> u8 { self.ctlz() }
    #[intrinsic("rok.cttz.u8")]
    fn cttz(self) -> u8 { self.cttz() }

    pub fn count_ones(self) -> u32 { self.ctpop() as u32 }
    pub fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    pub fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    pub fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    pub fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    pub fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    pub fn rotate_left(self, n: u32) -> u8 {
        let k = n % 8;
        if k == 0 { return self; }
        self << (k as u8) | self >> ((8 - k) as u8)
    }
    pub fn rotate_right(self, n: u32) -> u8 { self.rotate_left(8 - n % 8) }
    pub fn swap_bytes(self) -> u8 { self }

    // ponytail: little-endian targets only (`to_be` swaps, `to_le` is
    // the identity).
    pub fn to_be(self) -> u8 { self.swap_bytes() }
    pub fn to_le(self) -> u8 { self }
    pub fn from_be(x: u8) -> u8 { x.swap_bytes() }
    pub fn from_le(x: u8) -> u8 { x }
    pub fn to_le_bytes(self) -> [u8; 1] { [self as u8] }
    pub fn to_be_bytes(self) -> [u8; 1] { [self as u8] }
    pub fn to_ne_bytes(self) -> [u8; 1] { self.to_le_bytes() }
    pub fn from_le_bytes(bytes: [u8; 1]) -> u8 { bytes[0] as u8 }
    pub fn from_be_bytes(bytes: [u8; 1]) -> u8 { bytes[0] as u8 }
    pub fn from_ne_bytes(bytes: [u8; 1]) -> u8 { u8::from_le_bytes(bytes) }

    pub fn checked_add(self, rhs: u8) -> u8 | none {
        let r = self.wrapping_add(rhs);
        if r < self { return none; }
        r
    }
    pub fn checked_sub(self, rhs: u8) -> u8 | none {
        let r = self.wrapping_sub(rhs);
        if self < rhs { return none; }
        r
    }
    pub fn checked_mul(self, rhs: u8) -> u8 | none {
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: u8) -> u8 | none {
        if rhs == 0 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: u8) -> u8 | none {
        if rhs == 0 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> u8 | none {
        if self != 0 { return none; }
        self
    }
    pub fn checked_shl(self, n: u32) -> u8 | none {
        if n >= 8 { return none; }
        self << (n as u8)
    }
    pub fn checked_shr(self, n: u32) -> u8 | none {
        if n >= 8 { return none; }
        self >> (n as u8)
    }
    pub fn checked_pow(self, exp: u32) -> u8 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: u8 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: u8) -> u8 {
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: u8) -> u8 {
        self % rhs
    }
    pub fn wrapping_neg(self) -> u8 { u8::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> u8 { self << ((n % 8) as u8) }
    pub fn wrapping_shr(self, n: u32) -> u8 { self >> ((n % 8) as u8) }
    pub fn wrapping_pow(self, exp: u32) -> u8 {
        let base = self;
        let acc: u8 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: u8) -> u8 { self.checked_add(rhs) ?? u8::MAX }
    pub fn saturating_sub(self, rhs: u8) -> u8 { self.checked_sub(rhs) ?? 0 }
    pub fn saturating_mul(self, rhs: u8) -> u8 { self.checked_mul(rhs) ?? u8::MAX }
    pub fn saturating_pow(self, exp: u32) -> u8 { self.checked_pow(exp) ?? u8::MAX }

    pub fn overflowing_add(self, rhs: u8) -> (u8, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: u8) -> (u8, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: u8) -> (u8, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: u8) -> (u8, bool) { (self / rhs, false) }
    pub fn overflowing_rem(self, rhs: u8) -> (u8, bool) { (self % rhs, false) }
    pub fn overflowing_neg(self) -> (u8, bool) { (self.wrapping_neg(), self != 0) }
    pub fn overflowing_shl(self, n: u32) -> (u8, bool) { (self.wrapping_shl(n), n >= 8) }
    pub fn overflowing_shr(self, n: u32) -> (u8, bool) { (self.wrapping_shr(n), n >= 8) }
    pub fn overflowing_pow(self, exp: u32) -> (u8, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> u8 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: u8 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs_diff(self, rhs: u8) -> u8 { if self < rhs { rhs - self } else { self - rhs } }
    pub fn div_euclid(self, rhs: u8) -> u8 { self / rhs }
    pub fn rem_euclid(self, rhs: u8) -> u8 { self % rhs }
    /// Integer square root (rounded down).
    pub fn isqrt(self) -> u8 {
        if self < 2 { return self; }
        // A float estimate, then exact fix-up (division keeps it from
        // overflowing).
        let x = (self as f64).sqrt() as u8;
        while x > self / x { x -= 1; }
        while x + 1 <= self / (x + 1) { x += 1; }
        x
    }
    pub fn is_power_of_two(self) -> bool { self != 0 && self & (self - 1) == 0 }
    /// The smallest power of two `>= self`; panics past `MAX`.
    pub fn next_power_of_two(self) -> u8 {
        self.checked_next_power_of_two() ?? panic("next_power_of_two overflowed")
    }
    pub fn checked_next_power_of_two(self) -> u8 | none {
        if self <= 1 { return 1; }
        let p = 8 - (self - 1).leading_zeros();
        if p >= 8 { return none; }
        let one: u8 = 1;
        one << (p as u8)
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: u8) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        7 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: u8) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// u16

impl u16 {
    pub const MIN: u16 = 0;
    pub const MAX: u16 = 65535;

    #[intrinsic("rok.wrapping_add.u16")]
    pub fn wrapping_add(self, rhs: u16) -> u16 { self.wrapping_add(rhs) }
    #[intrinsic("rok.wrapping_sub.u16")]
    pub fn wrapping_sub(self, rhs: u16) -> u16 { self.wrapping_sub(rhs) }
    #[intrinsic("rok.wrapping_mul.u16")]
    pub fn wrapping_mul(self, rhs: u16) -> u16 { self.wrapping_mul(rhs) }
    #[intrinsic("rok.ctpop.u16")]
    fn ctpop(self) -> u16 { self.ctpop() }
    #[intrinsic("rok.ctlz.u16")]
    fn ctlz(self) -> u16 { self.ctlz() }
    #[intrinsic("rok.cttz.u16")]
    fn cttz(self) -> u16 { self.cttz() }

    pub fn count_ones(self) -> u32 { self.ctpop() as u32 }
    pub fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    pub fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    pub fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    pub fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    pub fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    pub fn rotate_left(self, n: u32) -> u16 {
        let k = n % 16;
        if k == 0 { return self; }
        self << (k as u16) | self >> ((16 - k) as u16)
    }
    pub fn rotate_right(self, n: u32) -> u16 { self.rotate_left(16 - n % 16) }
    #[intrinsic("rok.bswap.u16")]
    pub fn swap_bytes(self) -> u16 { self.swap_bytes() }

    // ponytail: little-endian targets only (`to_be` swaps, `to_le` is
    // the identity).
    pub fn to_be(self) -> u16 { self.swap_bytes() }
    pub fn to_le(self) -> u16 { self }
    pub fn from_be(x: u16) -> u16 { x.swap_bytes() }
    pub fn from_le(x: u16) -> u16 { x }
    pub fn to_le_bytes(self) -> [u8; 2] { [self as u8, (self >> 8) as u8] }
    pub fn to_be_bytes(self) -> [u8; 2] { [(self >> 8) as u8, self as u8] }
    pub fn to_ne_bytes(self) -> [u8; 2] { self.to_le_bytes() }
    pub fn from_le_bytes(bytes: [u8; 2]) -> u16 {
        let x: u16 = 0;
        for i in 0..2 { x = x | (bytes[i] as u16) << (8 * i as u16); }
        x
    }
    pub fn from_be_bytes(bytes: [u8; 2]) -> u16 {
        let x: u16 = 0;
        for i in 0..2 { x = x << 8 | bytes[i] as u16; }
        x
    }
    pub fn from_ne_bytes(bytes: [u8; 2]) -> u16 { u16::from_le_bytes(bytes) }

    pub fn checked_add(self, rhs: u16) -> u16 | none {
        let r = self.wrapping_add(rhs);
        if r < self { return none; }
        r
    }
    pub fn checked_sub(self, rhs: u16) -> u16 | none {
        let r = self.wrapping_sub(rhs);
        if self < rhs { return none; }
        r
    }
    pub fn checked_mul(self, rhs: u16) -> u16 | none {
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: u16) -> u16 | none {
        if rhs == 0 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: u16) -> u16 | none {
        if rhs == 0 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> u16 | none {
        if self != 0 { return none; }
        self
    }
    pub fn checked_shl(self, n: u32) -> u16 | none {
        if n >= 16 { return none; }
        self << (n as u16)
    }
    pub fn checked_shr(self, n: u32) -> u16 | none {
        if n >= 16 { return none; }
        self >> (n as u16)
    }
    pub fn checked_pow(self, exp: u32) -> u16 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: u16 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: u16) -> u16 {
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: u16) -> u16 {
        self % rhs
    }
    pub fn wrapping_neg(self) -> u16 { u16::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> u16 { self << ((n % 16) as u16) }
    pub fn wrapping_shr(self, n: u32) -> u16 { self >> ((n % 16) as u16) }
    pub fn wrapping_pow(self, exp: u32) -> u16 {
        let base = self;
        let acc: u16 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: u16) -> u16 { self.checked_add(rhs) ?? u16::MAX }
    pub fn saturating_sub(self, rhs: u16) -> u16 { self.checked_sub(rhs) ?? 0 }
    pub fn saturating_mul(self, rhs: u16) -> u16 { self.checked_mul(rhs) ?? u16::MAX }
    pub fn saturating_pow(self, exp: u32) -> u16 { self.checked_pow(exp) ?? u16::MAX }

    pub fn overflowing_add(self, rhs: u16) -> (u16, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: u16) -> (u16, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: u16) -> (u16, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: u16) -> (u16, bool) { (self / rhs, false) }
    pub fn overflowing_rem(self, rhs: u16) -> (u16, bool) { (self % rhs, false) }
    pub fn overflowing_neg(self) -> (u16, bool) { (self.wrapping_neg(), self != 0) }
    pub fn overflowing_shl(self, n: u32) -> (u16, bool) { (self.wrapping_shl(n), n >= 16) }
    pub fn overflowing_shr(self, n: u32) -> (u16, bool) { (self.wrapping_shr(n), n >= 16) }
    pub fn overflowing_pow(self, exp: u32) -> (u16, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> u16 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: u16 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs_diff(self, rhs: u16) -> u16 { if self < rhs { rhs - self } else { self - rhs } }
    pub fn div_euclid(self, rhs: u16) -> u16 { self / rhs }
    pub fn rem_euclid(self, rhs: u16) -> u16 { self % rhs }
    /// Integer square root (rounded down).
    pub fn isqrt(self) -> u16 {
        if self < 2 { return self; }
        // A float estimate, then exact fix-up (division keeps it from
        // overflowing).
        let x = (self as f64).sqrt() as u16;
        while x > self / x { x -= 1; }
        while x + 1 <= self / (x + 1) { x += 1; }
        x
    }
    pub fn is_power_of_two(self) -> bool { self != 0 && self & (self - 1) == 0 }
    /// The smallest power of two `>= self`; panics past `MAX`.
    pub fn next_power_of_two(self) -> u16 {
        self.checked_next_power_of_two() ?? panic("next_power_of_two overflowed")
    }
    pub fn checked_next_power_of_two(self) -> u16 | none {
        if self <= 1 { return 1; }
        let p = 16 - (self - 1).leading_zeros();
        if p >= 16 { return none; }
        let one: u16 = 1;
        one << (p as u16)
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: u16) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        15 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: u16) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// u32

impl u32 {
    pub const MIN: u32 = 0;
    pub const MAX: u32 = 4294967295;

    #[intrinsic("rok.wrapping_add.u32")]
    pub fn wrapping_add(self, rhs: u32) -> u32 { self.wrapping_add(rhs) }
    #[intrinsic("rok.wrapping_sub.u32")]
    pub fn wrapping_sub(self, rhs: u32) -> u32 { self.wrapping_sub(rhs) }
    #[intrinsic("rok.wrapping_mul.u32")]
    pub fn wrapping_mul(self, rhs: u32) -> u32 { self.wrapping_mul(rhs) }
    #[intrinsic("rok.ctpop.u32")]
    fn ctpop(self) -> u32 { self.ctpop() }
    #[intrinsic("rok.ctlz.u32")]
    fn ctlz(self) -> u32 { self.ctlz() }
    #[intrinsic("rok.cttz.u32")]
    fn cttz(self) -> u32 { self.cttz() }

    pub fn count_ones(self) -> u32 { self.ctpop() as u32 }
    pub fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    pub fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    pub fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    pub fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    pub fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    pub fn rotate_left(self, n: u32) -> u32 {
        let k = n % 32;
        if k == 0 { return self; }
        self << k | self >> (32 - k)
    }
    pub fn rotate_right(self, n: u32) -> u32 { self.rotate_left(32 - n % 32) }
    #[intrinsic("rok.bswap.u32")]
    pub fn swap_bytes(self) -> u32 { self.swap_bytes() }

    // ponytail: little-endian targets only (`to_be` swaps, `to_le` is
    // the identity).
    pub fn to_be(self) -> u32 { self.swap_bytes() }
    pub fn to_le(self) -> u32 { self }
    pub fn from_be(x: u32) -> u32 { x.swap_bytes() }
    pub fn from_le(x: u32) -> u32 { x }
    pub fn to_le_bytes(self) -> [u8; 4] { [self as u8, (self >> 8) as u8, (self >> 16) as u8, (self >> 24) as u8] }
    pub fn to_be_bytes(self) -> [u8; 4] { [(self >> 24) as u8, (self >> 16) as u8, (self >> 8) as u8, self as u8] }
    pub fn to_ne_bytes(self) -> [u8; 4] { self.to_le_bytes() }
    pub fn from_le_bytes(bytes: [u8; 4]) -> u32 {
        let x: u32 = 0;
        for i in 0..4 { x = x | (bytes[i] as u32) << (8 * i as u32); }
        x
    }
    pub fn from_be_bytes(bytes: [u8; 4]) -> u32 {
        let x: u32 = 0;
        for i in 0..4 { x = x << 8 | bytes[i] as u32; }
        x
    }
    pub fn from_ne_bytes(bytes: [u8; 4]) -> u32 { u32::from_le_bytes(bytes) }

    pub fn checked_add(self, rhs: u32) -> u32 | none {
        let r = self.wrapping_add(rhs);
        if r < self { return none; }
        r
    }
    pub fn checked_sub(self, rhs: u32) -> u32 | none {
        let r = self.wrapping_sub(rhs);
        if self < rhs { return none; }
        r
    }
    pub fn checked_mul(self, rhs: u32) -> u32 | none {
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: u32) -> u32 | none {
        if rhs == 0 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: u32) -> u32 | none {
        if rhs == 0 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> u32 | none {
        if self != 0 { return none; }
        self
    }
    pub fn checked_shl(self, n: u32) -> u32 | none {
        if n >= 32 { return none; }
        self << (n as u32)
    }
    pub fn checked_shr(self, n: u32) -> u32 | none {
        if n >= 32 { return none; }
        self >> (n as u32)
    }
    pub fn checked_pow(self, exp: u32) -> u32 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: u32 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: u32) -> u32 {
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: u32) -> u32 {
        self % rhs
    }
    pub fn wrapping_neg(self) -> u32 { u32::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> u32 { self << ((n % 32) as u32) }
    pub fn wrapping_shr(self, n: u32) -> u32 { self >> ((n % 32) as u32) }
    pub fn wrapping_pow(self, exp: u32) -> u32 {
        let base = self;
        let acc: u32 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: u32) -> u32 { self.checked_add(rhs) ?? u32::MAX }
    pub fn saturating_sub(self, rhs: u32) -> u32 { self.checked_sub(rhs) ?? 0 }
    pub fn saturating_mul(self, rhs: u32) -> u32 { self.checked_mul(rhs) ?? u32::MAX }
    pub fn saturating_pow(self, exp: u32) -> u32 { self.checked_pow(exp) ?? u32::MAX }

    pub fn overflowing_add(self, rhs: u32) -> (u32, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: u32) -> (u32, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: u32) -> (u32, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: u32) -> (u32, bool) { (self / rhs, false) }
    pub fn overflowing_rem(self, rhs: u32) -> (u32, bool) { (self % rhs, false) }
    pub fn overflowing_neg(self) -> (u32, bool) { (self.wrapping_neg(), self != 0) }
    pub fn overflowing_shl(self, n: u32) -> (u32, bool) { (self.wrapping_shl(n), n >= 32) }
    pub fn overflowing_shr(self, n: u32) -> (u32, bool) { (self.wrapping_shr(n), n >= 32) }
    pub fn overflowing_pow(self, exp: u32) -> (u32, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> u32 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: u32 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs_diff(self, rhs: u32) -> u32 { if self < rhs { rhs - self } else { self - rhs } }
    pub fn div_euclid(self, rhs: u32) -> u32 { self / rhs }
    pub fn rem_euclid(self, rhs: u32) -> u32 { self % rhs }
    /// Integer square root (rounded down).
    pub fn isqrt(self) -> u32 {
        if self < 2 { return self; }
        // A float estimate, then exact fix-up (division keeps it from
        // overflowing).
        let x = (self as f64).sqrt() as u32;
        while x > self / x { x -= 1; }
        while x + 1 <= self / (x + 1) { x += 1; }
        x
    }
    pub fn is_power_of_two(self) -> bool { self != 0 && self & (self - 1) == 0 }
    /// The smallest power of two `>= self`; panics past `MAX`.
    pub fn next_power_of_two(self) -> u32 {
        self.checked_next_power_of_two() ?? panic("next_power_of_two overflowed")
    }
    pub fn checked_next_power_of_two(self) -> u32 | none {
        if self <= 1 { return 1; }
        let p = 32 - (self - 1).leading_zeros();
        if p >= 32 { return none; }
        let one: u32 = 1;
        one << (p as u32)
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: u32) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        31 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: u32) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// u64

impl u64 {
    pub const MIN: u64 = 0;
    pub const MAX: u64 = 18446744073709551615;

    #[intrinsic("rok.wrapping_add.u64")]
    pub fn wrapping_add(self, rhs: u64) -> u64 { self.wrapping_add(rhs) }
    #[intrinsic("rok.wrapping_sub.u64")]
    pub fn wrapping_sub(self, rhs: u64) -> u64 { self.wrapping_sub(rhs) }
    #[intrinsic("rok.wrapping_mul.u64")]
    pub fn wrapping_mul(self, rhs: u64) -> u64 { self.wrapping_mul(rhs) }
    #[intrinsic("rok.ctpop.u64")]
    fn ctpop(self) -> u64 { self.ctpop() }
    #[intrinsic("rok.ctlz.u64")]
    fn ctlz(self) -> u64 { self.ctlz() }
    #[intrinsic("rok.cttz.u64")]
    fn cttz(self) -> u64 { self.cttz() }

    pub fn count_ones(self) -> u32 { self.ctpop() as u32 }
    pub fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    pub fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    pub fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    pub fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    pub fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    pub fn rotate_left(self, n: u32) -> u64 {
        let k = n % 64;
        if k == 0 { return self; }
        self << (k as u64) | self >> ((64 - k) as u64)
    }
    pub fn rotate_right(self, n: u32) -> u64 { self.rotate_left(64 - n % 64) }
    #[intrinsic("rok.bswap.u64")]
    pub fn swap_bytes(self) -> u64 { self.swap_bytes() }

    // ponytail: little-endian targets only (`to_be` swaps, `to_le` is
    // the identity).
    pub fn to_be(self) -> u64 { self.swap_bytes() }
    pub fn to_le(self) -> u64 { self }
    pub fn from_be(x: u64) -> u64 { x.swap_bytes() }
    pub fn from_le(x: u64) -> u64 { x }
    pub fn to_le_bytes(self) -> [u8; 8] { [self as u8, (self >> 8) as u8, (self >> 16) as u8, (self >> 24) as u8, (self >> 32) as u8, (self >> 40) as u8, (self >> 48) as u8, (self >> 56) as u8] }
    pub fn to_be_bytes(self) -> [u8; 8] { [(self >> 56) as u8, (self >> 48) as u8, (self >> 40) as u8, (self >> 32) as u8, (self >> 24) as u8, (self >> 16) as u8, (self >> 8) as u8, self as u8] }
    pub fn to_ne_bytes(self) -> [u8; 8] { self.to_le_bytes() }
    pub fn from_le_bytes(bytes: [u8; 8]) -> u64 {
        let x: u64 = 0;
        for i in 0..8 { x = x | (bytes[i] as u64) << (8 * i as u64); }
        x
    }
    pub fn from_be_bytes(bytes: [u8; 8]) -> u64 {
        let x: u64 = 0;
        for i in 0..8 { x = x << 8 | bytes[i] as u64; }
        x
    }
    pub fn from_ne_bytes(bytes: [u8; 8]) -> u64 { u64::from_le_bytes(bytes) }

    pub fn checked_add(self, rhs: u64) -> u64 | none {
        let r = self.wrapping_add(rhs);
        if r < self { return none; }
        r
    }
    pub fn checked_sub(self, rhs: u64) -> u64 | none {
        let r = self.wrapping_sub(rhs);
        if self < rhs { return none; }
        r
    }
    pub fn checked_mul(self, rhs: u64) -> u64 | none {
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: u64) -> u64 | none {
        if rhs == 0 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: u64) -> u64 | none {
        if rhs == 0 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> u64 | none {
        if self != 0 { return none; }
        self
    }
    pub fn checked_shl(self, n: u32) -> u64 | none {
        if n >= 64 { return none; }
        self << (n as u64)
    }
    pub fn checked_shr(self, n: u32) -> u64 | none {
        if n >= 64 { return none; }
        self >> (n as u64)
    }
    pub fn checked_pow(self, exp: u32) -> u64 | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: u64 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: u64) -> u64 {
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: u64) -> u64 {
        self % rhs
    }
    pub fn wrapping_neg(self) -> u64 { u64::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> u64 { self << ((n % 64) as u64) }
    pub fn wrapping_shr(self, n: u32) -> u64 { self >> ((n % 64) as u64) }
    pub fn wrapping_pow(self, exp: u32) -> u64 {
        let base = self;
        let acc: u64 = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: u64) -> u64 { self.checked_add(rhs) ?? u64::MAX }
    pub fn saturating_sub(self, rhs: u64) -> u64 { self.checked_sub(rhs) ?? 0 }
    pub fn saturating_mul(self, rhs: u64) -> u64 { self.checked_mul(rhs) ?? u64::MAX }
    pub fn saturating_pow(self, exp: u32) -> u64 { self.checked_pow(exp) ?? u64::MAX }

    pub fn overflowing_add(self, rhs: u64) -> (u64, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: u64) -> (u64, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: u64) -> (u64, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: u64) -> (u64, bool) { (self / rhs, false) }
    pub fn overflowing_rem(self, rhs: u64) -> (u64, bool) { (self % rhs, false) }
    pub fn overflowing_neg(self) -> (u64, bool) { (self.wrapping_neg(), self != 0) }
    pub fn overflowing_shl(self, n: u32) -> (u64, bool) { (self.wrapping_shl(n), n >= 64) }
    pub fn overflowing_shr(self, n: u32) -> (u64, bool) { (self.wrapping_shr(n), n >= 64) }
    pub fn overflowing_pow(self, exp: u32) -> (u64, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> u64 {
        if exp == 0 { return 1; }
        let base = self;
        let acc: u64 = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs_diff(self, rhs: u64) -> u64 { if self < rhs { rhs - self } else { self - rhs } }
    pub fn div_euclid(self, rhs: u64) -> u64 { self / rhs }
    pub fn rem_euclid(self, rhs: u64) -> u64 { self % rhs }
    /// Integer square root (rounded down).
    pub fn isqrt(self) -> u64 {
        if self < 2 { return self; }
        // A float estimate, then exact fix-up (division keeps it from
        // overflowing).
        let x = (self as f64).sqrt() as u64;
        while x > self / x { x -= 1; }
        while x + 1 <= self / (x + 1) { x += 1; }
        x
    }
    pub fn is_power_of_two(self) -> bool { self != 0 && self & (self - 1) == 0 }
    /// The smallest power of two `>= self`; panics past `MAX`.
    pub fn next_power_of_two(self) -> u64 {
        self.checked_next_power_of_two() ?? panic("next_power_of_two overflowed")
    }
    pub fn checked_next_power_of_two(self) -> u64 | none {
        if self <= 1 { return 1; }
        let p = 64 - (self - 1).leading_zeros();
        if p >= 64 { return none; }
        let one: u64 = 1;
        one << (p as u64)
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: u64) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        63 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: u64) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}

// usize

impl usize {
    // ponytail: 64-bit targets only; 32-bit targets need their own limits.
    pub const MIN: usize = 0;
    pub const MAX: usize = 18446744073709551615;

    #[intrinsic("rok.wrapping_add.usize")]
    pub fn wrapping_add(self, rhs: usize) -> usize { self.wrapping_add(rhs) }
    #[intrinsic("rok.wrapping_sub.usize")]
    pub fn wrapping_sub(self, rhs: usize) -> usize { self.wrapping_sub(rhs) }
    #[intrinsic("rok.wrapping_mul.usize")]
    pub fn wrapping_mul(self, rhs: usize) -> usize { self.wrapping_mul(rhs) }
    #[intrinsic("rok.ctpop.usize")]
    fn ctpop(self) -> usize { self.ctpop() }
    #[intrinsic("rok.ctlz.usize")]
    fn ctlz(self) -> usize { self.ctlz() }
    #[intrinsic("rok.cttz.usize")]
    fn cttz(self) -> usize { self.cttz() }

    pub fn count_ones(self) -> u32 { self.ctpop() as u32 }
    pub fn count_zeros(self) -> u32 { (~self).ctpop() as u32 }
    pub fn leading_zeros(self) -> u32 { self.ctlz() as u32 }
    pub fn trailing_zeros(self) -> u32 { self.cttz() as u32 }
    pub fn leading_ones(self) -> u32 { (~self).ctlz() as u32 }
    pub fn trailing_ones(self) -> u32 { (~self).cttz() as u32 }

    pub fn rotate_left(self, n: u32) -> usize {
        let k = n % 64;
        if k == 0 { return self; }
        self << (k as usize) | self >> ((64 - k) as usize)
    }
    pub fn rotate_right(self, n: u32) -> usize { self.rotate_left(64 - n % 64) }
    #[intrinsic("rok.bswap.usize")]
    pub fn swap_bytes(self) -> usize { self.swap_bytes() }

    // ponytail: little-endian targets only (`to_be` swaps, `to_le` is
    // the identity).
    pub fn to_be(self) -> usize { self.swap_bytes() }
    pub fn to_le(self) -> usize { self }
    pub fn from_be(x: usize) -> usize { x.swap_bytes() }
    pub fn from_le(x: usize) -> usize { x }
    pub fn to_le_bytes(self) -> [u8; 8] { [self as u8, (self >> 8) as u8, (self >> 16) as u8, (self >> 24) as u8, (self >> 32) as u8, (self >> 40) as u8, (self >> 48) as u8, (self >> 56) as u8] }
    pub fn to_be_bytes(self) -> [u8; 8] { [(self >> 56) as u8, (self >> 48) as u8, (self >> 40) as u8, (self >> 32) as u8, (self >> 24) as u8, (self >> 16) as u8, (self >> 8) as u8, self as u8] }
    pub fn to_ne_bytes(self) -> [u8; 8] { self.to_le_bytes() }
    pub fn from_le_bytes(bytes: [u8; 8]) -> usize {
        let x: usize = 0;
        for i in 0..8 { x = x | (bytes[i] as usize) << (8 * i as usize); }
        x
    }
    pub fn from_be_bytes(bytes: [u8; 8]) -> usize {
        let x: usize = 0;
        for i in 0..8 { x = x << 8 | bytes[i] as usize; }
        x
    }
    pub fn from_ne_bytes(bytes: [u8; 8]) -> usize { usize::from_le_bytes(bytes) }

    pub fn checked_add(self, rhs: usize) -> usize | none {
        let r = self.wrapping_add(rhs);
        if r < self { return none; }
        r
    }
    pub fn checked_sub(self, rhs: usize) -> usize | none {
        let r = self.wrapping_sub(rhs);
        if self < rhs { return none; }
        r
    }
    pub fn checked_mul(self, rhs: usize) -> usize | none {
        let r = self.wrapping_mul(rhs);
        if self != 0 && r / self != rhs { return none; }
        r
    }
    pub fn checked_div(self, rhs: usize) -> usize | none {
        if rhs == 0 { return none; }
        self / rhs
    }
    pub fn checked_rem(self, rhs: usize) -> usize | none {
        if rhs == 0 { return none; }
        self % rhs
    }
    pub fn checked_neg(self) -> usize | none {
        if self != 0 { return none; }
        self
    }
    pub fn checked_shl(self, n: u32) -> usize | none {
        if n >= 64 { return none; }
        self << (n as usize)
    }
    pub fn checked_shr(self, n: u32) -> usize | none {
        if n >= 64 { return none; }
        self >> (n as usize)
    }
    pub fn checked_pow(self, exp: u32) -> usize | none {
        if exp == 0 { return 1; }
        let base = self;
        let acc: usize = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc.checked_mul(base)?; }
            e = e >> 1;
            base = base.checked_mul(base)?;
        }
        acc.checked_mul(base)
    }

    pub fn wrapping_div(self, rhs: usize) -> usize {
        self / rhs
    }
    pub fn wrapping_rem(self, rhs: usize) -> usize {
        self % rhs
    }
    pub fn wrapping_neg(self) -> usize { usize::wrapping_sub(0, self) }
    pub fn wrapping_shl(self, n: u32) -> usize { self << ((n % 64) as usize) }
    pub fn wrapping_shr(self, n: u32) -> usize { self >> ((n % 64) as usize) }
    pub fn wrapping_pow(self, exp: u32) -> usize {
        let base = self;
        let acc: usize = 1;
        let e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e >> 1;
            base = base.wrapping_mul(base);
        }
        acc
    }

    pub fn saturating_add(self, rhs: usize) -> usize { self.checked_add(rhs) ?? usize::MAX }
    pub fn saturating_sub(self, rhs: usize) -> usize { self.checked_sub(rhs) ?? 0 }
    pub fn saturating_mul(self, rhs: usize) -> usize { self.checked_mul(rhs) ?? usize::MAX }
    pub fn saturating_pow(self, exp: u32) -> usize { self.checked_pow(exp) ?? usize::MAX }

    pub fn overflowing_add(self, rhs: usize) -> (usize, bool) {
        (self.wrapping_add(rhs), self.checked_add(rhs) is none)
    }
    pub fn overflowing_sub(self, rhs: usize) -> (usize, bool) {
        (self.wrapping_sub(rhs), self.checked_sub(rhs) is none)
    }
    pub fn overflowing_mul(self, rhs: usize) -> (usize, bool) {
        (self.wrapping_mul(rhs), self.checked_mul(rhs) is none)
    }
    pub fn overflowing_div(self, rhs: usize) -> (usize, bool) { (self / rhs, false) }
    pub fn overflowing_rem(self, rhs: usize) -> (usize, bool) { (self % rhs, false) }
    pub fn overflowing_neg(self) -> (usize, bool) { (self.wrapping_neg(), self != 0) }
    pub fn overflowing_shl(self, n: u32) -> (usize, bool) { (self.wrapping_shl(n), n >= 64) }
    pub fn overflowing_shr(self, n: u32) -> (usize, bool) { (self.wrapping_shr(n), n >= 64) }
    pub fn overflowing_pow(self, exp: u32) -> (usize, bool) {
        (self.wrapping_pow(exp), self.checked_pow(exp) is none)
    }

    /// `self` to the `exp`; overflow is the arithmetic's (panic in
    /// debug, wrap in release).
    pub fn pow(self, exp: u32) -> usize {
        if exp == 0 { return 1; }
        let base = self;
        let acc: usize = 1;
        let e = exp;
        while e > 1 {
            if e & 1 == 1 { acc = acc * base; }
            e = e >> 1;
            base = base * base;
        }
        acc * base
    }
    pub fn abs_diff(self, rhs: usize) -> usize { if self < rhs { rhs - self } else { self - rhs } }
    pub fn div_euclid(self, rhs: usize) -> usize { self / rhs }
    pub fn rem_euclid(self, rhs: usize) -> usize { self % rhs }
    /// Integer square root (rounded down).
    pub fn isqrt(self) -> usize {
        if self < 2 { return self; }
        // A float estimate, then exact fix-up (division keeps it from
        // overflowing).
        let x = (self as f64).sqrt() as usize;
        while x > self / x { x -= 1; }
        while x + 1 <= self / (x + 1) { x += 1; }
        x
    }
    pub fn is_power_of_two(self) -> bool { self != 0 && self & (self - 1) == 0 }
    /// The smallest power of two `>= self`; panics past `MAX`.
    pub fn next_power_of_two(self) -> usize {
        self.checked_next_power_of_two() ?? panic("next_power_of_two overflowed")
    }
    pub fn checked_next_power_of_two(self) -> usize | none {
        if self <= 1 { return 1; }
        let p = 64 - (self - 1).leading_zeros();
        if p >= 64 { return none; }
        let one: usize = 1;
        one << (p as usize)
    }
    /// `floor(log2(self))`; panics unless `self > 0`.
    pub fn ilog2(self) -> u32 { self.checked_ilog2() ?? panic("ilog2 of a non-positive number") }
    pub fn ilog10(self) -> u32 { self.checked_ilog10() ?? panic("ilog10 of a non-positive number") }
    pub fn ilog(self, base: usize) -> u32 {
        self.checked_ilog(base) ?? panic("ilog of a non-positive number or a base below 2")
    }
    pub fn checked_ilog2(self) -> u32 | none {
        if self <= 0 { return none; }
        63 - self.leading_zeros()
    }
    pub fn checked_ilog10(self) -> u32 | none { self.checked_ilog(10) }
    pub fn checked_ilog(self, base: usize) -> u32 | none {
        if self <= 0 || base < 2 { return none; }
        let n: u32 = 0;
        let x = self;
        while x >= base {
            x = x / base;
            n += 1;
        }
        n
    }
}
