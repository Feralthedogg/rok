// int: a new value each time

impl AddAssign for Int {
    fn add_assign(ref self, rhs: Int) { self = self + rhs; }
}

impl SubAssign for Int {
    fn sub_assign(ref self, rhs: Int) { self = self - rhs; }
}

impl MulAssign for Int {
    fn mul_assign(ref self, rhs: Int) { self = self * rhs; }
}

impl DivAssign for Int {
    fn div_assign(ref self, rhs: Int) { self = self / rhs; }
}

impl RemAssign for Int {
    fn rem_assign(ref self, rhs: Int) { self = self % rhs; }
}

impl ModuloAssign for Int {
    fn modulo_assign(ref self, rhs: Int) { self = self %% rhs; }
}

impl BitAndAssign for Int {
    fn bitand_assign(ref self, rhs: Int) { self = self & rhs; }
}

impl BitOrAssign for Int {
    fn bitor_assign(ref self, rhs: Int) { self = self | rhs; }
}

impl BitXorAssign for Int {
    fn bitxor_assign(ref self, rhs: Int) { self = self ^ rhs; }
}

impl ShlAssign<u32> for Int {
    fn shl_assign(ref self, rhs: u32) { self = self << rhs; }
}

impl ShrAssign<u32> for Int {
    fn shr_assign(ref self, rhs: u32) { self = self >> rhs; }
}

// float: a new value each time

impl AddAssign for Float {
    fn add_assign(ref self, rhs: Float) { self = self + rhs; }
}

impl SubAssign for Float {
    fn sub_assign(ref self, rhs: Float) { self = self - rhs; }
}

impl MulAssign for Float {
    fn mul_assign(ref self, rhs: Float) { self = self * rhs; }
}

impl DivAssign for Float {
