}

impl ModuloAssign for Float {
    fn modulo_assign(ref self, rhs: Float) { self = self %% rhs; }
}

// str: a new str each time (str is immutable)

impl AddAssign for str {
    fn add_assign(ref self, rhs: str) { self = self + rhs; }
}

impl AddAssign<char> for str {
    fn add_assign(ref self, rhs: char) { self = self + unsafe { rok_str_from_char(rhs as u32) }; }
}
