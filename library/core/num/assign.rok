// rok::core::num::assign — the `*Assign` impls (stdlib 2.4.6) of the
// primitives, `int` / `float` and `str`. A primitive's method is
// `#[intrinsic("rok.OP_assign.TYPE")]`: `a += b` and a by-name call both
// lower to `a = a op b`. `%%=` has no machine op; it calls `Modulo`.
// One block per (type, trait); keep it regular.

// i8

impl AddAssign for i8 {
    #[intrinsic("rok.add_assign.i8")]
    fn add_assign(ref self, rhs: i8) { self = self + rhs; }
}

impl SubAssign for i8 {
    #[intrinsic("rok.sub_assign.i8")]
    fn sub_assign(ref self, rhs: i8) { self = self - rhs; }
}

impl MulAssign for i8 {
    #[intrinsic("rok.mul_assign.i8")]
    fn mul_assign(ref self, rhs: i8) { self = self * rhs; }
}

impl DivAssign for i8 {
    #[intrinsic("rok.div_assign.i8")]
    fn div_assign(ref self, rhs: i8) { self = self / rhs; }
}

impl RemAssign for i8 {
    #[intrinsic("rok.rem_assign.i8")]
    fn rem_assign(ref self, rhs: i8) { self = self % rhs; }
}

impl ModuloAssign for i8 {
    fn modulo_assign(ref self, rhs: i8) { self = self %% rhs; }
}

impl BitAndAssign for i8 {
    #[intrinsic("rok.and_assign.i8")]
    fn bitand_assign(ref self, rhs: i8) { self = self & rhs; }
}

impl BitOrAssign for i8 {
    #[intrinsic("rok.or_assign.i8")]
    fn bitor_assign(ref self, rhs: i8) { self = self | rhs; }
}

impl BitXorAssign for i8 {
    #[intrinsic("rok.xor_assign.i8")]
    fn bitxor_assign(ref self, rhs: i8) { self = self ^ rhs; }
}

impl ShlAssign for i8 {
    #[intrinsic("rok.shl_assign.i8")]
    fn shl_assign(ref self, rhs: i8) { self = self << rhs; }
}

impl ShrAssign for i8 {
    #[intrinsic("rok.shr_assign.i8")]
    fn shr_assign(ref self, rhs: i8) { self = self >> rhs; }
}

