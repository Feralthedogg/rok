// rok::core::tuple — Clone / Copy / Default / Debug / PartialEq / Eq /
// Hash for tuples of 1 to 12 elements, component-wise (stdlib 2.5.7,
// 2.10.9, 2.13.6). One block per (arity, trait), all the same shape;
// keep every arity in step.

// 1-tuples
impl<A: Clone> Clone for (A,) {
    fn clone(self) -> (A,) { return (self.0.clone(),); }
}
impl<A: Copy> Copy for (A,) {}
impl<A: Default> Default for (A,) {
    fn default() -> (A,) { return (rok::core::marker::default_of(),); }
}
impl<A: Debug> Debug for (A,) {
    fn debug(self) -> str { return "(" + self.0.debug() + ",)"; }
}
impl<A: PartialEq> PartialEq for (A,) {
    fn eq(self, rhs: (A,)) -> bool { return self.0.eq(rhs.0); }
    fn ne(self, rhs: (A,)) -> bool { return !self.eq(rhs); }
}
impl<A: Eq> Eq for (A,) {}
impl<A: Hash> Hash for (A,) {
    fn hash(self) -> u64 {
        let h = 1u64;
        h = ((h << 5) | (h >> 59)) ^ self.0.hash();
        return h;
    }
}

// 2-tuples
impl<A: Clone, B: Clone> Clone for (A, B) {
    fn clone(self) -> (A, B) { return (self.0.clone(), self.1.clone()); }
}
impl<A: Copy, B: Copy> Copy for (A, B) {}
impl<A: Default, B: Default> Default for (A, B) {
    fn default() -> (A, B) { return (rok::core::marker::default_of(), rok::core::marker::default_of()); }
}
impl<A: Debug, B: Debug> Debug for (A, B) {
    fn debug(self) -> str { return "(" + self.0.debug() + ", " + self.1.debug() + ")"; }
}
impl<A: PartialEq, B: PartialEq> PartialEq for (A, B) {
    fn eq(self, rhs: (A, B)) -> bool { return self.0.eq(rhs.0) && self.1.eq(rhs.1); }
    fn ne(self, rhs: (A, B)) -> bool { return !self.eq(rhs); }
}
impl<A: Eq, B: Eq> Eq for (A, B) {}
impl<A: Hash, B: Hash> Hash for (A, B) {
    fn hash(self) -> u64 {
        let h = 2u64;
        h = ((h << 5) | (h >> 59)) ^ self.0.hash();
        h = ((h << 5) | (h >> 59)) ^ self.1.hash();
        return h;
    }
}

