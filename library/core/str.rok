// rok::core::str — `str` methods and trait impls (stdlib 2.15).
//
// `str` is a `(ptr, len)` value: literals are static bytes, strings
// built at run time are GC objects. The bodies call the runtime's
// `rok_str_*` symbols, which take `str` by value.
//
// `str` is immutable (spec 2.15.1); `StrBuf` is the growable buffer.

extern "C" {
    fn rok_str_len(s: str) -> usize;
    fn rok_str_concat(a: str, b: str) -> str;
    fn rok_str_cmp(a: str, b: str) -> i32;
    fn rok_str_slice(s: str, start: usize, end: usize) -> str;
    fn rok_str_find(s: str, pat: str) -> isize;
    fn rok_str_rfind(s: str, pat: str) -> isize;
    fn rok_str_trim(s: str, which: i32) -> str;
    fn rok_str_case(s: str, upper: i32) -> str;
    fn rok_str_replace(s: str, from: str, to: str) -> str;
    fn rok_str_char_count(s: str) -> usize;
    fn rok_str_hash(s: str) -> u64;
    fn rok_str_byte(s: str, i: usize) -> u8;
    fn rok_str_int_status(s: str, signed: i32, bits: u32) -> i32;
    fn rok_str_to_i64(s: str) -> i64;
    fn rok_str_to_u64(s: str) -> u64;
    fn rok_str_float_ok(s: str) -> i32;
    fn rok_str_to_f64(s: str) -> f64;
    fn rok_str_from_char(c: u32) -> str;
    fn rok_str_from_buf(buf: GcBuf<u8>, off: usize, len: usize) -> str;
    fn rok_buf_put_str(buf: GcBuf<u8>, off: usize, s: str);
    fn rok_str_utf8_error(s: str) -> isize;
}

impl str {
    pub fn new() -> str { return ""; }

    /// `bytes` as a `str`; throws if they are not UTF-8 (2.15.6).
    pub fn from_utf8(bytes: List<u8>) throws (Utf8Error) -> str {
        let buf = StrBuf::with_capacity(bytes.len());
        for b in bytes { buf.push_byte(b); }
        return try buf.to_str_checked();
    }

    /// A copy of the UTF-8 bytes. ponytail: spec returns a `Slice<u8>`
    /// view; there is no `Slice` yet.
    pub fn as_bytes(self) -> List<u8> {
        let out: List<u8> = List::with_capacity(self.len());
        for b in self.bytes() { out.push(b); }
        return out;
    }

    /// Byte length (not the char count).
    pub fn len(self) -> usize { return unsafe { rok_str_len(self) }; }
    pub fn is_empty(self) -> bool { return unsafe { rok_str_len(self) } == 0; }
    /// Number of chars (`s.chars().count()` in the spec).
    pub fn char_count(self) -> usize { return unsafe { rok_str_char_count(self) }; }

    /// `s[start:end]` by byte offsets; panics off a char boundary.
    pub fn slice(self, start: usize, end: usize) -> str {
        return unsafe { rok_str_slice(self, start, end) };
    }

    pub fn contains(self, pat: str) -> bool { return unsafe { rok_str_find(self, pat) } >= 0; }
    pub fn starts_with(self, pat: str) -> bool {
        if unsafe { rok_str_len(pat) } > unsafe { rok_str_len(self) } { return false; }
        return unsafe { rok_str_cmp(rok_str_slice(self, 0, rok_str_len(pat)), pat) } == 0;
    }
    pub fn ends_with(self, pat: str) -> bool {
        let n = unsafe { rok_str_len(self) };
        let m = unsafe { rok_str_len(pat) };
        if m > n { return false; }
        return unsafe { rok_str_cmp(rok_str_slice(self, n - m, n), pat) } == 0;
    }
    pub fn find(self, pat: str) -> usize | none {
        let i = unsafe { rok_str_find(self, pat) };
        if i < 0 { return none; }
        return i as usize;
    }
    pub fn rfind(self, pat: str) -> usize | none {
        let i = unsafe { rok_str_rfind(self, pat) };
        if i < 0 { return none; }
        return i as usize;
    }

    pub fn trim(self) -> str { return unsafe { rok_str_trim(self, 0) }; }
    pub fn trim_start(self) -> str { return unsafe { rok_str_trim(self, 1) }; }
    pub fn trim_end(self) -> str { return unsafe { rok_str_trim(self, 2) }; }

    // ponytail: ASCII case mapping only.
    pub fn to_lowercase(self) -> str { return unsafe { rok_str_case(self, 0) }; }
    pub fn to_uppercase(self) -> str { return unsafe { rok_str_case(self, 1) }; }
    pub fn replace(self, from: str, to: str) -> str { return unsafe { rok_str_replace(self, from, to) }; }

    /// Unicode scalar values, in order.
    pub fn chars(self) -> CharsIter { return CharsIter { s: self, pos: 0 }; }
    /// UTF-8 bytes, in order.
    pub fn bytes(self) -> BytesIter { return BytesIter { s: self, pos: 0 }; }
    /// The pieces between occurrences of `sep` (all of them, empty ones
    /// included).
    pub fn split(self, sep: str) -> SplitIter { return SplitIter { rest: self, sep: sep, done: false }; }
    /// Lines without their `\n` / `\r\n`; a final line ending adds no
    /// empty line.
    pub fn lines(self) -> LinesIter { return LinesIter { rest: self }; }
    /// `(byte offset, char)` pairs.
    pub fn char_indices(self) -> CharIndicesIter {
        return CharIndicesIter { chars: CharsIter { s: self, pos: 0 } };
    }
    /// The non-empty pieces between runs of whitespace.
    // ponytail: ASCII whitespace, like `trim`.
    pub fn split_whitespace(self) -> SplitWhitespaceIter {
        return SplitWhitespaceIter { s: self, pos: 0 };
    }

    /// `T`'s value spelled by this string (stdlib 2.15.7).
    pub fn parse<T: FromStr>(self) throws (T::Err) -> T { return try T::from_str(self); }
}

impl Add for str {
    type Output = str;
    fn add(self, rhs: str) -> str { return unsafe { rok_str_concat(self, rhs) }; }
}

impl PartialEq for str {
    fn eq(self, rhs: str) -> bool { return unsafe { rok_str_cmp(self, rhs) } == 0; }
    fn ne(self, rhs: str) -> bool { return unsafe { rok_str_cmp(self, rhs) } != 0; }
}

impl PartialOrd for str {
    fn lt(self, rhs: str) -> bool { return unsafe { rok_str_cmp(self, rhs) } < 0; }
    fn gt(self, rhs: str) -> bool { return unsafe { rok_str_cmp(self, rhs) } > 0; }
    fn le(self, rhs: str) -> bool { return unsafe { rok_str_cmp(self, rhs) } <= 0; }
    fn ge(self, rhs: str) -> bool { return unsafe { rok_str_cmp(self, rhs) } >= 0; }
}

impl Eq for str {}

impl Ord for str {
    fn cmp(self, other: str) -> Ordering {
        let c = unsafe { rok_str_cmp(self, other) };
        if c < 0 { return Ordering::Less; }
        if c > 0 { return Ordering::Greater; }
        return Ordering::Equal;
    }
}

/// Byte-wise FNV-1a, so `str` keys work in `Dict` / `Set`.
impl Hash for str {
    fn hash(self) -> u64 { return unsafe { rok_str_hash(self) }; }
}

// ---- iterators (stdlib 2.15.3) ----

pub struct CharsIter {
    s: str;
    pos: usize;
}

impl Iterator for CharsIter {
    type Item = char;
    fn next(ref self) -> char | none {
        if self.pos >= self.s.len() { return none; }
        let b = unsafe { rok_str_byte(self.s, self.pos) } as u32;
        let n = 1usize;
        let c = b;
        if b >= 0xF0u32 {
            n = 4usize;
            c = b & 0x07u32;
        } else if b >= 0xE0u32 {
            n = 3usize;
            c = b & 0x0Fu32;
        } else if b >= 0xC0u32 {
            n = 2usize;
            c = b & 0x1Fu32;
        }
        let i = 1usize;
        while i < n {
            let cont = unsafe { rok_str_byte(self.s, self.pos + i) } as u32;
            c = (c << 6u32) | (cont & 0x3Fu32);
            i += 1;
        }
        self.pos += n;
        return c as char;
    }
}

pub struct BytesIter {
    s: str;
    pos: usize;
}

impl Iterator for BytesIter {
    type Item = u8;
    fn next(ref self) -> u8 | none {
        if self.pos >= self.s.len() { return none; }
        let b = unsafe { rok_str_byte(self.s, self.pos) };
        self.pos += 1;
        return b;
    }
}

pub struct SplitIter {
    rest: str;
    sep: str;
    done: bool;
}

impl Iterator for SplitIter {
    type Item = str;
    fn next(ref self) -> str | none {
        if self.done { return none; }
        let at = unsafe { rok_str_find(self.rest, self.sep) };
        if at < 0 || self.sep.len() == 0 {
            self.done = true;
            return self.rest;
        }
        let i = at as usize;
        let piece = self.rest.slice(0, i);
        self.rest = self.rest.slice(i + self.sep.len(), self.rest.len());
        return piece;
    }
}

pub struct LinesIter {
    rest: str;
}

impl Iterator for LinesIter {
    type Item = str;
    fn next(ref self) -> str | none {
        if self.rest.len() == 0 { return none; }
        let at = unsafe { rok_str_find(self.rest, "\n") };
        let line = self.rest;
        if at < 0 {
            self.rest = "";
        } else {
            let i = at as usize;
            line = self.rest.slice(0, i);
            self.rest = self.rest.slice(i + 1, self.rest.len());
        }
        if line.ends_with("\r") { return line.slice(0, line.len() - 1); }
        return line;
    }
}

pub struct CharIndicesIter {
    chars: CharsIter;
}

impl Iterator for CharIndicesIter {
    type Item = (usize, char);
    fn next(ref self) -> (usize, char) | none {
        let at = self.chars.pos;
        let c = self.chars.next()?;
        return (at, c);
    }
}

fn is_ascii_space(b: u8) -> bool {
    return b == 32u8 || (b >= 9u8 && b <= 13u8);
}

pub struct SplitWhitespaceIter {
    s: str;
    pos: usize;
}

impl Iterator for SplitWhitespaceIter {
    type Item = str;
    fn next(ref self) -> str | none {
        let n = self.s.len();
        while self.pos < n && is_ascii_space(unsafe { rok_str_byte(self.s, self.pos) }) {
            self.pos += 1;
        }
        if self.pos >= n { return none; }
        let start = self.pos;
        while self.pos < n && !is_ascii_space(unsafe { rok_str_byte(self.s, self.pos) }) {
            self.pos += 1;
        }
        return self.s.slice(start, self.pos);
    }
}

// ---- StrBuf (stdlib 2.15.2) ----

/// A growable UTF-8 buffer. A handle like the collections: copies
/// share the buffer. `meta` = `[len, capacity]`, `data[0]` = bytes.
pub struct StrBuf {
    meta: GcBuf<usize>;
    data: GcBuf<GcBuf<u8>>;
}

impl StrBuf {
    pub fn new() -> StrBuf { return StrBuf::with_capacity(16); }

    pub fn with_capacity(cap: usize) -> StrBuf {
        let meta: GcBuf<usize> = buf_new(2);
        buf_set(meta, 1, cap);
        let data: GcBuf<GcBuf<u8>> = buf_new(1);
        let store: GcBuf<u8> = buf_new(cap);
        buf_set(data, 0, store);
        return StrBuf { meta: meta, data: data };
    }

    /// Byte length.
    pub fn len(self) -> usize { return buf_get(self.meta, 0); }
    pub fn is_empty(self) -> bool { return self.len() == 0; }
    pub fn capacity(self) -> usize { return buf_get(self.meta, 1); }
    pub fn clear(self) { buf_set(self.meta, 0, 0); }

    /// Room for `additional` more bytes (doubling).
    pub fn reserve(self, additional: usize) {
        let n = self.len();
        let cap = self.capacity();
        if n + additional <= cap { return; }
        let new_cap = cap * 2;
        if new_cap < n + additional { new_cap = n + additional; }
        let old: GcBuf<u8> = buf_get(self.data, 0);
        let store: GcBuf<u8> = buf_new(new_cap);
        unsafe { rok_buf_put_str(store, 0, rok_str_from_buf(old, 0, n)) };
        buf_set(self.data, 0, store);
        buf_set(self.meta, 1, new_cap);
    }

    /// Append `c`, UTF-8 encoded.
    pub fn push(self, c: char) {
        let v = c as u32;
        if v < 0x80u32 {
            self.push_byte(v as u8);
        } else if v < 0x800u32 {
            self.push_byte((0xC0u32 | (v >> 6u32)) as u8);
            self.push_byte((0x80u32 | (v & 0x3Fu32)) as u8);
        } else if v < 0x10000u32 {
            self.push_byte((0xE0u32 | (v >> 12u32)) as u8);
            self.push_byte((0x80u32 | ((v >> 6u32) & 0x3Fu32)) as u8);
            self.push_byte((0x80u32 | (v & 0x3Fu32)) as u8);
        } else {
            self.push_byte((0xF0u32 | (v >> 18u32)) as u8);
            self.push_byte((0x80u32 | ((v >> 12u32) & 0x3Fu32)) as u8);
            self.push_byte((0x80u32 | ((v >> 6u32) & 0x3Fu32)) as u8);
            self.push_byte((0x80u32 | (v & 0x3Fu32)) as u8);
        }
    }

    pub fn push_str(self, s: str) {
        let m = s.len();
        if m == 0 { return; }
        self.reserve(m);
        let n = self.len();
        unsafe { rok_buf_put_str(buf_get(self.data, 0), n, s) };
        buf_set(self.meta, 0, n + m);
    }

    /// Append one raw byte. ponytail: not in spec 2.15; it can break
    /// UTF-8, so `to_str` callers that push raw bytes go through
    /// `to_str_checked` (`str::from_utf8`) instead.
    pub fn push_byte(self, b: u8) {
        self.reserve(1);
        let n = self.len();
        buf_set(buf_get(self.data, 0), n, b);
        buf_set(self.meta, 0, n + 1);
    }

    /// The current contents as an immutable `str` (a copy).
    pub fn to_str(self) -> str {
        return unsafe { rok_str_from_buf(buf_get(self.data, 0), 0, self.len()) };
    }

    /// `to_str`, throwing if raw bytes made the contents invalid UTF-8.
    pub fn to_str_checked(self) throws (Utf8Error) -> str {
        let s = self.to_str();
        let at = unsafe { rok_str_utf8_error(s) };
        if at >= 0 { throw Utf8Error { valid_up_to: at as usize }; }
        return s;
    }
}

impl Display for StrBuf {
    fn display(self) -> str { return self.to_str(); }
}

/// Bytes that are not UTF-8 (`str::from_utf8`).
pub struct Utf8Error {
    pub valid_up_to: usize;
}

impl Display for Utf8Error {
    fn display(self) -> str { return f"invalid UTF-8 at byte {self.valid_up_to}"; }
}

impl Debug for Utf8Error {
    fn debug(self) -> str { return "Utf8Error(" + self.display() + ")"; }
}

impl Error for Utf8Error {}

// ---- FromStr (stdlib 2.15.7) ----

/// `str.parse::<T>()` dispatch.
pub trait FromStr {
    type Err;
    fn from_str(s: str) throws (Err) -> Self;
}

/// `s` checked as an integer of `bits` bits.
fn int_ok(s: str, signed: i32, bits: u32) throws (ParseError) {
    let st = unsafe { rok_str_int_status(s, signed, bits) };
    if st == 1 { throw ParseError { input: s, pos: 0, reason: "empty string" }; }
    if st == 2 { throw ParseError { input: s, pos: 0, reason: "invalid digit" }; }
    if st == 3 { throw ParseError { input: s, pos: 0, reason: "number out of range" }; }
}

fn signed_of(s: str, bits: u32) throws (ParseError) -> i64 {
    try int_ok(s, 1, bits);
    return unsafe { rok_str_to_i64(s) };
}

fn unsigned_of(s: str, bits: u32) throws (ParseError) -> u64 {
    try int_ok(s, 0, bits);
    return unsafe { rok_str_to_u64(s) };
}

fn float_of(s: str) throws (ParseError) -> f64 {
    if unsafe { rok_str_float_ok(s) } == 0 {
        throw ParseError { input: s, pos: 0, reason: "invalid float literal" };
    }
    return unsafe { rok_str_to_f64(s) };
}

impl FromStr for i8 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> i8 { return (try signed_of(s, 8)) as i8; }
}
impl FromStr for i16 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> i16 { return (try signed_of(s, 16)) as i16; }
}
impl FromStr for i32 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> i32 { return (try signed_of(s, 32)) as i32; }
}
impl FromStr for i64 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> i64 { return try signed_of(s, 64); }
}
impl FromStr for isize {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> isize { return (try signed_of(s, 64)) as isize; }
}
impl FromStr for u8 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> u8 { return (try unsigned_of(s, 8)) as u8; }
}
impl FromStr for u16 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> u16 { return (try unsigned_of(s, 16)) as u16; }
}
impl FromStr for u32 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> u32 { return (try unsigned_of(s, 32)) as u32; }
}
impl FromStr for u64 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> u64 { return try unsigned_of(s, 64); }
}
impl FromStr for usize {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> usize { return (try unsigned_of(s, 64)) as usize; }
}
impl FromStr for f64 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> f64 { return try float_of(s); }
}
impl FromStr for f32 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> f32 { return (try float_of(s)) as f32; }
}
impl FromStr for bool {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> bool {
        if s == "true" { return true; }
        if s == "false" { return false; }
        throw ParseError { input: s, pos: 0, reason: "expected `true` or `false`" };
    }
}
impl FromStr for char {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> char {
        let it = s.chars();
        let first = it.next();
        if s.len() == 0 { throw ParseError { input: s, pos: 0, reason: "empty string" }; }
        if it.next() is char { throw ParseError { input: s, pos: 0, reason: "too many characters" }; }
        return first ?? ' ';
    }
}
impl FromStr for str {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> str { return s; }
}
