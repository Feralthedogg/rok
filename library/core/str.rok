// rok::core::str — `str` methods and trait impls (stdlib 2.15).
//
// `str` is a `(ptr, len)` value: literals are static bytes, strings
// built at run time are GC objects, and a slice shares its source's
// bytes (so slicing, `lines`, `split*`, `trim*` and `strip_*` copy
// nothing). The bodies call the runtime's `rok_str_*` symbols, which
// take `str` by value.
//
// `str` is immutable (spec 2.15.1); `StrBuf` is the growable buffer.

impl str {
    pub fn new() -> str { "" }

    /// `bytes` as a `str`; throws if they are not UTF-8 (2.15.6).
    pub fn from_utf8(bytes: List<u8> | Slice<u8>) throws (Utf8Error) -> str {
        let view = match bytes {
            l: List<u8> => l[0:l.len()],
            v: Slice<u8> => v,
        };
        let (buf, at, n) = unsafe { view.raw_parts() };
        let bad = unsafe { rok_buf_utf8_error(buf, at, n) };
        if bad >= 0 { throw Utf8Error { valid_up_to: bad as usize }; }
        unsafe { rok_str_from_buf(buf, at, n) }
    }

    /// The UTF-8 bytes as a read-only view of the string itself (no
    /// copy, O(1)).
    pub fn as_bytes(self) -> Slice<u8> {
        Slice { buf: unsafe { rok_str_bytes_buf(self) }, start: 0, len: self.len(), stride: 1 }
    }

    /// Byte `i`, O(1); panics if `i >= len()`.
    pub fn byte(self, i: usize) -> u8 {
        if i >= self.len() { panic(f"str byte index {i} out of bounds for length {self.len()}"); }
        unsafe { rok_str_byte(self, i) }
    }

    /// Byte length (not the char count).
    pub fn len(self) -> usize { unsafe { rok_str_len(self) } }
    pub fn is_empty(self) -> bool { unsafe { rok_str_len(self) } == 0 }
    /// Number of chars (`s.chars().count()` in the spec).
    pub fn char_count(self) -> usize { unsafe { rok_str_char_count(self) } }

    pub fn contains(self, pat: str) -> bool { unsafe { rok_str_find(self, pat) } >= 0 }
    pub fn starts_with(self, pat: str) -> bool { unsafe { rok_str_eq_at(self, 0, pat) } != 0 }
    pub fn ends_with(self, pat: str) -> bool {
        let n = self.len();
        let m = pat.len();
        m <= n && unsafe { rok_str_eq_at(self, n - m, pat) } != 0
    }
    pub fn find(self, pat: str) -> usize | none {
        let i = unsafe { rok_str_find(self, pat) };
        if i < 0 { return none; }
        i as usize
    }
    pub fn rfind(self, pat: str) -> usize | none {
        let i = unsafe { rok_str_rfind(self, pat) };
        if i < 0 { return none; }
        i as usize
    }

    /// `self` without a leading `prefix`, or `none` if it does not start
    /// with it.
    pub fn strip_prefix(self, prefix: str) -> str | none {
        if !self.starts_with(prefix) { return none; }
        self[prefix.len():]
    }
    /// `self` without a trailing `suffix`, or `none`.
    pub fn strip_suffix(self, suffix: str) -> str | none {
        if !self.ends_with(suffix) { return none; }
        self[:self.len() - suffix.len()]
    }
    /// The pieces before and after the first `sep`, or `none`.
    pub fn split_once(self, sep: str) -> (str, str) | none {
        let i = self.find(sep)?;
        (self[:i], self[i + sep.len():])
    }
    /// `n` copies back to back.
    pub fn repeat(self, n: usize) -> str {
        let b = StrBuf::with_capacity(self.len() * n);
        for _ in 0..n { b.push_str(self); }
        b.to_str()
    }

    pub fn trim(self) -> str { unsafe { rok_str_trim(self, 0) } }
    pub fn trim_start(self) -> str { unsafe { rok_str_trim(self, 1) } }
    pub fn trim_end(self) -> str { unsafe { rok_str_trim(self, 2) } }

    /// Full Unicode case mapping (`"ß"` → `"SS"`, final `σ` → `ς`); no
    /// locale rules.
    pub fn to_lowercase(self) -> str { unsafe { rok_str_case(self, 0) } }
    pub fn to_uppercase(self) -> str { unsafe { rok_str_case(self, 1) } }
    pub fn replace(self, from: str, to: str) -> str { unsafe { rok_str_replace(self, from, to) } }

    /// Unicode scalar values, in order.
    pub fn chars(self) -> CharsIter { CharsIter { s: self, pos: 0 } }
    /// UTF-8 bytes, in order.
    pub fn bytes(self) -> SliceIter<u8> { self.as_bytes().iter() }
    /// The pieces between occurrences of `sep` (all of them, empty ones
    /// included).
    pub fn split(self, sep: str) -> SplitIter { SplitIter { rest: self, sep: sep, done: false } }
    /// Lines without their `\n` / `\r\n`; a final line ending adds no
    /// empty line.
    pub fn lines(self) -> LinesIter { LinesIter { rest: self } }
    /// `(byte offset, char)` pairs.
    pub fn char_indices(self) -> CharIndicesIter {
        CharIndicesIter { chars: CharsIter { s: self, pos: 0 } }
    }
    /// The non-empty pieces between runs of ASCII whitespace (like `trim`).
    pub fn split_whitespace(self) -> SplitWhitespaceIter {
        SplitWhitespaceIter { s: self, pos: 0 }
    }

    /// `T`'s value spelled by this string (stdlib 2.15.7).
    pub fn parse<T: FromStr>(self) throws (T::Err) -> T { try T::from_str(self) }
}

/// `s[a:b]` by byte offsets (2.15.3): O(1), sharing `s`'s bytes. The
/// bounds clamp to the length (like Python); a clamped bound off a char
/// boundary panics.
impl Sliceable<Range<usize>> for str {
    type Output = str;
    #[track_caller]
    fn slice(self, r: Range<usize>) -> str {
        let r = clamp_range(r, self.len());
        unsafe { rok_str_slice(self, r.start, r.end) }
    }
}

impl Add for str {
    type Output = str;
    fn add(self, rhs: str) -> str { unsafe { rok_str_concat(self, rhs) } }
}

impl PartialEq for str {
    fn eq(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } == 0 }
    fn ne(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } != 0 }
}

impl PartialOrd for str {
    fn lt(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } < 0 }
    fn gt(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } > 0 }
    fn le(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } <= 0 }
    fn ge(self, rhs: str) -> bool { unsafe { rok_str_cmp(self, rhs) } >= 0 }
}

impl Eq for str {}

impl Ord for str {
    fn cmp(self, other: str) -> Ordering {
        let c = unsafe { rok_str_cmp(self, other) };
        if c < 0 { return Ordering::Less; }
        if c > 0 { return Ordering::Greater; }
        Ordering::Equal
    }
}

/// Byte-wise FNV-1a, so `str` keys work in `Dict` / `Set`.
impl Hash for str {
    fn hash(self) -> u64 { unsafe { rok_str_hash(self) } }
}

// ---- iterators (stdlib 2.15.3) ----

pub struct CharsIter {
    s: str;
    pos: usize;
}

impl Iterator for CharsIter {
    type Item = char;
    fn next(ref self) -> char | none {
        if self.pos >= self.s.len() { return none; }
        let b = unsafe { rok_str_byte(self.s, self.pos) } as u32;
        let n = 1usize;
        let c = b;
        if b >= 0xF0u32 {
            n = 4usize;
            c = b & 0x07u32;
        } else if b >= 0xE0u32 {
            n = 3usize;
            c = b & 0x0Fu32;
        } else if b >= 0xC0u32 {
            n = 2usize;
            c = b & 0x1Fu32;
        }
        for i in 1..n {
            let cont = unsafe { rok_str_byte(self.s, self.pos + i) } as u32;
            c = (c << 6u32) | (cont & 0x3Fu32);
        }
        self.pos += n;
        unsafe { char::from_u32_unchecked(c) }
    }
}

pub struct SplitIter {
    rest: str;
    sep: str;
    done: bool;
}

impl Iterator for SplitIter {
    type Item = str;
    fn next(ref self) -> str | none {
        if self.done { return none; }
        let at = unsafe { rok_str_find(self.rest, self.sep) };
        if at < 0 || self.sep.len() == 0 {
            self.done = true;
            return self.rest;
        }
        let i = at as usize;
        let piece = self.rest[:i];
        self.rest = self.rest[i + self.sep.len():];
        piece
    }
}

pub struct LinesIter {
    rest: str;
}

impl Iterator for LinesIter {
    type Item = str;
    fn next(ref self) -> str | none {
        if self.rest.len() == 0 { return none; }
        let at = unsafe { rok_str_find(self.rest, "\n") };
        let line = self.rest;
        if at < 0 {
            self.rest = "";
        } else {
            let i = at as usize;
            line = self.rest[:i];
            self.rest = self.rest[i + 1:];
        }
        if line.ends_with("\r") { return line[:line.len() - 1]; }
        line
    }
}

pub struct CharIndicesIter {
    chars: CharsIter;
}

impl Iterator for CharIndicesIter {
    type Item = (usize, char);
    fn next(ref self) -> (usize, char) | none {
        let at = self.chars.pos;
        let c = self.chars.next()?;
        (at, c)
    }
}

fn is_ascii_space(b: u8) -> bool {
    b == 32u8 || (b >= 9u8 && b <= 13u8)
}

pub struct SplitWhitespaceIter {
    s: str;
    pos: usize;
}

impl Iterator for SplitWhitespaceIter {
    type Item = str;
    fn next(ref self) -> str | none {
        let n = self.s.len();
        while self.pos < n && is_ascii_space(unsafe { rok_str_byte(self.s, self.pos) }) {
            self.pos += 1;
        }
        if self.pos >= n { return none; }
        let start = self.pos;
        while self.pos < n && !is_ascii_space(unsafe { rok_str_byte(self.s, self.pos) }) {
            self.pos += 1;
        }
        self.s[start:self.pos]
    }
}

// ---- char (stdlib 2.15.4) ----
//
// The Unicode properties and case maps are runtime tables generated
// from the UCD (`runtime/rokr/gen_unicode.py`).

fn char_props(c: char) -> u32 { unsafe { rok_char_props(c as u32) } }

/// The bits of a `char` (`char::from_u32_unchecked`).
union CharBits {
    n: u32;
    c: char;
}

impl char {
    /// `n` as a char; `none` for a surrogate or a value past U+10FFFF.
    /// (`as char` takes only a `u8`.)
    pub fn from_u32(n: u32) -> char | none {
        if (n >= 0xD800u32 && n <= 0xDFFFu32) || n > 0x10FFFFu32 {
            return none;
        }
        unsafe { char::from_u32_unchecked(n) }
    }

    /// `n` as a char, unchecked: `n` must be a Unicode scalar value.
    pub unsafe fn from_u32_unchecked(n: u32) -> char {
        let b = CharBits { n: n };
        unsafe { b.c }
    }

    /// Digit `d` in base `radix` (2..=36; lowercase letters past `9`).
    /// Panics if `d` is not a digit of that base.
    #[track_caller]
    pub fn from_digit(d: u32, radix: u32) -> char {
        if radix < 2u32 || radix > 36u32 { panic("char::from_digit: radix must be in 2..=36"); }
        if d >= radix { panic("char::from_digit: not a digit of the radix"); }
        if d < 10u32 { return (0x30u8 + d as u8) as char; }
        (0x61u8 + d as u8 - 10u8) as char
    }

    /// The value of this digit in base `radix` (2..=36, either letter
    /// case); throws if it is not one.
    pub fn to_digit(self, radix: u32) throws (ValueError) -> u32 {
        if radix < 2u32 || radix > 36u32 { throw ValueError { msg: "radix must be in 2..=36" }; }
        let c = self as u32;
        let d = 99u32;
        if c >= 0x30u32 && c <= 0x39u32 {
            d = c - 0x30u32;
        } else if c >= 0x61u32 && c <= 0x7Au32 {
            d = c - 0x61u32 + 10u32;
        } else if c >= 0x41u32 && c <= 0x5Au32 {
            d = c - 0x41u32 + 10u32;
        }
        if d >= radix { throw ValueError { msg: f"{self.debug()} is not a base-{radix} digit" }; }
        d
    }

    pub fn is_digit(self, radix: u32) -> bool {
        try { self.to_digit(radix); true } catch _ { false }
    }

    /// Bytes in UTF-8.
    pub fn len_utf8(self) -> usize {
        let c = self as u32;
        if c < 0x80u32 { return 1; }
        if c < 0x800u32 { return 2; }
        if c < 0x10000u32 { return 3; }
        4
    }

    /// 16-bit units in UTF-16.
    pub fn len_utf16(self) -> usize {
        if (self as u32) < 0x10000u32 { return 1; }
        2
    }

    pub fn is_alphabetic(self) -> bool { char_props(self) & 1u32 != 0u32 }
    pub fn is_lowercase(self) -> bool { char_props(self) & 2u32 != 0u32 }
    pub fn is_uppercase(self) -> bool { char_props(self) & 4u32 != 0u32 }
    /// Unicode `White_Space`.
    pub fn is_whitespace(self) -> bool { char_props(self) & 8u32 != 0u32 }
    /// General category `Nd`, `Nl` or `No`.
    pub fn is_numeric(self) -> bool { char_props(self) & 16u32 != 0u32 }
    pub fn is_alphanumeric(self) -> bool { char_props(self) & 17u32 != 0u32 }
    /// General category `Cc`.
    pub fn is_control(self) -> bool {
        let c = self as u32;
        c < 0x20u32 || (c >= 0x7Fu32 && c < 0xA0u32)
    }

    /// The simple (one-char) lowercase mapping; `self` if none. Strings
    /// map fully with `str::to_lowercase`.
    pub fn to_lowercase(self) -> char {
        unsafe { char::from_u32_unchecked(rok_char_to_case(self as u32, 0)) }
    }
    /// The simple (one-char) uppercase mapping (`'ß'` stays `'ß'`; `"ß"`
    /// becomes `"SS"` through `str::to_uppercase`).
    pub fn to_uppercase(self) -> char {
        unsafe { char::from_u32_unchecked(rok_char_to_case(self as u32, 1)) }
    }

    pub fn is_ascii(self) -> bool { (self as u32) < 0x80u32 }
    pub fn is_ascii_uppercase(self) -> bool { self >= 'A' && self <= 'Z' }
    pub fn is_ascii_lowercase(self) -> bool { self >= 'a' && self <= 'z' }
    pub fn is_ascii_alphabetic(self) -> bool { self.is_ascii_uppercase() || self.is_ascii_lowercase() }
    pub fn is_ascii_digit(self) -> bool { self >= '0' && self <= '9' }
    pub fn is_ascii_alphanumeric(self) -> bool { self.is_ascii_alphabetic() || self.is_ascii_digit() }
    pub fn is_ascii_hexdigit(self) -> bool {
        self.is_ascii_digit() || (self >= 'a' && self <= 'f') || (self >= 'A' && self <= 'F')
    }
    /// Space, `\t`, `\n`, form feed, `\r`.
    pub fn is_ascii_whitespace(self) -> bool {
        self == ' ' || self == '\t' || self == '\n' || self == '\x0C' || self == '\r'
    }
    pub fn is_ascii_control(self) -> bool { (self as u32) < 0x20u32 || self == '\x7F' }
    /// `!` ..= `~` (printable, not space).
    pub fn is_ascii_graphic(self) -> bool { self >= '!' && self <= '~' }
    pub fn is_ascii_punctuation(self) -> bool { self.is_ascii_graphic() && !self.is_ascii_alphanumeric() }

    pub fn to_ascii_uppercase(self) -> char {
        if self.is_ascii_lowercase() { return ((self as u8) - 32u8) as char; }
        self
    }
    pub fn to_ascii_lowercase(self) -> char {
        if self.is_ascii_uppercase() { return ((self as u8) + 32u8) as char; }
        self
    }
    pub fn eq_ignore_ascii_case(self, other: char) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }
}

/// Code point order.
impl PartialOrd for char {
    fn lt(self, rhs: char) -> bool { (self as u32) < (rhs as u32) }
    fn le(self, rhs: char) -> bool { (self as u32) <= (rhs as u32) }
    fn gt(self, rhs: char) -> bool { (self as u32) > (rhs as u32) }
    fn ge(self, rhs: char) -> bool { (self as u32) >= (rhs as u32) }
}

impl Ord for char {
    fn cmp(self, other: char) -> Ordering { (self as u32).cmp(other as u32) }
}

/// `char::try_from(n)` (2.15.4): throws for a surrogate or a value past
/// U+10FFFF (`OverflowError`, as spec 2.15.4 says).
impl TryFrom<u32> for char {
    type Error = OverflowError;
    fn try_from(value: u32) throws (OverflowError) -> char {
        let c = char::from_u32(value);
        if c is char { return c; }
        throw OverflowError { op: "try_from", ty: "char" };
    }
}

// ---- StrBuf (stdlib 2.15.2) ----

/// A growable UTF-8 buffer. A handle like the collections: copies
/// share the buffer. `meta` = `[len, capacity]`, `data[0]` = bytes.
pub struct StrBuf {
    meta: GcBuf<usize>;
    data: GcBuf<GcBuf<u8>>;
}

impl StrBuf {
    pub fn new() -> StrBuf { StrBuf::with_capacity(16) }

    pub fn with_capacity(cap: usize) -> StrBuf {
        let meta: GcBuf<usize> = buf_new(2);
        meta[1] = cap;
        let data: GcBuf<GcBuf<u8>> = buf_new(1);
        data[0] = buf_new(cap);
        StrBuf { meta: meta, data: data }
    }

    /// Byte length.
    pub fn len(self) -> usize { self.meta[0] }
    pub fn is_empty(self) -> bool { self.len() == 0 }
    pub fn capacity(self) -> usize { self.meta[1] }
    pub fn clear(self) { self.meta[0] = 0; }

    /// Room for `additional` more bytes (doubling).
    pub fn reserve(self, additional: usize) {
        let n = self.len();
        let cap = self.capacity();
        if n + additional <= cap { return; }
        let new_cap = cap * 2;
        if new_cap < n + additional { new_cap = n + additional; }
        let store: GcBuf<u8> = buf_new(new_cap);
        unsafe { rok_buf_copy(store, 0, self.data[0], 0, n) };
        self.data[0] = store;
        self.meta[1] = new_cap;
    }

    /// Append `c`, UTF-8 encoded.
    pub fn push(self, c: char) {
        self.reserve(4);
        let n = self.len();
        self.meta[0] = n + unsafe { rok_buf_put_char(self.data[0], n, c as u32) };
    }

    pub fn push_str(self, s: str) {
        let m = s.len();
        if m == 0 { return; }
        self.reserve(m);
        let n = self.len();
        unsafe { rok_buf_put_str(self.data[0], n, s) };
        self.meta[0] = n + m;
    }

    /// Append one byte; the caller keeps the contents UTF-8.
    pub fn push_byte(self, b: u8) {
        self.reserve(1);
        let n = self.len();
        self.data[0][n] = b;
        self.meta[0] = n + 1;
    }

    /// The current contents as an immutable `str` (a copy).
    pub fn to_str(self) -> str {
        unsafe { rok_str_from_buf(self.data[0], 0, self.len()) }
    }
}

/// `b[a:b]`: the bytes `a..b` of the current contents as a `str`, checked
/// like `str` slicing (clamped). Copies the whole buffer first.
impl Sliceable<Range<usize>> for StrBuf {
    type Output = str;
    #[track_caller]
    fn slice(self, r: Range<usize>) -> str {
        self.to_str()[r.start:r.end]
    }
}

impl Display for StrBuf {
    fn display(self) -> str { self.to_str() }
}

/// Bytes that are not UTF-8 (`str::from_utf8`).
pub struct Utf8Error {
    pub valid_up_to: usize;
}

impl Display for Utf8Error {
    fn display(self) -> str { f"invalid UTF-8 at byte {self.valid_up_to}" }
}

impl Debug for Utf8Error {
    fn debug(self) -> str { f"Utf8Error({self})" }
}

impl Error for Utf8Error {}

// ---- FromStr (stdlib 2.15.7) ----

/// `str.parse::<T>()` dispatch.
pub trait FromStr {
    type Err;
    fn from_str(s: str) throws (Err) -> Self;
}

/// `s` as a decimal integer of `bits` bits (its bits as `i64`).
fn int_of(s: str, signed: i32, bits: u32) throws (ParseError) -> i64 {
    let out: GcBuf<i64> = buf_new(1);
    let st = unsafe { rok_str_parse_int(s, 10u32, signed, bits, out) };
    if st == 1 { throw ParseError { input: s, pos: 0, reason: "empty string" }; }
    if st == 2 { throw ParseError { input: s, pos: 0, reason: "invalid digit" }; }
    if st == 3 { throw ParseError { input: s, pos: 0, reason: "number out of range" }; }
    out[0]
}

fn signed_of(s: str, bits: u32) throws (ParseError) -> i64 { try int_of(s, 1, bits) }

fn unsigned_of(s: str, bits: u32) throws (ParseError) -> u64 { (try int_of(s, 0, bits)) as u64 }

fn float_of(s: str) throws (ParseError) -> f64 {
    let out: GcBuf<f64> = buf_new(1);
    if unsafe { rok_str_parse_float(s, out) } != 0 {
        throw ParseError { input: s, pos: 0, reason: "invalid float literal" };
    }
    out[0]
}

impl FromStr for i8 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> i8 { (try signed_of(s, 8)) as i8 }
}
impl FromStr for i16 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> i16 { (try signed_of(s, 16)) as i16 }
}
impl FromStr for i32 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> i32 { (try signed_of(s, 32)) as i32 }
}
impl FromStr for i64 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> i64 { try signed_of(s, 64) }
}
impl FromStr for isize {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> isize { (try signed_of(s, 64)) as isize }
}
impl FromStr for u8 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> u8 { (try unsigned_of(s, 8)) as u8 }
}
impl FromStr for u16 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> u16 { (try unsigned_of(s, 16)) as u16 }
}
impl FromStr for u32 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> u32 { (try unsigned_of(s, 32)) as u32 }
}
impl FromStr for u64 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> u64 { try unsigned_of(s, 64) }
}
impl FromStr for usize {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> usize { (try unsigned_of(s, 64)) as usize }
}
impl FromStr for f64 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> f64 { try float_of(s) }
}
impl FromStr for f32 {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> f32 { (try float_of(s)) as f32 }
}
impl FromStr for bool {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> bool {
        if s == "true" { return true; }
        if s == "false" { return false; }
        throw ParseError { input: s, pos: 0, reason: "expected `true` or `false`" };
    }
}
impl FromStr for char {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> char {
        let it = s.chars();
        let first = it.next();
        if s.len() == 0 { throw ParseError { input: s, pos: 0, reason: "empty string" }; }
        if it.next() is char { throw ParseError { input: s, pos: 0, reason: "too many characters" }; }
        first ?? ' '
    }
}
impl FromStr for str {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> str { s }
}
