    t[5] = s2 as u32;
    s1 = (t[7] as u64) + (a[7] as u64) * bi + c1;
    c1 = s1 >> 32u64;
    s2 = (s1 & 0xffffffffu64) + qm * 0xffffffffu64 + c2;
    c2 = s2 >> 32u64;
    t[6] = s2 as u32;
    s1 = (t[8] as u64) + (a[8] as u64) * bi + c1;
    c1 = s1 >> 32u64;
    s2 = (s1 & 0xffffffffu64) + qm * 0xffffffffu64 + c2;
    c2 = s2 >> 32u64;
    t[7] = s2 as u32;
    s1 = (t[9] as u64) + (a[9] as u64) * bi + c1;
    c1 = s1 >> 32u64;
    s2 = (s1 & 0xffffffffu64) + qm * 0xffffffffu64 + c2;
    c2 = s2 >> 32u64;
    t[8] = s2 as u32;
    s1 = (t[10] as u64) + (a[10] as u64) * bi + c1;
    c1 = s1 >> 32u64;
    s2 = (s1 & 0xffffffffu64) + qm * 0xffffffffu64 + c2;
    c2 = s2 >> 32u64;
    t[9] = s2 as u32;
    s1 = (t[11] as u64) + (a[11] as u64) * bi + c1;
    c1 = s1 >> 32u64;
    s2 = (s1 & 0xffffffffu64) + qm * 0xffffffffu64 + c2;
    c2 = s2 >> 32u64;
    t[10] = s2 as u32;
    s = (t[12] as u64) + c1 + c2;
    t[11] = s as u32;
    t[12] = (s >> 32u64) as u32;
    // t < 2p: subtract p if t[n] is set or t >= p.
    let d = fe_zero();
    let br = 0u64;
    let u = 0u64;
    u = (t[0] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[0] = u as u32;
    br = u >> 63u64;
    u = (t[1] as u64).wrapping_sub(0x00000000u64).wrapping_sub(br);
    d[1] = u as u32;
    br = u >> 63u64;
    u = (t[2] as u64).wrapping_sub(0x00000000u64).wrapping_sub(br);
    d[2] = u as u32;
    br = u >> 63u64;
    u = (t[3] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[3] = u as u32;
    br = u >> 63u64;
    u = (t[4] as u64).wrapping_sub(0xfffffffeu64).wrapping_sub(br);
    d[4] = u as u32;
    br = u >> 63u64;
    u = (t[5] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[5] = u as u32;
    br = u >> 63u64;
    u = (t[6] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[6] = u as u32;
    br = u >> 63u64;
    u = (t[7] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[7] = u as u32;
    br = u >> 63u64;
    u = (t[8] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[8] = u as u32;
    br = u >> 63u64;
    u = (t[9] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[9] = u as u32;
    br = u >> 63u64;
    u = (t[10] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[10] = u as u32;
    br = u >> 63u64;
    u = (t[11] as u64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[11] = u as u32;
    br = u >> 63u64;
    let mask = 0u32.wrapping_sub(t[12] | ((br as u32) ^ 1u32));
    d[0] = (d[0] & mask) | (t[0] & ~mask);
    d[1] = (d[1] & mask) | (t[1] & ~mask);
    d[2] = (d[2] & mask) | (t[2] & ~mask);
    d[3] = (d[3] & mask) | (t[3] & ~mask);
    d[4] = (d[4] & mask) | (t[4] & ~mask);
    d[5] = (d[5] & mask) | (t[5] & ~mask);
    d[6] = (d[6] & mask) | (t[6] & ~mask);
    d[7] = (d[7] & mask) | (t[7] & ~mask);
    d[8] = (d[8] & mask) | (t[8] & ~mask);
    d[9] = (d[9] & mask) | (t[9] & ~mask);
    d[10] = (d[10] & mask) | (t[10] & ~mask);
    d[11] = (d[11] & mask) | (t[11] & ~mask);
    d
}

/// `(a + b) mod p` for `a, b < p`.
pub(pkg) fn add_p384(a: Fe, b: Fe) -> Fe {
    let s = fe_zero();
    let d = fe_zero();
    let c = 0u64;
    let br = 0u64;
    let t = 0u64;
    let u = 0u64;
    t = (a[0] as u64) + (b[0] as u64) + c;
    s[0] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[0] = u as u32;
    br = u >> 63u64;
    t = (a[1] as u64) + (b[1] as u64) + c;
    s[1] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0x00000000u64).wrapping_sub(br);
    d[1] = u as u32;
    br = u >> 63u64;
    t = (a[2] as u64) + (b[2] as u64) + c;
    s[2] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0x00000000u64).wrapping_sub(br);
    d[2] = u as u32;
    br = u >> 63u64;
    t = (a[3] as u64) + (b[3] as u64) + c;
    s[3] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[3] = u as u32;
    br = u >> 63u64;
    t = (a[4] as u64) + (b[4] as u64) + c;
    s[4] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xfffffffeu64).wrapping_sub(br);
    d[4] = u as u32;
    br = u >> 63u64;
    t = (a[5] as u64) + (b[5] as u64) + c;
    s[5] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[5] = u as u32;
    br = u >> 63u64;
    t = (a[6] as u64) + (b[6] as u64) + c;
    s[6] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[6] = u as u32;
    br = u >> 63u64;
    t = (a[7] as u64) + (b[7] as u64) + c;
    s[7] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[7] = u as u32;
    br = u >> 63u64;
    t = (a[8] as u64) + (b[8] as u64) + c;
    s[8] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[8] = u as u32;
    br = u >> 63u64;
    t = (a[9] as u64) + (b[9] as u64) + c;
    s[9] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[9] = u as u32;
    br = u >> 63u64;
    t = (a[10] as u64) + (b[10] as u64) + c;
    s[10] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[10] = u as u32;
    br = u >> 63u64;
    t = (a[11] as u64) + (b[11] as u64) + c;
    s[11] = t as u32;
    c = t >> 32u64;
    u = (t & 0xffffffffu64).wrapping_sub(0xffffffffu64).wrapping_sub(br);
    d[11] = u as u32;
    br = u >> 63u64;
    // The difference when the sum overflowed or reached p.
    let mask = 0u32.wrapping_sub((c as u32) | ((br as u32) ^ 1u32));
    d[0] = (d[0] & mask) | (s[0] & ~mask);
    d[1] = (d[1] & mask) | (s[1] & ~mask);
    d[2] = (d[2] & mask) | (s[2] & ~mask);
    d[3] = (d[3] & mask) | (s[3] & ~mask);
    d[4] = (d[4] & mask) | (s[4] & ~mask);
    d[5] = (d[5] & mask) | (s[5] & ~mask);
    d[6] = (d[6] & mask) | (s[6] & ~mask);
    d[7] = (d[7] & mask) | (s[7] & ~mask);
    d[8] = (d[8] & mask) | (s[8] & ~mask);
    d[9] = (d[9] & mask) | (s[9] & ~mask);
    d[10] = (d[10] & mask) | (s[10] & ~mask);
    d[11] = (d[11] & mask) | (s[11] & ~mask);
    d
}

/// `(a - b) mod p` for `a, b < p`.
pub(pkg) fn sub_p384(a: Fe, b: Fe) -> Fe {
    let d = fe_zero();
    let br = 0u64;
    let u = 0u64;
    u = (a[0] as u64).wrapping_sub(b[0] as u64).wrapping_sub(br);
    d[0] = u as u32;
    br = u >> 63u64;
    u = (a[1] as u64).wrapping_sub(b[1] as u64).wrapping_sub(br);
    d[1] = u as u32;
    br = u >> 63u64;
    u = (a[2] as u64).wrapping_sub(b[2] as u64).wrapping_sub(br);
    d[2] = u as u32;
    br = u >> 63u64;
    u = (a[3] as u64).wrapping_sub(b[3] as u64).wrapping_sub(br);
    d[3] = u as u32;
    br = u >> 63u64;
    u = (a[4] as u64).wrapping_sub(b[4] as u64).wrapping_sub(br);
    d[4] = u as u32;
    br = u >> 63u64;
    u = (a[5] as u64).wrapping_sub(b[5] as u64).wrapping_sub(br);
    d[5] = u as u32;
    br = u >> 63u64;
    u = (a[6] as u64).wrapping_sub(b[6] as u64).wrapping_sub(br);
    d[6] = u as u32;
    br = u >> 63u64;
    u = (a[7] as u64).wrapping_sub(b[7] as u64).wrapping_sub(br);
    d[7] = u as u32;
    br = u >> 63u64;
    u = (a[8] as u64).wrapping_sub(b[8] as u64).wrapping_sub(br);
    d[8] = u as u32;
    br = u >> 63u64;
    u = (a[9] as u64).wrapping_sub(b[9] as u64).wrapping_sub(br);
    d[9] = u as u32;
    br = u >> 63u64;
    u = (a[10] as u64).wrapping_sub(b[10] as u64).wrapping_sub(br);
    d[10] = u as u32;
    br = u >> 63u64;
    u = (a[11] as u64).wrapping_sub(b[11] as u64).wrapping_sub(br);
    d[11] = u as u32;
    br = u >> 63u64;
    // Add p back on a borrow.
    let mask = 0u64.wrapping_sub(br);
    let c = 0u64;
    u = (d[0] as u64) + (0xffffffffu64 & mask) + c;
    d[0] = u as u32;
    c = u >> 32u64;
    u = (d[1] as u64) + (0x00000000u64 & mask) + c;
    d[1] = u as u32;
    c = u >> 32u64;
    u = (d[2] as u64) + (0x00000000u64 & mask) + c;
    d[2] = u as u32;
    c = u >> 32u64;
    u = (d[3] as u64) + (0xffffffffu64 & mask) + c;
    d[3] = u as u32;
    c = u >> 32u64;
    u = (d[4] as u64) + (0xfffffffeu64 & mask) + c;
    d[4] = u as u32;
    c = u >> 32u64;
    u = (d[5] as u64) + (0xffffffffu64 & mask) + c;
    d[5] = u as u32;
    c = u >> 32u64;
    u = (d[6] as u64) + (0xffffffffu64 & mask) + c;
    d[6] = u as u32;
    c = u >> 32u64;
    u = (d[7] as u64) + (0xffffffffu64 & mask) + c;
    d[7] = u as u32;
    c = u >> 32u64;
    u = (d[8] as u64) + (0xffffffffu64 & mask) + c;
    d[8] = u as u32;
    c = u >> 32u64;
    u = (d[9] as u64) + (0xffffffffu64 & mask) + c;
    d[9] = u as u32;
    c = u >> 32u64;
    u = (d[10] as u64) + (0xffffffffu64 & mask) + c;
    d[10] = u as u32;
    c = u >> 32u64;
    u = (d[11] as u64) + (0xffffffffu64 & mask) + c;
    d[11] = u as u32;
    c = u >> 32u64;
    d
}
