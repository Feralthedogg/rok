    let qm = 0u64;
    let s1 = 0u64;
    let s2 = 0u64;
    let c1 = 0u64;
    let c2 = 0u64;
    let s = 0u64;
    bi = b[0] as u64;
    qm = ((t[0] as u64) + (a[0] as u64) * bi) & 0xffffffffu64;
    s1 = (t[0] as u64) + (a[0] as u64) * bi;
    c1 = s1 >> 32u64;
    s2 = (s1 & 0xffffffffu64) + qm * 0xffffffffu64;
    c2 = s2 >> 32u64;
    s1 = (t[1] as u64) + (a[1] as u64) * bi + c1;
    c1 = s1 >> 32u64;
    s2 = (s1 & 0xffffffffu64) + c2;
    c2 = s2 >> 32u64;
    t[0] = s2 as u32;
    s1 = (t[2] as u64) + (a[2] as u64) * bi + c1;
