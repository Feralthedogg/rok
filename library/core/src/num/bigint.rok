// rok::core::num::bigint — `int`, the arbitrary-precision integer
// (stdlib spec 2.1.2, 2.1.6, 2.1.7). `#[keyword("int")]` routes the
// lowercase type name here in every package; an unsuffixed integer
// literal in an `int` slot is built by `Int::from_i64` /
// `Int::from_literal` (refs-lang 1.6.3, HIR `lower_literal`).
//
// Representation: a value that fits `i64` lives in `small` (`big` is
// `none`); anything larger is a sign + magnitude (`IntMag`, base-2^32
// limbs). The form is canonical: every result that fits `i64` drops
// back to `small` (spec 2.1.2 says promoted values stay big; canonical
// form keeps `==` / `hash` a field compare and is not observable).
// Values are immutable: a limb buffer is never written once it sits in
// an `Int`, so copies share it (spec 2.13.3: `int` is `Copy`).
//
// Algorithms: add / sub / shifts / products / Knuth D are runtime
// kernels (`rokr/src/bignum.rs`: 64-bit limbs on 64-bit targets,
// schoolbook, Karatsuba, Toom-3, three-prime NTT). Here: Burnikel-Ziegler
// division above `BZ` limbs; divide-and-conquer radix conversion over
// the powers chunk^(2^i) both ways, output dividing by Newton / Barrett
// reciprocals of the powers; square-and-multiply `pow`, Euclid `gcd`.

use rok::core::collections::raw::{GcBuf, buf_new};

/// Divisor limbs below which (or quotient limbs below which) division
/// is schoolbook (Knuth D); limb / digit counts below which radix
/// conversion is quadratic; power limbs from which output divides by a
/// reciprocal. Measured on aarch64.
const BZ: usize = 60;
const STR_SMALL: usize = 40;
const PARSE_SMALL: usize = 400;
const BARRETT: usize = 200;
const RECIP_SMALL: usize = 120;

/// A magnitude: little-endian base-2^32 limbs `d[0..n]`, no leading
/// zero limb (`n == 0` is zero). `d` may be longer than `n`.
pub(pkg) struct IntMag {
    d: GcBuf<u32>;
    n: usize;
}

impl IntMag {
    const fn zero() -> IntMag {
        unsafe {
            IntMag { d: buf_new(0), n: 0 }
        }
    }

    /// `d[0..n]` without its leading zero limbs (shares `d`).
    const fn trim(d: GcBuf<u32>, n: usize) -> IntMag {
        unsafe {
            let k = n;
            while k > 0 && d[k - 1] == 0u32 { k -= 1; }
            IntMag { d: d, n: k }
        }
    }

    const fn from_u64(v: u64) -> IntMag {
        unsafe {
            let d: GcBuf<u32> = buf_new(2);
            d[0] = v as u32;
            d[1] = (v >> 32u64) as u32;
            IntMag::trim(d, 2)
        }
    }

    /// Limb `i`, zero past the top.
    const fn limb(self, i: usize) -> u64 {
        unsafe {
            if i < self.n { self.d[i] as u64 } else { 0u64 }
        }
    }

    /// The low 64 bits.
    const fn low64(self) -> u64 { (self.limb(1) << 32u64) | self.limb(0) }

    /// Number of significant bits (0 for zero).
    const fn bits(self) -> u64 {
        unsafe {
            if self.n == 0 { return 0u64; }
            (self.n as u64) * 32u64 - (self.d[self.n - 1].leading_zeros() as u64)
        }
    }

    /// `self` vs `b`: -1, 0 or 1.
    const fn cmp3(self, b: IntMag) -> i32 {
        unsafe {
            if self.n != b.n { return if self.n < b.n { -1 } else { 1 }; }
            let i = self.n;
            while i > 0 {
                i -= 1;
                if self.d[i] != b.d[i] { return if self.d[i] < b.d[i] { -1 } else { 1 }; }
            }
            0
        }
    }

    const fn plus(self, b: IntMag) -> IntMag {
        unsafe {
            if self.n < b.n { return b.plus(self); }
            let r: GcBuf<u32> = buf_new(self.n + 1);
            r[self.n] = rok_nat_add(r, self.d, self.n, b.d, b.n);
            IntMag::trim(r, self.n + 1)
        }
    }

    /// `self - b`, `self >= b`.
    const fn minus(self, b: IntMag) -> IntMag {
        unsafe {
            let r: GcBuf<u32> = buf_new(self.n);
            rok_nat_sub(r, self.d, self.n, b.d, b.n);
            IntMag::trim(r, self.n)
        }
    }

    /// `hi B^k + lo` for `lo < B^k`.
    const fn join(hi: IntMag, lo: IntMag, k: usize) -> IntMag {
        unsafe {
            let r: GcBuf<u32> = buf_new(k + hi.n + 1);
            rok_nat_shl(r, 0, lo.d, lo.n, 0u32);
            rok_nat_shl(r, k, hi.d, hi.n, 0u32);
            IntMag::trim(r, k + hi.n + 1)
        }
    }

    /// Limbs `lo..hi` (a copy).
    const fn slice(self, lo: usize, hi: usize) -> IntMag {
        unsafe {
            let h = if hi < self.n { hi } else { self.n };
            if lo >= h { return IntMag::zero(); }
            let r: GcBuf<u32> = buf_new(h - lo);
            rok_nat_shr(r, self.d, h, (lo as u64) * 32u64);
            IntMag::trim(r, h - lo)
        }
    }

    /// Limbs `0..k` (shares `d`).
    const fn low(self, k: usize) -> IntMag {
        IntMag::trim(self.d, if k < self.n { k } else { self.n })
    }

    /// B^n - 1.
    const fn ones(n: usize) -> IntMag {
        unsafe {
            let d: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            while i < n {
                d[i] = 0xFFFF_FFFFu32;
                i += 1;
            }
            IntMag { d: d, n: n }
        }
    }

    /// `self * b` (squares when `b` is `self`).
    fn times(self, b: IntMag) -> IntMag {
        unsafe {
            if self.n == 0 || b.n == 0 { return IntMag::zero(); }
            let n = self.n + b.n;
            let r: GcBuf<u32> = buf_new(n);
            let t: GcBuf<u32> = buf_new(rok_nat_mul_scratch(self.n, b.n));
            rok_nat_mul(r, self.d, self.n, b.d, b.n, t);
            IntMag::trim(r, n)
        }
    }

    /// `self << s` bits.
    const fn shl(self, s: u64) -> IntMag {
        unsafe {
            if self.n == 0 { return self; }
            let limbs = (s / 32u64) as usize;
            let r: GcBuf<u32> = buf_new(self.n + limbs + 1);
            rok_nat_shl(r, limbs, self.d, self.n, (s % 32u64) as u32);
            IntMag::trim(r, self.n + limbs + 1)
        }
    }

    /// `self >> s` bits (floor).
    const fn shr(self, s: u64) -> IntMag {
        unsafe {
            if s / 32u64 >= self.n as u64 { return IntMag::zero(); }
            let n = self.n - (s / 32u64) as usize;
            let r: GcBuf<u32> = buf_new(n);
            rok_nat_shr(r, self.d, self.n, s);
            IntMag::trim(r, n)
        }
    }

    /// `(self / b, self % b)`, `b != 0`. Short divisors or quotients go
    /// to Knuth D; otherwise the normalized dividend is divided in base
    /// B^n digits (`n` the divisor's limbs), each a Burnikel-Ziegler
    /// 2n/1n step.
    fn divmod(self, b: IntMag) -> (IntMag, IntMag) {
        unsafe {
            if self.cmp3(b) < 0 { return (IntMag::zero(), self); }
            if b.n < BZ || self.n < b.n + BZ { return self.divmod_knuth(b); }
            let s = b.d[b.n - 1].leading_zeros() as u64;
            let bs = b.shl(s);
            let a = self.shl(s);
            let n = bs.n;
            let k = (a.n + n - 1) / n;
            let q: GcBuf<u32> = buf_new(k * n);
            let r = IntMag::zero();
            let i = k;
            while i > 0 {
                i -= 1;
                let (qd, rd) = IntMag::join(r, a.slice(i * n, i * n + n), n).div2n1n(bs, n);
                let j = 0usize;
                while j < qd.n {
                    q[i * n + j] = qd.d[j];
                    j += 1;
                }
                r = rd;
            }
            (IntMag::trim(q, k * n), r.shr(s))
        }
    }

    /// `(self / b, self % b)` for `self < b B^n`, `b` of `n` limbs with
    /// its top bit set (Burnikel-Ziegler 1998, algorithm 1): two 3n/2n
    /// steps on half-size digits.
    fn div2n1n(self, b: IntMag, n: usize) -> (IntMag, IntMag) {
        if n < BZ || self.n < n + BZ { return self.divmod_knuth(b); }
        let a = self;
        let v = b;
        let w = n;
        if w % 2 == 1 {
            // An even digit count: both times B keeps `v`'s top bit set.
            a = a.shl(32u64);
            v = v.shl(32u64);
            w += 1;
        }
        let h = w / 2;
        let v1 = v.slice(h, w);
        let v2 = v.low(h);
        let (q1, r1) = IntMag::div3n2n(a.slice(w, a.n), a.slice(h, w), v, v1, v2, h);
        let (q2, r2) = IntMag::div3n2n(r1, a.low(h), v, v1, v2, h);
        let q = IntMag::join(q1, q2, h);
        (q, if w != n { r2.shr(32u64) } else { r2 })
    }

    /// `(a12 B^n + a3) / b` for `b = b1 B^n + b2` (`b1` of `n` limbs, top
    /// bit set), `a12 < b B^n`, `a3 < B^n` (algorithm 2).
    fn div3n2n(a12: IntMag, a3: IntMag, b: IntMag, b1: IntMag, b2: IntMag, n: usize) -> (IntMag, IntMag) {
        let sh = (n as u64) * 32u64;
        let (q, r) = if a12.shr(sh).cmp3(b1) == 0 {
            (IntMag::ones(n), a12.minus(b1.shl(sh)).plus(b1))
        } else {
            a12.div2n1n(b1, n)
        };
        // The estimate is at most 2 too big.
        let t = IntMag::join(r, a3, n);
        let d = q.times(b2);
        while t.cmp3(d) < 0 {
            q = q.minus(IntMag::from_u64(1u64));
            t = t.plus(b);
        }
        (q, t.minus(d))
    }

    /// floor(B^2n / self), `n = self.n`: `recip_approx` made exact.
    fn recip(self) -> IntMag {
        let one = IntMag::from_u64(1u64);
        let b2n = one.shl((self.n as u64) * 64u64);
        let x = self.recip_approx();
        let px = x.times(self);
        while px.cmp3(b2n) > 0 {
            x = x.minus(one);
            px = px.minus(self);
        }
        while b2n.minus(px).cmp3(self) >= 0 {
            x = x.plus(one);
            px = px.plus(self);
        }
        x
    }

    /// floor(B^2n / self) within a few units (`n = self.n`): one Newton
    /// step from the reciprocal of the top `h = n/2 + 2` limbs. With
    /// X = R_h B^(n-h), B^2n - self X = B^(n-h) E for E = B^(n+h) -
    /// self R_h, so X' = X + R_h E / B^2h; the error squares.
    fn recip_approx(self) -> IntMag {
        let n = self.n;
        let one = IntMag::from_u64(1u64);
        if n < RECIP_SMALL {
            let (q, _) = one.shl((n as u64) * 64u64).divmod(self);
            return q;
        }
        let h = n / 2 + 2;
        let rh = self.slice(n - h, n).recip_approx();
        let x = rh.shl(((n - h) as u64) * 32u64);
        let px = self.times(rh);
        let bnh = one.shl(((n + h) as u64) * 32u64);
        let sh = ((2 * h) as u64) * 32u64;
        if px.cmp3(bnh) <= 0 {
            x.plus(rh.times(bnh.minus(px)).shr(sh))
        } else {
            x.minus(rh.times(px.minus(bnh)).shr(sh)).minus(one)
        }
    }

    /// `(self / p, self % p)` for `self < B^2n` (`n = p.n`) and `inv =
    /// p.recip()` (Barrett: the estimate is at most 2 short).
    fn barrett(self, p: IntMag, inv: IntMag) -> (IntMag, IntMag) {
        let n = p.n;
        let t = self.slice(n - 1, self.n).times(inv);
        let q = t.slice(n + 1, t.n);
        let r = self.minus(q.times(p));
        while r.cmp3(p) >= 0 {
            q = q.plus(IntMag::from_u64(1u64));
            r = r.minus(p);
        }
        (q, r)
    }

    /// Knuth TAOCP 4.3.1 algorithm D (a runtime kernel; `b != 0`).
    fn divmod_knuth(self, b: IntMag) -> (IntMag, IntMag) {
        unsafe {
            if self.cmp3(b) < 0 { return (IntMag::zero(), self); }
            if b.n == 1 {
                let q: GcBuf<u32> = buf_new(self.n);
                let rem = rok_nat_divmod_small(q, self.d, self.n, b.d[0]);
                return (IntMag::trim(q, self.n), IntMag::from_u64(rem as u64));
            }
            let m = self.n - b.n + 1;
            let q: GcBuf<u32> = buf_new(m);
            let r: GcBuf<u32> = buf_new(b.n);
            let t: GcBuf<u32> = buf_new(rok_nat_divmod_scratch(self.n, b.n));
            rok_nat_divmod(q, r, self.d, self.n, b.d, b.n, t);
            (IntMag::trim(q, m), IntMag::trim(r, b.n))
        }
    }
}

/// The digits of `x` in base `radix` ending at `out[end]` (exclusive),
/// zero-padded to `width`; the start. By halves: `x < pw[k - 1]^2`
/// splits at `pw[k - 1]` (`per 2^(k-1)` digits) into two `put_digits`
/// on `k - 1`, down to a runtime kernel at `STR_SMALL` (<= 64) limbs.
/// `inv[i]` is `pw[i].recip()`, or zero where plain division is used.
fn put_digits(x: IntMag, pw: List<IntMag>, inv: List<IntMag>, k: usize, per: usize, out: GcBuf<u8>, end: usize, width: usize, radix: u32) -> usize {
    if k == 0 || x.n <= STR_SMALL { return unsafe { rok_nat_put_digits(out, end, x.d, x.n, width, radix) }; }
    let p = pw[k - 1];
    // A leading part may be short: no padding to `w` then.
    if x.cmp3(p) < 0 { return put_digits(x, pw, inv, k - 1, per, out, end, width, radix); }
    let (q, r) = if inv[k - 1].n > 0 { x.barrett(p, inv[k - 1]) } else { x.divmod(p) };
    let w = per << (k - 1);
    put_digits(r, pw, inv, k - 1, per, out, end, w, radix);
    put_digits(q, pw, inv, k - 1, per, out, end - w, if width > w { width - w } else { 0 }, radix)
}

/// The value of the checked digits `bs[lo..hi]`, folded `per` at a
/// time: acc = acc * radix^k + chunk (quadratic).
fn fold_digits(bs: Slice<u8>, lo: usize, hi: usize, radix: u32, per: u32) -> IntMag {
    unsafe {
        let acc: GcBuf<u32> = buf_new((hi - lo) / (per as usize) + 2);
        let len = 0usize;
        let i = lo;
        while i < hi {
            let v = 0u64;
            let mul = 1u64;
            let k = 0u32;
            while k < per && i < hi {
                v = v * (radix as u64) + (digit_of(bs[i]) as u64);
                mul = mul * (radix as u64);
                k += 1u32;
                i += 1;
            }
            // mul <= chunk < 2^32.
            let carry = v;
            let j = 0usize;
            while j < len {
                let t = (acc[j] as u64) * mul + carry;
                acc[j] = t as u32;
                carry = t >> 32u64;
                j += 1;
            }
            if carry != 0u64 {
                acc[len] = carry as u32;
                len += 1;
            }
        }
        IntMag::trim(acc, len)
    }
}

/// `fold_digits` by halves: the low part is the largest `per 2^j`
/// digits shorter than the run, its weight `pw[j]`.
fn parse_digits(bs: Slice<u8>, lo: usize, hi: usize, radix: u32, per: u32, pw: List<IntMag>) -> IntMag {
    let len = hi - lo;
    if len <= PARSE_SMALL { return fold_digits(bs, lo, hi, radix, per); }
    let j = 0usize;
    while ((per as usize) << (j + 1)) < len { j += 1; }
    let l = (per as usize) << j;
    let top = parse_digits(bs, lo, hi - l, radix, per, pw);
    top.times(pw[j]).plus(parse_digits(bs, hi - l, hi, radix, per, pw))
}

/// An arbitrary-precision integer (spec 2.1.2). Write it `int`.
#[lang("int_type")]
#[keyword("int")]
pub struct Int {
    small: i64;
    neg: bool;
    big: IntMag | none;
}

/// `(10^9, 9)` for base 10: the largest power of `radix` below 2^32 and
/// its digit count.
const fn radix_chunk(radix: u32) -> (u32, u32) {
    let p = radix;
    let k = 1u32;
    while (p as u64) * (radix as u64) < 0x1_0000_0000u64 {
        p = p * radix;
        k += 1u32;
    }
    (p, k)
}

/// Digit value of an ASCII digit or letter (either case).
const fn digit_of(c: u8) -> u32 {
    let v = c as u32;
    if v >= 48u32 && v <= 57u32 { return v - 48u32; }
    if v >= 97u32 && v <= 122u32 { return v - 87u32; }
    v - 55u32
}

impl Int {
    /// Zero.
    pub const fn new() -> Int { Int::from_i64(0) }
    pub const fn from_i64(n: i64) -> Int { Int { small: n, neg: false, big: none } }
    pub const fn from_i32(n: i32) -> Int { Int::from_i64(n as i64) }
    pub const fn from_u64(n: u64) -> Int { Int::from_parts(false, IntMag::from_u64(n)) }

    /// An integer literal's digits (`_`, `0x` / `0o` / `0b` allowed):
    /// what an unsuffixed literal too big for `i64` in an `int` slot
    /// lowers to.
    pub fn from_literal(s: str) -> Int {
        let t = if s.contains("_") { s.replace("_", "") } else { s };
        let radix = 10u32;
        if t.len() > 2 && t.as_bytes()[0] == 48u8 {
            // `0x` / `0o` / `0b`, either case.
            let c = t.as_bytes()[1] | 32u8;
            if c == 120u8 { radix = 16u32; }
            if c == 111u8 { radix = 8u32; }
            if c == 98u8 { radix = 2u32; }
            if radix != 10u32 { t = t[2:]; }
        }
        match Int::parse_radix(t, radix) {
            v: Int => v,
            none => panic(f"malformed integer literal `{s}`"),
        }
    }

    /// `s` in base `radix` (2..=36): an optional sign, then digits of
    /// either case; `none` otherwise. The grammar is the runtime's, the
    /// same the primitives' `FromStr` reads.
    pub fn parse_radix(s: str, radix: u32) -> Int | none {
        unsafe {
            let out: GcBuf<i64> = buf_new(1);
            let st = rok_str_parse_int(s, radix, 1, 64u32, out);
            if st == 0 { return Int::from_i64(out[0]); }
            if st != 3 { return none; }
            // Past `i64`: the checked digits, by halves over the powers
            // pw[j] = chunk^(2^j).
            let bs = s.as_bytes();
            let n = s.len();
            let neg = bs[0] == 45u8;
            let i = if bs[0] == 45u8 || bs[0] == 43u8 { 1usize } else { 0usize };
            let (chunk, per) = radix_chunk(radix);
            let pw: List<IntMag> = List::new();
            pw.push(IntMag::from_u64(chunk as u64));
            while n - i > PARSE_SMALL && ((per as usize) << pw.len()) < n - i {
                let p = pw[pw.len() - 1];
                pw.push(p.times(p));
            }
            Int::from_parts(neg, parse_digits(bs, i, n, radix, per, pw))
        }
    }

    /// The digits in base `radix` (2..=36, lowercase), `-` first when
    /// negative.
    pub fn to_str_radix(self, radix: u32) -> str {
        unsafe {
            if radix < 2u32 || radix > 36u32 { panic(f"to_str_radix: radix {radix} out of 2..=36"); }
            let (neg, m) = self.parts();
            if m.n == 0 { return "0"; }
            // pw[i] = chunk^(2^i) until the top one's square exceeds `m`.
            let (chunk, per) = radix_chunk(radix);
            let pw: List<IntMag> = List::new();
            pw.push(IntMag::from_u64(chunk as u64));
            while m.n > STR_SMALL && pw[pw.len() - 1].bits() * 2u64 <= m.bits() + 1u64 {
                let p = pw[pw.len() - 1];
                pw.push(p.times(p));
            }
            // Digits <= bits / floor(log2 radix) + 1, plus the sign.
            let total = (m.bits() / ((31u32 - radix.leading_zeros()) as u64)) as usize + 2;
            let out: GcBuf<u8> = buf_new(total);
            // Every level but the top divides by its power more than once:
            // a reciprocal pays off there.
            let inv: List<IntMag> = List::new();
            let i = 0usize;
            while i < pw.len() {
                inv.push(if i + 1 < pw.len() && pw[i].n >= BARRETT { pw[i].recip() } else { IntMag::zero() });
                i += 1;
            }
            let at = put_digits(m, pw, inv, pw.len(), per as usize, out, total, 0, radix);
            if neg {
                at -= 1;
                out[at] = 45u8;
            }
            rok_str_from_buf(out, at, total - at)
        }
    }

    pub const fn to_i32(self) -> i32 | none {
        let v = self.to_i64()?;
        if v < -2147483648 || v > 2147483647 { return none; }
        v as i32
    }

    pub const fn to_i64(self) -> i64 | none {
        if self.big is none { return self.small; }
        none
    }

    pub const fn to_u64(self) -> u64 | none {
        if self.big is none {
            if self.small < 0 { return none; }
            return self.small as u64;
        }
        let (neg, m) = self.parts();
        if neg || m.n > 2 { return none; }
        m.low64()
    }

    /// The nearest `f64` (ties to even; `±inf` past `f64::MAX`).
    pub fn to_f64(self) -> f64 {
        if self.big is none { return self.small as f64; }
        rok::core::num::bigfloat::Float::from_int(self).to_f64()
    }

    pub const fn is_zero(self) -> bool { self.big is none && self.small == 0 }
    pub const fn is_negative(self) -> bool {
        if self.big is none { self.small < 0 } else { self.neg }
    }
    pub const fn is_positive(self) -> bool { !self.is_zero() && !self.is_negative() }

    /// `-1`, `0` or `1`.
    pub const fn signum(self) -> Int {
        if self.is_zero() { return Int::from_i64(0); }
        if self.is_negative() { Int::from_i64(-1) } else { Int::from_i64(1) }
    }

    pub const fn abs(self) -> Int {
        if self.is_negative() { -self } else { self }
    }

    /// Bits of `|self|` without leading zeros (0 for zero; Python's
    /// `bit_length`).
    pub const fn bit_length(self) -> u64 {
        let (_, m) = self.parts();
        m.bits()
    }

    /// `self^exp` (square and multiply).
    pub fn pow(self, exp: u32) -> Int {
        let acc = Int::from_i64(1);
        let base = self;
        let e = exp;
        while e > 0u32 {
            if e & 1u32 == 1u32 { acc = acc * base; }
            e = e >> 1u32;
            if e > 0u32 { base = base * base; }
        }
        acc
    }

    /// The greatest common divisor, never negative (`gcd(0, 0) == 0`).
    /// Euclid on full divisions; huge operands would want Lehmer's.
    pub fn gcd(self, other: Int) -> Int {
        let a = self.abs();
        let b = other.abs();
        while !b.is_zero() {
            let r = a % b;
            a = b;
            b = r;
        }
        a
    }

    /// `(self / rhs, self % rhs)` in one division (truncating, like
    /// `/` and `%`).
    pub fn div_rem(self, rhs: Int) -> (Int, Int) {
        if rhs.is_zero() { panic("attempt to divide an int by zero"); }
        if self.big is none && rhs.big is none && !(self.small == -9223372036854775807 - 1 && rhs.small == -1) {
            return (Int::from_i64(self.small / rhs.small), Int::from_i64(self.small % rhs.small));
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        let (q, r) = am.divmod(bm);
        (Int::from_parts(an != bn, q), Int::from_parts(an, r))
    }

    /// Sign and magnitude.
    pub(pkg) const fn parts(self) -> (bool, IntMag) {
        if let m: IntMag = self.big { return (self.neg, m); }
        let v = self.small;
        if v < 0 { (true, IntMag::from_u64(0u64.wrapping_sub(v as u64))) } else { (false, IntMag::from_u64(v as u64)) }
    }

    /// The canonical `int` of sign `neg` and magnitude `m`.
    pub(pkg) const fn from_parts(neg: bool, m: IntMag) -> Int {
        if m.n <= 2 {
            let v = m.low64();
            if v <= 0x7FFF_FFFF_FFFF_FFFFu64 { return Int::from_i64(if neg { -(v as i64) } else { v as i64 }); }
            if neg && v == 0x8000_0000_0000_0000u64 { return Int::from_i64(v as i64); }
        }
        Int { small: 0, neg: neg, big: m }
    }

    /// `self` vs `rhs`: -1, 0 or 1.
    const fn cmp3(self, rhs: Int) -> i32 {
        if self.big is none && rhs.big is none {
            if self.small < rhs.small { return -1; }
            return if self.small > rhs.small { 1 } else { 0 };
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        if an != bn { return if an { -1 } else { 1 }; }
        let c = am.cmp3(bm);
        if an { -c } else { c }
    }

    /// Two's complement limbs over `n` limbs (`n` past the magnitude).
    const fn twos(self, n: usize) -> GcBuf<u32> {
        unsafe {
            let (neg, m) = self.parts();
            let r: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            let carry = 1u64;
            while i < n {
                let v = m.limb(i);
                if neg {
                    let t = ((~(v as u32)) as u64) + carry;
                    r[i] = t as u32;
                    carry = t >> 32u64;
                } else {
                    r[i] = v as u32;
                }
                i += 1;
            }
            r
        }
    }

    /// The `int` of two's complement limbs `r[0..n]` (top bit = sign).
    const fn from_twos(r: GcBuf<u32>, n: usize) -> Int {
        unsafe {
            if r[n - 1] & 0x8000_0000u32 == 0u32 { return Int::from_parts(false, IntMag::trim(r, n)); }
            let m: GcBuf<u32> = buf_new(n);
            let carry = 1u64;
            let i = 0usize;
            while i < n {
                let t = ((~r[i]) as u64) + carry;
                m[i] = t as u32;
                carry = t >> 32u64;
                i += 1;
            }
            Int::from_parts(true, IntMag::trim(m, n))
        }
    }

    /// A bitwise op (`op`: 0 and, 1 or, 2 xor) on infinite two's
    /// complement (Python semantics).
    const fn bitwise(self, rhs: Int, op: i32) -> Int {
        unsafe {
            if self.big is none && rhs.big is none {
                let a = self.small;
                let b = rhs.small;
                return Int::from_i64(if op == 0 { a & b } else if op == 1 { a | b } else { a ^ b });
            }
            let (_, am) = self.parts();
            let (_, bm) = rhs.parts();
            let n = (if am.n > bm.n { am.n } else { bm.n }) + 1;
            let x = self.twos(n);
            let y = rhs.twos(n);
            let r: GcBuf<u32> = buf_new(n);
            let i = 0usize;
            while i < n {
                r[i] = if op == 0 { x[i] & y[i] } else if op == 1 { x[i] | y[i] } else { x[i] ^ y[i] };
                i += 1;
            }
            Int::from_twos(r, n)
        }
    }
}

impl Add for Int {
    type Output = Int;
    const fn add(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_add(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        add_signed(an, am, bn, bm)
    }
}

const fn add_signed(an: bool, am: IntMag, bn: bool, bm: IntMag) -> Int {
    if an == bn { return Int::from_parts(an, am.plus(bm)); }
    let c = am.cmp3(bm);
    if c == 0 { return Int::from_i64(0); }
    if c > 0 { Int::from_parts(an, am.minus(bm)) } else { Int::from_parts(bn, bm.minus(am)) }
}

impl Sub for Int {
    type Output = Int;
    const fn sub(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_sub(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        add_signed(an, am, !bn, bm)
    }
}

impl Mul for Int {
    type Output = Int;
    fn mul(self, rhs: Int) -> Int {
        if self.big is none && rhs.big is none {
            if let s: i64 = self.small.checked_mul(rhs.small) { return Int::from_i64(s); }
        }
        let (an, am) = self.parts();
        let (bn, bm) = rhs.parts();
        Int::from_parts(an != bn, am.times(bm))
    }
}

/// Truncating division (spec 2.1.2: `-7 / 2 == -3`); panics on zero.
impl Div for Int {
    type Output = Int;
    fn div(self, rhs: Int) -> Int {
        let (q, _) = self.div_rem(rhs);
        q
    }
}

/// The remainder of `/`: takes the dividend's sign (`-7 % 2 == -1`).
impl Rem for Int {
    type Output = Int;
    fn rem(self, rhs: Int) -> Int {
        let (_, r) = self.div_rem(rhs);
        r
    }
}

/// `%%`: takes the divisor's sign (`-7 %% 2 == 1`).
impl Modulo for Int {
    type Output = Int;
    fn modulo(self, rhs: Int) -> Int {
        let r = self % rhs;
        if !r.is_zero() && r.is_negative() != rhs.is_negative() { r + rhs } else { r }
    }
}

impl Neg for Int {
    type Output = Int;
    const fn neg(self) -> Int {
        if self.big is none {
            if let s: i64 = self.small.checked_neg() { return Int::from_i64(s); }
        }
        let (n, m) = self.parts();
        Int::from_parts(!n, m)
    }
}

impl BitAnd for Int {
    type Output = Int;
    const fn bitand(self, rhs: Int) -> Int { self.bitwise(rhs, 0) }
}

impl BitOr for Int {
    type Output = Int;
    const fn bitor(self, rhs: Int) -> Int { self.bitwise(rhs, 1) }
}

impl BitXor for Int {
    type Output = Int;
    const fn bitxor(self, rhs: Int) -> Int { self.bitwise(rhs, 2) }
}

/// `~x == -x - 1`.
impl BitNot for Int {
    type Output = Int;
    const fn bitnot(self) -> Int { -self - Int::from_i64(1) }
}

/// `x << n == x * 2^n`.
impl Shl<u32> for Int {
    type Output = Int;
    const fn shl(self, n: u32) -> Int {
        let (neg, m) = self.parts();
        Int::from_parts(neg, m.shl(n as u64))
    }
}

/// `x >> n == floor(x / 2^n)` (an arithmetic shift).
impl Shr<u32> for Int {
    type Output = Int;
    const fn shr(self, n: u32) -> Int {
        if self.big is none {
            if n >= 63u32 { return Int::from_i64(if self.small < 0 { -1 } else { 0 }); }
            return Int::from_i64(self.small >> (n as i64));
        }
        let (neg, m) = self.parts();
        if !neg { return Int::from_parts(false, m.shr(n as u64)); }
        // floor(-m / 2^n) = -((m - 1) >> n) - 1.
        let t = m.minus(IntMag::from_u64(1u64)).shr(n as u64);
        Int::from_parts(true, t.plus(IntMag::from_u64(1u64)))
    }
}

impl PartialEq for Int {
    const fn eq(self, rhs: Int) -> bool { self.cmp3(rhs) == 0 }
    const fn ne(self, rhs: Int) -> bool { self.cmp3(rhs) != 0 }
}

impl Eq for Int {}

impl PartialOrd for Int {
    const fn lt(self, rhs: Int) -> bool { self.cmp3(rhs) < 0 }
    const fn gt(self, rhs: Int) -> bool { self.cmp3(rhs) > 0 }
    const fn le(self, rhs: Int) -> bool { self.cmp3(rhs) <= 0 }
    const fn ge(self, rhs: Int) -> bool { self.cmp3(rhs) >= 0 }
}

impl Ord for Int {
    const fn cmp(self, rhs: Int) -> Ordering {
        let c = self.cmp3(rhs);
        if c < 0 { Ordering::Less } else if c > 0 { Ordering::Greater } else { Ordering::Equal }
    }
}

/// Equal to `i64`'s hash for values in `i64` range.
impl Hash for Int {
    const fn hash(self) -> u64 {
        unsafe {
            if let m: IntMag = self.big {
                let h = if self.neg { 0x9E37_79B9_7F4A_7C15u64 } else { 0u64 };
                let i = 0usize;
                while i < m.n {
                    h = (h ^ (m.d[i] as u64)).wrapping_mul(0x0000_0100_0000_01B3u64);
                    i += 1;
                }
                return h;
            }
            self.small as u64
        }
    }
}

impl Clone for Int {
    const fn clone(self) -> Int { self }
}

impl Copy for Int {}

impl Default for Int {
    const fn default() -> Int { Int::from_i64(0) }
}

impl Zero for Int {
    const fn zero() -> Int { Int::from_i64(0) }
}

impl One for Int {
    const fn one() -> Int { Int::from_i64(1) }
}

/// `b o x X` show the sign and magnitude: `int` has no width for a
/// two's complement form (`{-255:x}` is `-ff`, stdlib 2.10.5).
impl Display for Int {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        if self.big is none {
            f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self.small, 1u32, 0u32) };
        } else {
            let t = f.ty();
            let r = if t == 'b' { 2u32 } else if t == 'o' { 8u32 } else if t == 'x' || t == 'X' { 16u32 } else { 10u32 };
            let digits = self.abs().to_str_radix(r);
            f.t = unsafe { rok_fmt_digits(f.t, f.flags, f.counts, if self.is_negative() { 1u32 } else { 0u32 }, digits) };
        }
    }
}

impl Debug for Int {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) }
}

impl FromStr for Int {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> Int {
        match Int::parse_radix(s, 10u32) {
            v: Int => v,
            none => throw ParseError { input: s, pos: 0, reason: "invalid digit" },
        }
    }
}

// ---- conversions (stdlib 2.11.8, 2.1.7) ----

const fn overflow(ty: str) -> OverflowError { OverflowError { op: "try_from", ty: ty } }

/// The low 64 bits of the two's complement form (`wrapping_into`).
const fn low_bits(v: Int) -> u64 {
    if v.big is none { return v.small as u64; }
    let (neg, m) = v.parts();
    let low = m.low64();
    if neg { low.wrapping_neg() } else { low }
}

impl From<i8> for Int { const fn from(value: i8) -> Int { Int::from_i64(value as i64) } }
impl From<i16> for Int { const fn from(value: i16) -> Int { Int::from_i64(value as i64) } }
impl From<i32> for Int { const fn from(value: i32) -> Int { Int::from_i64(value as i64) } }
impl From<i64> for Int { const fn from(value: i64) -> Int { Int::from_i64(value) } }
impl From<isize> for Int { const fn from(value: isize) -> Int { Int::from_i64(value as i64) } }
impl From<u8> for Int { const fn from(value: u8) -> Int { Int::from_i64(value as i64) } }
impl From<u16> for Int { const fn from(value: u16) -> Int { Int::from_i64(value as i64) } }
impl From<u32> for Int { const fn from(value: u32) -> Int { Int::from_i64(value as i64) } }
impl From<u64> for Int { const fn from(value: u64) -> Int { Int::from_u64(value) } }
impl From<usize> for Int { const fn from(value: usize) -> Int { Int::from_u64(value as u64) } }

/// Lossy (rounds to nearest), as spec 2.11.8 allows for `int → f64`.
impl From<Int> for f64 { fn from(value: Int) -> f64 { value.to_f64() } }

impl TryFrom<Int> for i8 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> i8 {
        let v = value.to_i64() ?? 128;
        if v < -128 || v > 127 { throw overflow("i8"); }
        v as i8
    }
}
impl TryFrom<Int> for i16 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> i16 {
        let v = value.to_i64() ?? 32768;
        if v < -32768 || v > 32767 { throw overflow("i16"); }
        v as i16
    }
}
impl TryFrom<Int> for i32 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> i32 {
        match value.to_i32() {
            v: i32 => v,
            none => throw overflow("i32"),
        }
    }
}
impl TryFrom<Int> for i64 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> i64 {
        match value.to_i64() {
            v: i64 => v,
            none => throw overflow("i64"),
        }
    }
}
impl TryFrom<Int> for isize {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> isize {
        match value.to_i64() {
            v: i64 => v as isize,
            none => throw overflow("isize"),
        }
    }
}
impl TryFrom<Int> for u8 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> u8 {
        let v = value.to_u64() ?? 256u64;
        if v > 255u64 { throw overflow("u8"); }
        v as u8
    }
}
impl TryFrom<Int> for u16 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> u16 {
        let v = value.to_u64() ?? 65536u64;
        if v > 65535u64 { throw overflow("u16"); }
        v as u16
    }
}
impl TryFrom<Int> for u32 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> u32 {
        let v = value.to_u64() ?? 0x1_0000_0000u64;
        if v > 0xFFFF_FFFFu64 { throw overflow("u32"); }
        v as u32
    }
}
impl TryFrom<Int> for u64 {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> u64 {
        match value.to_u64() {
            v: u64 => v,
            none => throw overflow("u64"),
        }
    }
}
impl TryFrom<Int> for usize {
    type Error = OverflowError;
    const fn try_from(value: Int) throws (OverflowError) -> usize {
        match value.to_u64() {
            v: u64 => v as usize,
            none => throw overflow("usize"),
        }
    }
}

/// `value` clamped to `lo..=hi` as an `i64`.
const fn clamp_i64(value: Int, lo: i64, hi: i64) -> i64 {
    if value < Int::from_i64(lo) { return lo; }
    if value > Int::from_i64(hi) { return hi; }
    value.small
}

/// `value` clamped to `0..=hi` as a `u64`.
const fn clamp_u64(value: Int, hi: u64) -> u64 {
    if value.is_negative() { return 0u64; }
    match value.to_u64() {
        v: u64 => if v > hi { hi } else { v },
        none => hi,
    }
}

impl SaturatingFrom<Int> for i8 { const fn saturating_from(value: Int) -> i8 { clamp_i64(value, -128, 127) as i8 } }
impl SaturatingFrom<Int> for i16 { const fn saturating_from(value: Int) -> i16 { clamp_i64(value, -32768, 32767) as i16 } }
impl SaturatingFrom<Int> for i32 {
    const fn saturating_from(value: Int) -> i32 { clamp_i64(value, -2147483648, 2147483647) as i32 }
}
impl SaturatingFrom<Int> for i64 {
    const fn saturating_from(value: Int) -> i64 { clamp_i64(value, -9223372036854775807 - 1, 9223372036854775807) }
}
impl SaturatingFrom<Int> for isize {
    const fn saturating_from(value: Int) -> isize {
        clamp_i64(value, -9223372036854775807 - 1, 9223372036854775807) as isize
    }
}
impl SaturatingFrom<Int> for u8 { const fn saturating_from(value: Int) -> u8 { clamp_u64(value, 255u64) as u8 } }
impl SaturatingFrom<Int> for u16 { const fn saturating_from(value: Int) -> u16 { clamp_u64(value, 65535u64) as u16 } }
impl SaturatingFrom<Int> for u32 { const fn saturating_from(value: Int) -> u32 { clamp_u64(value, 0xFFFF_FFFFu64) as u32 } }
impl SaturatingFrom<Int> for u64 {
    const fn saturating_from(value: Int) -> u64 { clamp_u64(value, 0xFFFF_FFFF_FFFF_FFFFu64) }
}
impl SaturatingFrom<Int> for usize {
    const fn saturating_from(value: Int) -> usize { clamp_u64(value, 0xFFFF_FFFF_FFFF_FFFFu64) as usize }
}

// `wrapping_into` / `as`: the low bits of the two's complement form.
impl WrappingFrom<Int> for i8 { const fn wrapping_from(value: Int) -> i8 { low_bits(value) as i8 } }
impl WrappingFrom<Int> for i16 { const fn wrapping_from(value: Int) -> i16 { low_bits(value) as i16 } }
impl WrappingFrom<Int> for i32 { const fn wrapping_from(value: Int) -> i32 { low_bits(value) as i32 } }
impl WrappingFrom<Int> for i64 { const fn wrapping_from(value: Int) -> i64 { low_bits(value) as i64 } }
impl WrappingFrom<Int> for isize { const fn wrapping_from(value: Int) -> isize { low_bits(value) as isize } }
impl WrappingFrom<Int> for u8 { const fn wrapping_from(value: Int) -> u8 { low_bits(value) as u8 } }
impl WrappingFrom<Int> for u16 { const fn wrapping_from(value: Int) -> u16 { low_bits(value) as u16 } }
impl WrappingFrom<Int> for u32 { const fn wrapping_from(value: Int) -> u32 { low_bits(value) as u32 } }
impl WrappingFrom<Int> for u64 { const fn wrapping_from(value: Int) -> u64 { low_bits(value) } }
impl WrappingFrom<Int> for usize { const fn wrapping_from(value: Int) -> usize { low_bits(value) as usize } }
/// `n as f64`: rounds to nearest.
impl WrappingFrom<Int> for f64 { fn wrapping_from(value: Int) -> f64 { value.to_f64() } }
