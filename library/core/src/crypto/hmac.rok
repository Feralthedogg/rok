// HMAC (RFC 2104) and HKDF (RFC 5869) over a SHA-2 function.

use sup::{view, Bytes};
use sup::constant_time_eq;
use sup::sha2::{HashAlgorithm, Digest};

/// A running HMAC. A value: copying it forks the running MAC.
pub struct Hmac {
    inner: Digest;
    outer: Digest;
}

impl Hmac {
    pub fn new(alg: HashAlgorithm, key: Bytes) -> Hmac {
        let k = view(key);
        let bl = alg.block_len();
        let kb: List<u8> = if k.len() > bl { alg.digest(k) } else { k.to_list() };
        while kb.len() < bl { kb.push(0u8); }
        let ipad: List<u8> = List::with_capacity(bl);
        let opad: List<u8> = List::with_capacity(bl);
        for x in kb {
            ipad.push(x ^ 0x36u8);
            opad.push(x ^ 0x5cu8);
        }
        let inner = Digest::new(alg);
        inner.update(ipad);
        let outer = Digest::new(alg);
        outer.update(opad);
        Hmac { inner, outer }
    }

    /// The tag of `data` under `key`.
    pub fn mac(alg: HashAlgorithm, key: Bytes, data: Bytes) -> List<u8> {
        let h = Hmac::new(alg, key);
        h.update(data);
        h.finish()
    }

    /// Whether `tag` is the tag of `data`, compared in constant time.
    pub fn verify(alg: HashAlgorithm, key: Bytes, data: Bytes, tag: Bytes) -> bool {
        constant_time_eq(Hmac::mac(alg, key, data), tag)
    }

    pub fn update(ref self, data: Bytes) { self.inner.update(data); }

    pub fn finish(self) -> List<u8> {
        self.outer.update(self.inner.finish());
        self.outer.finish()
    }
}

/// HKDF: `extract` a pseudorandom key, `expand` it into output keying
/// material.
pub struct Hkdf;

impl Hkdf {
    /// `HMAC(salt, ikm)`; an empty salt is `output_len` zero bytes.
    pub fn extract(alg: HashAlgorithm, salt: Bytes, ikm: Bytes) -> List<u8> {
        let s = view(salt);
        if s.len() == 0 {
            let zeros: List<u8> = List::with_capacity(alg.output_len());
            for _ in 0..alg.output_len() { zeros.push(0u8); }
            return Hmac::mac(alg, zeros, ikm);
        }
        Hmac::mac(alg, s, ikm)
    }

    /// `len` bytes of output keying material; `len` is at most
    /// `255 * output_len`.
    pub fn expand(alg: HashAlgorithm, prk: Bytes, info: Bytes, len: usize) throws (ValueError) -> List<u8> {
        if len > 255 * alg.output_len() {
            throw ValueError { msg: "HKDF output too long" };
        }
        let base = Hmac::new(alg, prk);
        let inf = view(info);
        let out: List<u8> = List::with_capacity(len);
        let t: List<u8> = [];
        let i = 1u8;
        while out.len() < len {
            let h = base;
            h.update(t);
            h.update(inf);
            h.update([i]);
            t = h.finish();
            for x in t {
                if out.len() < len { out.push(x); }
            }
            i = i.wrapping_add(1u8);
        }
        out
    }
}
