// The P-256 and P-384 base fields: Montgomery multiplication (FIOS),
// addition and subtraction on `[u32; 12]` limbs. The loops have constant
// trip counts, so they carry no safepoint poll and unroll with the
// prime's limbs folded in. Constant time: carries and the final
// corrections are masks.

/// A field element: little-endian 32-bit limbs, the top four zero for
/// P-256.
pub(pkg) type Fe = [u32; 12];

pub(pkg) fn fe_zero() -> Fe { [0u32; 12] }

// ---- P-256: p = 2^256 - 2^224 + 2^192 + 2^96 - 1 ----

const P256: [u32; 8] = [0xffffffffu32, 0xffffffffu32, 0xffffffffu32, 0x00000000u32, 0x00000000u32, 0x00000000u32, 0x00000001u32, 0xffffffffu32];

/// `a b R^-1 mod p` for `a, b < p` (FIOS).
pub(pkg) fn mul_p256(a: Fe, b: Fe) -> Fe {
    let t: [u32; 9] = [0u32; 9];
    for i in 0usize..8 {
        let bi = b[i] as u64;
        // Limb 0 reduces to zero; the others shift down one.
        let s0 = (t[0] as u64) + (a[0] as u64) * bi;
        let qm = s0 & 0xffffffffu64;
        let c1 = s0 >> 32u64;
        let c2 = ((s0 & 0xffffffffu64) + qm * (P256[0] as u64)) >> 32u64;
        // Two loops: each short enough for LLVM to unroll fully.
        for j in 1usize..4 {
            let s1 = (t[j] as u64) + (a[j] as u64) * bi + c1;
            c1 = s1 >> 32u64;
            let s2 = (s1 & 0xffffffffu64) + qm * (P256[j] as u64) + c2;
            c2 = s2 >> 32u64;
            t[j - 1] = s2 as u32;
        }
        for j in 4usize..8 {
            let s1 = (t[j] as u64) + (a[j] as u64) * bi + c1;
            c1 = s1 >> 32u64;
            let s2 = (s1 & 0xffffffffu64) + qm * (P256[j] as u64) + c2;
            c2 = s2 >> 32u64;
            t[j - 1] = s2 as u32;
        }
        let s = (t[8] as u64) + c1 + c2;
        t[7] = s as u32;
        t[8] = (s >> 32u64) as u32;
    }
    // t < 2p: subtract p if t[n] is set or t >= p.
    let d = fe_zero();
    let br = 0u64;
    for j in 0usize..8 {
        let u = (t[j] as u64).wrapping_sub(P256[j] as u64).wrapping_sub(br);
        d[j] = u as u32;
        br = u >> 63u64;
    }
    let mask = 0u32.wrapping_sub(t[8] | ((br as u32) ^ 1u32));
    for j in 0usize..8 { d[j] = (d[j] & mask) | (t[j] & ~mask); }
    d
}

/// `(a + b) mod p` for `a, b < p`.
pub(pkg) fn add_p256(a: Fe, b: Fe) -> Fe {
    let s = fe_zero();
    let d = fe_zero();
    let c = 0u64;
    let br = 0u64;
    // Two loops: each short enough for LLVM to unroll fully.
    for j in 0usize..4 {
        let t = (a[j] as u64) + (b[j] as u64) + c;
        s[j] = t as u32;
        c = t >> 32u64;
        let u = (t & 0xffffffffu64).wrapping_sub(P256[j] as u64).wrapping_sub(br);
        d[j] = u as u32;
        br = u >> 63u64;
    }
    for j in 4usize..8 {
        let t = (a[j] as u64) + (b[j] as u64) + c;
        s[j] = t as u32;
        c = t >> 32u64;
        let u = (t & 0xffffffffu64).wrapping_sub(P256[j] as u64).wrapping_sub(br);
        d[j] = u as u32;
        br = u >> 63u64;
    }
    // The difference when the sum overflowed or reached p.
    let mask = 0u32.wrapping_sub((c as u32) | ((br as u32) ^ 1u32));
    for j in 0usize..8 { d[j] = (d[j] & mask) | (s[j] & ~mask); }
    d
}

/// `(a - b) mod p` for `a, b < p`.
pub(pkg) fn sub_p256(a: Fe, b: Fe) -> Fe {
    let d = fe_zero();
    let br = 0u64;
    for j in 0usize..8 {
        let u = (a[j] as u64).wrapping_sub(b[j] as u64).wrapping_sub(br);
        d[j] = u as u32;
        br = u >> 63u64;
    }
    // Add p back on a borrow.
    let mask = 0u64.wrapping_sub(br);
    let c = 0u64;
    for j in 0usize..8 {
        let u = (d[j] as u64) + ((P256[j] as u64) & mask) + c;
        d[j] = u as u32;
        c = u >> 32u64;
    }
    d
}

// ---- P-384: p = 2^384 - 2^128 - 2^96 + 2^32 - 1 ----

const P384: [u32; 12] = [0xffffffffu32, 0x00000000u32, 0x00000000u32, 0xffffffffu32, 0xfffffffeu32, 0xffffffffu32, 0xffffffffu32, 0xffffffffu32, 0xffffffffu32, 0xffffffffu32, 0xffffffffu32, 0xffffffffu32];

/// `a b R^-1 mod p` for `a, b < p` (FIOS).
pub(pkg) fn mul_p384(a: Fe, b: Fe) -> Fe {
    let t: [u32; 13] = [0u32; 13];
    for i in 0usize..12 {
        let bi = b[i] as u64;
        // Limb 0 reduces to zero; the others shift down one.
        let s0 = (t[0] as u64) + (a[0] as u64) * bi;
        let qm = s0 & 0xffffffffu64;
        let c1 = s0 >> 32u64;
        let c2 = ((s0 & 0xffffffffu64) + qm * (P384[0] as u64)) >> 32u64;
        // Two loops: each short enough for LLVM to unroll fully.
        for j in 1usize..6 {
            let s1 = (t[j] as u64) + (a[j] as u64) * bi + c1;
            c1 = s1 >> 32u64;
            let s2 = (s1 & 0xffffffffu64) + qm * (P384[j] as u64) + c2;
            c2 = s2 >> 32u64;
            t[j - 1] = s2 as u32;
        }
        for j in 6usize..12 {
            let s1 = (t[j] as u64) + (a[j] as u64) * bi + c1;
            c1 = s1 >> 32u64;
            let s2 = (s1 & 0xffffffffu64) + qm * (P384[j] as u64) + c2;
            c2 = s2 >> 32u64;
            t[j - 1] = s2 as u32;
        }
        let s = (t[12] as u64) + c1 + c2;
        t[11] = s as u32;
        t[12] = (s >> 32u64) as u32;
    }
    // t < 2p: subtract p if t[n] is set or t >= p.
    let d = fe_zero();
    let br = 0u64;
    for j in 0usize..12 {
        let u = (t[j] as u64).wrapping_sub(P384[j] as u64).wrapping_sub(br);
        d[j] = u as u32;
        br = u >> 63u64;
    }
    let mask = 0u32.wrapping_sub(t[12] | ((br as u32) ^ 1u32));
    for j in 0usize..12 { d[j] = (d[j] & mask) | (t[j] & ~mask); }
    d
}

/// `(a + b) mod p` for `a, b < p`.
pub(pkg) fn add_p384(a: Fe, b: Fe) -> Fe {
    let s = fe_zero();
    let d = fe_zero();
    let c = 0u64;
    let br = 0u64;
    // Two loops: each short enough for LLVM to unroll fully.
    for j in 0usize..6 {
        let t = (a[j] as u64) + (b[j] as u64) + c;
        s[j] = t as u32;
        c = t >> 32u64;
        let u = (t & 0xffffffffu64).wrapping_sub(P384[j] as u64).wrapping_sub(br);
        d[j] = u as u32;
        br = u >> 63u64;
    }
    for j in 6usize..12 {
        let t = (a[j] as u64) + (b[j] as u64) + c;
        s[j] = t as u32;
        c = t >> 32u64;
        let u = (t & 0xffffffffu64).wrapping_sub(P384[j] as u64).wrapping_sub(br);
        d[j] = u as u32;
        br = u >> 63u64;
    }
    // The difference when the sum overflowed or reached p.
    let mask = 0u32.wrapping_sub((c as u32) | ((br as u32) ^ 1u32));
    for j in 0usize..12 { d[j] = (d[j] & mask) | (s[j] & ~mask); }
    d
}

/// `(a - b) mod p` for `a, b < p`.
pub(pkg) fn sub_p384(a: Fe, b: Fe) -> Fe {
    let d = fe_zero();
    let br = 0u64;
    for j in 0usize..12 {
        let u = (a[j] as u64).wrapping_sub(b[j] as u64).wrapping_sub(br);
        d[j] = u as u32;
        br = u >> 63u64;
    }
    // Add p back on a borrow.
    let mask = 0u64.wrapping_sub(br);
    let c = 0u64;
    for j in 0usize..12 {
        let u = (d[j] as u64) + ((P384[j] as u64) & mask) + c;
        d[j] = u as u32;
        c = u >> 32u64;
    }
    d
}
