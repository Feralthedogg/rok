// Secret storage (2.21.5): a buffer in the large-object space, so the
// collector never moves or copies it, zeroed by `wipe`, by `using`
// release and by the collection that frees it (`rok_gc_secret_new`).
// `Secret` is the public byte form; `SecretWords` holds the algorithms'
// 32-bit key schedules and polynomials.

use sup::{view, Bytes};
use rok::core::collections::raw::{GcBuf, buf_erase, cap_mul};
use rok::core::index::index_oob;

/// A fixed-length secret byte string. Copies share the bytes.
pub struct Secret {
    w: GcBuf<u32>;
    len: usize;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl !Sync for Secret {}

impl Secret {
    /// `len` zero bytes.
    pub fn zeroed(len: usize) -> Secret {
        Secret { w: unsafe { rok_gc_secret_new(len) }, len }
    }

    /// A copy of `bytes`.
    pub fn new(bytes: Bytes) -> Secret {
        let b = view(bytes);
        let s = Secret::zeroed(b.len());
        let d = buf_erase(s.w);
        for i in 0..b.len() {
            unsafe { d[i] = b[i]; }
        }
        s
    }

    pub fn len(self) -> usize { self.len }

    /// The bytes where they are, not a copy: a view reads zeros once
    /// the secret is wiped.
    pub fn as_bytes(self) -> Slice<u8> {
        unsafe { Slice::from_raw_parts(buf_erase(self.w), 0, self.len) }
    }

    /// Overwrite the bytes with zeros now; every copy and view sees it.
    pub fn wipe(self) {
        unsafe { rok_gc_secret_wipe(self.w) };
    }
}

impl Index<usize> for Secret {
    type Output = u8;
    #[track_caller]
    fn index(self, i: usize) -> u8 {
        if i >= self.len { index_oob("Secret index", i, self.len); }
        unsafe { buf_erase(self.w)[i] }
    }
}

impl IndexSet<usize> for Secret {
    type Value = u8;
    #[track_caller]
    fn index_set(self, i: usize, v: u8) {
        if i >= self.len { index_oob("Secret index", i, self.len); }
        unsafe { buf_erase(self.w)[i] = v; }
    }
}

/// `s[a:b]`: a view of those bytes in place, like `as_bytes`.
impl Sliceable<Range<usize>> for Secret {
    type Output = Slice<u8>;
    fn slice(self, r: Range<usize>) -> Slice<u8> { self.as_bytes().slice(r) }
}

/// `using` release wipes.
impl Drop for Secret {
    fn drop(ref self) { self.wipe(); }
}

/// The length only.
impl Debug for Secret {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"Secret({self.len} bytes)") }
}

/// `n` secret words, zeroed at first.
pub(pkg) struct SecretWords {
    w: GcBuf<u32>;
    n: usize;
}

impl !Sync for SecretWords {}

impl SecretWords {
    #[track_caller]
    pub(pkg) fn new(n: usize) -> SecretWords {
        SecretWords { w: unsafe { rok_gc_secret_new(cap_mul(n, 4)) }, n }
    }

    pub(pkg) fn len(self) -> usize { self.n }

    /// Word `i`, unchecked: the caller checked `i < len`.
    pub(pkg) unsafe fn at(self, i: usize) -> u32 { unsafe { self.w[i] } }

    pub(pkg) fn wipe(self) {
        unsafe { rok_gc_secret_wipe(self.w) };
    }
}

impl Index<usize> for SecretWords {
    type Output = u32;
    #[track_caller]
    fn index(self, i: usize) -> u32 {
        if i >= self.n { index_oob("SecretWords index", i, self.n); }
        unsafe { self.w[i] }
    }
}

impl IndexSet<usize> for SecretWords {
    type Value = u32;
    #[track_caller]
    fn index_set(self, i: usize, v: u32) {
        if i >= self.n { index_oob("SecretWords index", i, self.n); }
        unsafe { self.w[i] = v; }
    }
}
