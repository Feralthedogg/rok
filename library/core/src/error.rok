// rok::core::error - `Result<T, E>`, an error kept as a value.
// Errors travel through `throws` / `try` (spec 4.14); `Result` is for
// holding one (collected results, callbacks, caches): "throw it →
// `throws`; keep it → `Result`". `?` does not apply to it (`T | none`
// only).
//
// `Ok` / `Err` are bare names everywhere through the implicit
// `use rok::core::**` (variants are reachable by globs).

pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    /// Run `f`, keeping its value or its error.
    pub const fn catching(f: fn() throws (E) -> T) -> Result<T, E> {
        try Result::Ok(f()) catch e { Result::Err(e) }
    }

    pub const fn is_ok(self) -> bool {
        match self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        }
    }

    pub const fn is_err(self) -> bool {
        match self {
            Result::Ok(_) => false,
            Result::Err(_) => true,
        }
    }

    pub const fn ok(self) -> T | none {
        match self {
            Result::Ok(v) => v,
            Result::Err(_) => none,
        }
    }

    pub fn err(self) -> E | none {
        match self {
            Result::Ok(_) => none,
            Result::Err(e) => e,
        }
    }

    /// Back into the error flow: the value, or `throw` the error.
    pub const fn get(self) throws (E) -> T {
        match self {
            Result::Ok(v) => v,
            Result::Err(e) => throw e,
        }
    }

    /// The value; panics on `Err`.
    #[track_caller]
    pub const fn unwrap(self) -> T {
        try! self.get()
    }

    pub const fn unwrap_or(self, default: T) -> T {
        match self {
            Result::Ok(v) => v,
            Result::Err(_) => default,
        }
    }

    pub const fn unwrap_or_else(self, f: fn(E) -> T) -> T {
        match self {
            Result::Ok(v) => v,
            Result::Err(e) => f(e),
        }
    }

    pub const fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Result::Ok(v) => Result::Ok(f(v)),
            Result::Err(e) => Result::Err(e),
        }
    }

    pub const fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Result::Ok(v) => Result::Ok(v),
            Result::Err(e) => Result::Err(f(e)),
        }
    }

    pub const fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Result::Ok(v) => f(v),
            Result::Err(e) => Result::Err(e),
        }
    }

    pub const fn or_else<F>(self, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        match self {
            Result::Ok(v) => Result::Ok(v),
            Result::Err(e) => f(e),
        }
    }
}

/// A `str` that is not a valid value of the requested type (stdlib
/// spec 2.14.4; thrown by `str::parse` / `FromStr`).
pub struct ParseError {
    pub input: str;
    pub pos: usize;
    pub reason: str;
}

impl Display for ParseError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"cannot parse \"{self.input}\": {self.reason}") }
}

impl Debug for ParseError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"ParseError({self})") }
}

impl Error for ParseError {}

/// An invalid argument value (stdlib spec 2.14.4;
/// `char::to_digit`, ...).
pub struct ValueError {
    pub msg: str;
}

impl Display for ValueError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.msg) }
}

impl Debug for ValueError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"ValueError({self.msg:?})") }
}

impl Error for ValueError {}

/// A value out of a fixed-width type's range in a checked conversion
/// (stdlib spec 2.14.4; thrown by `try_from` / `try_into`).
pub struct OverflowError {
    /// `"try_from"`, ...
    pub op: str;
    /// The target type: `"i32"`, ...
    pub ty: str;
}

impl Display for OverflowError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"{self.op}: value out of range for `{self.ty}`") }
}

impl Debug for OverflowError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"OverflowError({self})") }
}

impl Error for OverflowError {}

/// A failed `TryFrom` conversion: the trait's default `Error` (stdlib
/// spec 2.11.4) for impls that name no more specific one.
pub struct ConversionError {
    pub msg: str;
}

impl Display for ConversionError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.msg) }
}

impl Debug for ConversionError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"ConversionError({self.msg:?})") }
}

impl Error for ConversionError {}

/// A value of the wrong type (stdlib spec 2.14.4).
pub struct TypeError {
    pub expected: str;
    pub actual: str;
}

impl Display for TypeError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"expected `{self.expected}`, found `{self.actual}`") }
}

impl Debug for TypeError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(f"TypeError {{ expected: {self.expected:?}, actual: {self.actual:?} }}")
    }
}

impl Error for TypeError {}

/// An index out of range in a throwing API (stdlib spec 2.14.4;
/// `List::set`). `xs[i]` out of range panics instead.
pub struct IndexError {
    pub index: i64;
    pub len: usize;
}

impl Display for IndexError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"index {self.index} out of bounds (len {self.len})") }
}

impl Debug for IndexError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(f"IndexError {{ index: {self.index}, len: {self.len} }}")
    }
}

impl Error for IndexError {}

// Fatal errors (stdlib spec 2.14.4): never thrown; the runtime reports
// these conditions and exits with 101.

pub struct StackOverflowError;

impl Display for StackOverflowError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("stack overflow") }
}

impl Debug for StackOverflowError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("StackOverflowError") }
}

impl Error for StackOverflowError {}

pub struct OutOfMemoryError;

impl Display for OutOfMemoryError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("out of memory") }
}

impl Debug for OutOfMemoryError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("OutOfMemoryError") }
}

impl Error for OutOfMemoryError {}

pub struct InternalError;

impl Display for InternalError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("internal compiler error") }
}

impl Debug for InternalError {
    const fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("InternalError") }
}

impl Error for InternalError {}

/// Every error type's surface (stdlib spec 2.14.3). Untyped `throws`
/// means `throws (any Error)`.
pub trait Error: Display + Debug {
    /// The error that caused this one, if any.
    const fn source(self) -> any Error | none {
        none
    }
}

/// `Ok(<v:?>)` / `Err(<e:?>)`.
impl<T: Debug, E: Debug> Debug for Result<T, E> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        match self {
            Result::Ok(v) => {
                try f.write_str("Ok(");
                try Debug::fmt(v, ref f);
            }
            Result::Err(e) => {
                try f.write_str("Err(");
                try Debug::fmt(e, ref f);
            }
        }
        try f.write_str(")")
    }
}
