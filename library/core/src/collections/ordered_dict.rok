// rok::core::collections::ordered_dict — `OrderedDict<K, V>`, a hash map
// that iterates in insertion order (stdlib spec 2.9.5): a `Dict`, whose
// compact entries already keep that order. Re-inserting a present key
// keeps its place; a removed key re-inserted goes last.

pub struct OrderedDict<K, V> {
    d: Dict<K, V>;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl<K, V> !Sync for OrderedDict<K, V> {}

impl<K: Hash, V> OrderedDict<K, V> {
    pub const fn new() -> OrderedDict<K, V> {
        OrderedDict { d: Dict::new() }
    }

    pub const fn with_capacity(cap: usize) -> OrderedDict<K, V> {
        OrderedDict { d: Dict::with_capacity(cap) }
    }

    /// The pairs inserted in order (a later duplicate key replaces the
    /// value in the first one's place).
    pub const fn from(pairs: List<(K, V)>) -> OrderedDict<K, V> {
        let d: OrderedDict<K, V> = OrderedDict::with_capacity(pairs.len());
        for (k, v) in pairs {
            d.insert(k, v);
        }
        d
    }

    pub const fn len(self) -> usize {
        self.d.len()
    }

    pub const fn is_empty(self) -> bool {
        self.d.is_empty()
    }

    /// Insert or replace; the old value, or `none`.
    pub const fn insert(self, k: K, v: V) -> V | none {
        self.d.insert(k, v)
    }

    pub const fn get(self, k: K) -> V | none {
        self.d.get(k)
    }

    pub const fn contains_key(self, k: K) -> bool {
        self.d.contains_key(k)
    }

    pub const fn remove(self, k: K) -> V | none {
        self.d.remove(k)
    }

    pub const fn clear(self) {
        self.d.clear();
    }

    /// The keys in insertion order, lazily.
    pub const fn keys(self) -> KeysIter<K, V> {
        self.d.keys()
    }

    /// The values in insertion order, lazily.
    pub const fn values(self) -> ValuesIter<K, V> {
        self.d.values()
    }

    /// `(key, value)` pairs in insertion order, lazily.
    pub const fn entries(self) -> EntriesIter<K, V> {
        self.d.entries()
    }
}

impl<K: Hash, V> Default for OrderedDict<K, V> {
    fn default() -> OrderedDict<K, V> { OrderedDict::new() }
}

impl<K: Hash + Clone, V: Clone> Clone for OrderedDict<K, V> {
    const fn clone(self) -> OrderedDict<K, V> {
        let r: OrderedDict<K, V> = OrderedDict::with_capacity(self.len());
        for (k, v) in self {
            r.insert(k.clone(), v.clone());
        }
        r
    }
}

/// `for (k, v) in d`, in insertion order (2.9.9).
impl<K: Hash, V> IntoIterator for OrderedDict<K, V> {
    type IntoIter = EntriesIter<K, V>;
    type Item = (K, V);
    const fn into_iter(self) -> EntriesIter<K, V> {
        self.entries()
    }
}

impl<K: Hash, V> FromIterator<(K, V)> for OrderedDict<K, V> {
    const fn from_iter<I: IntoIterator<Item = (K, V)>>(it: I) -> OrderedDict<K, V> {
        let out: OrderedDict<K, V> = OrderedDict::new();
        for (k, v) in it {
            out.insert(k, v);
        }
        out
    }
}

/// `d[k]`; panics when the key is absent.
impl<K: Hash, V> Index<K> for OrderedDict<K, V> {
    type Output = V;
    const fn index(self, k: K) -> V {
        self.d[k]
    }
}

/// `d[k] = v` inserts or replaces.
impl<K: Hash, V> IndexSet<K> for OrderedDict<K, V> {
    type Value = V;
    const fn index_set(self, k: K, v: V) {
        self.insert(k, v);
    }
}

/// Same keys, equal values (order does not matter, as for `Dict`).
impl<K: Hash, V: PartialEq> PartialEq for OrderedDict<K, V> {
    const fn eq(self, rhs: OrderedDict<K, V>) -> bool {
        if self.len() != rhs.len() { return false; }
        for (k, v) in self {
            if !rhs.contains_key(k) || rhs[k] != v { return false; }
        }
        true
    }
    fn ne(self, rhs: OrderedDict<K, V>) -> bool { !self.eq(rhs) }
}

/// `{k: v, ..}` in insertion order.
impl<K: Hash + Debug, V: Debug> Debug for OrderedDict<K, V> {
    const fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("{");
        let first = true;
        for (k, v) in self {
            if !first { try f.write_str(", "); }
            try Debug::fmt(k, ref f);
            try f.write_str(": ");
            try Debug::fmt(v, ref f);
            first = false;
        }
        try f.write_str("}")
    }
}
