// rok::core::collections::slice — `Slice<T>`, a zero-copy view (stdlib
// spec 2.9.7): element `i` is `buf[start + i * stride]`. The view holds
// its buffer, so the storage stays alive as long as the view does.
//
// `xs[a:b]` desugars to `xs.slice(a..b)` (`Sliceable<Range<usize>>`, 2.3.4;
// a missing bound is `0` / `xs.len()`), and `xs[a:b:k]` to
// `xs.slice(r).step(k)` with `r = index::slice_range(a, b, k, len)`:
// Python's semantics (bounds clamp, a negative step reads them from the
// end, `xs[::-1]` reverses). `step` walks the selected range, from its
// end when negative. A view of a `List` sees later
// writes to the list's elements but not a regrowth (the list moves to a
// new buffer and the view keeps the old one); a view of a fixed array
// or a `StrBuf` views a copy, and `str::as_bytes` views the string's
// own bytes.

pub struct Slice<T> {
    pub(pkg) buf: GcBuf<T>;
    pub(pkg) start: usize;
    pub(pkg) len: usize;
    pub(pkg) stride: isize;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl<T> !Sync for Slice<T> {}

/// A contiguous view of `buf[r]` (`r` clamped to the length `n`).
pub(pkg) const fn view_of<T>(buf: GcBuf<T>, r: Range<usize>, n: usize) -> Slice<T> {
    let r = clamp_range(r, n);
    Slice { buf: buf, start: r.start, len: r.end - r.start, stride: 1 }
}

impl<T> Slice<T> {
    pub const fn len(self) -> usize {
        self.len
    }

    pub const fn is_empty(self) -> bool {
        self.len == 0
    }

    /// Buffer index of element `i` (`i < len`).
    const fn at(self, i: usize) -> usize {
        ((self.start as isize) + (i as isize) * self.stride) as usize
    }

    /// Element `i`, or `none` out of bounds.
    pub const fn get(self, i: usize) -> T | none {
        unsafe {
            if i >= self.len {
                return none;
            }
            return self.buf[self.at(i)];
        }
    }

    pub const fn first(self) -> T | none {
        self.get(0)
    }

    pub const fn last(self) -> T | none {
        if self.len == 0 {
            return none;
        }
        self.get(self.len - 1)
    }

    /// Every `k`th element (`k` != 0), back to front when `k` < 0.
    #[track_caller]
    pub const fn step(self, k: isize) -> Slice<T> {
        if k == 0 {
            panic("slice step must not be zero");
        }
        let m = if k < 0 { -k } else { k };
        let n = (self.len + (m as usize) - 1) / (m as usize);
        let first = if k < 0 && self.len > 0 { self.at(self.len - 1) } else { self.start };
        Slice { buf: self.buf, start: first, len: n, stride: self.stride * k }
    }

    pub const fn iter(self) -> SliceIter<T> {
        SliceIter { s: self, i: 0 }
    }

    /// `(buffer, start, len)` of the viewed elements as one contiguous
    /// run, for runtime calls on a buffer region. A strided view is
    /// copied first, so writes through its run do not reach the view.
    pub const unsafe fn raw_parts(self) -> (GcBuf<T>, usize, usize) {
        if self.stride == 1 {
            return (self.buf, self.start, self.len);
        }
        (self.to_list().buffer(), 0, self.len)
    }

    /// The view `raw_parts` takes apart: `len` elements of `buf` from
    /// `start`.
    pub const unsafe fn from_raw_parts(buf: GcBuf<T>, start: usize, len: usize) -> Slice<T> {
        Slice { buf: buf, start: start, len: len, stride: 1 }
    }

    /// A new list holding the viewed elements.
    pub const fn to_list(self) -> List<T> {
        let out: List<T> = List::with_capacity(self.len);
        for x in self {
            out.push(x);
        }
        out
    }
}

/// `s.iter()` / `for x in s`, in view order.
pub struct SliceIter<T> {
    s: Slice<T>;
    i: usize;
    /// Items taken from the back (`next_back`).
    back: usize = 0;
}

impl<T> Iterator for SliceIter<T> {
    type Item = T;
    const fn next(ref self) -> T | none {
        unsafe {
            if self.i + self.back >= self.s.len {
                return none;
            }
            self.i += 1;
            // `return`: with `T = ()` a bare tail reads as a missing value.
            return self.s.buf[self.s.at(self.i - 1)];
        }
    }

    /// `ExactSizeIterator`: O(1) (2.7.10).
    const fn count(self) -> usize { self.len() }
}

impl<T> DoubleEndedIterator for SliceIter<T> {
    const fn next_back(ref self) -> T | none {
        unsafe {
            if self.i + self.back >= self.s.len {
                return none;
            }
            self.back += 1;
            return self.s.buf[self.s.at(self.s.len - self.back)];
        }
    }
}

impl<T> ExactSizeIterator for SliceIter<T> {
    const fn len(self) -> usize { self.s.len - self.i - self.back }
}

impl<T> IntoIterator for Slice<T> {
    type IntoIter = SliceIter<T>;
    type Item = T;
    const fn into_iter(self) -> SliceIter<T> {
        self.iter()
    }
}

/// `s[i]`; panics out of bounds. Views are read-only (no `IndexSet`).
impl<T> Index<usize> for Slice<T> {
    type Output = T;
    #[track_caller]
    const fn index(self, i: usize) -> T {
        unsafe {
            if i >= self.len {
                return index_oob("slice index", i, self.len);
            }
            self.buf[self.at(i)]
        }
    }
}

/// `s[a:b]`: a view of the view.
impl<T> Sliceable<Range<usize>> for Slice<T> {
    type Output = Slice<T>;
    const fn slice(self, r: Range<usize>) -> Slice<T> {
        let r = clamp_range(r, self.len);
        let first = if r.start < self.len { self.at(r.start) } else { self.start };
        Slice { buf: self.buf, start: first, len: r.end - r.start, stride: self.stride }
    }
}

/// `xs[a:b]` (2.9.8): a view of the list's current buffer.
impl<T> Sliceable<Range<usize>> for List<T> {
    type Output = Slice<T>;
    const fn slice(self, r: Range<usize>) -> Slice<T> {
        view_of(self.buffer(), r, self.len())
    }
}

/// `a[i:j]` on a fixed array: a view of a GC copy (arrays are values).
impl<T, const N: usize> Sliceable<Range<usize>> for [T; N] {
    type Output = Slice<T>;
    const fn slice(self, r: Range<usize>) -> Slice<T> {
        unsafe {
            let r = clamp_range(r, N);
            let buf: GcBuf<T> = buf_new(r.end - r.start);
            for i in r.start..r.end {
                buf[i - r.start] = self[i];
            }
            Slice { buf: buf, start: 0, len: r.end - r.start, stride: 1 }
        }
    }
}

impl Slice<u8> {
    /// The offset of the first occurrence of `needle`, or `none`; an
    /// empty needle is at 0. A `b"..."` argument is a view.
    // Naive O(n * m) scan.
    pub const fn find(self, needle: Slice<u8> | List<u8>) -> usize | none {
        let p = match needle {
            s: Slice<u8> => s,
            l: List<u8> => l[:],
        };
        let m = p.len;
        if m > self.len {
            return none;
        }
        for i in 0..self.len - m + 1 {
            let j: usize = 0;
            while j < m && self[i + j] == p[j] {
                j += 1;
            }
            if j == m {
                return i;
            }
        }
        none
    }
}

impl List<u8> {
    /// `self[:].find(needle)`.
    pub const fn find(self, needle: Slice<u8> | List<u8>) -> usize | none {
        self[:].find(needle)
    }
}

/// Element-wise, in view order.
impl<T: PartialEq> PartialEq for Slice<T> {
    const fn eq(self, rhs: Slice<T>) -> bool {
        if self.len != rhs.len { return false; }
        for i in 0..self.len {
            if self[i] != rhs[i] { return false; }
        }
        true
    }
    fn ne(self, rhs: Slice<T>) -> bool { !self.eq(rhs) }
}

/// `[a, b, c]` like a list.
impl<T: Debug> Debug for Slice<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("[");
        for i in 0..self.len {
            if i > 0 { try f.write_str(", "); }
            try Debug::fmt(self[i], ref f);
        }
        try f.write_str("]")
    }
}
