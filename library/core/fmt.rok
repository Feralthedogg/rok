// rok::core::fmt — Display / Debug and the f-string helpers (stdlib
// 2.10, refs-lang 1.7.3).
//
// ponytail: spec 2.10 has `fn fmt(self, ref f: Formatter) throws
// (FmtError)` writing into a `Formatter` and eight traits (Binary,
// LowerHex, ...). Here `display` / `debug` return a new `str`; HIR
// lowers `f"..."` by each hole's type to `display()` / `debug()` or the
// `fstr_*` functions below, which apply the spec (fill / align / sign /
// `#` / `0` / width / precision / type letter) in the runtime. Upgrade
// when `ref` parameters and a growable `str` exist.

#[lang("display_trait")]
pub trait Display {
    fn display(self) -> str;
}

#[lang("debug_trait")]
pub trait Debug {
    fn debug(self) -> str;
}

extern "C" {
    fn rok_str_from_i64(n: i64) -> str;
    fn rok_str_from_u64(n: u64) -> str;
    fn rok_str_from_f64(d: f64, prec: i32) -> str;
    fn rok_str_from_char(c: u32) -> str;
    fn rok_str_debug(s: str) -> str;
    fn rok_fmt_int(v: u64, kind: u32, spec: str) -> str;
    fn rok_fmt_float(v: f64, is_f32: u32, spec: str) -> str;
    fn rok_fmt_str(disp: str, dbg: str, spec: str) -> str;
    fn rok_gc_alloc_bytes(size: usize, traced: i32) -> str;
    fn rok_str_write_at(dst: str, off: usize, src: str);
}

// f-string lowering targets (HIR calls them by full path; `spec` is the
// text after `:`).

/// A signed integer of `bits` bits.
pub fn fstr_int(v: i64, bits: u32, spec: str) -> str {
    unsafe { rok_fmt_int(v as u64, bits | 256u32, spec) }
}
/// An unsigned integer of `bits` bits.
pub fn fstr_uint(v: u64, bits: u32, spec: str) -> str { unsafe { rok_fmt_int(v, bits, spec) } }
/// A float (`is_f32`: format as `f32`).
pub fn fstr_float(v: f64, is_f32: bool, spec: str) -> str {
    unsafe { rok_fmt_float(v, if is_f32 { 1u32 } else { 0u32 }, spec) }
}
/// Any other value as its `display()` (or `debug()` for `?`).
pub fn fstr_str(disp: str, dbg: str, spec: str) -> str { unsafe { rok_fmt_str(disp, dbg, spec) } }

/// The pieces of an f-string in one allocation.
pub fn fstr_join<const N: usize>(parts: [str; N]) -> str {
    let n = 0usize;
    let i = 0usize;
    while i < N {
        n = n + parts[i].len();
        i = i + 1;
    }
    let out = unsafe { rok_gc_alloc_bytes(n, 0) };
    let at = 0usize;
    i = 0;
    while i < N {
        unsafe { rok_str_write_at(out, at, parts[i]) };
        at = at + parts[i].len();
        i = i + 1;
    }
    out
}

impl Display for i8 { fn display(self) -> str { unsafe { rok_str_from_i64(self as i64) } } }
impl Display for i16 { fn display(self) -> str { unsafe { rok_str_from_i64(self as i64) } } }
impl Display for i32 { fn display(self) -> str { unsafe { rok_str_from_i64(self as i64) } } }
impl Display for i64 { fn display(self) -> str { unsafe { rok_str_from_i64(self) } } }
impl Display for isize { fn display(self) -> str { unsafe { rok_str_from_i64(self as i64) } } }
impl Display for u8 { fn display(self) -> str { unsafe { rok_str_from_u64(self as u64) } } }
impl Display for u16 { fn display(self) -> str { unsafe { rok_str_from_u64(self as u64) } } }
impl Display for u32 { fn display(self) -> str { unsafe { rok_str_from_u64(self as u64) } } }
impl Display for u64 { fn display(self) -> str { unsafe { rok_str_from_u64(self) } } }
impl Display for usize { fn display(self) -> str { unsafe { rok_str_from_u64(self as u64) } } }
impl Display for f32 { fn display(self) -> str { unsafe { rok_str_from_f64(self as f64, 0 - 1) } } }
impl Display for f64 { fn display(self) -> str { unsafe { rok_str_from_f64(self, 0 - 1) } } }
impl Display for bool {
    fn display(self) -> str { if self { "true" } else { "false" } }
}
impl Display for char { fn display(self) -> str { unsafe { rok_str_from_char(self as u32) } } }
impl Display for str { fn display(self) -> str { self } }

impl Debug for i8 { fn debug(self) -> str { self.display() } }
impl Debug for i16 { fn debug(self) -> str { self.display() } }
impl Debug for i32 { fn debug(self) -> str { self.display() } }
impl Debug for i64 { fn debug(self) -> str { self.display() } }
impl Debug for isize { fn debug(self) -> str { self.display() } }
impl Debug for u8 { fn debug(self) -> str { self.display() } }
impl Debug for u16 { fn debug(self) -> str { self.display() } }
impl Debug for u32 { fn debug(self) -> str { self.display() } }
impl Debug for u64 { fn debug(self) -> str { self.display() } }
impl Debug for usize { fn debug(self) -> str { self.display() } }
impl Debug for f32 { fn debug(self) -> str { self.display() } }
impl Debug for f64 { fn debug(self) -> str { self.display() } }
impl Debug for bool { fn debug(self) -> str { self.display() } }
// ponytail: no escaping of `'` / control chars in `char` Debug.
impl Debug for char {
    fn debug(self) -> str { "'" + unsafe { rok_str_from_char(self as u32) } + "'" }
}
impl Debug for str { fn debug(self) -> str { unsafe { rok_str_debug(self) } } }
