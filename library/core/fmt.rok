// rok::core::fmt — `Formatter`, `Display` / `Debug`, `Format` and the
// f-string lowering targets (stdlib 2.10, refs-lang 1.7.3).
//
// Every rendering writes into a `Formatter`: the runtime's growing text
// plus the spec of the value being written. HIR lowers `f"..."` to one
// such text: literal pieces and primitive holes go to the runtime
// directly, any other hole through `Display::fmt` / `Debug::fmt`
// (`fstr_*` below), and `rok_fmt_finish` hands the text over as the
// `str` without a copy.

use rok::core::collections::raw::{GcBuf, buf_new};

/// A failed write (2.10.12). Writing to memory never fails.
pub struct FmtError;

impl Display for FmtError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("an error occurred when formatting") }
}

impl Debug for FmtError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("FmtError") }
}

/// The spec's `align`.
pub enum Alignment {
    Left,
    Right,
    Center,
    Equal,
}

/// The spec's `sign`.
pub enum Sign {
    Plus,
    Minus,
    Space,
}

/// What `f"{x}"` writes.
#[lang("display_trait")]
pub trait Display {
    fn fmt(self, ref f: Formatter) throws (FmtError);
}

/// What `f"{x:?}"` writes.
#[lang("debug_trait")]
pub trait Debug {
    fn fmt(self, ref f: Formatter) throws (FmtError);
}

/// An f-string spec, `[[fill]align][sign][#][0][width][.precision][type]`
/// (refs-lang 1.7.3). An absent `align`, `sign` or `ty` is `'\0'`; the
/// Display letters `s d g` read as absent.
pub struct FormatSpec {
    pub fill: char;
    pub align: char;
    pub sign: char;
    pub alt: bool;
    pub zero: bool;
    pub width: usize | none;
    pub precision: usize | none;
    pub ty: char;
}

/// A number rendered per a spec into a new `str` (2.10.5).
pub trait Format {
    fn format(self, spec: FormatSpec) -> str;
}

impl FormatSpec {
    /// The empty spec.
    pub fn new() -> FormatSpec {
        FormatSpec {
            fill: ' ', align: '\0', sign: '\0', alt: false, zero: false,
            width: none, precision: none, ty: '\0',
        }
    }

    /// `text` parsed by the runtime with the parser the compiler checks
    /// static specs with; panics on a malformed spec.
    pub fn parse(text: str) -> FormatSpec {
        let w: GcBuf<i64> = buf_new(8);
        unsafe { rok_fmt_spec_parse(text, w) };
        let s = FormatSpec::new();
        s.fill = char::from_u32(w[0] as u32) ?? ' ';
        s.align = (w[1] as u8) as char;
        s.sign = (w[2] as u8) as char;
        s.alt = w[3] != 0;
        s.zero = w[4] != 0;
        if w[5] >= 0 { s.width = w[5] as usize; }
        if w[6] >= 0 { s.precision = w[6] as usize; }
        s.ty = (w[7] as u8) as char;
        s
    }
}

/// Where a value's text goes, with the spec it is written by (2.10.2):
/// the runtime's growing text (`rok_fmt_*`) and the spec packed in two
/// words — `flags`: fill (bits 0..32), align, sign, type (a byte each
/// from bit 32), `#` (bit 56), `0` (bit 57); `counts`: width, precision
/// (32 bits each, all ones when absent).
pub struct Formatter {
    pub(pkg) t: str;
    pub(pkg) flags: u64;
    pub(pkg) counts: u64;
}

/// The packed words of no spec.
const PLAIN_FLAGS: u64 = 32;
const PLAIN_COUNTS: u64 = 0xFFFFFFFFFFFFFFFF;

/// A packed count: all ones when absent.
fn count_bits(v: usize | none) -> u64 {
    match v {
        n: usize => if n < 0xFFFFFFFF { n as u64 } else { 0xFFFFFFFEu64 },
        none => 0xFFFFFFFFu64,
    }
}

impl Formatter {
    pub fn new() -> Formatter { Formatter::with_capacity(16) }

    /// Empty, with room for `cap` bytes.
    pub fn with_capacity(cap: usize) -> Formatter {
        Formatter { t: unsafe { rok_fmt_new(cap) }, flags: PLAIN_FLAGS, counts: PLAIN_COUNTS }
    }

    /// Empty, writing values per `spec`.
    pub fn with_spec(spec: FormatSpec) -> Formatter {
        let f = Formatter::new();
        let ty = if spec.ty == 's' || spec.ty == 'd' || spec.ty == 'g' { '\0' } else { spec.ty };
        let alt = if spec.alt { 1u64 } else { 0u64 };
        let zero = if spec.zero { 1u64 } else { 0u64 };
        f.flags = (spec.fill as u64) + ((spec.align as u64) << 32u64) + ((spec.sign as u64) << 40u64)
            + ((ty as u64) << 48u64) + (alt << 56u64) + (zero << 57u64);
        let p: usize | none = none;
        if let n: usize = spec.precision { p = if n > 500 { 500 } else { n }; }
        f.counts = count_bits(spec.width) + (count_bits(p) << 32u64);
        f
    }

    /// The text written, as a `str` (no copy); the formatter is spent.
    pub fn finish(self) -> str { unsafe { rok_fmt_finish(self.t) } }

    pub fn write_str(ref self, s: str) throws (FmtError) { self.t = unsafe { rok_fmt_str(self.t, s) }; }

    pub fn write_char(ref self, c: char) throws (FmtError) { self.t = unsafe { rok_fmt_char(self.t, c as u32) }; }

    /// `s` cut to `precision` chars and padded to `width` (text aligns
    /// left by default).
    pub fn pad(ref self, s: str) throws (FmtError) {
        let start = unsafe { rok_fmt_len(self.t) };
        self.t = unsafe { rok_fmt_str(self.t, s) };
        self.t = unsafe { rok_fmt_pad(self.t, self.flags, self.counts, start, start, 0u32) };
    }

    /// An integer: the sign, `prefix` (`"0x"` ..) under `#`, the digits
    /// `buf`, padded to `width` — right by default; `0` and `=` fill
    /// between the prefix and the digits.
    pub fn pad_integral(ref self, is_nonnegative: bool, prefix: str, buf: str) throws (FmtError) {
        let nonneg = if is_nonnegative { 1u32 } else { 0u32 };
        self.t = unsafe { rok_fmt_integral(self.t, prefix, buf, self.flags, self.counts, nonneg) };
    }

    pub fn fill(self) -> char { char::from_u32((self.flags & 0xFFFFFFFFu64) as u32) ?? ' ' }

    /// `none` when the spec names no alignment: numbers then align
    /// right, other values left.
    pub fn align(self) -> Alignment | none {
        let a = self.byte(32u64);
        if a == '<' { return Alignment::Left; }
        if a == '>' { return Alignment::Right; }
        if a == '^' { return Alignment::Center; }
        if a == '=' { Alignment::Equal } else { none }
    }

    pub fn sign(self) -> Sign | none {
        let s = self.byte(40u64);
        if s == '+' { return Sign::Plus; }
        if s == '-' { return Sign::Minus; }
        if s == ' ' { Sign::Space } else { none }
    }

    pub fn alternate(self) -> bool { ((self.flags >> 56u64) & 1u64) != 0u64 }
    pub fn pad_zero(self) -> bool { ((self.flags >> 57u64) & 1u64) != 0u64 }
    pub fn width(self) -> usize | none { count_of(self.counts) }
    pub fn precision(self) -> usize | none { count_of(self.counts >> 32u64) }

    /// The spec's type letter (`'\0'` for none or `s d g`).
    pub(pkg) fn ty(self) -> char { self.byte(48u64) }

    fn byte(self, at: u64) -> char { (((self.flags >> at) & 0xFFu64) as u8) as char }
}

fn count_of(v: u64) -> usize | none {
    let n = v & 0xFFFFFFFFu64;
    if n == 0xFFFFFFFFu64 { none } else { n as usize }
}

// f-string lowering targets (HIR calls them by full path, on the text
// `t`; each returns it, maybe moved). Formatting to memory never fails.

/// `{v}`.
pub fn fstr_display<T: Display>(t: str, v: T) -> str {
    let f = Formatter { t: t, flags: PLAIN_FLAGS, counts: PLAIN_COUNTS };
    try! Display::fmt(v, ref f);
    f.t
}

/// `{v:?}`.
pub fn fstr_debug<T: Debug>(t: str, v: T) -> str {
    let f = Formatter { t: t, flags: PLAIN_FLAGS, counts: PLAIN_COUNTS };
    try! Debug::fmt(v, ref f);
    f.t
}

/// A number under a spec (`flags`, `counts`).
pub fn fstr_num<T: Display>(t: str, v: T, flags: u64, counts: u64) -> str {
    let f = Formatter { t: t, flags: flags, counts: counts };
    try! Display::fmt(v, ref f);
    f.t
}

/// A dynamic spec's packed words; panics when malformed, or when
/// `text_only` and it has a number's type letter.
pub fn fstr_pack(spec: str, text_only: bool) -> (u64, u64) {
    let out: GcBuf<u64> = buf_new(2);
    unsafe { rok_fmt_pack(spec, if text_only { 1u32 } else { 0u32 }, out) };
    (out[0], out[1])
}

/// A dynamic spec on a value with both: `?` picks the Debug; then cut
/// and padded as text.
pub fn fstr_text_any<T: Display + Debug>(t: str, v: T, spec: str) -> str {
    let (flags, counts) = fstr_pack(spec, true);
    let start = unsafe { rok_fmt_len(t) };
    let debug = ((flags >> 48u64) & 0xFFu64) == 63u64;
    let out = if debug { fstr_debug(t, v) } else { fstr_display(t, v) };
    unsafe { rok_fmt_pad(out, flags, counts, start, start, 0u32) }
}

/// `Format::format` for every number: `v`'s Display under `spec`.
pub(pkg) fn format_number<T: Display>(v: T, spec: FormatSpec) -> str {
    let f = Formatter::with_spec(spec);
    try! Display::fmt(v, ref f);
    f.finish()
}

// Integers: `b o x X` show a fixed-width integer's two's complement at
// its width (2.10.5).
impl Display for i8 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 1u32, 8u32) }; } }
impl Display for i16 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 1u32, 16u32) }; } }
impl Display for i32 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 1u32, 32u32) }; } }
impl Display for i64 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self, 1u32, 64u32) }; } }
impl Display for isize { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 1u32, 64u32) }; } }
impl Display for u8 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 0u32, 8u32) }; } }
impl Display for u16 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 0u32, 16u32) }; } }
impl Display for u32 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 0u32, 32u32) }; } }
impl Display for u64 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 0u32, 64u32) }; } }
impl Display for usize { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_int(f.t, f.flags, f.counts, self as i64, 0u32, 64u32) }; } }
/// Shortest round-trip digits, never an exponent (`1`, `0.1`, `1e21` as
/// `1000000000000000000000`), `inf` / `NaN`.
impl Display for f32 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_f64(f.t, f.flags, f.counts, self as f64, 1u32) }; } }
impl Display for f64 { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_f64(f.t, f.flags, f.counts, self, 0u32) }; } }
impl Display for bool {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.pad(if self { "true" } else { "false" }) }
}
impl Display for char { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_char(self) } }
impl Display for str { fn fmt(self, ref f: Formatter) throws (FmtError) { try f.pad(self) } }

impl Debug for i8 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for i16 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for i32 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for i64 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for isize { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for u8 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for u16 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for u32 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for u64 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for usize { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for f32 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for f64 { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
impl Debug for bool { fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self, ref f) } }
/// A rok literal: quotes, `\\`, `\n` `\r` `\t` `\0` escaped, other
/// control and bidi chars as `\u{..}` (2.10.4).
impl Debug for char {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        f.t = unsafe { rok_fmt_escaped(f.t, rok_str_from_char(self as u32), 39u32) };
    }
}
impl Debug for str { fn fmt(self, ref f: Formatter) throws (FmtError) { f.t = unsafe { rok_fmt_escaped(f.t, self, 34u32) }; } }

impl Format for i8 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for i16 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for i32 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for i64 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for isize { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for u8 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for u16 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for u32 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for u64 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for usize { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for f32 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
impl Format for f64 { fn format(self, spec: FormatSpec) -> str { format_number(self, spec) } }
