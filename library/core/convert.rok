// TryFrom (integers that may not fit)

impl TryFrom<i8> for u8 {
    type Error = OverflowError;
    fn try_from(value: i8) throws (OverflowError) -> u8 {
        if value < 0 { throw overflow("u8"); }
        value as u8
    }
}

impl TryFrom<i8> for u16 {
    type Error = OverflowError;
    fn try_from(value: i8) throws (OverflowError) -> u16 {
        if value < 0 { throw overflow("u16"); }
        value as u16
    }
}

