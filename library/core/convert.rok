impl TryFrom<f64> for f32 {
    type Error = OverflowError;
    /// Throws when a finite `value` is beyond `f32`'s range.
    fn try_from(value: f64) throws (OverflowError) -> f32 {
        if value.is_finite() && value.abs() > f32::MAX as f64 { throw overflow("f32"); }
        value as f32
    }
}

// SaturatingFrom

impl SaturatingFrom<i8> for i16 {
    fn saturating_from(value: i8) -> i16 { value as i16 }
}

impl SaturatingFrom<i8> for i32 {
    fn saturating_from(value: i8) -> i32 { value as i32 }
}

impl SaturatingFrom<i8> for i64 {
    fn saturating_from(value: i8) -> i64 { value as i64 }
}

impl SaturatingFrom<i8> for isize {
    fn saturating_from(value: i8) -> isize { value as isize }
}

impl SaturatingFrom<i8> for u8 {
    fn saturating_from(value: i8) -> u8 {
        if value < 0 { return 0; }
        value as u8
    }
}

impl SaturatingFrom<i8> for u16 {
    fn saturating_from(value: i8) -> u16 {
        if value < 0 { return 0; }
        value as u16
    }
}

