// rok::core::convert — conversion traits (stdlib spec 2.11) and their
// primitive impls (2.11.8). Four policies, each named at the call:
// lossless `into`, fallible `try_into` (throws the target's
// `TryFrom::Error`; `OverflowError` for numbers),
// `saturating_into`, `wrapping_into` (= `as`).
//
// ponytail: spec 2.11.3 / 2.11.4 / 2.11.5 write the `Into`-side traits
// as `trait Into<T> { fn into(self) -> T; }`, mirrored automatically
// from `From`. A blanket `impl<T, U: From<T>> Into<U> for T` cannot fix
// `U` from the receiver here, so each `*Into` trait has one generic
// method instead (`T` comes from the expected type, like `parse`), with
// one blanket impl over every type; the conversions themselves are the
// `*From` impls. `SaturatingFrom` / `WrappingFrom` are not in the spec;
// they are what `saturating_into` / `wrapping_into` dispatch to.
// No `#[intrinsic("rok.cast.FROM.TO")]` (2.11.12): the bodies are `as`,
// the same machine op.

/// A lossless conversion from `U` (2.11.2).
pub trait From<U> {
    fn from(value: U) -> Self;
}

/// `x.into()` = `T::from(x)` (2.11.3); `T` from the expected type.
pub trait Into {
    fn into<T: From<Self>>(self) -> T;
}

impl<S> Into for S {
    fn into<T: From<S>>(self) -> T { T::from(self) }
}

/// A conversion that can fail (2.11.4). `Error` is what it throws:
/// `ConversionError` unless the impl names another (the numeric impls
/// say `OverflowError`).
pub trait TryFrom<U> {
    type Error = ConversionError;
    fn try_from(value: U) throws (Self::Error) -> Self;
}

/// `x.try_into()` = `T::try_from(x)` (2.11.4); throws `T`'s `Error`.
pub trait TryInto {
    fn try_into<T: TryFrom<Self>>(self) throws (T::Error) -> T;
}

impl<S> TryInto for S {
    fn try_into<T: TryFrom<S>>(self) throws (T::Error) -> T { try T::try_from(self) }
}

/// Out-of-range values clamp to the nearest end (2.11.5).
pub trait SaturatingFrom<U> {
    fn saturating_from(value: U) -> Self;
}

pub trait SaturatingInto {
    fn saturating_into<T: SaturatingFrom<Self>>(self) -> T;
}

impl<S> SaturatingInto for S {
    fn saturating_into<T: SaturatingFrom<S>>(self) -> T { T::saturating_from(self) }
}

/// Keep the low bits — `as` spelled as a method (2.11.5).
pub trait WrappingFrom<U> {
    fn wrapping_from(value: U) -> Self;
}

pub trait WrappingInto {
    fn wrapping_into<T: WrappingFrom<Self>>(self) -> T;
}

impl<S> WrappingInto for S {
    fn wrapping_into<T: WrappingFrom<S>>(self) -> T { T::wrapping_from(self) }
}

fn overflow(ty: str) -> OverflowError { OverflowError { op: "try_from", ty } }

