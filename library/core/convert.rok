        value as usize
    }
}

impl SaturatingFrom<i16> for i8 {
    fn saturating_from(value: i16) -> i8 {
        if value < i8::MIN as i16 { return i8::MIN; }
        if value > i8::MAX as i16 { return i8::MAX; }
        value as i8
    }
}

impl SaturatingFrom<i16> for i32 {
    fn saturating_from(value: i16) -> i32 { value as i32 }
}

