// rok::core::task — tasks on the work-stealing executor (stdlib spec
// 2.18, refs-lang 7.6), `block_on` (2.20.6); time is `task::time`.
//
// `block_on` starts a pool of N workers (N = online CPUs): the calling
// thread is worker 0, the rest are OS threads (`rok_thread_spawn`). Each
// worker has a local queue (`spawn_local` tasks, never stolen) and a
// deque; a non-worker thread's wakes go to the shared injector. A worker
// takes from its local queue, its deque, the injector, then steals from
// the other deques; with nothing to run it fires due timers and sleeps on
// the pool's signal word (`rok_sync_wait_timeout`) until a push or its
// next timer.
//
// A task is polled by one worker at a time: its state word goes IDLE →
// SCHEDULED (queued) → RUNNING → IDLE / DONE, and a wake while RUNNING
// marks it NOTIFIED so it is queued again after the poll.
//
// An idle worker raises its sleep flag, looks once more, then waits on
// that flag; a push clears one raised flag and wakes only that worker
// (a `spawn_local` push wakes the task's home worker).
//
// I/O (707): a process-wide driver thread blocks in kqueue / epoll and
// unparks the tasks waiting on a ready fd (`readable` / `writable`).
//
// Cancellation (2.18.4, 707 §7.7.10): `Task::cancel` sets the flag and
// wakes the task; every `await` checks it (`cancel_requested`) on entry
// and after each resume, and leaves the coroutine body like a `return`,
// running the `finally` / `using` cleanups it passes.
//
// The deques are the runtime's lock-free Chase-Lev deques (`rok_deque_*`)
// of boxed `TaskRef`s (a `TaskRef` is several words; a deque item is one
// GC reference, traced through the deque). The owner takes FIFO too (a
// steal from its own deque): LIFO would let a task that keeps waking
// itself (`yield_now`) starve the rest of its deque.
//
// ponytail: the local queues and the injector are rings behind a spin
// lock each (many producers). The timer heap is one `Mutex` per pool
// (7.7.5 allows a heap; it recommends a timing wheel). The I/O driver
// is a reactor thread, not each worker polling (707 §7.7.11).

pub mod time;

use rok::core::task::time::{Duration, Instant};
use rok::core::future::{Context, Future, Poll, TryAsyncFuture, Waker};
use rok::core::collections::raw::{GcBuf, buf_new};
use rok::core::sync::{Atomic, AtomicOrdering, Mutex};

extern "C" {
    fn rok_time_now_ns() -> i64;
    fn rok_cpu_count() -> usize;
    fn rok_task_exec_active() -> i32;
    fn rok_task_exec_get() -> GcBuf<Worker>;
    fn rok_task_exec_set(w: GcBuf<Worker>);
    fn rok_task_exec_clear();
    fn rok_task_parking_ready() -> i32;
    fn rok_task_parking_install(p: GcBuf<Parking>) -> GcBuf<Parking>;
    fn rok_thread_new_id() -> u64;
    fn rok_thread_spawn(f: fn() + Send, stack_size: usize, id: u64) -> usize;
    fn rok_thread_join(handle: usize) -> i32;
    fn rok_thread_detach(handle: usize) -> i32;
    fn rok_thread_yield_now();
    fn rok_sync_wait_timeout(word: GcBuf<i32>, index: usize, expected: i32, ns: i64);
    fn rok_sync_wake(word: GcBuf<i32>, index: usize);
    fn rok_io_driver_claim() -> i32;
    fn rok_io_watch(fd: i32) -> i32;
    fn rok_io_poll(out: GcBuf<i64>, max: usize) -> i32;
    fn rok_net_wait(fd: i32, write: i32, timeout_ns: i64) -> i32;
    fn rok_task_key_i32(word: GcBuf<i32>) -> usize;
    fn rok_task_abi_install(hook: fn(i32, i64, i64, GcBuf<Waker>));
    fn rok_deque_new() -> GcBuf<GcBuf<TaskRef>>;
    fn rok_deque_push(d: GcBuf<GcBuf<TaskRef>>, item: GcBuf<TaskRef>);
    fn rok_deque_steal(d: GcBuf<GcBuf<TaskRef>>, out: GcBuf<GcBuf<TaskRef>>, index: usize) -> i32;
}

#[intrinsic("rok.atomic.load")]
fn atomic_load<T>(buf: GcBuf<T>, i: usize, o: AtomicOrdering) -> T;
#[intrinsic("rok.atomic.xchg")]
fn atomic_xchg<T>(buf: GcBuf<T>, i: usize, v: T, o: AtomicOrdering) -> T;
#[intrinsic("rok.atomic.add")]
fn atomic_add<T>(buf: GcBuf<T>, i: usize, v: T, o: AtomicOrdering) -> T;
#[intrinsic("rok.atomic.cas")]
fn atomic_cas<T>(
    buf: GcBuf<T>, i: usize, current: T, new: T, success: AtomicOrdering, failure: AtomicOrdering,
) -> T;

fn now_ns() -> i64 {
    unsafe { rok_time_now_ns() }
}

// ---- tasks ----

const IDLE: i32 = 0;
const SCHEDULED: i32 = 1;
const RUNNING: i32 = 2;
const NOTIFIED: i32 = 3;
const DONE: i32 = 4;

/// A task as the executor sees it (what a `Waker` holds).
pub struct TaskRef {
    /// `[state, cancelled, timed, proxy, unwinding]` (`timed`: it has
    /// added a timer; `proxy`: a `select` stand-in, see `up`;
    /// `unwinding`: a cancellation point saw the cancel).
    state: GcBuf<i32>;
    /// One poll of the task's future; `true` once it is done.
    poll: GcBuf<fn(Context) -> bool>;
    /// Wakers to wake when it is done (and the lock for `DONE`).
    joiners: Mutex<List<Waker>>;
    pool: Pool;
    /// Parking keys it may still be parked on (under the parking lock):
    /// dropped from the table when it finishes (a cancelled task's).
    parked: List<usize>;
    /// `spawn_local`: runs only on worker `home`.
    local: bool;
    home: usize;
    /// Its `TaskId`.
    id: u64;
    /// A `select`'s stand-in for its children (`state[3]` set): wakes
    /// go to `up[0]` (while not done) and its cancel flag is that one's
    /// too. Other tasks share their pool's empty `no_up`.
    up: GcBuf<Waker>;
}

unsafe impl Send for TaskRef {}
unsafe impl Sync for TaskRef {}

fn is_done(t: TaskRef) -> bool {
    atomic_load(t.state, 0, SeqCst) == DONE
}

fn is_cancelled(t: TaskRef) -> bool {
    atomic_load(t.state, 1, SeqCst) != 0
}

/// A finished task that left by its cancel (no result). One cancelled
/// after its last cancellation point finished normally: its result
/// stands (a value it received is not lost).
fn no_result(t: TaskRef) -> bool {
    is_cancelled(t) && atomic_load(t.state, 4, SeqCst) != 0
}

/// Schedule `t` to be polled (`Waker::wake`); safe from any thread.
pub fn wake_task(t: TaskRef) {
    if t.state[3] != 0 {
        if atomic_load(t.state, 0, SeqCst) != DONE {
            t.up[0].wake();
        }
        return;
    }
    loop {
        let s = atomic_load(t.state, 0, SeqCst);
        if s == IDLE {
            if atomic_cas(t.state, 0, IDLE, SCHEDULED, SeqCst, SeqCst) == IDLE {
                schedule(t);
                return;
            }
        } else if s == RUNNING {
            if atomic_cas(t.state, 0, RUNNING, NOTIFIED, SeqCst, SeqCst) == RUNNING {
                return;
            }
        } else {
            return;
        }
    }
}

/// Wake `waiter` once `t` is done (at once if it is).
fn join_later(t: TaskRef, waiter: Waker) -> bool {
    let done = false;
    using g = t.joiners.lock() {
        if is_done(t) {
            done = true;
        } else {
            g.get().push(waiter);
        }
    }
    done
}

fn finish(t: TaskRef) {
    let ws: List<Waker> = List::new();
    using g = t.joiners.lock() {
        atomic_xchg(t.state, 0, DONE, SeqCst);
        ws = g.get();
        g.set(List::new());
    }
    // The finished future (its frame) is no longer reachable from here.
    t.poll[0] = |ctx: Context| -> bool { true };
    // Its parking entries go with it (a cancelled task left its `await`
    // without the wake it waited for), and a cancelled task's timers.
    if is_cancelled(t) {
        finish_cancelled(t);
    } else {
        unpark_task(t);
    }
    for w in ws {
        w.wake();
    }
    // `help_until` / the main worker may be waiting on it.
    t.pool.wake_helpers();
    if t.local {
        t.pool.wake_worker(t.home);
    }
}

// ---- the pool ----

/// A FIFO ring of tasks behind a lock; `len` is readable without it.
struct Queue {
    spin: GcBuf<i32>;
    /// `[head, len, capacity]`.
    meta: GcBuf<usize>;
    slots: GcBuf<GcBuf<TaskRef | none>>;
}

fn queue_new() -> Queue {
    let meta: GcBuf<usize> = buf_new(3);
    meta[2] = 64;
    let slots: GcBuf<GcBuf<TaskRef | none>> = buf_new(1);
    let ring: GcBuf<TaskRef | none> = buf_new(64);
    slots[0] = ring;
    let spin: GcBuf<i32> = buf_new(1);
    Queue { spin: spin, meta: meta, slots: slots }
}

/// A work-stealing executor (`block_on` makes one per call).
pub struct Pool {
    locals: List<Queue>;
    deques: List<GcBuf<GcBuf<TaskRef>>>;
    /// Per worker: where `find_task` receives a stolen task.
    stolen: GcBuf<GcBuf<TaskRef>>;
    injector: Queue;
    /// Timer min-heap: deadline (monotonic ns) and the waker to wake.
    timers: Mutex<Timers>;
    /// `[epoch, shutdown, helpers, searching]`: `help_until` (`helpers`
    /// of them) waits on `epoch`, which a push or a finished task bumps;
    /// `searching` workers are idle but awake (a push need not wake one).
    signal: GcBuf<i32>;
    /// Per worker: 1 while it sleeps (or is about to), cleared by the
    /// push that wakes it.
    sleep: GcBuf<i32>;
    /// Per worker: the task it is polling (`task::id`).
    running: GcBuf<TaskRef | none>;
    /// Every non-proxy task's `up`.
    no_up: GcBuf<Waker>;
}

unsafe impl Send for Pool {}
unsafe impl Sync for Pool {}

struct Timers {
    at: List<i64>;
    who: List<Waker>;
    /// `[dead]`: cancelled tasks with timers since the last sweep.
    dead: GcBuf<usize>;
}

fn timers_new(at: List<i64>, who: List<Waker>) -> Timers {
    let dead: GcBuf<usize> = buf_new(1);
    Timers { at: at, who: who, dead: dead }
}

/// This thread's worker: its pool and index.
pub struct Worker {
    pool: Pool;
    index: usize;
}

impl Pool {
    fn new(n: usize) -> Pool {
        let locals: List<Queue> = List::new();
        let deques: List<GcBuf<GcBuf<TaskRef>>> = List::new();
        for i in 0..n {
            locals.push(queue_new());
            deques.push(unsafe { rok_deque_new() });
        }
        let stolen: GcBuf<GcBuf<TaskRef>> = buf_new(n);
        let signal: GcBuf<i32> = buf_new(4);
        let sleep: GcBuf<i32> = buf_new(n);
        let running: GcBuf<TaskRef | none> = buf_new(n);
        for i in 0..n {
            running[i] = none;
        }
        Pool {
            locals: locals,
            deques: deques,
            stolen: stolen,
            injector: queue_new(),
            timers: Mutex::new(timers_new(List::<i64>::new(), List::<Waker>::new())),
            signal: signal,
            sleep: sleep,
            running: running,
            no_up: buf_new(0),
        }
    }

    /// Number of workers.
    pub fn workers(self) -> usize {
        self.deques.len()
    }

    /// Bump the epoch and wake one sleeping worker (if any).
    fn notify(self) {
        self.wake_helpers();
        if atomic_load(self.signal, 3, SeqCst) > 0 {
            return;
        }
        let n = self.workers();
        for i in 0..n {
            if self.wake_worker(i) {
                return;
            }
        }
    }

    fn wake_helpers(self) {
        atomic_add(self.signal, 0, 1, SeqCst);
        if atomic_load(self.signal, 2, SeqCst) > 0 {
            unsafe { rok_sync_wake(self.signal, 0) };
        }
    }

    /// Wake worker `i` if it sleeps; whether it did.
    fn wake_worker(self, i: usize) -> bool {
        if atomic_load(self.sleep, i, SeqCst) == 1 && atomic_cas(self.sleep, i, 1, 0, SeqCst, SeqCst) == 1 {
            unsafe { rok_sync_wake(self.sleep, i) };
            return true;
        }
        false
    }

    fn wake_all(self) {
        for i in 0..self.workers() {
            atomic_xchg(self.sleep, i, 0, SeqCst);
            unsafe { rok_sync_wake(self.sleep, i) };
        }
    }
}

fn current() -> Worker | none {
    if unsafe { rok_task_exec_active() } == 0 {
        return none;
    }
    (unsafe { rok_task_exec_get() })[0]
}

fn current_worker() -> Worker {
    current() ?? panic("no task executor is running: await inside `async fn main` or `task::block_on`")
}

fn set_current(w: Worker) {
    let cell: GcBuf<Worker> = buf_new(1);
    cell[0] = w;
    unsafe { rok_task_exec_set(cell) };
}

// ponytail: the queue lock spins (with `sched_yield`) instead of
// sleeping: its critical sections are a few loads and stores.
fn qlock(q: Queue) {
    while atomic_cas(q.spin, 0, 0, 1, SeqCst, SeqCst) != 0 {
        unsafe { rok_thread_yield_now() };
    }
}

fn qunlock(q: Queue) {
    atomic_xchg(q.spin, 0, 0, SeqCst);
}

fn push(q: Queue, t: TaskRef) {
    qlock(q);
    {
        let head = q.meta[0];
        let len = q.meta[1];
        let cap = q.meta[2];
        let ring = q.slots[0];
        if len == cap {
            let bigger: GcBuf<TaskRef | none> = buf_new(cap * 2);
            for i in 0..len {
                bigger[i] = ring[(head + i) % cap];
            }
            q.slots[0] = bigger;
            ring = bigger;
            head = 0;
            cap *= 2;
            q.meta[0] = 0;
            q.meta[2] = cap;
        }
        ring[(head + len) % cap] = t;
        atomic_xchg(q.meta, 1, len + 1, SeqCst);
    }
    qunlock(q);
}

fn pop_front(q: Queue) -> TaskRef | none {
    if atomic_load(q.meta, 1, SeqCst) == 0 {
        return none;
    }
    let t: TaskRef | none = none;
    qlock(q);
    {
        let len = q.meta[1];
        if len > 0 {
            let head = q.meta[0];
            let ring = q.slots[0];
            t = ring[head];
            ring[head] = none;
            q.meta[0] = (head + 1) % q.meta[2];
            atomic_xchg(q.meta, 1, len - 1, SeqCst);
        }
    }
    qunlock(q);
    t
}

fn schedule(t: TaskRef) {
    let pool = t.pool;
    if t.local {
        push(pool.locals[t.home], t);
        pool.wake_worker(t.home);
        return;
    }
    match current() {
        // Only the owner pushes to a deque: a worker of another pool
        // goes through the injector.
        w: Worker => if same_pool(w.pool, pool) {
            let boxed: GcBuf<TaskRef> = buf_new(1);
            boxed[0] = t;
            unsafe { rok_deque_push(pool.deques[w.index], boxed) };
        } else {
            push(pool.injector, t);
        },
        none => push(pool.injector, t),
    }
    pool.notify();
}

fn same_pool(a: Pool, b: Pool) -> bool {
    unsafe { rok_task_key_i32(a.signal) == rok_task_key_i32(b.signal) }
}

/// The oldest task of deque `d`, for worker `i`.
fn steal(pool: Pool, d: GcBuf<GcBuf<TaskRef>>, i: usize) -> TaskRef | none {
    if unsafe { rok_deque_steal(d, pool.stolen, i) } == 0 {
        return none;
    }
    pool.stolen[i][0]
}

/// The next task for worker `i`: its local queue, its deque, the
/// injector, then the other workers' deques.
fn find_task(pool: Pool, i: usize) -> TaskRef | none {
    if let t: TaskRef = pop_front(pool.locals[i]) {
        return t;
    }
    if let t: TaskRef = steal(pool, pool.deques[i], i) {
        return t;
    }
    if let t: TaskRef = pop_front(pool.injector) {
        return t;
    }
    let n = pool.workers();
    for k in 1..n {
        if let t: TaskRef = steal(pool, pool.deques[(i + k) % n], i) {
            return t;
        }
    }
    none
}

/// Poll `t` on worker `i`.
fn run(t: TaskRef, i: usize) {
    if atomic_cas(t.state, 0, SCHEDULED, RUNNING, SeqCst, SeqCst) != SCHEDULED {
        return;
    }
    // A cancelled task is polled once more: its `await` sees the flag
    // and leaves the body through its cleanups. Only a poll that began
    // after the cancel saw the flag; one cancelled while it ran (`cancel`
    // then marks it NOTIFIED) is polled again below, else the task would
    // finish without running its `finally` / `using` cleanups.
    let cancelled = is_cancelled(t);
    let poll = t.poll[0];
    let ctx = Context::from_waker(Waker { task: t });
    // `help_until` runs tasks inside a task's poll: restore the outer one.
    let outer = t.pool.running[i];
    t.pool.running[i] = t;
    let ready = poll(ctx);
    t.pool.running[i] = outer;
    if ready || cancelled {
        if !ready {
            // Ended without a result (no cancellation point reached).
            atomic_xchg(t.state, 4, 1, SeqCst);
        }
        finish(t);
    } else if atomic_cas(t.state, 0, RUNNING, IDLE, SeqCst, SeqCst) != RUNNING {
        // Woken while it ran.
        atomic_xchg(t.state, 0, SCHEDULED, SeqCst);
        schedule(t);
    }
}

/// Is the task polling with `ctx` cancelled? (The compiler's `await`
/// checks this: 2.18.4 cancellation points.) A true answer means the
/// caller leaves: the cancelled task (or `select` proxy) is marked
/// `unwinding`.
pub fn cancel_requested(ctx: Context) -> bool {
    match cancel_source(ctx.waker.task) {
        t: TaskRef => {
            atomic_xchg(t.state, 4, 1, SeqCst);
            true
        }
        none => false,
    }
}

/// Whether a future that just returned `Ready` with `ctx` may have left
/// because of a cancel (its value is then a placeholder): the `await`
/// after a ready poll checks this, not the bare flag, so a value a
/// hand-written future handed over (a message, a guard) is kept when the
/// cancel lands meanwhile — the next cancellation point leaves.
pub fn unwinding(ctx: Context) -> bool {
    let t = ctx.waker.task;
    if atomic_load(t.state, 4, SeqCst) != 0 {
        return true;
    }
    t.state[3] != 0 && unwinding(Context::from_waker(t.up[0]))
}

/// The cancelled task `t` answers to: itself, or (a `select` proxy) its
/// parent's chain.
fn cancel_source(t: TaskRef) -> TaskRef | none {
    if atomic_load(t.state, 1, SeqCst) != 0 {
        return t;
    }
    if t.state[3] == 0 {
        return none;
    }
    cancel_source(t.up[0].task)
}

/// Wake every due timer; the nanoseconds to the next one (-1: none).
fn fire_timers(pool: Pool) -> i64 {
    let due: List<Waker> = List::new();
    let next: i64 = -1;
    using g = pool.timers.lock() {
        let tm = g.get();
        let now = now_ns();
        while tm.at.len() > 0 && tm.at[0] <= now {
            due.push(tm.who[0]);
            pop_timer(tm);
        }
        if tm.at.len() > 0 {
            next = tm.at[0] - now;
        }
    }
    for w in due {
        w.wake();
    }
    if due.len() > 0 {
        return 0;
    }
    next
}

/// After `ran + 1` task runs in a row: every 32nd fires the due timers.
/// Without it a worker that always finds a task (tasks looping on
/// `yield_now`) never fires one, and every `sleep` waits forever.
fn timers_while_busy(pool: Pool, ran: i64) -> i64 {
    if ran < 31 {
        return ran + 1;
    }
    fire_timers(pool);
    0
}

fn add_timer(deadline: i64, w: Waker) {
    let pool = w.task.pool;
    atomic_xchg(w.task.state, 2, 1, SeqCst);
    using g = pool.timers.lock() {
        let tm = g.get();
        tm.at.push(deadline);
        tm.who.push(w);
        let i = tm.at.len() - 1;
        while i > 0 {
            let p = (i - 1) / 2;
            if tm.at[p] <= tm.at[i] {
                break;
            }
            swap_timers(tm, i, p);
            i = p;
        }
    }
    // A sleeping worker recomputes how long to sleep (even while others
    // search: they may have read the timers already).
    pool.wake_helpers();
    for i in 0..pool.workers() {
        if pool.wake_worker(i) {
            return;
        }
    }
}

fn swap_timers(tm: Timers, i: usize, j: usize) {
    let a = tm.at[i];
    let w = tm.who[i];
    tm.at[i] = tm.at[j];
    tm.who[i] = tm.who[j];
    tm.at[j] = a;
    tm.who[j] = w;
}

fn pop_timer(tm: Timers) {
    let n = tm.at.len() - 1;
    swap_timers(tm, 0, n);
    tm.at.pop();
    tm.who.pop();
    sift_down(tm, 0);
}

/// Drop cancelled task `t`'s timers from its pool's heap, lazily: a
/// finished task's timer wakes nobody, and once the cancelled tasks
/// since the last sweep reach half the heap, one O(heap) sweep drops
/// every finished task's timers (amortized O(1) per cancel).
// ponytail: a binary heap (spec 7.7.5 allows it; the recommended timing
// wheel would make insert O(1) too — worth it with ~millions of timers).
fn remove_timers(t: TaskRef) {
    using g = t.pool.timers.lock() {
        let tm = g.get();
        tm.dead[0] += 1;
        if tm.dead[0] * 2 >= tm.at.len() {
            let at: List<i64> = List::new();
            let who: List<Waker> = List::new();
            for i in 0..tm.at.len() {
                if !is_done(tm.who[i].task) {
                    at.push(tm.at[i]);
                    who.push(tm.who[i]);
                }
            }
            let fresh = timers_new(at, who);
            g.set(fresh);
            let i = at.len() / 2;
            while i > 0 {
                i -= 1;
                sift_down(fresh, i);
            }
        }
    }
}

fn sift_down(tm: Timers, from: usize) {
    let n = tm.at.len();
    let i = from;
    loop {
        let l = 2 * i + 1;
        let r = l + 1;
        let m = i;
        if l < n && tm.at[l] < tm.at[m] {
            m = l;
        }
        if r < n && tm.at[r] < tm.at[m] {
            m = r;
        }
        if m == i {
            break;
        }
        swap_timers(tm, i, m);
        i = m;
    }
}

/// Run tasks on worker `w` until `main` is done (`none`: until the pool
/// shuts down).
fn work(w: Worker, main: TaskRef | none) {
    let pool = w.pool;
    let i = w.index;
    let ran: i64 = 0;
    loop {
        if let m: TaskRef = main {
            if is_done(m) {
                return;
            }
        }
        if atomic_load(pool.signal, 1, SeqCst) != 0 {
            return;
        }
        if let t: TaskRef = find_task(pool, i) {
            run(t, i);
            ran = timers_while_busy(pool, ran);
            continue;
        }
        let next = fire_timers(pool);
        if next == 0 {
            continue;
        }
        // Search a little before sleeping (pushes meanwhile wake nobody).
        atomic_add(pool.signal, 3, 1, SeqCst);
        let found: TaskRef | none = none;
        for spins in 0..4 {
            unsafe { rok_thread_yield_now() };
            found = find_task(pool, i);
            if found is TaskRef {
                break;
            }
        }
        atomic_add(pool.signal, 3, -1, SeqCst);
        if let t: TaskRef = found {
            run(t, i);
            continue;
        }
        // Raise the sleep flag, look once more (a push after this sees
        // the flag), then sleep until woken or the next timer.
        atomic_xchg(pool.sleep, i, 1, SeqCst);
        if let t: TaskRef = find_task(pool, i) {
            atomic_xchg(pool.sleep, i, 0, SeqCst);
            run(t, i);
            continue;
        }
        let done = match main {
            m: TaskRef => is_done(m),
            none => false,
        };
        // The timers again: one added after the flag went up wakes us,
        // one added before is seen here.
        next = fire_timers(pool);
        if next == 0 || done || atomic_load(pool.signal, 1, SeqCst) != 0 {
            atomic_xchg(pool.sleep, i, 0, SeqCst);
            continue;
        }
        let wait: i64 = 1000000000;
        if next > 0 && next < wait {
            wait = next;
        }
        unsafe { rok_sync_wait_timeout(pool.sleep, i, 1, wait) };
        atomic_xchg(pool.sleep, i, 0, SeqCst);
    }
}

fn new_task(pool: Pool, poll: fn(Context) -> bool, local: bool, home: usize) -> TaskRef {
    let state: GcBuf<i32> = buf_new(5);
    state[0] = SCHEDULED;
    let p: GcBuf<fn(Context) -> bool> = buf_new(1);
    p[0] = poll;
    let t = TaskRef {
        state: state,
        poll: p,
        joiners: Mutex::new(List::<Waker>::new()),
        pool: pool,
        parked: List::new(),
        local: local,
        home: home,
        id: NEXT_TASK_ID.fetch_add(1),
        up: pool.no_up,
    };
    schedule(t);
    t
}

/// The poll function of a task running `fut`, storing its output in
/// `slot`.
fn poll_fn<F: Future>(fut: F, slot: GcBuf<F::Output>) -> fn(Context) -> bool {
    let cell: GcBuf<F> = buf_new(1);
    cell[0] = fut;
    |ctx: Context| -> bool {
        let f = cell[0];
        let c = ctx;
        let r = f.poll(ref c);
        cell[0] = f;
        if let Poll::Ready(v) = r {
            slot[0] = v;
            return true;
        }
        false
    }
}

/// Start a pool and run `main` on worker 0 (this thread) until it is
/// done; the other workers stop after their current poll.
fn run_pool(main: fn(Context) -> bool) {
    if unsafe { rok_task_exec_active() } != 0 {
        panic("task::block_on inside a running task (it would deadlock); use `await`");
    }
    let n = unsafe { rok_cpu_count() };
    unsafe { rok_task_abi_install(|op: i32, a: i64, b: i64, w: GcBuf<Waker>| abi_hook(op, a, b, w)) };
    let pool = Pool::new(n);
    let w0 = Worker { pool: pool, index: 0 };
    set_current(w0);
    let handles: List<usize> = List::new();
    for i in 1..n {
        let idx = i;
        let body: fn() + Send = || {
            set_current(Worker { pool: pool, index: idx });
            work(Worker { pool: pool, index: idx }, none);
            unsafe { rok_task_exec_clear() };
        };
        handles.push(unsafe { rok_thread_spawn(body, 0, rok_thread_new_id()) });
    }
    let t = new_task(pool, main, true, 0);
    work(w0, t);
    atomic_xchg(pool.signal, 1, 1, SeqCst);
    pool.wake_all();
    for h in handles {
        unsafe { rok_thread_join(h) };
    }
    unsafe { rok_task_exec_clear() };
}

/// Run `fut` to completion on a fresh pool, from synchronous code
/// (2.20.6). Tasks still running when it is done are dropped.
pub fn block_on<F: Future>(fut: F) -> F::Output {
    let slot: GcBuf<F::Output> = buf_new(1);
    run_pool(poll_fn(fut, slot));
    slot[0]
}

/// `block_on` for a throwing `async` body: its error is thrown here.
pub fn block_on_try<T, E>(fut: TryAsyncFuture<T, E>) throws (E) -> T {
    let cell: GcBuf<TryAsyncFuture<T, E>> = buf_new(1);
    cell[0] = fut;
    let out: GcBuf<T> = buf_new(1);
    let err: GcBuf<E> = buf_new(1);
    let failed: GcBuf<bool> = buf_new(1);
    run_pool(|ctx: Context| -> bool {
        let f = cell[0];
        let c = ctx;
        let r = try f.poll(ref c) catch e {
            err[0] = e;
            failed[0] = true;
            return true;
        };
        cell[0] = f;
        if let Poll::Ready(v) = r {
            out[0] = v;
            return true;
        }
        false
    });
    if failed[0] {
        throw err[0];
    }
    out[0]
}

/// The running pool (inside `block_on`): for code that puts its own
/// work on the workers, e.g. `par::*` (`spawn(async { .. })` + `join`).
pub fn current_pool() -> Pool | none {
    current()?.pool
}

/// Workers of the running pool (1 outside `block_on`).
pub fn workers() -> usize {
    current()?.pool?.workers() ?? 1
}

/// Online CPUs: a pool's worker count.
pub fn cpu_count() -> usize {
    unsafe { rok_cpu_count() }
}

// ---- the `par` seam: sync jobs on the pool ----

struct RunOnce {
    f: fn() -> bool;
}

unsafe impl Send for RunOnce {}

impl Future for RunOnce {
    type Output = bool;
    fn poll(ref self, ref ctx: Context) -> Poll<bool> {
        Poll::Ready((self.f)())
    }
}

/// Run `f()` with a pool running on this thread: the current one, or a
/// pool started for the call (`block_on`).
pub(pkg) fn in_pool(f: fn() -> bool) -> bool {
    if current() is Worker {
        return f();
    }
    block_on(RunOnce { f: f })
}

/// `f` as a task on the running pool (`par`'s `fork`).
pub(pkg) fn fork_job(f: fn() + Send) -> Task<bool> {
    spawn(RunOnce { f: || { f(); true } })
}

/// Block this worker until `t` is done, running pool tasks meanwhile
/// (so a fork-join on a busy pool cannot deadlock).
pub(pkg) fn help_until(t: Task<bool>) {
    let w = current_worker();
    let pool = w.pool;
    atomic_add(pool.signal, 2, 1, SeqCst);
    let ran: i64 = 0;
    while !is_done(t.task) {
        let epoch = atomic_load(pool.signal, 0, SeqCst);
        if let other: TaskRef = find_task(pool, w.index) {
            run(other, w.index);
            ran = timers_while_busy(pool, ran);
            continue;
        }
        if fire_timers(pool) == 0 {
            continue;
        }
        if !is_done(t.task) {
            unsafe { rok_sync_wait_timeout(pool.signal, 0, epoch, 1000000) };
        }
    }
    atomic_add(pool.signal, 2, -1, SeqCst);
}

// ---- spawning ----

/// A spawned task; `await` it for its result (2.18.2).
pub struct Task<T> {
    task: TaskRef;
    slot: GcBuf<T>;
}

unsafe impl<T: Send> Send for Task<T> {}

impl<T> Task<T> {
    pub fn is_finished(self) -> bool { is_done(self.task) }

    /// This task's id (what `task::id()` returns inside it).
    pub fn id(self) -> TaskId { TaskId { id: self.task.id } }

    /// Ask the task to stop (2.18.4): it is woken, its current `await`
    /// leaves the body (running the `finally` / `using` cleanups on the
    /// way out) and it finishes without a result. Awaiting it then
    /// panics; use `try await t.join()` to see `CancellationError`. A
    /// task that reaches no cancellation point after the cancel finishes
    /// normally, with its result.
    pub fn cancel(self) {
        atomic_xchg(self.task.state, 1, 1, SeqCst);
        wake_task(self.task);
    }

    pub fn is_cancelled(self) -> bool { is_cancelled(self.task) }

    /// Await the result, throwing `CancellationError` for a cancelled
    /// task.
    pub fn join(self) -> Join<T> {
        Join { task: self }
    }
}

impl<T> Future for Task<T> {
    type Output = T;
    fn poll(ref self, ref ctx: Context) -> Poll<T> {
        if !join_later(self.task, ctx.waker) {
            return Poll::Pending;
        }
        if no_result(self.task) {
            panic("awaited a cancelled task (use `try await t.join()`)");
        }
        Poll::Ready(self.slot[0])
    }
}

/// `Task::join`.
pub struct Join<T> {
    task: Task<T>;
}

impl<T> Join<T> {
    pub fn poll(ref self, ref ctx: Context) throws (CancellationError) -> Poll<T> {
        if !join_later(self.task.task, ctx.waker) {
            return Poll::Pending;
        }
        if no_result(self.task.task) {
            throw CancellationError {};
        }
        Poll::Ready(self.task.slot[0])
    }
}

/// Identifies a task for as long as the process runs (ids are never
/// reused): `Task::id`, `task::id()`. Not in spec 2.18 (tokio's
/// `task::Id`).
pub struct TaskId {
    id: u64;
}

static NEXT_TASK_ID: Atomic<u64> = Atomic::new(1);

impl TaskId {
    pub fn as_u64(self) -> u64 { self.id }
}

impl PartialEq for TaskId {
    fn eq(self, rhs: TaskId) -> bool { self.id == rhs.id }
    fn ne(self, rhs: TaskId) -> bool { self.id != rhs.id }
}

impl Eq for TaskId {}

impl Hash for TaskId {
    fn hash(self) -> u64 { self.id.hash() }
}

impl Display for TaskId {
    fn display(self) -> str { self.id.display() }
}

impl Debug for TaskId {
    fn debug(self) -> str { f"TaskId({self.id})" }
}

/// The running task's id; panics outside a task (`try_id`).
pub fn id() -> TaskId {
    try_id() ?? panic("task::id() outside a task")
}

/// The running task's id, or `none` outside a task (sync code, a
/// `spawn_blocking` thread).
pub fn try_id() -> TaskId | none {
    let w = current()?;
    let t = w.pool.running[w.index]?;
    TaskId { id: t.id }
}

/// A task was cancelled (2.18.4).
pub struct CancellationError {}

impl Display for CancellationError {
    fn display(self) -> str { "task cancelled" }
}

impl Debug for CancellationError {
    fn debug(self) -> str { "CancellationError" }
}

impl Error for CancellationError {}

/// Run `fut` as a new task on any worker, concurrently with the
/// spawner (2.18.1). Needs a running executor (inside `async fn main` /
/// `block_on`).
pub fn spawn<F: Future + Send>(fut: F) -> Task<F::Output> where F::Output: Send {
    let w = current_worker();
    let slot: GcBuf<F::Output> = buf_new(1);
    let t = new_task(w.pool, poll_fn(fut, slot), false, w.index);
    Task { task: t, slot: slot }
}

/// Run `fut` as a new task on this worker only (it need not be `Send`).
pub fn spawn_local<F: Future>(fut: F) -> Task<F::Output> {
    let w = current_worker();
    let slot: GcBuf<F::Output> = buf_new(1);
    let t = new_task(w.pool, poll_fn(fut, slot), true, w.index);
    Task { task: t, slot: slot }
}

/// Every task's result, in order (2.18.1).
pub async fn join<T>(tasks: List<Task<T>>) -> List<T> {
    let out: List<T> = List::new();
    for t in tasks {
        out.push(await t);
    }
    out
}

/// The result of whichever task finishes first (2.18.1).
pub fn race<T>(tasks: List<Task<T>>) -> Race<T> {
    Race { tasks: tasks }
}

pub struct Race<T> {
    tasks: List<Task<T>>;
}

impl<T> Future for Race<T> {
    type Output = T;
    fn poll(ref self, ref ctx: Context) -> Poll<T> {
        for t in self.tasks {
            if join_later(t.task, ctx.waker) {
                return Poll::Ready(t.slot[0]);
            }
        }
        Poll::Pending
    }
}

/// The first of `futs` to complete, with its index: `let (i, v) = await
/// task::select([a, b])` (refs-lang 4.12.9 names `select`; 2.18 gives no
/// signature). Unlike `race` the futures are not spawned: they run inside
/// the awaiting task, polled in list order (ties go to the lower index).
/// The futures share one type: `async { .. }` blocks with the same
/// output do (wrap differing outputs, `async { Msg::A(await a) }`).
/// Once one completes, every other one that has started is polled once
/// more as cancelled (its `await` leaves through `finally` / `using`, as
/// for `Task::cancel`) and dropped. Panics on an empty list.
pub fn select<F: Future>(futs: List<F>) -> SelectFuture<F> {
    if futs.len() == 0 {
        panic("task::select of no futures");
    }
    let started: GcBuf<bool> = buf_new(futs.len());
    let proxy: GcBuf<TaskRef | none> = buf_new(1);
    // A zeroed slot is not `none` for a struct union: store it.
    proxy[0] = none;
    SelectFuture { futs: futs, started: started, proxy: proxy }
}

pub struct SelectFuture<F> {
    futs: List<F>;
    started: GcBuf<bool>;
    /// The children's waker (`proxy_task`), made at the first poll: what
    /// they register (parking, timers) is dropped when `select` ends.
    proxy: GcBuf<TaskRef | none>;
}

impl<F: Future> Future for SelectFuture<F> {
    type Output = (usize, F::Output);
    fn poll(ref self, ref ctx: Context) -> Poll<(usize, F::Output)> {
        let p = match self.proxy[0] {
            t: TaskRef => t,
            none => {
                let t = proxy_task(ctx.waker);
                self.proxy[0] = t;
                t
            }
        };
        let c = Context::from_waker(Waker { task: p });
        let n = self.futs.len();
        for i in 0..n {
            let f = self.futs[i];
            self.started[i] = true;
            let r = f.poll(ref c);
            self.futs[i] = f;
            if let Poll::Ready(v) = r {
                self.cancel_others(i, p);
                return Poll::Ready((i, v));
            }
        }
        Poll::Pending
    }
}

impl<F: Future> SelectFuture<F> {
    /// Finish the proxy (its wakes stop) as cancelled, poll the started
    /// losers once with it (their cancellation path), then drop all it
    /// registered.
    fn cancel_others(self, winner: usize, p: TaskRef) {
        atomic_xchg(p.state, 0, DONE, SeqCst);
        atomic_xchg(p.state, 1, 1, SeqCst);
        let c = Context::from_waker(Waker { task: p });
        for i in 0..self.futs.len() {
            if i != winner && self.started[i] {
                let f = self.futs[i];
                f.poll(ref c);
            }
        }
        finish_cancelled(p);
    }
}

/// A stand-in task for `select`'s children: never scheduled; its wakes
/// go to `parent` until it is done.
fn proxy_task(parent: Waker) -> TaskRef {
    let state: GcBuf<i32> = buf_new(5);
    state[3] = 1;
    let p: GcBuf<fn(Context) -> bool> = buf_new(1);
    p[0] = |ctx: Context| -> bool { true };
    let up: GcBuf<Waker> = buf_new(1);
    up[0] = parent;
    TaskRef {
        state: state,
        poll: p,
        joiners: Mutex::new(List::<Waker>::new()),
        pool: parent.task.pool,
        parked: List::new(),
        local: false,
        home: 0,
        id: 0,
        up: up,
    }
}

/// Drop a finished cancelled task's parking entries and timers.
fn finish_cancelled(t: TaskRef) {
    unpark_task(t);
    if atomic_load(t.state, 2, SeqCst) != 0 {
        remove_timers(t);
    }
}

/// Index of the first task to finish (`buffer_unordered`).
pub(pkg) fn first_done<T>(tasks: List<Task<T>>) -> FirstDone<T> {
    FirstDone { tasks: tasks }
}

pub(pkg) struct FirstDone<T> {
    tasks: List<Task<T>>;
}

impl<T> Future for FirstDone<T> {
    type Output = usize;
    fn poll(ref self, ref ctx: Context) -> Poll<usize> {
        for i in 0..self.tasks.len() {
            if join_later(self.tasks[i].task, ctx.waker) {
                return Poll::Ready(i);
            }
        }
        Poll::Pending
    }
}

// ---- time ----

/// Completes once `dur` has passed (2.18.1).
pub fn sleep(dur: Duration) -> Sleep {
    Sleep { deadline: now_ns() + dur.as_nanos() }
}

/// Completes at `when`.
pub fn sleep_until(when: Instant) -> Sleep {
    Sleep { deadline: when.as_nanos() }
}

pub struct Sleep {
    deadline: i64;
}

impl Future for Sleep {
    type Output = ();
    fn poll(ref self, ref ctx: Context) -> Poll<()> {
        if now_ns() >= self.deadline {
            return Poll::Ready(());
        }
        add_timer(self.deadline, ctx.waker);
        Poll::Pending
    }
}

/// Let the other ready tasks run once (2.18.1).
pub fn yield_now() -> YieldNow {
    YieldNow { yielded: false }
}

pub struct YieldNow {
    yielded: bool;
}

impl Future for YieldNow {
    type Output = ();
    fn poll(ref self, ref ctx: Context) -> Poll<()> {
        if self.yielded {
            return Poll::Ready(());
        }
        self.yielded = true;
        ctx.waker.wake();
        Poll::Pending
    }
}

/// `task`'s result, or `TimeoutError` once `dur` has passed (2.18.1):
/// `try await task::timeout(d, t)`.
pub fn timeout<T>(dur: Duration, task: Task<T>) -> Timeout<T> {
    Timeout { task: task, deadline: now_ns() + dur.as_nanos() }
}

pub struct Timeout<T> {
    task: Task<T>;
    deadline: i64;
}

impl<T> Timeout<T> {
    pub fn poll(ref self, ref ctx: Context) throws (TimeoutError) -> Poll<T> {
        if join_later(self.task.task, ctx.waker) {
            return Poll::Ready(self.task.slot[0]);
        }
        if now_ns() >= self.deadline {
            throw TimeoutError {};
        }
        add_timer(self.deadline, ctx.waker);
        Poll::Pending
    }
}

/// `task::timeout` ran out.
pub struct TimeoutError {}

impl Display for TimeoutError {
    fn display(self) -> str { "timed out" }
}

impl Debug for TimeoutError {
    fn debug(self) -> str { "TimeoutError" }
}

impl Error for TimeoutError {}

// ---- parking: async waits on sync primitives and fds ----

/// Tasks waiting on a key (a primitive's GC address, or an fd's
/// `io_key`): `Mutex::lock_async`, `Receiver::recv_async`, socket I/O
/// park here; whoever may have made the key ready unparks it (708's
/// park / unpark at the task level).
// ponytail: one process-wide table behind one lock.
pub struct Parking {
    lock: Mutex<i32>;
    waiting: Dict<usize, List<Waker>>;
}

fn parking() -> Parking {
    let p: GcBuf<Parking> = buf_new(1);
    if unsafe { rok_task_parking_ready() } == 0 {
        p[0] = Parking { lock: Mutex::new(0), waiting: Dict::<usize, List<Waker>>::new() };
    }
    (unsafe { rok_task_parking_install(p) })[0]
}

/// Wake `waker` at the next `unpark(key)`. The entry goes at that
/// `unpark` or when the waker's task finishes (a cancelled task's wait).
pub fn park(key: usize, waker: Waker) {
    let p = parking();
    using g = p.lock.lock() {
        match p.waiting.get(key) {
            l: List<Waker> => l.push(waker),
            none => {
                let l: List<Waker> = List::new();
                l.push(waker);
                p.waiting.insert(key, l);
            }
        }
        let ks = waker.task.parked;
        let known = false;
        for k in ks {
            if k == key { known = true; }
        }
        if !known {
            // Keys it was since unparked from, once in a while (a
            // long-lived task parking on many keys).
            if ks.len() >= 16 && ks.len() % 16 == 0 {
                let live: List<usize> = List::new();
                for k in ks {
                    if parked_on(p, k, waker.task) { live.push(k); }
                }
                ks.clear();
                for k in live { ks.push(k); }
            }
            ks.push(key);
        }
    }
}

/// Is `t` in `key`'s list? (Under `p.lock`.)
fn parked_on(p: Parking, key: usize, t: TaskRef) -> bool {
    if let l: List<Waker> = p.waiting.get(key) {
        for w in l {
            if same_task(w.task, t) { return true; }
        }
    }
    false
}

/// Drop finished task `t`'s parking entries.
fn unpark_task(t: TaskRef) {
    if t.parked.len() == 0 || unsafe { rok_task_parking_ready() } == 0 {
        return;
    }
    let p = parking();
    using g = p.lock.lock() {
        for k in t.parked {
            if let l: List<Waker> = p.waiting.get(k) {
                let rest: List<Waker> = List::new();
                for w in l {
                    if !same_task(w.task, t) { rest.push(w); }
                }
                if rest.len() == 0 {
                    p.waiting.remove(k);
                } else {
                    p.waiting.insert(k, rest);
                }
            }
        }
        t.parked.clear();
    }
}

fn same_task(a: TaskRef, b: TaskRef) -> bool {
    unsafe { rok_task_key_i32(a.state) == rok_task_key_i32(b.state) }
}

/// Parked wakers (all keys) plus pending timers of unfinished tasks of
/// the running pool: a diagnostic (a cancelled task leaves none
/// behind).
pub fn registrations() -> usize {
    let n: usize = 0;
    if unsafe { rok_task_parking_ready() } != 0 {
        let p = parking();
        using g = p.lock.lock() {
            for l in p.waiting.values() {
                n += l.len();
            }
        }
    }
    if let pool: Pool = current_pool() {
        using g = pool.timers.lock() {
            for w in g.get().who {
                if !is_done(w.task) { n += 1; }
            }
        }
    }
    n
}

/// Wake every task parked on `key` (cheap when no task ever parked).
pub fn unpark(key: usize) {
    if unsafe { rok_task_parking_ready() } == 0 {
        return;
    }
    let p = parking();
    let woken: List<Waker> | none = none;
    using g = p.lock.lock() {
        woken = p.waiting.remove(key);
    }
    if let l: List<Waker> = woken {
        for w in l {
            w.wake();
        }
    }
}

// ---- the I/O driver (707) ----

/// The parking key of `fd`'s read (`write == 0`) or write readiness.
fn io_key(fd: i32, write: i32) -> usize {
    (1usize << 62) | ((fd as usize) * 2 + (write as usize))
}

/// Start the driver thread once: it blocks in kqueue / epoll and
/// unparks the tasks waiting on each fd that became ready.
fn start_driver() {
    if unsafe { rok_io_driver_claim() } == 0 {
        return;
    }
    let body: fn() + Send = || {
        let evs: GcBuf<i64> = buf_new(128);
        loop {
            let n = unsafe { rok_io_poll(evs, 128) };
            for i in 0..n {
                let k = evs[i as usize];
                unpark(io_key((k / 2) as i32, (k % 2) as i32));
            }
        }
    };
    let h = unsafe { rok_thread_spawn(body, 0, rok_thread_new_id()) };
    unsafe { rok_thread_detach(h) };
}

/// Completes once `fd` may be readable (`await task::readable(fd)`
/// after a read hit `WouldBlock`); it may also complete spuriously, so
/// retry the operation in a loop.
pub fn readable(fd: i32) -> IoReady {
    IoReady { fd: fd, write: 0, armed: false }
}

/// `readable` for writes.
pub fn writable(fd: i32) -> IoReady {
    IoReady { fd: fd, write: 1, armed: false }
}

pub struct IoReady {
    fd: i32;
    write: i32;
    armed: bool;
}

impl Future for IoReady {
    type Output = ();
    fn poll(ref self, ref ctx: Context) -> Poll<()> {
        if self.armed {
            return Poll::Ready(());
        }
        start_driver();
        if unsafe { rok_io_watch(self.fd) } < 0 {
            // Not pollable: let the operation report the error.
            return Poll::Ready(());
        }
        // Park first, then look: an edge after the look unparks us.
        park(io_key(self.fd, self.write), ctx.waker);
        if unsafe { rok_net_wait(self.fd, self.write, 0) } != 0 {
            return Poll::Ready(());
        }
        self.armed = true;
        Poll::Pending
    }
}

// ---- runtime ABI (805 §8.5.5, 708 §7.8.8) ----
//
// `rok_io_register` / `rok_timer_register` / `rok_coro_park` /
// `rok_coro_unpark` are runtime symbols that call back here (`abi_hook`,
// installed when a pool starts), for hand-written futures and foreign
// code. A `waker` is a one-element `GcBuf<Waker>`; a coroutine `frame`
// is any GC object, whose address is the parking key. Each registration
// wakes once: register again for the next wait.

/// The runtime's ABI calls: `op` 0 `rok_io_register(fd = a, interest =
/// b)`, 1 `rok_timer_register(deadline = a)`, 2 `rok_coro_park(frame =
/// a)`, 3 `rok_coro_unpark(frame = a)` (`w` unused).
fn abi_hook(op: i32, a: i64, b: i64, w: GcBuf<Waker>) {
    if op == 0 {
        io_register(a as i32, b, w[0]);
    } else if op == 1 {
        add_timer(a, w[0]);
    } else if op == 2 {
        park(a as usize, w[0]);
    } else {
        unpark(a as usize);
    }
}

/// Wake `w` once `fd` may be readable (`interest & 1`) or writable
/// (`interest & 2`) — at once if it already is, or if the fd cannot be
/// watched (the retried operation reports the error).
fn io_register(fd: i32, interest: i64, w: Waker) {
    start_driver();
    if unsafe { rok_io_watch(fd) } < 0 {
        w.wake();
        return;
    }
    for dir in 0..2 {
        if (interest >> (dir as i64)) & 1 != 0 {
            // Park first, then look (as `readable`).
            park(io_key(fd, dir), w);
            if unsafe { rok_net_wait(fd, dir, 0) } != 0 {
                w.wake();
            }
        }
    }
}

// ---- blocking work (regular files) ----

/// Run `f` on the blocking pool; the future completes with its result
/// (tokio's `spawn_blocking`). For syscalls with no readiness to wait
/// on, like regular files under kqueue / epoll. `f` is queued at once; a
/// cancelled awaiter leaves it to finish in the background and its
/// result is dropped.
pub fn spawn_blocking<T: Send>(f: fn() -> T + Send) -> Blocking<T> {
    let slot: GcBuf<T> = buf_new(1);
    let done: GcBuf<bool> = buf_new(1);
    let waiter: Mutex<Waker | none> = Mutex::new(none);
    let job: fn() + Send = || {
        slot[0] = f();
        let w: Waker | none = none;
        using g = waiter.lock() {
            done[0] = true;
            w = g.get();
        }
        if let k: Waker = w {
            k.wake();
        }
    };
    BLOCKING.submit(job);
    Blocking { slot: slot, done: done, waiter: waiter }
}

/// Most pool threads at once (tokio's default); past it jobs queue.
const BLOCKING_MAX_THREADS: usize = 512;
/// A pool thread idle this long exits (tokio's default).
const BLOCKING_KEEP_ALIVE_NS: i64 = 10_000_000_000;

/// The process-wide blocking pool: threads start lazily when a job finds
/// no idle one (up to `BLOCKING_MAX_THREADS`), take jobs FIFO, and exit
/// after `BLOCKING_KEEP_ALIVE_NS` without one.
static BLOCKING: BlockingPool = BlockingPool::new();

struct BlockingPool {
    lock: Mutex<i32>;
    /// Queued jobs are `jobs[head..]` (under `lock`).
    jobs: List<fn() + Send>;
    /// `[head, threads]` (under `lock`).
    counts: GcBuf<usize>;
    /// The sleeping threads' wake words (under `lock`): a submit pops one,
    /// sets it to 1 and wakes that thread only.
    idle: List<GcBuf<i32>>;
}

unsafe impl Send for BlockingPool {}
unsafe impl Sync for BlockingPool {}

impl BlockingPool {
    fn new() -> BlockingPool {
        let counts: GcBuf<usize> = buf_new(2);
        BlockingPool { lock: Mutex::new(0), jobs: List::new(), counts: counts, idle: List::new() }
    }

    fn submit(self, job: fn() + Send) {
        let spawn = false;
        let wake: GcBuf<i32> | none = none;
        using g = self.lock.lock() {
            self.jobs.push(job);
            // Hand the job to one sleeping thread, else start one.
            if let w: GcBuf<i32> = self.idle.pop() {
                w[0] = 1;
                wake = w;
            } else if self.counts[1] < BLOCKING_MAX_THREADS {
                self.counts[1] += 1;
                spawn = true;
            }
        }
        if let w: GcBuf<i32> = wake {
            unsafe { rok_sync_wake(w, 0) };
        }
        if spawn {
            let pool = self;
            let h = unsafe { rok_thread_spawn(|| pool.work(BLOCKING_KEEP_ALIVE_NS), 0, rok_thread_new_id()) };
            if h == 0 {
                self.work(0); // no thread to be had: drain the queue here
            } else {
                unsafe { rok_thread_detach(h) };
            }
        }
    }

    /// A pool thread: run queued jobs until idle for `keep_alive` ns.
    fn work(self, keep_alive: i64) {
        let me: GcBuf<i32> = buf_new(1);
        let idle_since = now_ns();
        loop {
            let job: (fn() + Send) | none = none;
            let quit = false;
            using g = self.lock.lock() {
                let head = self.counts[0];
                if head < self.jobs.len() {
                    job = self.jobs[head];
                    if head + 1 == self.jobs.len() {
                        self.jobs.clear();
                        self.counts[0] = 0;
                    } else {
                        self.counts[0] = head + 1;
                    }
                } else if now_ns() - idle_since >= keep_alive {
                    self.counts[1] -= 1;
                    quit = true;
                } else {
                    me[0] = 0;
                    self.idle.push(me);
                }
            }
            if quit {
                return;
            }
            if let f: fn() + Send = job {
                f();
                idle_since = now_ns();
                continue;
            }
            let left = idle_since + keep_alive - now_ns();
            unsafe { rok_sync_wait_timeout(me, 0, 0, left) };
            using g = self.lock.lock() {
                // Not handed a job (a timeout or a spurious wake): leave
                // the idle list.
                if me[0] == 0 {
                    let mine = unsafe { rok_task_key_i32(me) };
                    for i in 0..self.idle.len() {
                        if unsafe { rok_task_key_i32(self.idle[i]) } == mine {
                            self.idle.remove(i);
                            break;
                        }
                    }
                }
            }
        }
    }
}

pub struct Blocking<T> {
    slot: GcBuf<T>;
    /// Set under `waiter`'s lock, after `slot`.
    done: GcBuf<bool>;
    waiter: Mutex<Waker | none>;
}

impl<T> Future for Blocking<T> {
    type Output = T;
    fn poll(ref self, ref ctx: Context) -> Poll<T> {
        let done = false;
        using g = self.waiter.lock() {
            done = self.done[0];
            if !done {
                g.set(ctx.waker);
            }
        }
        if done {
            return Poll::Ready(self.slot[0]);
        }
        Poll::Pending
    }
}
