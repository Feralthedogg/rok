// rok::core::channel — message passing between threads (stdlib spec
// 2.17). Multi-producer, single-consumer; `recv` / `send` block the OS
// thread, `recv_async` / `for await` / `send_async` suspend the task
// (`task::park`: receivers on the `meta` address, senders one past it).
//
// ponytail: one `Mutex` + two `Condvar`s around a growable ring of
// one-value boxes (spec: lock-free ring / segmented list). A popped slot
// is pointed at a shared empty box, so a received value is not kept
// alive by the channel.

/// What `send` hands back when this sender was closed.
pub enum SendError<T> {
    Closed(T),
}

pub enum TrySendError<T> {
    Full(T),
    Closed(T),
}

// `meta` slots.
const HEAD: usize = 0;
const LEN: usize = 1;
const SENDERS: usize = 2;
/// Queue limit, 0 = unbounded (a rendezvous channel has 1).
const LIMIT: usize = 3;
const CAP: usize = 4;
/// Values ever pushed / popped (rendezvous senders wait on `POPPED`).
const PUSHED: usize = 5;
const POPPED: usize = 6;
/// 1: `channel_bounded(0)`, a send returns once a receiver took it.
const RENDEZVOUS: usize = 7;
/// Receivers blocked in `recv`.
const WAITING: usize = 8;
/// 1 while the receiver is suspended in `recv_async` / `for await`.
const ASYNC_WAITING: usize = 9;

struct Chan<T> {
    lock: Mutex<i32>;
    meta: GcBuf<usize>;
    ring: GcBuf<GcBuf<GcBuf<T>>>;
    empty: GcBuf<T>;
    not_empty: Condvar;
    not_full: Condvar;
}

extern "C" {
    fn rok_task_key_usize(meta: GcBuf<usize>) -> usize;
}

impl<T> Chan<T> {
    fn get(self, i: usize) -> usize { self.meta[i] }

    /// Wake tasks parked in `recv_async` (a value or a close arrived).
    fn notify_async(self) {
        rok::core::task::unpark(unsafe { rok_task_key_usize(self.meta) });
    }

    /// Wake tasks suspended in `send_async` (room, or a value taken).
    fn notify_senders(self) {
        self.not_full.notify_all();
        rok::core::task::unpark(self.send_key());
    }

    fn send_key(self) -> usize {
        unsafe { rok_task_key_usize(self.meta) } + 1
    }
    fn put(self, i: usize, v: usize) { self.meta[i] = v; }

    fn full(self) -> bool {
        self.get(LIMIT) > 0 && self.get(LEN) >= self.get(LIMIT)
    }

    // The lock is held for the calls below.
    fn push(self, v: T) {
        let head = self.get(HEAD);
        let len = self.get(LEN);
        let cap = self.get(CAP);
        let ring = self.ring[0];
        if len == cap {
            let bigger: GcBuf<GcBuf<T>> = buf_new(cap * 2);
            for i in 0..len {
                bigger[i] = ring[(head + i) % cap];
            }
            self.ring[0] = bigger;
            ring = bigger;
            head = 0;
            cap *= 2;
            self.put(HEAD, 0);
            self.put(CAP, cap);
        }
        let cell: GcBuf<T> = buf_new(1);
        cell[0] = v;
        ring[(head + len) % cap] = cell;
        self.put(LEN, len + 1);
        self.meta[PUSHED] += 1;
    }

    fn pop(self) -> T {
        let head = self.get(HEAD);
        let ring = self.ring[0];
        let v = ring[head][0];
        ring[head] = self.empty;
        self.put(HEAD, (head + 1) % self.get(CAP));
        self.meta[LEN] -= 1;
        self.meta[POPPED] += 1;
        v
    }
}

fn make<T>(limit: usize, rendezvous: bool) -> (Sender<T>, Receiver<T>) {
    let meta: GcBuf<usize> = buf_new(10);
    meta[SENDERS] = 1;
    meta[LIMIT] = limit;
    meta[CAP] = 16;
    if rendezvous {
        meta[RENDEZVOUS] = 1;
    }
    let ring: GcBuf<GcBuf<GcBuf<T>>> = buf_new(1);
    let store: GcBuf<GcBuf<T>> = buf_new(16);
    ring[0] = store;
    let empty: GcBuf<T> = buf_new(0);
    let ch = Chan {
        lock: Mutex::new(0),
        meta: meta,
        ring: ring,
        empty: empty,
        not_empty: Condvar::new(),
        not_full: Condvar::new(),
    };
    let open: GcBuf<bool> = buf_new(1);
    open[0] = true;
    (Sender { ch: ch, open: open }, Receiver { ch: ch })
}

/// An unbounded channel.
pub fn channel<T: Send>() -> (Sender<T>, Receiver<T>) {
    make(0usize, false)
}

/// A channel holding at most `cap` queued values: `send` blocks while
/// it is full. `cap` 0 is a rendezvous channel: `send` returns once a
/// receiver has taken the value.
pub fn channel_bounded<T: Send>(cap: usize) -> (Sender<T>, Receiver<T>) {
    if cap == 0 {
        return make(1usize, true);
    }
    make(cap, false)
}

/// The sending end. Each clone is its own sender and is closed on its
/// own; the channel closes when every sender has closed (2.17.3).
pub struct Sender<T> {
    ch: Chan<T>;
    open: GcBuf<bool>;
}

impl<T> Sender<T> {
    /// Queue `value` (blocking while a bounded channel is full, and on a
    /// rendezvous channel until it is received). Throws it back if this
    /// sender was closed.
    pub fn send(self, value: T) throws (SendError<T>) {
        if !self.open[0] {
            throw SendError::Closed(value);
        }
        using g = self.ch.lock.lock() {
            while self.ch.full() {
                g = self.ch.not_full.wait(g);
            }
            let ticket = self.ch.get(PUSHED);
            self.ch.push(value);
            self.ch.not_empty.notify_all();
            self.ch.notify_async();
            if self.ch.get(RENDEZVOUS) == 1 {
                while self.ch.get(POPPED) <= ticket {
                    g = self.ch.not_full.wait(g);
                }
            }
        }
    }

    /// Queue `value` without blocking: `Full` if a bounded channel is
    /// full, or if no receiver is waiting on a rendezvous channel.
    pub fn try_send(self, value: T) throws (TrySendError<T>) {
        if !self.open[0] {
            throw TrySendError::Closed(value);
        }
        let sent = false;
        using g = self.ch.lock.lock() {
            let ready = if self.ch.get(RENDEZVOUS) == 1 {
                self.ch.get(WAITING) + self.ch.get(ASYNC_WAITING) > self.ch.get(LEN)
            } else {
                !self.ch.full()
            };
            if ready {
                self.ch.push(value);
                sent = true;
            }
        }
        if !sent {
            throw TrySendError::Full(value);
        }
        self.ch.not_empty.notify_all();
        self.ch.notify_async();
    }

    /// `try await tx.send_async(v)` inside async code: like `send`, but
    /// suspends the task (not the thread) while a bounded channel is
    /// full, and on a rendezvous channel until the value is received.
    pub fn send_async(self, value: T) -> SendFuture<T> {
        SendFuture { tx: self, value: value, pushed: false, ticket: 0 }
    }

    /// Close this sender; later `send`s on it throw `Closed`.
    pub fn close(self) {
        using g = self.ch.lock.lock() {
            if self.open[0] {
                self.open[0] = false;
                self.ch.meta[SENDERS] -= 1;
            }
        }
        self.ch.not_empty.notify_all();
        self.ch.notify_async();
    }
}

impl<T> Clone for Sender<T> {
    /// Another open sender on the same channel.
    fn clone(self) -> Sender<T> {
        using g = self.ch.lock.lock() {
            self.ch.meta[SENDERS] += 1;
        }
        let open: GcBuf<bool> = buf_new(1);
        open[0] = true;
        Sender { ch: self.ch, open: open }
    }
}

/// The receiving end.
pub struct Receiver<T> {
    ch: Chan<T>;
}

impl<T> Receiver<T> {
    /// `await rx.recv_async()` inside async code: like `recv`, but
    /// suspends the task instead of blocking the thread.
    pub fn recv_async(self) -> RecvFuture<T> {
        RecvFuture { rx: self }
    }

    /// The next value, blocking until one arrives; `none` once the queue
    /// is empty and every sender has closed.
    pub fn recv(self) -> T | none {
        let got = false;
        let v: T | none = none;
        using g = self.ch.lock.lock() {
            self.ch.meta[WAITING] += 1;
            while self.ch.get(LEN) == 0 && self.ch.get(SENDERS) > 0 {
                g = self.ch.not_empty.wait(g);
            }
            self.ch.meta[WAITING] -= 1;
            if self.ch.get(LEN) > 0 {
                v = self.ch.pop();
                got = true;
            }
        }
        if got {
            self.ch.notify_senders();
        }
        v
    }

    /// The next value if one is queued; `none` if empty or closed.
    pub fn try_recv(self) -> T | none {
        let got = false;
        let v: T | none = none;
        using g = self.ch.lock.lock() {
            if self.ch.get(LEN) > 0 {
                v = self.ch.pop();
                got = true;
            }
        }
        if got {
            self.ch.notify_senders();
        }
        v
    }

    /// Values until the channel closes (also `for v in rx`).
    pub fn iter(self) -> ChannelIter<T> {
        ChannelIter { rx: self }
    }
}

/// `for v in rx` (2.17.5).
impl<T> IntoIterator for Receiver<T> {
    type IntoIter = ChannelIter<T>;
    type Item = T;
    fn into_iter(self) -> ChannelIter<T> {
        ChannelIter { rx: self }
    }
}

pub struct ChannelIter<T> {
    rx: Receiver<T>;
}

impl<T> Iterator for ChannelIter<T> {
    type Item = T;
    fn next(ref self) -> T | none {
        self.rx.recv()
    }
}

/// `Receiver::recv_async`.
pub struct RecvFuture<T> {
    rx: Receiver<T>;
}

impl<T> rok::core::future::Future for RecvFuture<T> {
    type Output = T | none;
    fn poll(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<T | none> {
        let rx = self.rx;
        rx.poll_next(ref ctx)
    }
}

/// `for await v in rx` (2.17.5): values until every sender has closed.
impl<T> rok::core::stream::Stream for Receiver<T> {
    type Item = T;
    fn poll_next(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<T | none> {
        // Park before looking, so a send after the look unparks us.
        rok::core::task::park(unsafe { rok_task_key_usize(self.ch.meta) }, ctx.waker());
        let got = false;
        let closed = false;
        let v: T | none = none;
        using g = self.ch.lock.lock() {
            if self.ch.get(LEN) > 0 {
                v = self.ch.pop();
                got = true;
            } else if self.ch.get(SENDERS) == 0 {
                closed = true;
            }
            // A rendezvous `try_send` counts a suspended receiver.
            self.ch.put(ASYNC_WAITING, if got || closed { 0 } else { 1 });
        }
        if got {
            self.ch.notify_senders();
            return rok::core::future::Poll::Ready(v);
        }
        if closed {
            return rok::core::future::Poll::Ready(none);
        }
        rok::core::future::Poll::Pending
    }
}

/// `Sender::send_async`.
pub struct SendFuture<T> {
    tx: Sender<T>;
    value: T;
    pushed: bool;
    ticket: usize;
}

impl<T> SendFuture<T> {
    pub fn poll(ref self, ref ctx: rok::core::future::Context) throws (SendError<T>) -> rok::core::future::Poll<()> {
        let ch = self.tx.ch;
        if !self.pushed {
            if !self.tx.open[0] {
                throw SendError::Closed(self.value);
            }
            // Park before looking, so a receive after the look unparks us.
            rok::core::task::park(ch.send_key(), ctx.waker());
            using g = ch.lock.lock() {
                if !ch.full() {
                    self.ticket = ch.get(PUSHED);
                    ch.push(self.value);
                    self.pushed = true;
                }
            }
            if !self.pushed {
                return rok::core::future::Poll::Pending;
            }
            ch.not_empty.notify_all();
            ch.notify_async();
            if ch.get(RENDEZVOUS) == 0 {
                return rok::core::future::Poll::Ready(());
            }
        }
        // Rendezvous: done once a receiver took our value.
        rok::core::task::park(ch.send_key(), ctx.waker());
        let taken = false;
        using g = ch.lock.lock() {
            taken = ch.get(POPPED) > self.ticket;
        }
        if taken {
            return rok::core::future::Poll::Ready(());
        }
        rok::core::future::Poll::Pending
    }
}
