// rok::core::channel — message passing between threads (stdlib spec
// 2.17). Multi-producer, single-consumer; `recv` / `send` block the OS
// thread, `recv_async` / `for await` / `send_async` suspend the task
// (`task::park`: receivers on the `meta` address, senders one past it).
//
// One `Mutex` and two `Condvar`s around the queue (2.17.6): a bounded
// channel's is a fixed ring (a `Deque` made at its capacity, so it never
// grows), an unbounded one's a list of fixed segments (it grows without
// copying, and drained segments are dropped).

use rok::core::rt::key;

/// What `send` hands back when this sender was closed.
pub enum SendError<T> {
    Closed(T),
}

pub enum TrySendError<T> {
    Full(T),
    Closed(T),
}

// Errors (2.14.3) whatever `T` is: the value they carry is not shown.
impl<T> Display for SendError<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("sending on a closed channel") }
}

impl<T> Debug for SendError<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("Closed(..)") }
}

impl<T> Error for SendError<T> {}

impl<T> Display for TrySendError<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        match self {
            TrySendError::Full(_) => try f.write_str("sending on a full channel"),
            TrySendError::Closed(_) => try f.write_str("sending on a closed channel"),
        }
    }
}

impl<T> Debug for TrySendError<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        match self {
            TrySendError::Full(_) => try f.write_str("Full(..)"),
            TrySendError::Closed(_) => try f.write_str("Closed(..)"),
        }
    }
}

impl<T> Error for TrySendError<T> {}

// `meta` slots.
const SENDERS: usize = 0;
/// Queue limit, 0 = unbounded (a rendezvous channel has 1).
const LIMIT: usize = 1;
/// Values ever pushed / popped (rendezvous senders wait on `POPPED`).
const PUSHED: usize = 2;
const POPPED: usize = 3;
/// 1: `channel_bounded(0)`, a send returns once a receiver took it.
const RENDEZVOUS: usize = 4;
/// Receivers blocked in `recv`.
const WAITING: usize = 5;
/// 1 while the receiver is suspended in `recv_async` / `for await`.
const ASYNC_WAITING: usize = 6;

struct Chan<T> {
    lock: Mutex<i32>;
    meta: GcBuf<usize>;
    queue: Deque<T> | Segments<T>;
    not_empty: Condvar;
    not_full: Condvar;
}

// `queue` is only touched with `lock` held.
unsafe impl<T: Send> Send for Chan<T> {}
unsafe impl<T: Send> Sync for Chan<T> {}

impl<T> Chan<T> {
    const fn get(self, i: usize) -> usize {
        unsafe {
            self.meta[i]
        }
    }

    /// Wake tasks parked in `recv_async` (a value or a close arrived).
    fn notify_async(self) {
        rok::core::task::unpark(key(self.meta));
    }

    /// Wake tasks suspended in `send_async` (room, or a value taken).
    fn notify_senders(self) {
        self.not_full.notify_all();
        rok::core::task::unpark(self.send_key());
    }

    fn send_key(self) -> usize {
        key(self.meta) + 1
    }
    const fn put(self, i: usize, v: usize) {
        unsafe {
            self.meta[i] = v;
        }
    }

    const fn full(self) -> bool {
        self.get(LIMIT) > 0 && self.len() >= self.get(LIMIT)
    }

    const fn len(self) -> usize {
        match self.queue {
            q: Deque<T> => q.len(),
            q: Segments<T> => q.len(),
        }
    }

    // The lock is held for the calls below.
    const fn push(self, v: T) {
        unsafe {
            match self.queue {
                q: Deque<T> => q.push_back(v),
                q: Segments<T> => q.push(v),
            }
            self.meta[PUSHED] += 1;
        }
    }

    const fn pop(self) -> T {
        unsafe {
            self.meta[POPPED] += 1;
            match self.queue {
                q: Deque<T> => q.pop_front() ?? panic("channel: pop from an empty queue"),
                q: Segments<T> => q.pop(),
            }
        }
    }
}

/// Slots per segment of an unbounded queue.
const SEGMENT: usize = 32;

struct Segment<T> {
    slots: GcBuf<T>;
    next: GcBuf<Segment<T> | none>;
}

const fn segment<T>() -> Segment<T> {
    unsafe {
        let next: GcBuf<Segment<T> | none> = buf_new(1);
        next[0] = none;
        Segment { slots: buf_new(SEGMENT), next: next }
    }
}

/// An unbounded FIFO: values enter the tail segment and leave the head
/// one; a full tail links a new segment, a drained head is unlinked.
struct Segments<T> {
    /// `[head, tail]`.
    ends: GcBuf<Segment<T>>;
    /// `[head index, tail index, len]`.
    at: GcBuf<usize>;
    /// One zeroed `T`: what a vacated slot holds (so it keeps nothing alive).
    zero: GcBuf<T>;
}

const fn segments<T>() -> Segments<T> {
    unsafe {
        let ends: GcBuf<Segment<T>> = buf_new(2);
        let s = segment();
        ends[0] = s;
        ends[1] = s;
        Segments { ends: ends, at: buf_new(3), zero: buf_new(1) }
    }
}

impl<T> Segments<T> {
    const fn len(self) -> usize {
        unsafe { self.at[2] }
    }

    const fn push(self, v: T) {
        unsafe {
            if self.at[1] == SEGMENT {
                let s = segment();
                self.ends[1].next[0] = s;
                self.ends[1] = s;
                self.at[1] = 0;
            }
            self.ends[1].slots[self.at[1]] = v;
            self.at[1] += 1;
            self.at[2] += 1;
        }
    }

    /// The oldest value; the queue is not empty.
    const fn pop(self) -> T {
        unsafe {
            if self.at[2] == 0 {
                panic("channel: pop from an empty queue");
            }
            if self.at[0] == SEGMENT {
                self.ends[0] = self.ends[0].next[0] ?? panic("channel: segment list broken");
                self.at[0] = 0;
            }
            let head = self.ends[0];
            let v = head.slots[self.at[0]];
            head.slots[self.at[0]] = self.zero[0];
            self.at[0] += 1;
            self.at[2] -= 1;
            v
        }
    }
}

const fn make<T>(limit: usize, rendezvous: bool) -> (Sender<T>, Receiver<T>) {
    unsafe {
        let meta: GcBuf<usize> = buf_new(7);
        meta[SENDERS] = 1;
        meta[LIMIT] = limit;
        if rendezvous {
            meta[RENDEZVOUS] = 1;
        }
        let ch = Chan {
            lock: Mutex::new(0),
            meta: meta,
            queue: if limit > 0 {
                Deque::<T>::with_capacity(limit)
            } else {
                segments::<T>()
            },
            not_empty: Condvar::new(),
            not_full: Condvar::new(),
        };
        let open: GcBuf<bool> = buf_new(1);
        open[0] = true;
        (Sender { ch: ch, open: open }, Receiver { ch: ch })
    }
}

/// An unbounded channel.
pub const fn channel<T: Send>() -> (Sender<T>, Receiver<T>) {
    make(0usize, false)
}

/// A channel holding at most `cap` queued values: `send` blocks while
/// it is full. `cap` 0 is a rendezvous channel: `send` returns once a
/// receiver has taken the value.
pub const fn channel_bounded<T: Send>(cap: usize) -> (Sender<T>, Receiver<T>) {
    if cap == 0 {
        return make(1usize, true);
    }
    make(cap, false)
}

/// The sending end. Each clone is its own sender and is closed on its
/// own; the channel closes when every sender has closed (2.17.3).
pub struct Sender<T> {
    ch: Chan<T>;
    open: GcBuf<bool>;
}

impl<T> Sender<T> {
    /// Queue `value` (blocking while a bounded channel is full, and on a
    /// rendezvous channel until it is received). Throws it back if this
    /// sender was closed.
    pub fn send(self, value: T) throws (SendError<T>) {
        unsafe {
            if !self.open[0] {
                throw SendError::Closed(value);
            }
            using g = self.ch.lock.lock() {
                while self.ch.full() {
                    g = self.ch.not_full.wait(g);
                }
                let ticket = self.ch.get(PUSHED);
                self.ch.push(value);
                self.ch.not_empty.notify_all();
                self.ch.notify_async();
                if self.ch.get(RENDEZVOUS) == 1 {
                    while self.ch.get(POPPED) <= ticket {
                        g = self.ch.not_full.wait(g);
                    }
                }
            }
        }
    }

    /// Queue `value` without blocking: `Full` if a bounded channel is
    /// full, or if no receiver is waiting on a rendezvous channel.
    pub fn try_send(self, value: T) throws (TrySendError<T>) {
        unsafe {
            if !self.open[0] {
                throw TrySendError::Closed(value);
            }
            let sent = false;
            using g = self.ch.lock.lock() {
                let ready = if self.ch.get(RENDEZVOUS) == 1 {
                    self.ch.get(WAITING) + self.ch.get(ASYNC_WAITING) > self.ch.len()
                } else {
                    !self.ch.full()
                };
                if ready {
                    self.ch.push(value);
                    sent = true;
                }
            }
            if !sent {
                throw TrySendError::Full(value);
            }
            self.ch.not_empty.notify_all();
            self.ch.notify_async();
        }
    }

    /// `try await tx.send_async(v)` inside async code: like `send`, but
    /// suspends the task (not the thread) while a bounded channel is
    /// full, and on a rendezvous channel until the value is received.
    pub const fn send_async(self, value: T) -> SendFuture<T> {
        SendFuture { tx: self, value: value, pushed: false, ticket: 0 }
    }

    /// Close this sender; later `send`s on it throw `Closed`.
    pub fn close(self) {
        unsafe {
            using g = self.ch.lock.lock() {
                if self.open[0] {
                    self.open[0] = false;
                    self.ch.meta[SENDERS] -= 1;
                }
            }
            self.ch.not_empty.notify_all();
            self.ch.notify_async();
        }
    }
}

impl<T> Clone for Sender<T> {
    /// Another open sender on the same channel.
    fn clone(self) -> Sender<T> {
        unsafe {
            using g = self.ch.lock.lock() {
                self.ch.meta[SENDERS] += 1;
            }
            let open: GcBuf<bool> = buf_new(1);
            open[0] = true;
            Sender { ch: self.ch, open: open }
        }
    }
}

/// The receiving end.
pub struct Receiver<T> {
    ch: Chan<T>;
}

impl<T> Receiver<T> {
    /// `await rx.recv_async()` inside async code: like `recv`, but
    /// suspends the task instead of blocking the thread.
    pub const fn recv_async(self) -> RecvFuture<T> {
        RecvFuture { rx: self }
    }

    /// The next value, blocking until one arrives; `none` once the queue
    /// is empty and every sender has closed.
    pub fn recv(self) -> T | none {
        unsafe {
            let got = false;
            let v: T | none = none;
            using g = self.ch.lock.lock() {
                self.ch.meta[WAITING] += 1;
                while self.ch.len() == 0 && self.ch.get(SENDERS) > 0 {
                    g = self.ch.not_empty.wait(g);
                }
                self.ch.meta[WAITING] -= 1;
                if self.ch.len() > 0 {
                    v = self.ch.pop();
                    got = true;
                }
            }
            if got {
                self.ch.notify_senders();
            }
            v
        }
    }

    /// The next value if one is queued; `none` if empty or closed.
    pub fn try_recv(self) -> T | none {
        let got = false;
        let v: T | none = none;
        using g = self.ch.lock.lock() {
            if self.ch.len() > 0 {
                v = self.ch.pop();
                got = true;
            }
        }
        if got {
            self.ch.notify_senders();
        }
        v
    }

    /// Values until the channel closes (also `for v in rx`).
    pub fn iter(self) -> ChannelIter<T> {
        ChannelIter { rx: self }
    }
}

/// `for v in rx` (2.17.5).
impl<T> IntoIterator for Receiver<T> {
    type IntoIter = ChannelIter<T>;
    type Item = T;
    const fn into_iter(self) -> ChannelIter<T> {
        ChannelIter { rx: self }
    }
}

pub struct ChannelIter<T> {
    rx: Receiver<T>;
}

impl<T> Iterator for ChannelIter<T> {
    type Item = T;
    fn next(ref self) -> T | none {
        self.rx.recv()
    }
}

/// `Receiver::recv_async`.
pub struct RecvFuture<T> {
    rx: Receiver<T>;
}

impl<T> rok::core::future::Future for RecvFuture<T> {
    type Output = T | none;
    fn poll(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<T | none> {
        let rx = self.rx;
        rx.poll_next(ref ctx)
    }
}

/// `for await v in rx` (2.17.5): values until every sender has closed.
impl<T> rok::core::stream::Stream for Receiver<T> {
    type Item = T;
    fn poll_next(ref self, ref ctx: rok::core::future::Context) -> rok::core::future::Poll<T | none> {
        // A cancelled task leaves at this `await`: a value taken now
        // would be dropped, so leave it queued (and stop counting as a
        // suspended receiver).
        if rok::core::task::cancel_requested(ctx) {
            using g = self.ch.lock.lock() {
                self.ch.put(ASYNC_WAITING, 0);
            }
            return rok::core::future::Poll::Pending;
        }
        // Park before looking, so a send after the look unparks us.
        rok::core::task::park(key(self.ch.meta), ctx.waker());
        let got = false;
        let closed = false;
        let v: T | none = none;
        using g = self.ch.lock.lock() {
            if self.ch.len() > 0 {
                v = self.ch.pop();
                got = true;
            } else if self.ch.get(SENDERS) == 0 {
                closed = true;
            }
            // A rendezvous `try_send` counts a suspended receiver.
            self.ch.put(ASYNC_WAITING, if got || closed { 0 } else { 1 });
        }
        if got {
            self.ch.notify_senders();
            return rok::core::future::Poll::Ready(v);
        }
        if closed {
            return rok::core::future::Poll::Ready(none);
        }
        rok::core::future::Poll::Pending
    }
}

/// `Sender::send_async`.
pub struct SendFuture<T> {
    tx: Sender<T>;
    value: T;
    pushed: bool;
    ticket: usize;
}

impl<T> SendFuture<T> {
    pub fn poll(ref self, ref ctx: rok::core::future::Context) throws (SendError<T>) -> rok::core::future::Poll<()> {
        unsafe {
            let ch = self.tx.ch;
            if !self.pushed {
                if !self.tx.open[0] {
                    throw SendError::Closed(self.value);
                }
                // A cancelled task does not send.
                if rok::core::task::cancel_requested(ctx) {
                    return rok::core::future::Poll::Pending;
                }
                // Park before looking, so a receive after the look unparks us.
                rok::core::task::park(ch.send_key(), ctx.waker());
                using g = ch.lock.lock() {
                    if !ch.full() {
                        self.ticket = ch.get(PUSHED);
                        ch.push(self.value);
                        self.pushed = true;
                    }
                }
                if !self.pushed {
                    return rok::core::future::Poll::Pending;
                }
                ch.not_empty.notify_all();
                ch.notify_async();
                if ch.get(RENDEZVOUS) == 0 {
                    return rok::core::future::Poll::Ready(());
                }
            }
            // Rendezvous: done once a receiver took our value.
            rok::core::task::park(ch.send_key(), ctx.waker());
            let taken = false;
            using g = ch.lock.lock() {
                taken = ch.get(POPPED) > self.ticket;
            }
            if taken {
                return rok::core::future::Poll::Ready(());
            }
            rok::core::future::Poll::Pending
        }
    }
}

// The module paths of stdlib 2.17.6.
pub mod sender {
    pub use rok::core::channel::{Sender, SendFuture, SendError, TrySendError};
}
pub mod receiver {
    pub use rok::core::channel::{Receiver, RecvFuture, ChannelIter};
}
