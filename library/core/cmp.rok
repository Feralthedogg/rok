// rok::core::cmp — total equality, ordering and hashing (stdlib spec
// 2.5). `PartialEq` / `PartialOrd` carry the comparison operators and
// stay with the other operator traits in `ops.rok`. `Eq` is a pure
// marker with no methods, so it has no slot.

pub trait Eq: PartialEq {}

/// The result of a three-way comparison (2.5.4).
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

impl Ordering {
    pub fn is_lt(self) -> bool { match self { Ordering::Less => true, _ => false } }
    pub fn is_eq(self) -> bool { match self { Ordering::Equal => true, _ => false } }
    pub fn is_gt(self) -> bool { match self { Ordering::Greater => true, _ => false } }
    pub fn reverse(self) -> Ordering {
        match self {
            Ordering::Less => Ordering::Greater,
            Ordering::Equal => Ordering::Equal,
            Ordering::Greater => Ordering::Less,
        }
    }
}

impl PartialEq for Ordering {
    fn eq(self, rhs: Ordering) -> bool {
        match (self, rhs) {
            (Ordering::Less, Ordering::Less) => true,
            (Ordering::Equal, Ordering::Equal) => true,
            (Ordering::Greater, Ordering::Greater) => true,
            _ => false,
        }
    }
    fn ne(self, rhs: Ordering) -> bool { !self.eq(rhs) }
}

impl Eq for Ordering {}

/// A total order (2.5.5).
#[lang("ord_trait")]
pub trait Ord: PartialOrd + Eq {
    fn cmp(self, rhs: Self) -> Ordering;

    fn min(self, rhs: Self) -> Self {
        if self.le(rhs) { self } else { rhs }
    }

    fn max(self, rhs: Self) -> Self {
        if self.ge(rhs) { self } else { rhs }
    }

    fn clamp(self, low: Self, high: Self) -> Self {
        if self.lt(low) { return low; }
        if self.gt(high) { return high; }
        self
    }
}

/// `a == b` ⇒ `a.hash() == b.hash()` (2.5.6) — what `Dict` / `Set`
/// rely on.
#[lang("hash_trait")]
pub trait Hash: Eq {
    fn hash(self) -> u64;
}
