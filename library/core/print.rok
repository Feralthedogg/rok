// rok::core::print — `print` / `println` / `eprint` / `eprintln`
// (stdlib 3.5.2: they live in core so the implicit `use rok::core::**`
// exposes them). Use an f-string for anything that is not a `str`:
// `println(f"total = {total}")`.

extern "C" {
    fn rok_write_str(s: str) -> i32;
    fn rok_ewrite_str(s: str) -> i32;
}

pub fn print(s: str) { unsafe { rok_write_str(s) }; }
pub fn println(s: str) { unsafe { rok_write_str(s); rok_write_str("\n"); } }
pub fn eprint(s: str) { unsafe { rok_ewrite_str(s) }; }
pub fn eprintln(s: str) { unsafe { rok_ewrite_str(s); rok_ewrite_str("\n"); } }
