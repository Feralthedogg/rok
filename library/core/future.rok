// Future + Stream traits (spec 4.12 / 4.13).
//
// `await expr` desugars to `<typeof(expr) as Future>::poll(...)` once
// the LangTable consumer for `future_trait` lands. Stage-1 lowers
// `await` as passthrough (no real suspend), so this trait registration
// is here for spec parity and to be ready for the eventual scheduler.

#[lang("future_trait")]
trait Future {
    type Output;
    fn poll(self) -> Output | none;
}

// No `stream_trait` slot in stdlib spec 0.4 — unregistered for now.
trait Stream {
    type Item;
    fn next(self) -> Item | none;
}
