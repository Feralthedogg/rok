/// No short-circuit: both lists are evaluated (2.6.2).
impl DotLogicalAnd for List<bool> {
    type Output = List<bool>;
    #[track_caller]
    fn dot_logical_and(self, rhs: List<bool>) -> List<bool> {
        zip_with(self, rhs, |a: bool, b: bool| -> bool { a && b })
    }
}

/// No short-circuit: both lists are evaluated (2.6.2).
impl DotLogicalOr for List<bool> {
    type Output = List<bool>;
    #[track_caller]
    fn dot_logical_or(self, rhs: List<bool>) -> List<bool> {
        zip_with(self, rhs, |a: bool, b: bool| -> bool { a || b })
    }
}
