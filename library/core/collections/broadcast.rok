// rok::core::collections::broadcast — the element-wise dot operators
// on `List<T>` (stdlib spec 2.6.7): `List op List` (same length, else a
// panic), `List op T` and `T op List` (the scalar applies to every
// element). Arithmetic / bitwise ones give `List<T>`, comparisons
// `List<bool>`; `.&&` / `.||` combine `List<bool>`s without
// short-circuit.

/// Lengths of two broadcast operands agree (a function broadcast
/// `f.(a, b)` checks each argument against the first).
#[track_caller]
pub fn check_len(len: usize, want: usize) {
    if len != want {
        panic(f"broadcast over lengths {want} and {len}");
    }
}

/// `[f(a[i], b[i])]`; panics when the lengths differ.
#[track_caller]
fn zip_with<A, B, C>(a: List<A>, b: List<B>, f: fn(A, B) -> C) -> List<C> {
    let n = a.len();
    if n != b.len() {
        panic(f"broadcast over lists of lengths {n} and {b.len()}");
    }
    let out: List<C> = List::with_capacity(n);
    for i in 0..n {
        out.push(f(a[i], b[i]));
    }
    out
}

/// `[f(a[i], b)]`.
fn map_right<A, B, C>(a: List<A>, b: B, f: fn(A, B) -> C) -> List<C> {
    let out: List<C> = List::with_capacity(a.len());
    for x in a {
        out.push(f(x, b));
    }
    out
}

/// `[f(a, b[i])]`.
fn map_left<A, B, C>(a: A, b: List<B>, f: fn(A, B) -> C) -> List<C> {
    let out: List<C> = List::with_capacity(b.len());
    for x in b {
        out.push(f(a, x));
    }
    out
}

impl<T: Add<Output = T>> DotAdd<List<T>> for List<T> {
    type Output = List<T>;
    #[track_caller]
    fn dot_add(self, rhs: List<T>) -> List<T> { zip_with(self, rhs, |a: T, b: T| -> T { a + b }) }
}

impl<T: Add<Output = T>> DotAdd<T> for List<T> {
    type Output = List<T>;
    fn dot_add(self, rhs: T) -> List<T> { map_right(self, rhs, |a: T, b: T| -> T { a + b }) }
}

impl<T: Add<Output = T>> DotAdd<List<T>> for T {
    type Output = List<T>;
    fn dot_add(self, rhs: List<T>) -> List<T> { map_left(self, rhs, |a: T, b: T| -> T { a + b }) }
}

