// rok::core::collections::dict — `Dict<K, V>`, a hash map (stdlib spec
// 2.9.3): open addressing with linear probing over a power-of-two
// table. `meta` holds `[len, capacity, used]` (`used` counts tombstones
// too); `slots` holds the current table, swapped on growth. Iteration
// order is unspecified.

/// One table: per slot a key, a value and a state (0 empty, 1 full,
/// 2 deleted). `keys` / `vals` have one more slot that stays zero: a
/// deleted slot's key and value are overwritten with it, so a tombstone
/// keeps nothing alive.
pub struct DictSlots<K, V> {
    keys: GcBuf<K>;
    vals: GcBuf<V>;
    state: GcBuf<u8>;
}

/// Home slot of hash `h` in a table of `mask + 1` slots: the hash
/// mixed first, so a weak one (an integer's own value) still spreads
/// over the low bits.
fn home(h: u64, mask: usize) -> usize {
    let x = h.wrapping_mul(0x9E37_79B9_7F4A_7C15u64);
    ((x ^ (x >> 32u64)) as usize) & mask
}

fn new_slots<K, V>(cap: usize) -> DictSlots<K, V> {
    unsafe {
        let n = cap_add(cap, 1);
        DictSlots {
            keys: buf_new(buf_len(n, size_of::<K>())),
            vals: buf_new(buf_len(n, size_of::<V>())),
            state: buf_new(buf_len(cap, 1)),
        }
    }
}

pub struct Dict<K, V> {
    meta: GcBuf<usize>;
    slots: GcBuf<DictSlots<K, V>>;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl<K, V> !Sync for Dict<K, V> {}

impl<K: Hash, V> Dict<K, V> {
    pub fn new() -> Dict<K, V> {
        Dict::with_capacity(4)
    }

    pub fn with_capacity(cap: usize) -> Dict<K, V> {
        unsafe {
            let c = 8usize;
            let want = cap_mul(cap, 2);
            while c < want {
                c = cap_mul(c, 2);
            }
            let meta: GcBuf<usize> = buf_new(3);
            meta[1] = c;
            let slots: GcBuf<DictSlots<K, V>> = buf_new(1);
            slots[0] = new_slots(c);
            Dict { meta, slots }
        }
    }

    pub fn len(self) -> usize {
        unsafe {
            self.meta[0]
        }
    }

    pub fn is_empty(self) -> bool {
        self.len() == 0
    }

    /// The slot holding `k`, or the capacity when absent.
    fn find(self, k: K) -> usize {
        unsafe {
            let s = self.slots[0];
            let cap = self.meta[1];
            let mask = cap - 1;
            let i = home(k.hash(), mask);
            for _ in 0..cap {
                let st = s.state[i];
                if st == 0u8 {
                    return cap;
                }
                if st == 1u8 && s.keys[i] == k {
                    return i;
                }
                i = (i + 1) & mask;
            }
            cap
        }
    }

    /// Store into the first non-full slot of `k`'s probe run (`k` is
    /// known to be absent and the table to have room).
    fn place(self, k: K, v: V) {
        unsafe {
            let s = self.slots[0];
            let mask = self.meta[1] - 1;
            let i = home(k.hash(), mask);
            while s.state[i] == 1u8 {
                i = (i + 1) & mask;
            }
            if s.state[i] == 0u8 {
                self.meta[2] += 1;
            }
            s.keys[i] = k;
            s.vals[i] = v;
            s.state[i] = 1u8;
            self.meta[0] += 1;
        }
    }

    /// Rebuild into a table of `cap` slots (drops tombstones).
    fn rehash(self, cap: usize) {
        unsafe {
            let old = self.slots[0];
            let old_cap = self.meta[1];
            self.slots[0] = new_slots(cap);
            self.meta[0] = 0;
            self.meta[1] = cap;
            self.meta[2] = 0;
            for i in 0..old_cap {
                if old.state[i] == 1u8 {
                    self.place(old.keys[i], old.vals[i]);
                }
            }
        }
    }

    /// Insert or replace; the old value, or `none`.
    pub fn insert(self, k: K, v: V) -> V | none {
        unsafe {
            let cap = self.meta[1];
            let at = self.find(k);
            if at < cap {
                let s = self.slots[0];
                let old = s.vals[at];
                s.vals[at] = v;
                return old;
            }
            // Load factor 3/4, tombstones included.
            if (self.meta[2] + 1) * 4 > cap * 3 {
                let grown = cap;
                if (self.len() + 1) * 2 > cap {
                    grown = cap_mul(cap, 2);
                }
                self.rehash(grown);
            }
            self.place(k, v);
            none
        }
    }

    pub fn get(self, k: K) -> V | none {
        unsafe {
            let at = self.find(k);
            if at == self.meta[1] {
                return none;
            }
            let s = self.slots[0];
            s.vals[at]
        }
    }

    pub fn contains_key(self, k: K) -> bool {
        unsafe {
            self.find(k) < self.meta[1]
        }
    }

    pub fn remove(self, k: K) -> V | none {
        unsafe {
            let cap = self.meta[1];
            let at = self.find(k);
            if at == cap {
                return none;
            }
            let s = self.slots[0];
            let v = s.vals[at];
            s.keys[at] = s.keys[cap];
            s.vals[at] = s.vals[cap];
            s.state[at] = 2u8;
            self.meta[0] -= 1;
            v
        }
    }

    /// The first full slot at or after `from`, or the capacity.
    fn next_full(self, from: usize) -> usize {
        unsafe {
            let s = self.slots[0];
            let cap = self.meta[1];
            let i = from;
            while i < cap && s.state[i] != 1u8 {
                i += 1;
            }
            i
        }
    }

    /// The keys, lazily (2.9.3; order unspecified).
    pub fn keys(self) -> DictKeys<K, V> {
        DictKeys { d: self, at: 0 }
    }

    /// The values, lazily.
    pub fn values(self) -> DictValues<K, V> {
        DictValues { d: self, at: 0 }
    }

    /// `(key, value)` pairs, lazily.
    pub fn entries(self) -> DictEntries<K, V> {
        DictEntries { d: self, at: 0 }
    }

    /// `k`'s place in the dict, present or not (2.9.3).
    pub fn entry(self, k: K) -> Entry<K, V> {
        Entry { d: self, key: k }
    }
}

/// `d.entry(k)`: read or fill one key's slot. Each call looks the key
/// up again.
pub struct Entry<K, V> {
    d: Dict<K, V>;
    key: K;
}

impl<K: Hash, V> Entry<K, V> {
    pub fn key(self) -> K {
        self.key
    }

    /// The value, after inserting `v` if the key is absent.
    pub fn or_insert(self, v: V) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, v);
        }
        self.d[self.key]
    }

    /// The value, after inserting `f()` if the key is absent.
    pub fn or_insert_with(self, f: fn() -> V) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, f());
        }
        self.d[self.key]
    }

    /// A present value replaced by `f(value)`; an absent key is left alone.
    pub fn and_modify(self, f: fn(V) -> V) -> Entry<K, V> {
        if self.d.contains_key(self.key) {
            self.d.insert(self.key, f(self.d[self.key]));
        }
        self
    }
}

impl<K: Hash, V: Default> Entry<K, V> {
    /// The value, after inserting `V::default()` if the key is absent.
    pub fn or_default(self) -> V {
        if !self.d.contains_key(self.key) {
            self.d.insert(self.key, V::default());
        }
        self.d[self.key]
    }
}

// The iterators walk the live table; a dict changed while iterated
// gives unspecified (but memory-safe) results.

pub struct DictKeys<K, V> {
    d: Dict<K, V>;
    at: usize;
}

impl<K: Hash, V> Iterator for DictKeys<K, V> {
    type Item = K;
    fn next(ref self) -> K | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.meta[1] {
                return none;
            }
            self.at = i + 1;
            let s = self.d.slots[0];
            s.keys[i]
        }
    }
}

pub struct DictValues<K, V> {
    d: Dict<K, V>;
    at: usize;
}

impl<K: Hash, V> Iterator for DictValues<K, V> {
    type Item = V;
    fn next(ref self) -> V | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.meta[1] {
                return none;
            }
            self.at = i + 1;
            let s = self.d.slots[0];
            s.vals[i]
        }
    }
}

pub struct DictEntries<K, V> {
    d: Dict<K, V>;
    at: usize;
}

impl<K: Hash, V> Iterator for DictEntries<K, V> {
    type Item = (K, V);
    fn next(ref self) -> (K, V) | none {
        unsafe {
            let i = self.d.next_full(self.at);
            if i >= self.d.meta[1] {
                return none;
            }
            self.at = i + 1;
            let s = self.d.slots[0];
            (s.keys[i], s.vals[i])
        }
    }
}

impl<K: Hash, V> Default for Dict<K, V> {
    fn default() -> Dict<K, V> { Dict::new() }
}

/// A new dict with every key and value cloned (stdlib 2.13.2).
impl<K: Hash + Clone, V: Clone> Clone for Dict<K, V> {
    fn clone(self) -> Dict<K, V> {
        let r: Dict<K, V> = Dict::new();
        for (k, v) in self {
            r.insert(k.clone(), v.clone());
        }
        r
    }
}

/// `d += e`: merge `e` in place; its values win (stdlib 2.4.6).
impl<K: Hash, V> AddAssign<Dict<K, V>> for Dict<K, V> {
    fn add_assign(ref self, rhs: Dict<K, V>) {
        for (k, v) in rhs {
            self.insert(k, v);
        }
    }
}

/// `for (k, v) in d` (2.9.9).
impl<K: Hash, V> IntoIterator for Dict<K, V> {
    type IntoIter = DictEntries<K, V>;
    type Item = (K, V);
    fn into_iter(self) -> DictEntries<K, V> {
        self.entries()
    }
}

/// `d[k]`; panics when the key is absent.
impl<K: Hash, V> Index<K> for Dict<K, V> {
    type Output = V;
    #[track_caller]
    fn index(self, k: K) -> V {
        unsafe {
            let at = self.find(k);
            if at == self.meta[1] {
                return panic("Dict: key not found");
            }
            let s = self.slots[0];
            s.vals[at]
        }
    }
}

/// `d[k] = v` inserts or replaces.
impl<K: Hash, V> IndexSet<K> for Dict<K, V> {
    type Value = V;
    fn index_set(self, k: K, v: V) {
        self.insert(k, v);
    }
}

/// Same keys, equal values (insertion order does not matter).
impl<K: Hash, V: PartialEq> PartialEq for Dict<K, V> {
    fn eq(self, rhs: Dict<K, V>) -> bool {
        if self.len() != rhs.len() { return false; }
        for (k, v) in self {
            if !rhs.contains_key(k) { return false; }
            if rhs[k] != v { return false; }
        }
        true
    }
    fn ne(self, rhs: Dict<K, V>) -> bool { !self.eq(rhs) }
}

impl<K: Hash, V: Eq> Eq for Dict<K, V> {}

/// Order-independent: entries combine by xor.
impl<K: Hash, V: Hash> Hash for Dict<K, V> {
    fn hash(self) -> u64 {
        let h = self.len() as u64;
        for (k, v) in self {
            let vh = v.hash();
            h ^= k.hash() ^ ((vh << 17u64) | (vh >> 47u64));
        }
        h
    }
}

/// `{k: v, ..}` with each key's and value's `Debug`, in iteration order.
impl<K: Hash + Debug, V: Debug> Debug for Dict<K, V> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("{");
        let first = true;
        for (k, v) in self {
            if !first { try f.write_str(", "); }
            try Debug::fmt(k, ref f);
            try f.write_str(": ");
            try Debug::fmt(v, ref f);
            first = false;
        }
        try f.write_str("}")
    }
}

/// `{k: v, ..}` (refs-lang 6.5.1, 6.5.6).
#[literal("{" {expr ":" expr} % "," * "}")]
pub fn dict_literal<K: Hash, V>(pairs: ...(K, V)) -> Dict<K, V> {
    let d: Dict<K, V> = Dict::new();
    for (k, v) in pairs {
        d.insert(k, v);
    }
    return d;
}
