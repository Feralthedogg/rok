// rok::core::collections::raw — the GC buffer the collections are built
// on. `GcBuf<T>` is compiler-known: one GC reference to an object
// holding a run of `T`s, zeroed at allocation; when `T` holds GC
// references the collector traces every element. It carries no length —
// its owner tracks that. The functions below are compiler intrinsics
// (unchecked indexing); their bodies never run.

pub struct GcBuf<T> {}

/// A zeroed buffer of `len` elements; `T` comes from the slot's type.
#[intrinsic("rok.buf.new")]
pub fn buf_new<T>(len: usize) -> GcBuf<T> {
    return buf_new(len);
}

/// Element `i` (no bounds check).
#[intrinsic("rok.buf.get")]
pub fn buf_get<T>(buf: GcBuf<T>, i: usize) -> T {
    return buf_get(buf, i);
}

/// Store element `i` (no bounds check).
#[intrinsic("rok.buf.set")]
pub fn buf_set<T>(buf: GcBuf<T>, i: usize, v: T) {
    buf_set(buf, i, v);
}
