// rok::core::collections::raw — the GC buffer the collections are built
// on. `GcBuf<T>` is compiler-known: one GC reference to an object
// holding a run of `T`s, zeroed at allocation; when `T` holds GC
// references the collector traces every element. It carries no length —
// its owner tracks that. The functions below are compiler intrinsics
// (unchecked indexing); their bodies never run.

pub struct GcBuf<T> {}

/// A zeroed buffer of `len` elements; `T` comes from the slot's type.
#[intrinsic("rok.buf.new")]
pub fn buf_new<T>(len: usize) -> GcBuf<T> {
    buf_new(len)
}

/// Element `i` (no bounds check).
#[intrinsic("rok.buf.get")]
pub fn buf_get<T>(buf: GcBuf<T>, i: usize) -> T {
    buf_get(buf, i)
}

/// Store element `i` (no bounds check).
#[intrinsic("rok.buf.set")]
pub fn buf_set<T>(buf: GcBuf<T>, i: usize, v: T) {
    buf_set(buf, i, v);
}

/// Whether `a` and `b` are one buffer (identity, not contents). Pins
/// nothing.
#[intrinsic("rok.buf.same")]
pub fn buf_same<T>(a: GcBuf<T>, b: GcBuf<T>) -> bool {
    buf_same(a, b)
}

/// `buf` typed as `GcBuf<u8>`: a runtime parameter that takes any GC
/// object.
#[intrinsic("rok.buf.erase")]
pub(pkg) fn buf_erase<T>(buf: GcBuf<T>) -> GcBuf<u8> {
    buf_erase(buf)
}

/// `b[i]`: unchecked, like `buf_get`. The compiler lowers `b[i]` on a
/// `GcBuf` straight to `rok.buf.get`, so this body never runs.
impl<T> Index<usize> for GcBuf<T> {
    type Output = T;
    fn index(self, i: usize) -> T {
        buf_get(self, i)
    }
}

/// `b[i] = v`: unchecked, like `buf_set`; lowered to `rok.buf.set`.
impl<T> IndexSet<usize> for GcBuf<T> {
    type Value = T;
    fn index_set(self, i: usize, v: T) {
        buf_set(self, i, v);
    }
}
