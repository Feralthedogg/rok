// rok::core::collections::list — `List<T>`, a growable array (stdlib
// spec 2.9.2). `meta` holds `[len, capacity]`; `data` holds the current
// element buffer, swapped for a bigger one on growth.

pub struct List<T> {
    meta: GcBuf<usize>;
    data: GcBuf<GcBuf<T>>;
}

impl<T> List<T> {
    pub fn new() -> List<T> {
        List::with_capacity(4)
    }

    pub fn with_capacity(cap: usize) -> List<T> {
        let meta: GcBuf<usize> = buf_new(2);
        meta[1] = cap;
        let data: GcBuf<GcBuf<T>> = buf_new(1);
        data[0] = buf_new(cap);
        List { meta, data }
    }

    pub fn len(self) -> usize {
        self.meta[0]
    }

    pub fn is_empty(self) -> bool {
        self.len() == 0
    }

    pub fn capacity(self) -> usize {
        self.meta[1]
    }

    /// The current element buffer (`Slice` views it).
    pub(pkg) fn buffer(self) -> GcBuf<T> {
        self.data[0]
    }

    /// Room for `additional` more elements (doubling).
    pub fn reserve(self, additional: usize) {
        let n = self.len();
        let cap = self.capacity();
        if n + additional <= cap {
            return;
        }
        let new_cap = cap * 2;
        if new_cap < n + additional {
            new_cap = n + additional;
        }
        let old = self.data[0];
        let store: GcBuf<T> = buf_new(new_cap);
        for i in 0..n {
            store[i] = old[i];
        }
        self.data[0] = store;
        self.meta[1] = new_cap;
    }

    /// Capacity cut down to the length.
    pub fn shrink_to_fit(self) {
        let n = self.len();
        if n == self.capacity() {
            return;
        }
        let old = self.data[0];
        let store: GcBuf<T> = buf_new(n);
        for i in 0..n {
            store[i] = old[i];
        }
        self.data[0] = store;
        self.meta[1] = n;
    }

    /// Push every item of `items`, in order.
    pub fn extend<I: IntoIterator<Item = T>>(self, items: I) {
        for x in items {
            self.push(x);
        }
    }

    pub fn push(self, x: T) {
        self.reserve(1);
        let n = self.len();
        self.data[0][n] = x;
        self.meta[0] = n + 1;
    }

    pub fn pop(self) -> T | none {
        let n = self.len();
        if n == 0 {
            return none;
        }
        self.meta[0] = n - 1;
        self.data[0][n - 1]
    }

    /// Element `idx`, or `none` out of bounds.
    pub fn get(self, idx: usize) -> T | none {
        if idx >= self.len() {
            return none;
        }
        self.data[0][idx]
    }

    pub fn first(self) -> T | none {
        self.get(0)
    }

    pub fn last(self) -> T | none {
        let n = self.len();
        if n == 0 {
            return none;
        }
        self.get(n - 1)
    }

    pub fn insert(self, idx: usize, x: T) {
        let n = self.len();
        if idx > n {
            panic("List::insert: index out of bounds");
        }
        self.reserve(1);
        let store = self.data[0];
        let i = n;
        while i > idx {
            store[i] = store[i - 1];
            i -= 1;
        }
        store[idx] = x;
        self.meta[0] = n + 1;
    }

    pub fn remove(self, idx: usize) -> T {
        let n = self.len();
        if idx >= n {
            return panic("List::remove: index out of bounds");
        }
        let store = self.data[0];
        let x = store[idx];
        for i in idx + 1..n {
            store[i - 1] = store[i];
        }
        self.meta[0] = n - 1;
        x
    }

    pub fn clear(self) {
        self.meta[0] = 0;
    }

    pub fn iter(self) -> ListIter<T> {
        // [front index, items taken from the back]
        let pos: GcBuf<usize> = buf_new(2);
        ListIter { list: self, pos }
    }
}

/// `xs.iter()` / `for x in xs`: walks a list front to back.
pub struct ListIter<T> {
    list: List<T>;
    pos: GcBuf<usize>;
}

impl<T> Iterator for ListIter<T> {
    type Item = T;
    fn next(ref self) -> T | none {
        let i = self.pos[0];
        if i + self.pos[1] >= self.list.len() {
            return none;
        }
        self.pos[0] = i + 1;
        self.list.get(i)
    }
}

impl<T> DoubleEndedIterator for ListIter<T> {
    fn next_back(ref self) -> T | none {
        let i = self.pos[0];
        let back = self.pos[1];
        if i + back >= self.list.len() {
            return none;
        }
        self.pos[1] = back + 1;
        self.list.get(self.list.len() - back - 1)
    }
}

impl<T> IntoIterator for List<T> {
    type IntoIter = ListIter<T>;
    type Item = T;
    fn into_iter(self) -> ListIter<T> {
        self.iter()
    }
}

impl<T> Default for List<T> {
    fn default() -> List<T> { List::new() }
}

/// A new list with every element cloned (stdlib 2.13.2).
impl<T: Clone> Clone for List<T> {
    fn clone(self) -> List<T> {
        let r: List<T> = List::new();
        for x in self {
            r.push(x.clone());
        }
        r
    }
}

/// `xs[i]`; panics out of bounds.
impl<T> Index<usize> for List<T> {
    type Output = T;
    fn index(self, idx: usize) -> T {
        if idx >= self.len() {
            return panic("List index out of bounds");
        }
        self.data[0][idx]
    }
}

/// `xs[i] = v`; panics out of bounds.
impl<T> IndexSet<usize> for List<T> {
    type Value = T;
    fn index_set(self, idx: usize, value: T) {
        if idx >= self.len() {
            panic("List index out of bounds");
        }
        self.data[0][idx] = value;
    }
}

/// `it.collect()` into a list (2.9.9).
impl<T> FromIterator<T> for List<T> {
    fn from_iter<I>(it: I) -> List<T> {
        let out: List<T> = List::new();
        for x in it {
            out.push(x);
        }
        out
    }
}

/// Element-wise, in order.
impl<T: PartialEq> PartialEq for List<T> {
    fn eq(self, rhs: List<T>) -> bool {
        let n = self.len();
        if n != rhs.len() { return false; }
        for i in 0..n {
            if self[i] != rhs[i] { return false; }
        }
        true
    }
    fn ne(self, rhs: List<T>) -> bool { !self.eq(rhs) }
}

impl<T: Eq> Eq for List<T> {}

/// Lexicographic (stdlib 2.5.7): the first differing element decides,
/// else the shorter list comes first.
impl<T: PartialEq + PartialOrd> PartialOrd for List<T> {
    fn lt(self, rhs: List<T>) -> bool {
        let n = self.len().min(rhs.len());
        for i in 0..n {
            if self[i] != rhs[i] { return self[i] < rhs[i]; }
        }
        self.len() < rhs.len()
    }
    fn le(self, rhs: List<T>) -> bool {
        let n = self.len().min(rhs.len());
        for i in 0..n {
            if self[i] != rhs[i] { return self[i] < rhs[i]; }
        }
        self.len() <= rhs.len()
    }
    fn gt(self, rhs: List<T>) -> bool { rhs.lt(self) }
    fn ge(self, rhs: List<T>) -> bool { rhs.le(self) }
}

impl<T: Ord> Ord for List<T> {
    fn cmp(self, rhs: List<T>) -> rok::core::cmp::Ordering {
        let n = self.len().min(rhs.len());
        for i in 0..n {
            let c = self[i].cmp(rhs[i]);
            if !c.is_eq() { return c; }
        }
        self.len().cmp(rhs.len())
    }
}

/// Order-dependent mix of the element hashes.
impl<T: Hash> Hash for List<T> {
    fn hash(self) -> u64 {
        let h = 0xcbf29ce484222325u64 ^ (self.len() as u64);
        for x in self {
            h = ((h << 5u64) | (h >> 59u64)) ^ x.hash();
        }
        h
    }
}

/// `[a, b, c]` with each element's `Debug`.
impl<T: Debug> Debug for List<T> {
    fn debug(self) -> str {
        let out = "[";
        let first = true;
        for x in self {
            if !first { out += ", "; }
            out += x.debug();
            first = false;
        }
        out + "]"
    }
}

/// `[a, b, c]` (refs-lang 6.5.1): a `List` — a fixed array only in a
/// `[T; N]` slot, which the compiler builds itself.
#[literal("[" {expr} % "," * "]")]
pub fn list_literal<T>(items: ...T) -> List<T> {
    let l: List<T> = List::new();
    for x in items {
        l.push(x);
    }
    return l;
}
