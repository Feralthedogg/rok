// rok::core::collections::set — `Set<T>`, a hash set (stdlib spec
// 2.9.4) over `Dict<T, bool>`. Iteration order is unspecified.

pub struct Set<T> {
    d: Dict<T, bool>;
}

// Shares its buffer like `List` (stdlib 2.13.9).
impl<T> !Sync for Set<T> {}

impl<T: Hash> Set<T> {
    pub fn new() -> Set<T> {
        Set { d: Dict::new() }
    }

    pub fn len(self) -> usize {
        self.d.len()
    }

    pub fn is_empty(self) -> bool {
        self.d.is_empty()
    }

    /// `true` when `x` was not there yet.
    pub fn insert(self, x: T) -> bool {
        self.d.insert(x, true) is none
    }

    /// `true` when `x` was there.
    pub fn remove(self, x: T) -> bool {
        !(self.d.remove(x) is none)
    }

    pub fn contains(self, x: T) -> bool {
        self.d.contains_key(x)
    }

    pub fn union(self, other: Set<T>) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in self.d.keys() {
            out.insert(x);
        }
        for x in other.d.keys() {
            out.insert(x);
        }
        out
    }

    pub fn intersection(self, other: Set<T>) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in self.d.keys() {
            if other.contains(x) {
                out.insert(x);
            }
        }
        out
    }

    pub fn difference(self, other: Set<T>) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in self.d.keys() {
            if !other.contains(x) {
                out.insert(x);
            }
        }
        out
    }

    pub fn symmetric_difference(self, other: Set<T>) -> Set<T> {
        self.difference(other).union(other.difference(self))
    }

    pub fn is_subset(self, other: Set<T>) -> bool {
        for x in self.d.keys() {
            if !other.contains(x) {
                return false;
            }
        }
        true
    }

    pub fn is_superset(self, other: Set<T>) -> bool {
        other.is_subset(self)
    }

    pub fn is_disjoint(self, other: Set<T>) -> bool {
        self.intersection(other).is_empty()
    }

    pub fn to_list(self) -> List<T> {
        self.d.keys().collect()
    }

    pub fn iter(self) -> KeysIter<T, bool> {
        self.d.keys()
    }
}

impl<T: Hash> Default for Set<T> {
    fn default() -> Set<T> { Set::new() }
}

/// A new set with every element cloned (stdlib 2.13.2).
impl<T: Hash + Clone> Clone for Set<T> {
    fn clone(self) -> Set<T> {
        let r: Set<T> = Set::new();
        for x in self {
            r.insert(x.clone());
        }
        r
    }
}

/// `for x in s` (2.9.9).
impl<T: Hash> IntoIterator for Set<T> {
    type IntoIter = KeysIter<T, bool>;
    type Item = T;
    fn into_iter(self) -> KeysIter<T, bool> {
        self.d.keys()
    }
}

/// `it.collect()` into a set (2.9.9).
impl<T: Hash> FromIterator<T> for Set<T> {
    fn from_iter<I>(it: I) -> Set<T> {
        let out: Set<T> = Set::new();
        for x in it {
            out.insert(x);
        }
        out
    }
}

/// Same members.
impl<T: Hash> PartialEq for Set<T> {
    fn eq(self, rhs: Set<T>) -> bool {
        if self.len() != rhs.len() { return false; }
        for x in self {
            if !rhs.contains(x) { return false; }
        }
        true
    }
    fn ne(self, rhs: Set<T>) -> bool { !self.eq(rhs) }
}

impl<T: Hash> Eq for Set<T> {}

/// Order-independent: member hashes combine by xor.
impl<T: Hash> Hash for Set<T> {
    fn hash(self) -> u64 {
        let h = self.len() as u64;
        for x in self { h ^= x.hash(); }
        h
    }
}

/// `{a, b, ..}` with each member's `Debug`, in iteration order.
impl<T: Hash + Debug> Debug for Set<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("{");
        let first = true;
        for x in self {
            if !first { try f.write_str(", "); }
            try Debug::fmt(x, ref f);
            first = false;
        }
        try f.write_str("}")
    }
}

/// `{a, b}` / `{a,}` (refs-lang 6.5.1, 6.5.6; `{ a }` is a block).
#[literal("{" {expr} % "," + "}")]
pub fn set_literal<T: Hash>(items: ...T) -> Set<T> {
    let s: Set<T> = Set::new();
    for x in items {
        s.insert(x);
    }
    return s;
}
