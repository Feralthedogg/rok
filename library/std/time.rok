// rok::std::time (stdlib spec 303): `Duration` / `Instant` live in
// `rok::core::task::time` (2.18.6) and are re-exported here; the wall
// clock (`SystemTime`) and the boot clock (`BootTime`) are std-only.

pub use rok::core::task::time::{Duration, Instant};

/// A wall-clock (UTC) point: `i64` nanoseconds from `UNIX_EPOCH`
/// (1678..2262). It can step backwards (NTP, the user).
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub struct SystemTime {
    ns: i64;
}

/// 1970-01-01 00:00:00 UTC.
pub const UNIX_EPOCH: SystemTime = SystemTime { ns: 0 };

impl SystemTime {
    pub fn now() -> SystemTime { SystemTime { ns: unsafe { rok_time_realtime_ns() } } }

    /// `self - earlier`; throws when `earlier` is later, carrying how much.
    pub fn duration_since(self, earlier: SystemTime) throws (SystemTimeError) -> Duration {
        if earlier.ns > self.ns {
            throw SystemTimeError { duration: Duration::ns(earlier.ns - self.ns) };
        }
        Duration::ns(self.ns - earlier.ns)
    }

    pub fn elapsed(self) throws (SystemTimeError) -> Duration { try SystemTime::now().duration_since(self) }

    pub fn checked_add(self, dur: Duration) -> SystemTime | none {
        SystemTime { ns: self.ns.checked_add(dur.as_ns())? }
    }
    pub fn checked_sub(self, dur: Duration) -> SystemTime | none {
        SystemTime { ns: self.ns.checked_sub(dur.as_ns())? }
    }

    pub fn from_unix(secs: i64, nanos: u32) -> SystemTime {
        SystemTime { ns: secs * 1000000000 + nanos as i64 }
    }
    /// Whole seconds since the epoch; throws before it.
    pub fn unix_seconds(self) throws (SystemTimeError) -> i64 { (try self.duration_since(UNIX_EPOCH)).as_secs() }
    /// Nanoseconds since the epoch (`i64`: no `i128` yet); throws before it.
    pub fn unix_nanos(self) throws (SystemTimeError) -> i64 { (try self.duration_since(UNIX_EPOCH)).as_ns() }
}

impl Add<Duration> for SystemTime {
    type Output = SystemTime;
    fn add(self, rhs: Duration) -> SystemTime { SystemTime { ns: self.ns + rhs.as_ns() } }
}

impl Sub<Duration> for SystemTime {
    type Output = SystemTime;
    fn sub(self, rhs: Duration) -> SystemTime { SystemTime { ns: self.ns - rhs.as_ns() } }
}

/// `SystemTime::duration_since` with `earlier` later than `self`.
pub struct SystemTimeError {
    /// How far `earlier` was ahead.
    pub duration: Duration;
}

impl Display for SystemTimeError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"second time provided was later than self by {self.duration}") }
}
impl Debug for SystemTimeError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"SystemTimeError({self.duration})") }
}
impl Error for SystemTimeError {}

/// Time since boot, counting suspend (3.3.4): `CLOCK_BOOTTIME` on Linux;
/// on macOS `CLOCK_MONOTONIC`, which counts sleep there.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub struct BootTime {
    ns: i64;
}

impl BootTime {
    pub fn now() -> BootTime { BootTime { ns: unsafe { rok_time_boot_ns() } } }
    pub fn elapsed(self) -> Duration { BootTime::now().duration_since(self) }
    pub fn duration_since(self, earlier: BootTime) -> Duration { Duration::ns(self.ns - earlier.ns) }
}
