// rok::std::thread — OS threads, 1:1 (stdlib spec 304, refs-lang
// 7.6.6). Each thread is a GC mutator: its frames are roots, it stops
// at safepoints, and blocking calls (`join`, `sleep`, lock waits) let a
// collection run without it.
//
// A panic in any thread ends the whole process (exit 101): panics are
// not catchable (2.14), so `join` never sees one. `JoinError` only
// reports an OS join failure.
//
// `current().name()` is always `none` (names live on the spawner's
// `JoinHandle`). A handle that is neither joined nor `detach`ed keeps
// its OS thread record (rok has no implicit drop to detach it).

use rok::std::io::IoError;
use rok::std::time::Duration;

extern "C" {
    fn rok_thread_new_id() -> u64;
    fn rok_thread_spawn(f: fn() + Send, stack_size: usize, id: u64) -> usize;
    fn rok_thread_join(handle: usize) -> i32;
    fn rok_thread_detach(handle: usize) -> i32;
    fn rok_thread_id() -> u64;
    fn rok_thread_sleep_ns(ns: i64);
    fn rok_thread_yield_now();
    fn rok_thread_park(timeout_ns: i64);
    fn rok_thread_unpark(id: u64);
}

/// Identifies a thread for its lifetime (its runtime worker id).
pub struct ThreadId {
    id: u64;
}

impl ThreadId {
    pub fn as_u64(self) -> u64 { self.id }
}

impl PartialEq for ThreadId {
    fn eq(self, rhs: ThreadId) -> bool { self.id == rhs.id }
    fn ne(self, rhs: ThreadId) -> bool { self.id != rhs.id }
}

/// A thread's identity. ponytail: spec writes `Thread<T>`; `T` is
/// unused by its methods, so it is left out.
pub struct Thread {
    id: ThreadId;
    name: str | none;
}

impl Thread {
    pub fn id(self) -> ThreadId { self.id }
    pub fn name(self) -> str | none { self.name }
    /// Wake the thread from `park` (or make its next `park` return at
    /// once). No-op once the thread has ended.
    pub fn unpark(self) { unsafe { rok_thread_unpark(self.id.id) }; }
}

/// The OS could not join the thread.
pub struct JoinError {
    message: str;
}

impl JoinError {
    pub fn message(self) -> str { self.message }
}

/// The running thread's result, once joined.
pub struct JoinHandle<T> {
    handle: usize;
    result: GcBuf<T>;
    thread: Thread;
}

impl<T> JoinHandle<T> {
    /// Wait for the thread and take its result.
    pub fn join(self) throws (JoinError) -> T {
        if unsafe { rok_thread_join(self.handle) } != 0 {
            throw JoinError { message: "pthread_join failed" };
        }
        self.result[0]
    }

    pub fn thread(self) -> Thread { self.thread }

    /// Let the thread run on its own; its OS resources are released when
    /// it ends. The handle must not be joined afterwards.
    pub fn detach(self) {
        unsafe { rok_thread_detach(self.handle) };
    }
}

/// Spawn configuration.
pub struct Builder {
    name: str | none;
    stack_size: usize | none;
}

impl Builder {
    pub fn new() -> Builder { Builder { name: none, stack_size: none } }

    pub fn name(self, name: str) -> Builder {
        Builder { name: name, stack_size: self.stack_size }
    }

    /// Stack bytes for the new thread (default 8 MiB).
    pub fn stack_size(self, size: usize) -> Builder {
        Builder { name: self.name, stack_size: size }
    }

    pub fn spawn<T: Send>(self, f: fn() -> T + Send) throws (IoError) -> JoinHandle<T> {
        let result: GcBuf<T> = buf_new(1);
        let run: fn() + Send = || { result[0] = f(); };
        let id = unsafe { rok_thread_new_id() };
        let h = unsafe { rok_thread_spawn(run, self.stack_size ?? 0usize, id) };
        if h == 0usize {
            throw IoError::new("could not create an OS thread");
        }
        JoinHandle {
            handle: h,
            result: result,
            thread: Thread { id: ThreadId { id: id }, name: self.name },
        }
    }
}

/// Run `f` on a new OS thread.
pub fn spawn<T: Send>(f: fn() -> T + Send) -> JoinHandle<T> {
    try! Builder::new().spawn(f)
}

/// The calling thread.
pub fn current() -> Thread {
    Thread { id: ThreadId { id: unsafe { rok_thread_id() } }, name: none }
}

/// Let the OS run another thread.
pub fn yield_now() {
    unsafe { rok_thread_yield_now() };
}

/// Block the calling thread for `dur`.
pub fn sleep(dur: Duration) {
    unsafe { rok_thread_sleep_ns(dur.as_nanos()) };
}

/// Always `false`: a panic ends the process before anything can ask.
pub fn panicking() -> bool { false }

/// Block until this thread is `unpark`ed (an earlier `unpark` makes it
/// return at once). May also return spuriously: re-check the condition.
pub fn park() {
    unsafe { rok_thread_park(-1) };
}

/// `park`, for at most `dur`.
pub fn park_timeout(dur: Duration) {
    unsafe { rok_thread_park(dur.as_nanos()) };
}

/// A value per thread, made by `init` on each thread's first use (304.4).
// ponytail: one `Dict` keyed by thread id behind a `Mutex`; entries of
// finished threads stay until the `ThreadLocal` is unreachable.
pub struct ThreadLocal<T> {
    init: fn() -> T + Sync;
    slots: Mutex<Dict<u64, Cell<T>>>;
}

// Each `Cell` is only reached from its own thread.
unsafe impl<T> Send for ThreadLocal<T> {}
unsafe impl<T> Sync for ThreadLocal<T> {}

impl<T> ThreadLocal<T> {
    /// This thread's cell.
    fn cell(self) -> Cell<T> {
        let id = unsafe { rok_thread_id() };
        let found: Cell<T> | none = none;
        using g = self.slots.lock() {
            found = g.get().get(id);
        }
        if let c: Cell<T> = found { return c; }
        let init = self.init;
        let c = Cell::new(init());
        using g = self.slots.lock() {
            g.get().insert(id, c);
        }
        c
    }

    /// Run `f` on this thread's value.
    pub fn with<R>(self, f: fn(Cell<T>) -> R) -> R {
        f(self.cell())
    }

    pub fn get(self) -> T {
        self.cell().get()
    }

    pub fn set(self, value: T) {
        self.cell().set(value);
    }
}

/// A `ThreadLocal` whose per-thread value starts as `init()`.
pub fn local<T>(init: fn() -> T + Sync) -> ThreadLocal<T> {
    let slots: Dict<u64, Cell<T>> = Dict::new();
    ThreadLocal { init: init, slots: Mutex::new(slots) }
}
