// rok::std::thread — OS threads, 1:1 (stdlib spec 304, refs-lang
// 7.6.6). Each thread is a GC mutator: its frames are roots, it stops
// at safepoints, and blocking calls (`join`, `sleep`, lock waits) let a
// collection run without it.
//
// A panic in any thread ends the whole process (exit 101): panics are
// not catchable (2.14), so `join` never sees one. `JoinError` only
// reports an OS join failure.
//
// A handle that is neither joined nor `detach`ed keeps its OS thread
// record (rok has no implicit drop to detach it).
//
// Each thread has one record (`Rec`: name, park token, thread-local
// values) in `THREADS`, keyed by its id: a spawned thread's is made
// before it starts and dropped when its closure returns; any other
// thread's on its first `current()` / `park` / thread-local use.

use rok::std::io::{IoError, IoErrorKind};
use rok::std::time::Duration;
use rok::core::future::IntoFuture;
use rok::core::task::Blocking;

/// Identifies a thread for its lifetime (its runtime worker id).
pub struct ThreadId {
    id: u64;
}

impl ThreadId {
    pub fn as_u64(self) -> u64 { self.id }
}

impl PartialEq for ThreadId {
    fn eq(self, rhs: ThreadId) -> bool { self.id == rhs.id }
    fn ne(self, rhs: ThreadId) -> bool { self.id != rhs.id }
}

/// What the library keeps per thread.
struct Rec {
    id: u64;
    name: str | none;
    /// 1 = an `unpark` is pending.
    park: Atomic<i32>;
    /// `ThreadLocal` key → that local's `Cell<T>` on this thread.
    locals: Dict<u64, any>;
}

// Every handle of a thread shares its `Rec`; `locals` is only touched by
// that thread.
unsafe impl Send for Rec {}
unsafe impl Sync for Rec {}

fn new_rec(id: u64, name: str | none) -> Rec {
    Rec { id: id, name: name, park: Atomic::new(0), locals: Dict::new() }
}

static THREADS: Mutex<Dict<u64, Rec>> = Mutex::new(Dict::new());

/// The calling thread's record, made on first use.
fn this_rec() -> Rec {
    let id = unsafe { rok_thread_id() };
    let found: Rec | none = none;
    using g = THREADS.lock() { found = g.get().get(id); }
    if let r: Rec = found {
        return r;
    }
    // Only the thread itself makes its record: no race to insert.
    let fresh = new_rec(id, none);
    using g = THREADS.lock() { g.get().insert(id, fresh); }
    fresh
}

/// A thread's identity (non-generic, 304.1).
pub struct Thread {
    rec: Rec;
}

impl Thread {
    pub fn id(self) -> ThreadId { ThreadId { id: self.rec.id } }
    pub fn name(self) -> str | none { self.rec.name }
    /// Wake the thread from `park` (or make its next `park` return at
    /// once). No-op once the thread has ended.
    pub fn unpark(self) {
        self.rec.park.store(1);
        self.rec.park.wake();
    }
}

/// The OS could not join the thread: `pthread_join`'s error number, or
/// [`JOIN_LOST`].
#[derive(Debug)]
pub struct JoinError {
    pub code: i32;
}

/// `JoinError::code` of a thread a failed REPL cell's rollback ended
/// (the session went back to before the cell; the thread is gone).
pub const JOIN_LOST: i32 = -1;

impl Display for JoinError {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        if self.code == JOIN_LOST {
            try f.write_str("thread join failed: the thread ended with a failed REPL cell")
        } else {
            try f.write_str(f"thread join failed (error {self.code})")
        }
    }
}

impl Error for JoinError {}

/// The running thread's result, once joined.
pub struct JoinHandle<T> {
    handle: usize;
    result: GcBuf<T>;
    thread: Thread;
}

impl<T> JoinHandle<T> {
    /// Wait for the thread and take its result.
    pub fn join(self) throws (JoinError) -> T {
        unsafe {
            if rok_thread_lost(self.thread.rec.id) != 0 {
                throw JoinError { code: JOIN_LOST };
            }
            let code = rok_thread_join(self.handle);
            if code != 0 { throw JoinError { code }; }
            self.result[0]
        }
    }

    pub fn thread(self) -> Thread { self.thread }

    /// Let the thread run on its own; its OS resources are released when
    /// it ends. The handle must not be joined afterwards.
    pub fn detach(self) {
        unsafe { rok_thread_detach(self.handle) };
    }
}

/// `await handle` (2.20.5): the join runs on the executor's blocking
/// lane, so only the task waits; a failed OS join panics.
impl<T: Send> IntoFuture for JoinHandle<T> {
    type Output = T;
    type IntoFuture = Blocking<T>;
    fn into_future(self) -> Blocking<T> {
        rok::core::task::spawn_blocking(|| try! self.join())
    }
}

/// Spawn configuration.
pub struct Builder {
    name: str | none;
    stack_size: usize | none;
}

impl Builder {
    pub fn new() -> Builder { Builder { name: none, stack_size: none } }

    pub fn name(self, name: str) -> Builder {
        Builder { name: name, stack_size: self.stack_size }
    }

    /// Stack bytes for the new thread (default 8 MiB).
    pub fn stack_size(self, size: usize) -> Builder {
        Builder { name: self.name, stack_size: size }
    }

    pub fn spawn<T: Send>(self, f: fn() -> T + Send) throws (IoError) -> JoinHandle<T> {
        unsafe {
            let result: GcBuf<T> = buf_new(1);
            let id = rok_thread_new_id();
            let rec = new_rec(id, self.name);
            using g = THREADS.lock() { g.get().insert(id, rec); }
            // Written once by the thread, read by `join` after it.
            let cell = Handoff::new(result);
            let run: fn() + Send = || {
                let result = cell.get();
                result[0] = f();
                using g = THREADS.lock() { g.get().remove(id); }
            };
            let h = unsafe { rok_thread_spawn(run, self.stack_size ?? 0usize, id) };
            if h == 0usize {
                using g = THREADS.lock() { g.get().remove(id); }
                // No threads on this target (wasm32-wasi, the browser).
                if unsafe { rok_cpu_count() } == 0 {
                    throw IoError::with_kind(IoErrorKind::Unsupported, "threads are not supported on this target");
                }
                throw IoError::new("could not create an OS thread");
            }
            JoinHandle { handle: h, result: result, thread: Thread { rec: rec } }
        }
    }
}

/// Run `f` on a new OS thread.
pub fn spawn<T: Send>(f: fn() -> T + Send) -> JoinHandle<T> {
    try! Builder::new().spawn(f)
}

/// The calling thread.
pub fn current() -> Thread {
    Thread { rec: this_rec() }
}

/// Let the OS run another thread.
pub fn yield_now() {
    unsafe { rok_thread_yield_now() };
}

/// Block the calling thread for `dur`.
pub fn sleep(dur: Duration) {
    unsafe { rok_thread_sleep_ns(dur.as_ns()) };
}

/// Always `false`: a panic ends the process before anything can ask.
pub fn panicking() -> bool { false }

/// Block until this thread is `unpark`ed (an earlier `unpark` makes it
/// return at once). May also return spuriously: re-check the condition.
pub fn park() {
    park_ns(-1);
}

/// `park`, for at most `dur`.
pub fn park_timeout(dur: Duration) {
    park_ns(dur.as_ns());
}

fn park_ns(timeout_ns: i64) {
    let token = this_rec().park;
    if token.swap(0) == 1 {
        return;
    }
    token.wait(0, timeout_ns);
    token.store(0);
}

/// A value per thread, made by `init` on each thread's first use (304.4).
/// It lives in the thread's record and goes with it.
pub struct ThreadLocal<T> {
    init: fn() -> T + Sync;
    key: u64;
}

static NEXT_LOCAL: Atomic<u64> = Atomic::new(1);

// Each `Cell` is only reached from its own thread.
unsafe impl<T> Send for ThreadLocal<T> {}
unsafe impl<T> Sync for ThreadLocal<T> {}

impl<T> ThreadLocal<T> {
    /// This thread's cell; only this thread touches its `locals`.
    fn cell(self) -> Cell<T> {
        let locals = this_rec().locals;
        if let v: any = locals.get(self.key) {
            if let c: Cell<T> = rok::core::reflect::cast::<Cell<T>>(v) {
                return c;
            }
        }
        let init = self.init;
        let c = Cell::new(init());
        locals.insert(self.key, c);
        c
    }

    /// `f` of this thread's value.
    pub fn with<R>(self, f: fn(T) -> R) -> R {
        f(self.get())
    }

    pub fn get(self) -> T {
        self.cell().get()
    }

    pub fn set(self, value: T) {
        self.cell().set(value);
    }
}

/// A `ThreadLocal` whose per-thread value starts as `init()`.
pub fn local<T>(init: fn() -> T + Sync) -> ThreadLocal<T> {
    ThreadLocal { init: init, key: NEXT_LOCAL.fetch_add(1) }
}
