// rok::std::net (stdlib spec 302): TCP / UDP sockets, addresses, DNS.
//
// Sockets are non-blocking underneath. The blocking calls (`accept`,
// `read`, ...) wait for readiness with `poll` — so read / write timeouts
// are that wait's limit — and `set_nonblocking(true)` makes them throw
// `WouldBlock` instead. The `*_async` calls suspend the task until the
// I/O driver (`task::readable` / `writable`, refs-lang 7.7) sees the fd
// ready: `try await s.read_async(buf)`.
//
// Read buffers are `List<u8>` (spec 302): `read(buf)` fills `buf[0..n]`
// of a pre-sized list in place. The write side takes any `AsBytes`
// (`str`, `List<u8>`, `Slice<u8>`).
//
// Spec 302 makes the plain calls suspend inside a task; here they block
// the worker and the `*_async` variants suspend (a sync fn cannot
// suspend a stackless coroutine). No Unix sockets, TLS, IPv6 multicast
// or zero-copy hooks (302.3 / 302.5 / 302.7). `set_*_timeout` applies
// to the blocking calls only (`task::timeout` covers async).

use rok::std::io::{IoError, IoErrorKind, Reader, Writer, AsBytes, check, would_block, region};
use rok::std::time::Duration;

// ---- addresses (302.4) ----

pub struct Ipv4Addr {
    pub octets: [u8; 4];
}

pub struct Ipv6Addr {
    pub segments: [u16; 8];
}

impl Ipv4Addr {
    pub const LOCALHOST: Ipv4Addr = Ipv4Addr { octets: [127u8, 0u8, 0u8, 1u8] };
    pub const UNSPECIFIED: Ipv4Addr = Ipv4Addr { octets: [0u8, 0u8, 0u8, 0u8] };

    pub fn new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr {
        Ipv4Addr { octets: [a, b, c, d] }
    }

    /// The address as a big-endian number (`a.b.c.d` = `a << 24 | ..`).
    pub fn to_bits(self) -> u32 {
        ((self.octets[0] as u32) << 24) | ((self.octets[1] as u32) << 16)
            | ((self.octets[2] as u32) << 8) | (self.octets[3] as u32)
    }

    pub fn is_loopback(self) -> bool { self.octets[0] == 127u8 }
    pub fn is_unspecified(self) -> bool { self.to_bits() == 0u32 }
    pub fn is_multicast(self) -> bool { self.octets[0] >= 224u8 && self.octets[0] <= 239u8 }
}

impl Ipv6Addr {
    pub const LOCALHOST: Ipv6Addr = Ipv6Addr { segments: [0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 1u16] };
    pub const UNSPECIFIED: Ipv6Addr = Ipv6Addr { segments: [0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16, 0u16] };

    pub fn new(a: u16, b: u16, c: u16, d: u16, e: u16, f: u16, g: u16, h: u16) -> Ipv6Addr {
        Ipv6Addr { segments: [a, b, c, d, e, f, g, h] }
    }

    pub fn is_loopback(self) -> bool {
        for i in 0..7 {
            if self.segments[i] != 0u16 { return false; }
        }
        self.segments[7] == 1u16
    }
}

impl PartialEq for Ipv4Addr {
    fn eq(self, rhs: Ipv4Addr) -> bool { self.to_bits() == rhs.to_bits() }
    fn ne(self, rhs: Ipv4Addr) -> bool { !self.eq(rhs) }
}

impl PartialEq for Ipv6Addr {
    fn eq(self, rhs: Ipv6Addr) -> bool {
        for i in 0..8 {
            if self.segments[i] != rhs.segments[i] { return false; }
        }
        true
    }
    fn ne(self, rhs: Ipv6Addr) -> bool { !self.eq(rhs) }
}

impl Display for Ipv4Addr {
    fn display(self) -> str {
        f"{self.octets[0]}.{self.octets[1]}.{self.octets[2]}.{self.octets[3]}"
    }
}

impl Debug for Ipv4Addr {
    fn debug(self) -> str { self.display() }
}

impl Display for Ipv6Addr {
    /// RFC 5952: lowercase hex, the longest run (2+) of zero groups as `::`.
    fn display(self) -> str {
        let best = -1;
        let best_len = 1;
        let i = 0;
        while i < 8 {
            let j = i;
            while j < 8 && self.segments[j] == 0u16 { j += 1; }
            if j - i > best_len {
                best = i;
                best_len = j - i;
            }
            i = if j > i { j } else { i + 1 };
        }
        let out = "";
        let k = 0;
        while k < 8 {
            if k == best {
                out += "::";
                k += best_len;
                continue;
            }
            if out.len() > 0 && !out.ends_with(":") { out += ":"; }
            out += hex(self.segments[k] as u64);
            k += 1;
        }
        out
    }
}

impl Debug for Ipv6Addr {
    fn debug(self) -> str { self.display() }
}

/// Lowercase hex digits of `n`.
fn hex(n: u64) -> str {
    if n == 0u64 { return "0"; }
    let digits = "0123456789abcdef";
    let out = "";
    while n > 0u64 {
        let d = (n % 16u64) as usize;
        out = digits[d:d + 1] + out;
        n /= 16u64;
    }
    out
}

pub struct SocketAddrV4 {
    pub ip: Ipv4Addr;
    pub port: u16;
}

pub struct SocketAddrV6 {
    pub ip: Ipv6Addr;
    pub port: u16;
    pub flow_info: u32;
    pub scope_id: u32;
}

pub enum SocketAddr {
    V4(SocketAddrV4),
    V6(SocketAddrV6),
}

impl SocketAddr {
    pub fn v4(ip: Ipv4Addr, port: u16) -> SocketAddr {
        SocketAddr::V4(SocketAddrV4 { ip: ip, port: port })
    }

    pub fn v6(ip: Ipv6Addr, port: u16) -> SocketAddr {
        SocketAddr::V6(SocketAddrV6 { ip: ip, port: port, flow_info: 0u32, scope_id: 0u32 })
    }

    pub fn port(self) -> u16 {
        match self {
            SocketAddr::V4(a) => a.port,
            SocketAddr::V6(a) => a.port,
        }
    }

    pub fn with_port(self, port: u16) -> SocketAddr {
        match self {
            SocketAddr::V4(a) => SocketAddr::v4(a.ip, port),
            SocketAddr::V6(a) => SocketAddr::V6(SocketAddrV6 { ip: a.ip, port: port, flow_info: a.flow_info, scope_id: a.scope_id }),
        }
    }

    pub fn is_ipv4(self) -> bool {
        match self {
            SocketAddr::V4(a) => true,
            SocketAddr::V6(a) => false,
        }
    }

    pub fn is_ipv6(self) -> bool { !self.is_ipv4() }

    fn family(self) -> i32 { if self.is_ipv4() { 4 } else { 6 } }
}

impl PartialEq for SocketAddr {
    fn eq(self, rhs: SocketAddr) -> bool { self.display() == rhs.display() }
    fn ne(self, rhs: SocketAddr) -> bool { !self.eq(rhs) }
}

impl Display for SocketAddr {
    fn display(self) -> str {
        match self {
            SocketAddr::V4(a) => f"{a.ip.display()}:{a.port}",
            SocketAddr::V6(a) => f"[{a.ip.display()}]:{a.port}",
        }
    }
}

impl Debug for SocketAddr {
    fn debug(self) -> str { self.display() }
}

// ---- parsing ----

fn bad_addr(s: str) -> ParseError {
    ParseError { input: s, pos: 0, reason: "invalid IP address syntax" }
}

/// Digits of `s` in `radix` (at most `max_len` of them) as a number.
fn number(s: str, radix: u64, max_len: usize) -> u64 | none {
    if s.len() == 0 || s.len() > max_len { return none; }
    let n = 0u64;
    for c in s.chars() {
        let d = (try c.to_digit(radix as u32) catch _ { return none; }) as u64;
        n = n * radix + d;
    }
    n
}

fn parse_v4(s: str) -> Ipv4Addr | none {
    let parts: List<u8> = List::new();
    for p in s.split(".") {
        let n = number(p, 10u64, 3)?;
        if n > 255u64 { return none; }
        parts.push(n as u8);
    }
    if parts.len() != 4 { return none; }
    Ipv4Addr::new(parts[0], parts[1], parts[2], parts[3])
}

/// Hex groups of one side of `::` (empty side: no groups).
fn groups(s: str) -> List<u16> | none {
    let out: List<u16> = List::new();
    if s.len() == 0 { return out; }
    for p in s.split(":") {
        out.push(number(p, 16u64, 4)? as u16);
    }
    out
}

fn parse_v6(s: str) -> Ipv6Addr | none {
    let seg: List<u16> = List::new();
    if let at: usize = s.find("::") {
        let h = groups(s[:at])?;
        let t = groups(s[at + 2:])?;
        if h.len() + t.len() > 7 { return none; }
        for g in h { seg.push(g); }
        for _ in h.len() + t.len()..8 { seg.push(0u16); }
        for g in t { seg.push(g); }
    } else {
        seg = groups(s)?;
    }
    if seg.len() != 8 { return none; }
    Ipv6Addr::new(seg[0], seg[1], seg[2], seg[3], seg[4], seg[5], seg[6], seg[7])
}

impl FromStr for Ipv4Addr {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> Ipv4Addr {
        if let a: Ipv4Addr = parse_v4(s) { return a; }
        throw bad_addr(s);
    }
}

impl FromStr for Ipv6Addr {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> Ipv6Addr {
        if let a: Ipv6Addr = parse_v6(s) { return a; }
        throw bad_addr(s);
    }
}

/// A port number (`0..=65535`).
fn port_of(s: str) -> u16 | none {
    let p = number(s, 10u64, 5)?;
    if p > 65535u64 { return none; }
    p as u16
}

fn parse_socket_addr(s: str) -> SocketAddr | none {
    if s.starts_with("[") {
        let at = s.find("]:")?;
        return SocketAddr::v6(parse_v6(s[1:at])?, port_of(s[at + 2:])?);
    }
    let at = s.rfind(":")?;
    SocketAddr::v4(parse_v4(s[:at])?, port_of(s[at + 1:])?)
}

/// `"127.0.0.1:8080"` / `"[::1]:8080"`.
impl FromStr for SocketAddr {
    type Err = ParseError;
    fn from_str(s: str) throws (ParseError) -> SocketAddr {
        if let a: SocketAddr = parse_socket_addr(s) { return a; }
        throw ParseError { input: s, pos: 0, reason: "invalid socket address syntax" };
    }
}

// ---- runtime marshalling: `[family, port, flow, scope, bytes..16]` ----

const ADDR_WORDS: usize = 20;

fn words_of(a: SocketAddr) -> GcBuf<i64> {
    let w: GcBuf<i64> = buf_new(ADDR_WORDS);
    match a {
        SocketAddr::V4(v) => {
            w[0] = 4i64;
            w[1] = v.port as i64;
            for i in 0..4usize { w[4 + i] = v.ip.octets[i] as i64; }
        }
        SocketAddr::V6(v) => {
            w[0] = 6i64;
            w[1] = v.port as i64;
            w[2] = v.flow_info as i64;
            w[3] = v.scope_id as i64;
            for i in 0..8usize {
                let g = v.ip.segments[i] as i64;
                w[4 + 2 * i] = g / 256i64;
                w[5 + 2 * i] = g % 256i64;
            }
        }
    }
    w
}

fn addr_at(w: GcBuf<i64>, at: usize) -> SocketAddr {
    let b = |i: usize| -> i64 { w[at + 4 + i] };
    let port = w[at + 1] as u16;
    if w[at] == 6i64 {
        let s: List<u16> = List::new();
        for i in 0..8usize { s.push((b(2 * i) * 256i64 + b(2 * i + 1)) as u16); }
        let ip = Ipv6Addr::new(s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7]);
        return SocketAddr::V6(SocketAddrV6 {
            ip: ip,
            port: port,
            flow_info: w[at + 2] as u32,
            scope_id: w[at + 3] as u32,
        });
    }
    SocketAddr::v4(Ipv4Addr::new(b(0) as u8, b(1) as u8, b(2) as u8, b(3) as u8), port)
}

// ---- DNS (302.4) ----

const MAX_ADDRS: usize = 32;

fn resolve_raw(host: str, port: u16) throws (IoError) -> List<SocketAddr> {
    let out: GcBuf<i64> = buf_new(ADDR_WORDS * MAX_ADDRS);
    let n = try check(unsafe { rok_net_resolve(host, port, out, MAX_ADDRS) } as i64, host);
    if n == 0 { throw IoError::with_kind(IoErrorKind::NotFound, host + ": no addresses"); }
    let addrs: List<SocketAddr> = List::new();
    for i in 0..n as usize { addrs.push(addr_at(out, i * ADDR_WORDS)); }
    addrs
}

/// Addresses of `host`: `"name:port"`, `"[v6]:port"`, a socket address,
/// or a bare name / IP (port 0).
pub fn resolve(host: str) throws (IoError) -> List<SocketAddr> {
    if let a: SocketAddr = parse_socket_addr(host) { return [a]; }
    let name = host;
    let port = 0u16;
    if let at: usize = host.rfind(":") {
        let rest = host[:at];
        if !rest.contains(":") {
            if let p: u16 = port_of(host[at + 1:]) {
                name = rest;
                port = p;
            }
        }
    }
    if name.starts_with("[") && name.ends_with("]") {
        name = name[1:name.len() - 1];
    }
    try resolve_raw(name, port)
}

/// The first address of `host` with `port`.
pub fn resolve_one(host: str, port: u16) throws (IoError) -> SocketAddr {
    (try resolve_raw(host, port))[0]
}

fn addrs_of(addr: str | SocketAddr) throws (IoError) -> List<SocketAddr> {
    match addr {
        a: SocketAddr => [a],
        s: str => try resolve(s),
    }
}

// ---- the socket core ----

/// An fd shared by copies of a handle, plus `[nonblocking, read
/// timeout ns, write timeout ns]` (timeouts -1: none).
struct Sock {
    fd: GcBuf<i32>;
    opts: GcBuf<i64>;
}

fn sock_of(fd: i32) -> Sock {
    let cell: GcBuf<i32> = buf_new(1);
    cell[0] = fd;
    let opts: GcBuf<i64> = buf_new(3);
    opts[1] = -1i64;
    opts[2] = -1i64;
    Sock { fd: cell, opts: opts }
}

fn new_sock(family: i32, kind: i32) throws (IoError) -> Sock {
    let fd = try check(unsafe { rok_net_socket(family, kind) } as i64, "socket");
    sock_of(fd as i32)
}

fn timed_out(what: str) -> IoError {
    IoError::with_kind(IoErrorKind::TimedOut, what + ": timed out")
}

/// The chunk `read_to_end` grows its list by.
const CHUNK: usize = 16384;

impl Sock {
    fn live(self) throws (IoError) -> i32 {
        let fd = self.fd[0];
        if fd < 0 { throw IoError::with_kind(IoErrorKind::InvalidInput, "socket is closed"); }
        fd
    }

    fn close(self) {
        let fd = self.fd[0];
        if fd >= 0 {
            self.fd[0] = -1;
            unsafe { rok_os_close(fd) };
        }
    }

    /// After a `WouldBlock`: throw it (non-blocking mode) or wait for
    /// readiness within the timeout.
    fn block(self, write: i32, what: str) throws (IoError) {
        if self.opts[0] != 0i64 {
            throw IoError::with_kind(IoErrorKind::WouldBlock, what + ": operation would block");
        }
        let r = unsafe { rok_net_wait(try self.live(), write, self.opts[1 + write as usize]) };
        if r == 0 { throw timed_out(what); }
        try check(r as i64, what);
    }

    fn set_timeout(self, write: usize, dur: Duration | none) {
        self.opts[1 + write] = match dur {
            d: Duration => d.as_ns(),
            none => -1i64,
        };
    }

    fn timeout(self, write: usize) -> Duration | none {
        let ns = self.opts[1 + write];
        if ns < 0i64 { return none; }
        Duration::ns(ns)
    }

    fn addr(self, peer: i32) throws (IoError) -> SocketAddr {
        let out: GcBuf<i64> = buf_new(ADDR_WORDS);
        try check(unsafe { rok_net_addr(try self.live(), out, peer) } as i64, "getsockname");
        addr_at(out, 0)
    }

    fn setopt(self, opt: i32, val: i64) throws (IoError) {
        try check(unsafe { rok_net_setopt(try self.live(), opt, val) } as i64, "setsockopt");
    }

    fn try_clone(self) throws (IoError) -> Sock {
        let fd = try check(unsafe { rok_os_dup(try self.live()) } as i64, "dup");
        let s = sock_of(fd as i32);
        for i in 0..3usize { s.opts[i] = self.opts[i]; }
        s
    }

    /// One read into `buf[at..at + n]`: the count, or `none` on `WouldBlock`.
    fn read_once(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize | none {
        let r = unsafe { rok_os_read(try self.live(), buf, at, n) } as i64;
        if would_block(r) { return none; }
        (try check(r, "read")) as usize
    }

    /// One write of `buf[at..at + n]`: the count, or `none` on `WouldBlock`.
    fn write_once(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize | none {
        let r = unsafe { rok_net_send(try self.live(), buf, at, n) } as i64;
        if would_block(r) { return none; }
        (try check(r, "write")) as usize
    }

    fn read_into(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize {
        loop {
            if let k: usize = try self.read_once(buf, at, n) { return k; }
            try self.block(0, "read");
        }
    }

    async fn read_into_async(self, buf: GcBuf<u8>, at: usize, n: usize) throws (IoError) -> usize {
        loop {
            if let k: usize = try self.read_once(buf, at, n) { return k; }
            await task::readable(try self.live());
        }
    }

    fn read(self, buf: List<u8>) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        try self.read_into(b, at, n)
    }

    async fn read_async(self, buf: List<u8>) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        try await self.read_into_async(b, at, n)
    }

    fn read_to_end(self) throws (IoError) -> List<u8> {
        let out: List<u8> = List::new();
        loop {
            let m = out.len();
            out.reserve(CHUNK);
            unsafe { out.set_len(m + CHUNK) };
            let (b, at, _) = region(out);
            let k = try self.read_into(b, at + m, CHUNK) catch e { unsafe { out.set_len(m) }; throw e; };
            unsafe { out.set_len(m + k) };
            if k == 0 { return out; }
        }
    }

    async fn read_to_end_async(self) throws (IoError) -> List<u8> {
        let out: List<u8> = List::new();
        loop {
            let m = out.len();
            out.reserve(CHUNK);
            unsafe { out.set_len(m + CHUNK) };
            let (b, at, _) = region(out);
            let k = try await self.read_into_async(b, at + m, CHUNK) catch e { unsafe { out.set_len(m) }; throw e; };
            unsafe { out.set_len(m + k) };
            if k == 0 { return out; }
        }
    }

    fn write(self, data: Slice<u8>) throws (IoError) -> usize {
        let (b, at, n) = unsafe { data.raw_parts() };
        loop {
            if let k: usize = try self.write_once(b, at, n) { return k; }
            try self.block(1, "write");
        }
    }

    async fn write_async(self, data: Slice<u8>) throws (IoError) -> usize {
        let (b, at, n) = unsafe { data.raw_parts() };
        loop {
            if let k: usize = try self.write_once(b, at, n) { return k; }
            await task::writable(try self.live());
        }
    }

    fn write_all(self, data: Slice<u8>) throws (IoError) {
        let (b, at, n) = unsafe { data.raw_parts() };
        let done = 0usize;
        while done < n {
            match try self.write_once(b, at + done, n - done) {
                k: usize => {
                    if k == 0 { throw IoError::new("failed to write whole buffer"); }
                    done += k;
                }
                none => try self.block(1, "write"),
            }
        }
    }

    async fn write_all_async(self, data: Slice<u8>) throws (IoError) {
        let (b, at, n) = unsafe { data.raw_parts() };
        let done = 0usize;
        while done < n {
            match try self.write_once(b, at + done, n - done) {
                k: usize => {
                    if k == 0 { throw IoError::new("failed to write whole buffer"); }
                    done += k;
                }
                none => await task::writable(try self.live()),
            }
        }
    }
}

// ---- TCP (302.1) ----

pub enum Shutdown {
    Read,
    Write,
    Both,
}

/// A TCP connection. Copies share the socket; `close()` (or leaving a
/// `using` block) closes it for all.
pub struct TcpStream {
    sock: Sock;
}

/// A listening TCP socket.
pub struct TcpListener {
    sock: Sock;
}

/// Start connecting `addr`: the socket and whether it is still pending.
fn connect_start(addr: SocketAddr) throws (IoError) -> (Sock, bool) {
    let s = try new_sock(addr.family(), 1);
    let r = unsafe { rok_net_connect(try s.live(), words_of(addr)) };
    if r < 0 {
        s.close();
        throw IoError::from_os(-r, f"connect {addr.display()}");
    }
    (s, r == 1)
}

fn connect_finish(s: Sock, addr: SocketAddr) throws (IoError) -> TcpStream {
    let e = unsafe { rok_net_sock_error(try s.live()) };
    if e < 0 {
        s.close();
        throw IoError::from_os(-e, f"connect {addr.display()}");
    }
    TcpStream { sock: s }
}

fn connect_wait(addr: SocketAddr, limit: i64) throws (IoError) -> TcpStream {
    let (s, pending) = try connect_start(addr);
    if pending {
        let r = unsafe { rok_net_wait(try s.live(), 1, limit) };
        if r <= 0 {
            s.close();
            if r == 0 { throw timed_out(f"connect {addr.display()}"); }
            throw IoError::from_os(-r, f"connect {addr.display()}");
        }
    }
    try connect_finish(s, addr)
}

impl TcpStream {
    /// Connect, blocking until the handshake is done.
    pub fn connect(addr: SocketAddr) throws (IoError) -> TcpStream {
        try connect_wait(addr, -1i64)
    }

    pub fn connect_timeout(addr: SocketAddr, dur: Duration) throws (IoError) -> TcpStream {
        try connect_wait(addr, dur.as_ns())
    }

    /// `connect` that suspends the task during the handshake.
    pub async fn connect_async(addr: SocketAddr) throws (IoError) -> TcpStream {
        let (s, pending) = try connect_start(addr);
        if pending {
            await task::writable(try s.live());
            // A spurious wake: wait until the connect resolved.
            while unsafe { rok_net_wait(try s.live(), 1, 0i64) } == 0 {
                await task::writable(try s.live());
            }
        }
        try connect_finish(s, addr)
    }

    /// The OS socket descriptor (`-1` once closed).
    pub fn fd(self) -> i32 { self.sock.fd[0] }

    /// Read up to `buf.len()` bytes into `buf[0..n]`; 0 at end of stream.
    pub fn read(self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }

    /// `read` that suspends the task until data arrives.
    pub async fn read_async(self, buf: List<u8>) throws (IoError) -> usize {
        try await self.sock.read_async(buf)
    }

    /// Everything until the peer closes its side.
    pub fn read_to_end(self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }

    pub async fn read_to_end_async(self) throws (IoError) -> List<u8> {
        try await self.sock.read_to_end_async()
    }

    /// Write some prefix of `buf`; its length.
    pub fn write<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try self.sock.write(buf.byte_slice())
    }

    pub async fn write_async<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }

    pub fn write_all<B: AsBytes>(self, buf: B) throws (IoError) {
        try self.sock.write_all(buf.byte_slice());
    }

    pub async fn write_all_async<B: AsBytes>(self, buf: B) throws (IoError) {
        try await self.sock.write_all_async(buf.byte_slice());
    }

    pub fn write_str(self, s: str) throws (IoError) { try self.sock.write_all(s.as_bytes()); }

    pub async fn write_str_async(self, s: str) throws (IoError) {
        try await self.sock.write_all_async(s.as_bytes());
    }

    /// Nothing to flush: writes go straight to the socket.
    pub fn flush(self) throws (IoError) {}

    pub fn peer_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(1) }
    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }

    pub fn shutdown(self, how: Shutdown) throws (IoError) {
        let h = match how {
            Shutdown::Read => 0,
            Shutdown::Write => 1,
            Shutdown::Both => 2,
        };
        try check(unsafe { rok_net_shutdown(try self.sock.live(), h) } as i64, "shutdown");
    }

    pub fn set_nodelay(self, nodelay: bool) throws (IoError) {
        try self.sock.setopt(1, if nodelay { 1i64 } else { 0i64 });
    }

    /// Keepalive probes after `alive` idle (whole seconds); `none` = off.
    pub fn set_keepalive(self, alive: Duration | none) throws (IoError) {
        match alive {
            d: Duration => try self.sock.setopt(2, d.as_secs()),
            none => try self.sock.setopt(2, -1i64),
        }
    }

    pub fn set_read_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(0, dur); }
    pub fn set_write_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(1, dur); }
    pub fn read_timeout(self) -> Duration | none { self.sock.timeout(0) }
    pub fn write_timeout(self) -> Duration | none { self.sock.timeout(1) }

    /// Make the blocking calls throw `WouldBlock` instead of waiting.
    pub fn set_nonblocking(self, nb: bool) throws (IoError) {
        self.sock.opts[0] = if nb { 1i64 } else { 0i64 };
    }

    pub fn try_clone(self) throws (IoError) -> TcpStream {
        TcpStream { sock: try self.sock.try_clone() }
    }

    /// Close now; later calls fail with `InvalidInput`.
    pub fn close(self) { self.sock.close(); }
}

impl Reader for TcpStream {
    fn read(ref self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }
    fn read_to_end(ref self) throws (IoError) -> List<u8> { try self.sock.read_to_end() }
}

impl Writer for TcpStream {
    fn write(ref self, buf: List<u8>) throws (IoError) -> usize { try self.sock.write(buf.byte_slice()) }
    fn write_all(ref self, buf: List<u8>) throws (IoError) { try self.sock.write_all(buf.byte_slice()); }
    fn write_str(ref self, s: str) throws (IoError) { try self.sock.write_all(s.as_bytes()); }
    fn flush(ref self) throws (IoError) {}
}

impl Drop for TcpStream {
    fn drop(ref self) { self.sock.close(); }
}

impl TcpListener {
    /// Bind and listen (`SO_REUSEADDR`, backlog 128). Port 0 picks one:
    /// see `local_addr`.
    pub fn bind(addr: SocketAddr) throws (IoError) -> TcpListener {
        let s = try new_sock(addr.family(), 1);
        let r = unsafe { rok_net_bind(try s.live(), words_of(addr)) };
        if r >= 0 { r = unsafe { rok_net_listen(try s.live(), 128) }; }
        if r < 0 {
            s.close();
            throw IoError::from_os(-r, f"bind {addr.display()}");
        }
        TcpListener { sock: s }
    }

    fn accept_once(self) throws (IoError) -> (TcpStream, SocketAddr) | none {
        let out: GcBuf<i64> = buf_new(ADDR_WORDS);
        let fd = unsafe { rok_net_accept(try self.sock.live(), out) } as i64;
        if would_block(fd) { return none; }
        try check(fd, "accept");
        (TcpStream { sock: sock_of(fd as i32) }, addr_at(out, 0))
    }

    /// The next connection and its peer, blocking until one arrives.
    pub fn accept(self) throws (IoError) -> (TcpStream, SocketAddr) {
        loop {
            if let c: (TcpStream, SocketAddr) = try self.accept_once() { return c; }
            try self.sock.block(0, "accept");
        }
    }

    /// `accept` that suspends the task until a connection arrives.
    pub async fn accept_async(self) throws (IoError) -> (TcpStream, SocketAddr) {
        loop {
            if let c: (TcpStream, SocketAddr) = try self.accept_once() { return c; }
            await task::readable(try self.sock.live());
        }
    }

    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }

    pub fn try_clone(self) throws (IoError) -> TcpListener {
        TcpListener { sock: try self.sock.try_clone() }
    }

    pub fn set_nonblocking(self, nb: bool) throws (IoError) {
        self.sock.opts[0] = if nb { 1i64 } else { 0i64 };
    }

    /// `for c in l.incoming() { let s = try c.get(); .. }`: connections
    /// forever (each item is the stream or the error `accept` threw).
    pub fn incoming(self) -> Incoming { Incoming { listener: self } }

    pub fn fd(self) -> i32 { self.sock.fd[0] }

    pub fn close(self) { self.sock.close(); }
}

impl Drop for TcpListener {
    fn drop(ref self) { self.sock.close(); }
}

/// `TcpListener::incoming`.
pub struct Incoming {
    listener: TcpListener;
}

impl Iterator for Incoming {
    type Item = Result<TcpStream, IoError>;
    fn next(ref self) -> Result<TcpStream, IoError> | none {
        let (s, _) = try self.listener.accept() catch e { return Result::Err(e); };
        Result::Ok(s)
    }
}

// ---- UDP (302.2) ----

/// A UDP socket. Copies share the socket.
pub struct UdpSocket {
    sock: Sock;
}

impl UdpSocket {
    pub fn bind(addr: SocketAddr) throws (IoError) -> UdpSocket {
        let s = try new_sock(addr.family(), 2);
        let r = unsafe { rok_net_bind(try s.live(), words_of(addr)) };
        if r < 0 {
            s.close();
            throw IoError::from_os(-r, f"bind {addr.display()}");
        }
        UdpSocket { sock: s }
    }

    /// One datagram from `buf[at..at + n]` to `addr`: the count, or
    /// `none` on `WouldBlock`.
    fn send_to_once(self, buf: GcBuf<u8>, at: usize, n: usize, addr: SocketAddr) throws (IoError) -> usize | none {
        let r = unsafe { rok_net_send_to(try self.sock.live(), buf, at, n, words_of(addr)) } as i64;
        if would_block(r) { return none; }
        (try check(r, f"send_to {addr.display()}")) as usize
    }

    /// One datagram into `buf`: its length and sender, or `none` on
    /// `WouldBlock`.
    fn recv_from_once(self, buf: List<u8>) throws (IoError) -> (usize, SocketAddr) | none {
        let out: GcBuf<i64> = buf_new(ADDR_WORDS);
        let (b, at, n) = region(buf);
        let r = unsafe { rok_net_recv_from(try self.sock.live(), b, at, n, out) } as i64;
        if would_block(r) { return none; }
        ((try check(r, "recv_from")) as usize, addr_at(out, 0))
    }

    /// Send the datagram `buf` to `addr`; bytes sent.
    pub fn send_to<B: AsBytes>(self, buf: B, addr: SocketAddr) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        loop {
            if let k: usize = try self.send_to_once(b, at, n, addr) { return k; }
            try self.sock.block(1, "send_to");
        }
    }

    pub async fn send_to_async<B: AsBytes>(self, buf: B, addr: SocketAddr) throws (IoError) -> usize {
        let (b, at, n) = region(buf);
        loop {
            if let k: usize = try self.send_to_once(b, at, n, addr) { return k; }
            await task::writable(try self.sock.live());
        }
    }

    /// The next datagram into `buf[0..n]` (truncated to `buf.len()`)
    /// and its sender.
    pub fn recv_from(self, buf: List<u8>) throws (IoError) -> (usize, SocketAddr) {
        loop {
            if let r: (usize, SocketAddr) = try self.recv_from_once(buf) { return r; }
            try self.sock.block(0, "recv_from");
        }
    }

    pub async fn recv_from_async(self, buf: List<u8>) throws (IoError) -> (usize, SocketAddr) {
        loop {
            if let r: (usize, SocketAddr) = try self.recv_from_once(buf) { return r; }
            await task::readable(try self.sock.live());
        }
    }

    /// Fix the peer: `send` / `recv` then talk to it only.
    pub fn connect(self, addr: SocketAddr) throws (IoError) {
        let r = unsafe { rok_net_connect(try self.sock.live(), words_of(addr)) };
        try check(r as i64, f"connect {addr.display()}");
    }

    pub fn send<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try self.sock.write(buf.byte_slice())
    }

    pub async fn send_async<B: AsBytes>(self, buf: B) throws (IoError) -> usize {
        try await self.sock.write_async(buf.byte_slice())
    }

    pub fn recv(self, buf: List<u8>) throws (IoError) -> usize { try self.sock.read(buf) }

    pub async fn recv_async(self, buf: List<u8>) throws (IoError) -> usize {
        try await self.sock.read_async(buf)
    }

    pub fn local_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(0) }
    pub fn peer_addr(self) throws (IoError) -> SocketAddr { try self.sock.addr(1) }

    pub fn set_broadcast(self, on: bool) throws (IoError) {
        try self.sock.setopt(3, if on { 1i64 } else { 0i64 });
    }

    pub fn join_multicast_v4(self, addr: Ipv4Addr, iface: Ipv4Addr) throws (IoError) {
        try check(unsafe { rok_net_multicast_v4(try self.sock.live(), addr.to_bits(), iface.to_bits(), 1) } as i64, "join_multicast_v4");
    }

    pub fn leave_multicast_v4(self, addr: Ipv4Addr, iface: Ipv4Addr) throws (IoError) {
        try check(unsafe { rok_net_multicast_v4(try self.sock.live(), addr.to_bits(), iface.to_bits(), 0) } as i64, "leave_multicast_v4");
    }

    pub fn set_multicast_loop_v4(self, on: bool) throws (IoError) {
        try self.sock.setopt(4, if on { 1i64 } else { 0i64 });
    }

    pub fn set_multicast_ttl_v4(self, ttl: u32) throws (IoError) {
        try self.sock.setopt(5, ttl as i64);
    }

    /// `UDP_SEGMENT` (GSO); `Unsupported` off Linux.
    pub fn set_segment_size(self, size: u16) throws (IoError) {
        try self.sock.setopt(6, size as i64);
    }

    pub fn set_read_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(0, dur); }
    pub fn set_write_timeout(self, dur: Duration | none) throws (IoError) { self.sock.set_timeout(1, dur); }

    pub fn set_nonblocking(self, nb: bool) throws (IoError) {
        self.sock.opts[0] = if nb { 1i64 } else { 0i64 };
    }

    pub fn try_clone(self) throws (IoError) -> UdpSocket {
        UdpSocket { sock: try self.sock.try_clone() }
    }

    pub fn fd(self) -> i32 { self.sock.fd[0] }

    pub fn close(self) { self.sock.close(); }
}

impl Drop for UdpSocket {
    fn drop(ref self) { self.sock.close(); }
}

// ---- conveniences (302.6) ----

/// Connect to the first address of `addr` that accepts (names are
/// resolved).
pub fn tcp_connect(addr: str | SocketAddr) throws (IoError) -> TcpStream {
    let addrs = try addrs_of(addr);
    let last = IoError::new("no address to connect to");
    for a in addrs {
        let s = try TcpStream::connect(a) catch e {
            last = e;
            continue;
        };
        return s;
    }
    throw last;
}

/// `tcp_connect` that suspends the task while connecting.
pub async fn tcp_connect_async(addr: str | SocketAddr) throws (IoError) -> TcpStream {
    let addrs = try addrs_of(addr);
    let last = IoError::new("no address to connect to");
    for a in addrs {
        let s = try await TcpStream::connect_async(a) catch e {
            last = e;
            continue;
        };
        return s;
    }
    throw last;
}

pub fn tcp_listen(addr: str | SocketAddr) throws (IoError) -> TcpListener {
    try TcpListener::bind((try addrs_of(addr))[0])
}

pub fn udp_bind(addr: str | SocketAddr) throws (IoError) -> UdpSocket {
    try UdpSocket::bind((try addrs_of(addr))[0])
}
