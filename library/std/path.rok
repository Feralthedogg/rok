// rok::std::path (stdlib spec 308): `Path`, a UTF-8 path value with
// Python-style `/` joining. Unix separators only (`/`).
//
// `Path` is immutable: `/` returns a new one, `p /= q` is `p = p / q`.
// `RawPath` holds OS bytes (Unix only; the fs layer never produces one —
// it reports non-UTF-8 names as `InvalidData`). No Windows prefixes.

use rok::std::fs;
use rok::std::fs::Metadata;
use rok::std::io::IoError;

extern "C" {
    fn rok_os_realpath(path: str, err: GcBuf<i32>) -> str;
    fn rok_str_utf8_error(s: str) -> isize;
    fn rok_str_byte(s: str, i: usize) -> u8;
}

pub struct Path {
    s: str;
}

/// One piece of a path (`Path::components`).
pub enum Component {
    RootDir,
    Prefix(str),
    CurDir,
    ParentDir,
    Normal(str),
}

impl Component {
    pub fn as_str(self) -> str {
        match self {
            Component::RootDir => "/",
            Component::Prefix(p) => p,
            Component::CurDir => ".",
            Component::ParentDir => "..",
            Component::Normal(n) => n,
        }
    }
}

impl PartialEq for Component {
    fn eq(self, rhs: Component) -> bool { self.as_str() == rhs.as_str() }
    fn ne(self, rhs: Component) -> bool { self.as_str() != rhs.as_str() }
}

impl Debug for Component {
    fn debug(self) -> str {
        match self {
            Component::RootDir => "RootDir",
            Component::Prefix(p) => f"Prefix({p})",
            Component::CurDir => "CurDir",
            Component::ParentDir => "ParentDir",
            Component::Normal(n) => f"Normal({n})",
        }
    }
}

/// `p.strip_prefix(base)` where `base` is not a prefix of `p`.
pub struct StripPrefixError {}

impl Display for StripPrefixError {
    fn display(self) -> str { "prefix not found" }
}
impl Debug for StripPrefixError {
    fn debug(self) -> str { "StripPrefixError" }
}
impl Error for StripPrefixError {}

/// What the fs functions take: a `Path` or a `str` spelling one.
pub trait AsPath {
    fn as_path(self) -> Path;
}

impl AsPath for Path {
    fn as_path(self) -> Path { self }
}

impl AsPath for str {
    fn as_path(self) -> Path { Path { s: self } }
}

/// `s` without trailing `/`s (but `/` stays `/`).
fn trim_slashes(s: str) -> str {
    let n = s.len();
    while n > 1 && s[n - 1:n] == "/" { n -= 1; }
    s[:n]
}

impl Path {
    pub fn new() -> Path { Path { s: "" } }
    pub fn from(s: str) -> Path { Path { s: s } }

    pub fn from_components<I: Iterator<Item = str>>(components: I) -> Path {
        let p = Path::new();
        for c in components { p = p.join(Path::from(c)); }
        p
    }

    pub fn as_str(self) -> str { self.s }
    pub fn to_raw(self) -> RawPath { RawPath { raw: self.s } }
    /// `raw` as a path; throws if it is not UTF-8 (3.8.4).
    pub fn try_from(raw: RawPath) throws (NonUtf8Error) -> Path { try raw.try_to_path() }

    pub fn is_absolute(self) -> bool { self.s.starts_with("/") }
    pub fn is_relative(self) -> bool { !self.is_absolute() }
    pub fn has_root(self) -> bool { self.is_absolute() }

    /// The path without its last component; `none` for `/` and `""`.
    /// `Path::from("a").parent()` is `""` (as in Rust).
    pub fn parent(self) -> Path | none {
        let comps = self.component_list();
        let n = comps.len();
        if n == 0 { return none; }
        let last = comps[n - 1];
        if last is Component::RootDir { return none; }
        let out = Path::new();
        for i in 0..n - 1 {
            out = out.join(Path::from(comps[i].as_str()));
        }
        out
    }

    /// The last component unless it is `..` / `/`.
    pub fn file_name(self) -> str | none {
        let comps = self.component_list();
        let n = comps.len();
        if n == 0 { return none; }
        match comps[n - 1] {
            Component::Normal(name) => name,
            _ => none,
        }
    }

    /// `file_name` without its extension.
    pub fn file_stem(self) -> str | none {
        let name = self.file_name()?;
        let dot = name.rfind(".") ?? 0usize;
        if dot == 0 { return name; }
        name[:dot]
    }

    /// After the last `.` of `file_name` (`none` for `.bashrc`, `a`).
    pub fn extension(self) -> str | none {
        let name = self.file_name()?;
        let dot = name.rfind(".") ?? 0usize;
        if dot == 0 { return none; }
        name[dot + 1:]
    }

    pub fn components(self) -> Components {
        Components { items: self.component_list(), pos: 0 }
    }

    /// `self`, its parent, its grandparent, ...
    pub fn ancestors(self) -> Ancestors {
        Ancestors { next: self }
    }

    fn component_list(self) -> List<Component> {
        let out: List<Component> = List::new();
        if self.s.starts_with("/") { out.push(Component::RootDir); }
        let first = true;
        for part in self.s.split("/") {
            if part == "" {
                // separator run or the root
            } else if part == "." {
                if first && !self.s.starts_with("/") { out.push(Component::CurDir); }
            } else if part == ".." {
                out.push(Component::ParentDir);
            } else {
                out.push(Component::Normal(part));
            }
            first = false;
        }
        out
    }

    /// `other` appended; an absolute `other` replaces `self`.
    pub fn join(self, other: Path) -> Path {
        if other.is_absolute() || self.s == "" { return other; }
        if other.s == "" { return self; }
        if self.s.ends_with("/") { return Path { s: self.s + other.s }; }
        Path { s: self.s + "/" + other.s }
    }

    pub fn with_file_name(self, name: str) -> Path {
        let parent = self.parent() ?? Path::new();
        parent.join(Path::from(name))
    }

    pub fn with_extension(self, ext: str) -> Path {
        let stem = self.file_stem() ?? "";
        if ext == "" { return self.with_file_name(stem); }
        self.with_file_name(stem + "." + ext)
    }

    /// Component-wise prefix test.
    pub fn starts_with(self, base: Path) -> bool {
        let a = self.component_list();
        let b = base.component_list();
        if b.len() > a.len() { return false; }
        for i in 0..b.len() {
            if a[i] != b[i] { return false; }
        }
        true
    }

    /// Component-wise suffix test.
    pub fn ends_with(self, suffix: Path) -> bool {
        let a = self.component_list();
        let b = suffix.component_list();
        if b.len() > a.len() { return false; }
        let off = a.len() - b.len();
        for i in 0..b.len() {
            if a[off + i] != b[i] { return false; }
        }
        true
    }

    pub fn strip_prefix(self, base: Path) throws (StripPrefixError) -> Path {
        if !self.starts_with(base) { throw StripPrefixError {}; }
        let a = self.component_list();
        let out = Path::new();
        for i in base.component_list().len()..a.len() {
            out = out.join(Path::from(a[i].as_str()));
        }
        out
    }

    /// Lexical `.` / `..` resolution (no filesystem access).
    pub fn normalize(self) -> Path {
        let kept: List<Component> = List::new();
        for c in self.component_list() {
            match c {
                Component::CurDir => {}
                Component::ParentDir => {
                    let n = kept.len();
                    if n > 0 && kept[n - 1] is Component::Normal {
                        kept.pop();
                    } else if !(n > 0 && kept[n - 1] is Component::RootDir) {
                        kept.push(c);
                    }
                }
                _ => kept.push(c),
            }
        }
        let out = Path::new();
        for c in kept { out = out.join(Path::from(c.as_str())); }
        if out.s == "" { return Path::from("."); }
        out
    }

    pub fn exists(self) -> bool { fs::exists(self) }

    pub fn is_file(self) -> bool {
        let m = try fs::metadata(self) catch _ { return false; };
        m.is_file()
    }

    pub fn is_dir(self) -> bool {
        let m = try fs::metadata(self) catch _ { return false; };
        m.is_dir()
    }

    pub fn is_symlink(self) -> bool {
        let m = try fs::symlink_metadata(self) catch _ { return false; };
        m.is_symlink()
    }

    pub fn metadata(self) throws (IoError) -> Metadata { try fs::metadata(self) }

    /// Absolute, symlinks resolved (`realpath`).
    pub fn canonicalize(self) throws (IoError) -> Path {
        let err: GcBuf<i32> = buf_new(1);
        let s = unsafe { rok_os_realpath(self.s, err) };
        if err[0] != 0 { throw IoError::from_os(err[0], self.s); }
        Path { s: s }
    }
}

impl Div<str> for Path {
    type Output = Path;
    fn div(self, rhs: str) -> Path { self.join(Path::from(rhs)) }
}

impl Div<Path> for Path {
    type Output = Path;
    fn div(self, rhs: Path) -> Path { self.join(rhs) }
}

/// OS path bytes that need not be UTF-8 (3.8.5). Unix bytes only (no
/// `from_wide` / `as_wide`).
pub struct RawPath {
    raw: str;
}

impl RawPath {
    pub fn from_bytes(bytes: List<u8>) -> RawPath {
        let b = StrBuf::new();
        for x in bytes { b.push_byte(x); }
        RawPath { raw: b.to_str() }
    }

    pub fn as_bytes(self) -> Slice<u8> { self.raw.as_bytes() }

    /// The path, if the bytes are UTF-8.
    pub fn try_to_path(self) throws (NonUtf8Error) -> Path {
        let at = unsafe { rok_str_utf8_error(self.raw) };
        if at >= 0 { throw NonUtf8Error { valid_up_to: at as usize }; }
        Path { s: self.raw }
    }

    /// The path with each invalid sequence (a bad byte and the
    /// continuation bytes after it) replaced by U+FFFD.
    pub fn to_path_lossy(self) -> Path {
        let out = StrBuf::new();
        let rest = self.raw;
        loop {
            let at = unsafe { rok_str_utf8_error(rest) };
            if at < 0 { break; }
            let i = at as usize;
            out.push_str(rest[:i]);
            out.push_str("\u{FFFD}");
            i += 1;
            while i < rest.len() && (unsafe { rok_str_byte(rest, i) } & 0xC0u8) == 0x80u8 { i += 1; }
            rest = rest[i:];
        }
        out.push_str(rest);
        Path { s: out.to_str() }
    }
}

impl PartialEq for RawPath {
    fn eq(self, rhs: RawPath) -> bool { self.raw == rhs.raw }
    fn ne(self, rhs: RawPath) -> bool { self.raw != rhs.raw }
}

impl Debug for RawPath {
    fn debug(self) -> str { f"RawPath({self.to_path_lossy().as_str().debug()})" }
}

/// `RawPath` bytes that are not UTF-8.
pub struct NonUtf8Error {
    /// Length of the valid UTF-8 prefix.
    pub valid_up_to: usize;
}

impl Display for NonUtf8Error {
    fn display(self) -> str { f"path is not UTF-8 (valid up to byte {self.valid_up_to})" }
}
impl Debug for NonUtf8Error {
    fn debug(self) -> str { f"NonUtf8Error {{ valid_up_to: {self.valid_up_to} }}" }
}
impl Error for NonUtf8Error {}

impl PartialEq for Path {
    fn eq(self, rhs: Path) -> bool { self.s == rhs.s }
    fn ne(self, rhs: Path) -> bool { self.s != rhs.s }
}

impl Display for Path {
    fn display(self) -> str { self.s }
}

impl Debug for Path {
    fn debug(self) -> str { self.s.debug() }
}

pub struct Components {
    items: List<Component>;
    pos: usize;
}

impl Iterator for Components {
    type Item = Component;
    fn next(ref self) -> Component | none {
        let c = self.items.get(self.pos)?;
        self.pos += 1;
        c
    }
}

pub struct Ancestors {
    next: Path | none;
}

impl Iterator for Ancestors {
    type Item = Path;
    fn next(ref self) -> Path | none {
        let p = self.next?;
        self.next = p.parent();
        p
    }
}
