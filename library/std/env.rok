// rok::std::env (stdlib spec 306): arguments, environment variables,
// directories, exit.
//
// `set_var` has no global lock: call it before spawning threads (306.3).
// Names and values from the OS are bytes; `var` / `vars` / `args` hand
// out the UTF-8 ones as `str`, the `*_os` forms raw.

use rok::std::io::{IoError, check, fetch, text_of, list_of, list_of_str};
use rok::std::path::{Path, AsPath};

/// Exit the process now with `code` (refs-lang 4.16.4); `finally` and
/// `Drop` do not run.
pub fn exit(code: i32) -> ! {
    unsafe { rok_exit(code) };
}

/// Command-line arguments; `[0]` is the program name.
pub fn args() -> List<str> {
    let n = unsafe { rok_os_argc() };
    let out: List<str> = List::with_capacity(n);
    for i in 0..n {
        out.push(unsafe { rok_os_arg(i) });
    }
    out
}

/// The arguments as raw OS bytes.
pub fn args_os() -> List<RawStr> {
    let n = unsafe { rok_os_argc() };
    let out: List<RawStr> = List::with_capacity(n);
    for i in 0..n {
        out.push(RawStr { raw: list_of_str(unsafe { rok_os_arg(i) }) });
    }
    out
}

/// Bytes from the OS that need not be UTF-8 (`args_os`, `var_os`).
pub struct RawStr {
    raw: List<u8>;
}

impl RawStr {
    /// Byte length.
    pub fn len(self) -> usize { self.raw.len() }
    pub fn is_empty(self) -> bool { self.raw.len() == 0 }

    /// The bytes as text; throws if they are not UTF-8.
    pub fn to_str(self) throws (Utf8Error) -> str { try str::from_utf8(self.raw) }

    /// A copy of the bytes.
    pub fn as_bytes(self) -> List<u8> { list_of(self.raw) }
}

impl PartialEq for RawStr {
    fn eq(self, rhs: RawStr) -> bool { self.raw == rhs.raw }
    fn ne(self, rhs: RawStr) -> bool { self.raw != rhs.raw }
}

impl Debug for RawStr {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        let shown = try f"RawStr({self.to_str():?})" catch _ { f"RawStr({self.len()} bytes)" };
        try f.write_str(shown)
    }
}

/// Why `var` found nothing.
pub enum VarError {
    NotPresent,
}

impl Display for VarError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("environment variable not found") }
}
impl Debug for VarError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str("NotPresent") }
}
impl Error for VarError {}

/// `name`'s value as bytes, or `none` when unset.
fn var_bytes(name: str) -> List<u8> | none {
    try fetch(|b: GcBuf<u8>, at: usize, n: usize| unsafe { rok_os_getenv(name, b, at, n) }, name)
        catch _ { return none; }
}

/// `name`'s value; `NotPresent` when unset or not UTF-8.
pub fn var(name: str) throws (VarError) -> str {
    if let v: str = var_opt(name) { return v; }
    throw VarError::NotPresent;
}

/// `name`'s value as raw bytes, or `none`.
pub fn var_os(name: str) -> RawStr | none {
    RawStr { raw: var_bytes(name)? }
}

/// `var(name)` or `none`.
fn var_opt(name: str) -> str | none {
    try text_of(var_bytes(name)?) catch _ { none }
}

pub fn set_var(name: str, value: str) { unsafe { rok_os_setenv(name, value, 0) }; }
pub fn remove_var(name: str) { unsafe { rok_os_setenv(name, "", 1) }; }

/// Every `(name, value)` pair, a snapshot taken lazily as it goes.
pub fn vars() -> Vars { Vars { pos: 0 } }

pub struct Vars {
    pos: usize;
}

impl Iterator for Vars {
    type Item = (str, str);
    fn next(ref self) -> (str, str) | none {
        loop {
            let kv = unsafe { rok_os_env_at(self.pos) };
            if kv.len() == 0 { return none; }
            self.pos += 1;
            let eq = kv.find("=") ?? 0usize;
            // Skip malformed entries (no `=`, or an empty name).
            if eq > 0 { return (kv[:eq], kv[eq + 1:]); }
        }
    }
}

/// `vars` as raw OS bytes (names and values need not be UTF-8).
pub fn vars_os() -> VarsOs { VarsOs { pos: 0 } }

pub struct VarsOs {
    pos: usize;
}

impl Iterator for VarsOs {
    type Item = (RawStr, RawStr);
    fn next(ref self) -> (RawStr, RawStr) | none {
        loop {
            let kv = unsafe { rok_os_env_at(self.pos) };
            if kv.len() == 0 { return none; }
            self.pos += 1;
            // `=` is ASCII, so the byte split is exact even in non-UTF-8.
            let eq = kv.find("=") ?? 0usize;
            if eq > 0 { return (RawStr { raw: list_of_str(kv[:eq]) }, RawStr { raw: list_of_str(kv[eq + 1:]) }); }
        }
    }
}

pub fn current_dir() throws (IoError) -> Path {
    let cwd = try fetch(|b: GcBuf<u8>, at: usize, n: usize| unsafe { rok_os_getcwd(b, at, n) }, "getcwd");
    Path::from(try text_of(cwd))
}

pub fn set_current_dir<P: AsPath>(path: P) throws (IoError) {
    let p = path.as_path().as_str();
    try check(unsafe { rok_os_chdir(p) } as i64, p);
}

pub fn home_dir() -> Path | none {
    let h = var_opt("HOME")?;
    if h == "" { return none; }
    Path::from(h)
}

/// `$TMPDIR`, else `/tmp`.
pub fn temp_dir() -> Path {
    let t = var_opt("TMPDIR") ?? "";
    if t == "" { return Path::from("/tmp"); }
    Path::from(t)
}

#[cfg(target_os = "macos")]
const MACOS: bool = true;
#[cfg(not(target_os = "macos"))]
const MACOS: bool = false;

/// macOS: `~/Library/<mac>`; elsewhere the XDG variable `xdg` when it
/// holds an absolute path, else `~/<home_rel>`. `none` without a home.
fn user_dir(mac: str, xdg: str, home_rel: str) -> Path | none {
    if !MACOS {
        let x = var_opt(xdg) ?? "";
        if x.starts_with("/") { return Path::from(x); }
    }
    let h = home_dir()?;
    if MACOS { return h / "Library" / mac; }
    h / home_rel
}

/// Per-user configuration: `~/Library/Application Support`, or
/// `$XDG_CONFIG_HOME` / `~/.config`.
pub fn config_dir() -> Path | none { user_dir("Application Support", "XDG_CONFIG_HOME", ".config") }
/// Per-user cache: `~/Library/Caches`, or `$XDG_CACHE_HOME` / `~/.cache`.
pub fn cache_dir() -> Path | none { user_dir("Caches", "XDG_CACHE_HOME", ".cache") }
/// Per-user data: `~/Library/Application Support`, or `$XDG_DATA_HOME` /
/// `~/.local/share`.
pub fn data_dir() -> Path | none { user_dir("Application Support", "XDG_DATA_HOME", ".local/share") }

/// `paths` split on `:` (empty pieces dropped).
pub fn split_paths(paths: str) -> List<Path> {
    let out: List<Path> = List::new();
    for p in paths.split(":") {
        if p != "" { out.push(Path::from(p)); }
    }
    out
}

/// `paths` joined with `:` (the `PATH` form); throws if one holds a `:`.
pub fn join_paths<I: Iterator<Item = Path>>(paths: I) throws (JoinPathsError) -> str {
    let out = StrBuf::new();
    let first = true;
    for p in paths {
        let s = p.as_str();
        if s.contains(":") { throw JoinPathsError { path: s }; }
        if !first { out.push_str(":"); }
        out.push_str(s);
        first = false;
    }
    out.to_str()
}

/// A `join_paths` entry that holds the separator.
pub struct JoinPathsError {
    pub path: str;
}

impl Display for JoinPathsError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"path {self.path:?} contains the separator `:`") }
}
impl Debug for JoinPathsError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"JoinPathsError({self.path:?})") }
}
impl Error for JoinPathsError {}

/// The running executable's absolute path.
pub fn current_exe() throws (IoError) -> Path {
    let exe = try fetch(|b: GcBuf<u8>, at: usize, n: usize| unsafe { rok_os_current_exe(b, at, n) }, "current_exe");
    Path::from(try text_of(exe))
}

pub fn pid() -> u32 { unsafe { rok_os_getpid() } }

pub fn parent_pid() -> u32 | none {
    let p = unsafe { rok_os_getppid() };
    if p == 0u32 { return none; }
    p
}
