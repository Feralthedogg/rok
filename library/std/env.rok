// rok::std::env (stdlib spec 306): arguments, environment variables,
// directories, exit.
//
// ponytail: no `args_os` / `var_os` / `vars_os` (`RawStr` does not
// exist; names and values are taken as UTF-8), no `config_dir` /
// `cache_dir` / `data_dir` / `join_paths` / `current_exe`; `set_var`
// has no global lock (call it before spawning threads, 306.3).

use rok::std::io::{IoError, check, err_cell, check_cell};
use rok::std::path::{Path, AsPath};

extern "C" {
    fn rok_exit(code: i32) -> !;
    fn rok_os_argc() -> usize;
    fn rok_os_arg(i: usize) -> str;
    fn rok_os_env_at(i: usize) -> str;
    fn rok_os_getenv(name: str, found: GcBuf<i32>) -> str;
    fn rok_os_setenv(name: str, value: str, unset: i32) -> i32;
    fn rok_os_getcwd(err: GcBuf<i32>) -> str;
    fn rok_os_chdir(path: str) -> i32;
    fn rok_os_getpid() -> u32;
    fn rok_os_getppid() -> u32;
}

/// Exit the process now with `code` (refs-lang 4.16.4); `finally` and
/// `Drop` do not run.
pub fn exit(code: i32) -> ! {
    unsafe { rok_exit(code) };
}

/// Command-line arguments; `[0]` is the program name.
pub fn args() -> List<str> {
    let n = unsafe { rok_os_argc() };
    let out: List<str> = List::with_capacity(n);
    for i in 0..n {
        out.push(unsafe { rok_os_arg(i) });
    }
    out
}

/// Why `var` found nothing.
pub enum VarError {
    NotPresent,
}

impl Display for VarError {
    fn display(self) -> str { "environment variable not found" }
}
impl Debug for VarError {
    fn debug(self) -> str { "NotPresent" }
}
impl Error for VarError {}

pub fn var(name: str) throws (VarError) -> str {
    let found: GcBuf<i32> = buf_new(1);
    let v = unsafe { rok_os_getenv(name, found) };
    if found[0] == 0 { throw VarError::NotPresent; }
    v
}

/// `var(name)` or `none`.
fn var_opt(name: str) -> str | none {
    let found: GcBuf<i32> = buf_new(1);
    let v = unsafe { rok_os_getenv(name, found) };
    if found[0] == 0 { return none; }
    v
}

pub fn set_var(name: str, value: str) { unsafe { rok_os_setenv(name, value, 0) }; }
pub fn remove_var(name: str) { unsafe { rok_os_setenv(name, "", 1) }; }

/// Every `(name, value)` pair, a snapshot taken lazily as it goes.
pub fn vars() -> Vars { Vars { pos: 0 } }

pub struct Vars {
    pos: usize;
}

impl Iterator for Vars {
    type Item = (str, str);
    fn next(ref self) -> (str, str) | none {
        loop {
            let kv = unsafe { rok_os_env_at(self.pos) };
            if kv.len() == 0 { return none; }
            self.pos += 1;
            let eq = kv.find("=") ?? 0usize;
            // Skip malformed entries (no `=`, or an empty name).
            if eq > 0 { return (kv.slice(0, eq), kv.slice(eq + 1, kv.len())); }
        }
    }
}

pub fn current_dir() throws (IoError) -> Path {
    let err = err_cell();
    let s = unsafe { rok_os_getcwd(err) };
    try check_cell(err, "getcwd");
    Path::from(s)
}

pub fn set_current_dir<P: AsPath>(path: P) throws (IoError) {
    let p = path.as_path().as_str();
    try check(unsafe { rok_os_chdir(p) } as i64, p);
}

pub fn home_dir() -> Path | none {
    let h = var_opt("HOME")?;
    if h == "" { return none; }
    Path::from(h)
}

/// `$TMPDIR`, else `/tmp`.
pub fn temp_dir() -> Path {
    let t = var_opt("TMPDIR") ?? "";
    if t == "" { return Path::from("/tmp"); }
    Path::from(t)
}

/// `paths` split on `:` (empty pieces dropped).
pub fn split_paths(paths: str) -> List<Path> {
    let out: List<Path> = List::new();
    for p in paths.split(":") {
        if p != "" { out.push(Path::from(p)); }
    }
    out
}

pub fn pid() -> u32 { unsafe { rok_os_getpid() } }

pub fn parent_pid() -> u32 | none {
    let p = unsafe { rok_os_getppid() };
    if p == 0u32 { return none; }
    p
}
