// The TLS 1.3 engine (RFC 8446): record layer, key schedule and the
// client and server handshakes over a blocking `TcpStream`.
//
// Supported: the three TLS 1.3 cipher suites, X25519 and the
// X25519MLKEM768 hybrid, HelloRetryRequest (both sides), ALPN, SNI,
// KeyUpdate, close_notify, server authentication with the signature
// schemes `x509` verifies (the server signs with Ed25519). Not
// supported: PSK / session resumption and 0-RTT (session tickets are
// ignored), client certificates (a CertificateRequest is answered with
// an empty Certificate), TLS 1.2 and below.

use sup::{TlsError, TlsErrorKind, Certificate, CipherSuite, PrivateKey};
use sup::x509;
use sup::x509::{CertInfo, PubKey, SigAlg};
use rok::std::net::TcpStream;
use rok::std::io::{IoError, IoErrorKind, byte_buf};
use rok::std::crypto::random;
use rok::std::time::SystemTime;
use rok::core::crypto::sha2::{HashAlgorithm, Digest};
use rok::core::crypto::hmac::{Hmac, Hkdf};
use rok::core::crypto::aead::{Aead, AeadAlgorithm};
use rok::core::crypto::x25519::X25519;
use rok::core::crypto::mlkem::MlKem768;
use rok::core::crypto::ed25519::Ed25519;
use rok::core::crypto::constant_time_eq;

// Content types.
const CHANGE_CIPHER_SPEC: u8 = 20u8;
const ALERT: u8 = 21u8;
const HANDSHAKE: u8 = 22u8;
const APPLICATION_DATA: u8 = 23u8;

// Handshake message types.
const CLIENT_HELLO: u8 = 1u8;
const SERVER_HELLO: u8 = 2u8;
const NEW_SESSION_TICKET: u8 = 4u8;
const ENCRYPTED_EXTENSIONS: u8 = 8u8;
const CERTIFICATE: u8 = 11u8;
const CERTIFICATE_REQUEST: u8 = 13u8;
const CERTIFICATE_VERIFY: u8 = 15u8;
const FINISHED: u8 = 20u8;
const KEY_UPDATE: u8 = 24u8;
const MESSAGE_HASH: u8 = 254u8;

// Extensions.
const EXT_SERVER_NAME: u16 = 0u16;
const EXT_SUPPORTED_GROUPS: u16 = 10u16;
const EXT_SIGNATURE_ALGORITHMS: u16 = 13u16;
const EXT_ALPN: u16 = 16u16;
const EXT_PRE_SHARED_KEY: u16 = 41u16;
const EXT_SUPPORTED_VERSIONS: u16 = 43u16;
const EXT_COOKIE: u16 = 44u16;
const EXT_KEY_SHARE: u16 = 51u16;

// Named groups.
const X25519_GROUP: u16 = 0x001du16;
const HYBRID_GROUP: u16 = 0x11ecu16;

// Signature schemes.
const ECDSA_P256_SHA256: u16 = 0x0403u16;
const ECDSA_P384_SHA384: u16 = 0x0503u16;
const RSA_PSS_SHA256: u16 = 0x0804u16;
const RSA_PSS_SHA384: u16 = 0x0805u16;
const RSA_PSS_SHA512: u16 = 0x0806u16;
const ED25519_SCHEME: u16 = 0x0807u16;
const RSA_PKCS1_SHA256: u16 = 0x0401u16;
const RSA_PKCS1_SHA384: u16 = 0x0501u16;
const RSA_PKCS1_SHA512: u16 = 0x0601u16;

// Alerts.
pub(pkg) const ALERT_CLOSE_NOTIFY: u8 = 0u8;
pub(pkg) const ALERT_UNEXPECTED_MESSAGE: u8 = 10u8;
pub(pkg) const ALERT_BAD_RECORD_MAC: u8 = 20u8;
pub(pkg) const ALERT_RECORD_OVERFLOW: u8 = 22u8;
pub(pkg) const ALERT_HANDSHAKE_FAILURE: u8 = 40u8;
pub(pkg) const ALERT_BAD_CERTIFICATE: u8 = 42u8;
pub(pkg) const ALERT_ILLEGAL_PARAMETER: u8 = 47u8;
pub(pkg) const ALERT_DECODE_ERROR: u8 = 50u8;
pub(pkg) const ALERT_DECRYPT_ERROR: u8 = 51u8;
pub(pkg) const ALERT_PROTOCOL_VERSION: u8 = 70u8;
pub(pkg) const ALERT_INTERNAL_ERROR: u8 = 80u8;
pub(pkg) const ALERT_MISSING_EXTENSION: u8 = 109u8;
pub(pkg) const ALERT_NO_APPLICATION_PROTOCOL: u8 = 120u8;

/// SHA-256("HelloRetryRequest"): a ServerHello random marking an HRR.
const HRR_RANDOM: [u8; 32] = [
    0xcfu8, 0x21u8, 0xadu8, 0x74u8, 0xe5u8, 0x9au8, 0x61u8, 0x11u8, 0xbeu8, 0x1du8, 0x8cu8, 0x02u8, 0x1eu8, 0x65u8, 0xb8u8, 0x91u8,
    0xc2u8, 0xa2u8, 0x11u8, 0x16u8, 0x7au8, 0xbbu8, 0x8cu8, 0x5eu8, 0x07u8, 0x9eu8, 0x09u8, 0xe2u8, 0xc8u8, 0xa8u8, 0x33u8, 0x9cu8,
];

const MAX_PLAINTEXT: usize = 16384;
/// Records written under one key before a KeyUpdate (AES-GCM's limit
/// is 2^24.5 full records).
const UPDATE_AFTER: u64 = 0x100_0000u64;

fn proto(msg: str, alert: u8) -> TlsError {
    TlsError { kind: TlsErrorKind::Protocol, msg, alert }
}

fn decode_err(what: str) -> TlsError { proto(f"malformed {what}", ALERT_DECODE_ERROR) }

// ---- byte building / reading ----

fn put_u16(out: List<u8>, v: usize) {
    out.push((v >> 8) as u8);
    out.push(v as u8);
}

fn put_u24(out: List<u8>, v: usize) {
    out.push((v >> 16) as u8);
    out.push((v >> 8) as u8);
    out.push(v as u8);
}

fn put(out: List<u8>, b: Slice<u8>) {
    for x in b { out.push(x); }
}

fn put_list(out: List<u8>, b: List<u8>) {
    for x in b { out.push(x); }
}

fn vec8(out: List<u8>, b: List<u8>) {
    out.push(b.len() as u8);
    put_list(out, b);
}

fn vec16(out: List<u8>, b: List<u8>) {
    put_u16(out, b.len());
    put_list(out, b);
}

fn ext(out: List<u8>, kind: u16, body: List<u8>) {
    put_u16(out, kind as usize);
    vec16(out, body);
}

/// A handshake message: type, 24-bit length, body.
fn message(kind: u8, body: List<u8>) -> List<u8> {
    let m: List<u8> = List::with_capacity(body.len() + 4);
    m.push(kind);
    put_u24(m, body.len());
    put_list(m, body);
    m
}

/// A cursor over a received message.
struct Rd {
    s: Slice<u8>;
    pos: usize;
    what: str;
}

impl Rd {
    fn new(s: Slice<u8>, what: str) -> Rd { Rd { s, pos: 0, what } }

    fn left(self) -> usize { self.s.len() - self.pos }

    fn bytes(ref self, n: usize) throws (TlsError) -> Slice<u8> {
        if self.left() < n { throw decode_err(self.what); }
        let b = self.s[self.pos:self.pos + n];
        self.pos += n;
        b
    }

    fn u8(ref self) throws (TlsError) -> u8 { (try self.bytes(1))[0] }

    fn u16(ref self) throws (TlsError) -> usize {
        let b = try self.bytes(2);
        ((b[0] as usize) << 8) | (b[1] as usize)
    }

    fn u24(ref self) throws (TlsError) -> usize {
        let b = try self.bytes(3);
        ((b[0] as usize) << 16) | ((b[1] as usize) << 8) | (b[2] as usize)
    }

    fn vec8(ref self) throws (TlsError) -> Slice<u8> {
        let n = try self.u8();
        try self.bytes(n as usize)
    }

    fn vec16(ref self) throws (TlsError) -> Slice<u8> {
        let n = try self.u16();
        try self.bytes(n)
    }

    fn vec24(ref self) throws (TlsError) -> Slice<u8> {
        let n = try self.u24();
        try self.bytes(n)
    }

    fn end(self) throws (TlsError) {
        if self.left() != 0 { throw decode_err(self.what); }
    }
}

/// `(type, body)` pairs of an extension block; a repeated type is an
/// error (RFC 8446 4.2).
fn extensions(b: Slice<u8>, what: str) throws (TlsError) -> List<(usize, Slice<u8>)> {
    let r = Rd::new(b, what);
    let out: List<(usize, Slice<u8>)> = [];
    while r.left() > 0 {
        let t = try r.u16();
        let body = try r.vec16();
        for (u, _) in out {
            if u == t { throw proto(f"duplicate extension {t} in {what}", ALERT_ILLEGAL_PARAMETER); }
        }
        out.push((t, body));
    }
    out
}

fn find_ext(exts: List<(usize, Slice<u8>)>, t: u16) -> Slice<u8> | none {
    for (u, body) in exts {
        if u == t as usize { return body; }
    }
    none
}

// ---- key schedule (RFC 8446 7.1) ----

fn suite_hash(s: CipherSuite) -> HashAlgorithm {
    match s {
        CipherSuite::Aes256GcmSha384 => HashAlgorithm::Sha384,
        _ => HashAlgorithm::Sha256,
    }
}

fn suite_aead(s: CipherSuite) -> AeadAlgorithm {
    match s {
        CipherSuite::Aes128GcmSha256 => AeadAlgorithm::Aes128Gcm,
        CipherSuite::Aes256GcmSha384 => AeadAlgorithm::Aes256Gcm,
        CipherSuite::ChaCha20Poly1305Sha256 => AeadAlgorithm::ChaCha20Poly1305,
    }
}

fn expand_label(h: HashAlgorithm, secret: List<u8>, label: str, ctx: List<u8>, len: usize) -> List<u8> {
    let info: List<u8> = [];
    put_u16(info, len);
    let full = "tls13 " + label;
    info.push(full.len() as u8);
    put(info, full.as_bytes());
    vec8(info, ctx);
    // `len` is at most a hash length: within HKDF's limit.
    try Hkdf::expand(h, secret, info, len) catch _ { [] }
}

fn derive_secret(h: HashAlgorithm, secret: List<u8>, label: str, transcript: Digest) -> List<u8> {
    expand_label(h, secret, label, transcript.finish(), h.output_len())
}

fn zeros(n: usize) -> List<u8> {
    let z: List<u8> = List::with_capacity(n);
    for _ in 0..n { z.push(0u8); }
    z
}

/// One direction of the record layer.
struct Dir {
    aead: Aead | none;
    iv: List<u8>;
    seq: u64;
    secret: List<u8>;
}

fn plain_dir() -> Dir { Dir { aead: none, iv: [], seq: 0u64, secret: [] } }

fn dir_of(suite: CipherSuite, secret: List<u8>) -> Dir {
    let h = suite_hash(suite);
    let alg = suite_aead(suite);
    let key = expand_label(h, secret, "key", [], alg.key_len());
    let iv = expand_label(h, secret, "iv", [], 12);
    // The key has the suite's length.
    let aead = try Aead::new(alg, key) catch _ { panic("AEAD key length") };
    Dir { aead, iv, seq: 0u64, secret }
}

fn nonce(d: Dir) -> List<u8> {
    let n: List<u8> = List::with_capacity(12);
    for i in 0..12 {
        let b = d.iv[i];
        if i >= 4 { b = b ^ ((d.seq >> (8 * (11 - i)) as u64) as u8); }
        n.push(b);
    }
    n
}

// ---- the connection ----

/// Connection state; `Client` / `Server` share one through a GC cell.
pub(pkg) struct Conn {
    pub(pkg) sock: TcpStream;
    pub(pkg) is_client: bool;
    rd: Dir;
    wr: Dir;
    /// Received bytes not yet made into records.
    inbuf: List<u8>;
    /// Handshake bytes not yet made into messages.
    hs: List<u8>;
    /// Decrypted application data not yet returned, from `plain_at`.
    plain: List<u8>;
    plain_at: usize;
    suite: CipherSuite;
    pub(pkg) alpn: List<u8> | none;
    pub(pkg) peer: List<Certificate>;
    pub(pkg) sni: str | none;
    pub(pkg) done: bool;
    /// close_notify received.
    eof: bool;
    /// close_notify sent.
    closed: bool;
    /// A fatal error ended the connection.
    pub(pkg) failed: str | none;
}

pub(pkg) fn new_conn(sock: TcpStream, is_client: bool) -> Conn {
    Conn {
        sock,
        is_client,
        rd: plain_dir(),
        wr: plain_dir(),
        inbuf: [],
        hs: [],
        plain: [],
        plain_at: 0,
        suite: CipherSuite::Aes128GcmSha256,
        alpn: none,
        peer: [],
        sni: none,
        done: false,
        eof: false,
        closed: false,
        failed: none,
    }
}

fn io_tls(e: IoError) -> TlsError {
    TlsError { kind: TlsErrorKind::Io, msg: e.message, alert: ALERT_INTERNAL_ERROR }
}

impl Conn {
    // ---- records ----

    /// Read more bytes from the socket into `inbuf`.
    fn fill(ref self) throws (TlsError) {
        let buf = byte_buf(MAX_PLAINTEXT + 2048);
        let s = self.sock;
        let n = try s.read(buf) catch e { throw io_tls(e); };
        if n == 0 {
            throw TlsError { kind: TlsErrorKind::Io, msg: "connection closed without close_notify", alert: ALERT_CLOSE_NOTIFY };
        }
        let inb = self.inbuf;
        put(inb, buf[0:n]);
    }

    /// The next record: `(content type, plaintext)`. Plaintext-era
    /// ChangeCipherSpec records are dropped.
    fn record(ref self) throws (TlsError) -> (u8, List<u8>) {
        loop {
            while self.inbuf.len() < 5 { try self.fill(); }
            let typ = self.inbuf[0];
            let len = ((self.inbuf[3] as usize) << 8) | (self.inbuf[4] as usize);
            if self.inbuf[1] != 3u8 { throw proto("not a TLS record", ALERT_DECODE_ERROR); }
            if len > MAX_PLAINTEXT + 256 { throw proto("record too long", ALERT_RECORD_OVERFLOW); }
            while self.inbuf.len() < 5 + len { try self.fill(); }
            let header = self.inbuf[0:5].to_list();
            let body = self.inbuf[5:5 + len].to_list();
            self.inbuf = self.inbuf[5 + len:self.inbuf.len()].to_list();
            if typ == CHANGE_CIPHER_SPEC {
                // Middlebox compatibility (RFC 8446 5): one byte 0x01,
                // only before the handshake completes.
                if self.done || body.len() != 1 || body[0] != 1u8 {
                    throw proto("unexpected change_cipher_spec", ALERT_UNEXPECTED_MESSAGE);
                }
                continue;
            }
            match self.rd.aead {
                a: Aead => {
                    if typ != APPLICATION_DATA { throw proto("unencrypted record", ALERT_UNEXPECTED_MESSAGE); }
                    let d = self.rd;
                    let n = nonce(d);
                    let opened = try a.open(n, header, body) catch _ { none };
                    self.rd.seq = self.rd.seq.wrapping_add(1u64);
                    match opened {
                        p: List<u8> => {
                            // TLSInnerPlaintext: content, type, zero padding.
                            let i = p.len();
                            while i > 0 && p[i - 1] == 0u8 { i -= 1; }
                            if i == 0 { throw proto("record without content type", ALERT_UNEXPECTED_MESSAGE); }
                            if i - 1 > MAX_PLAINTEXT { throw proto("record too long", ALERT_RECORD_OVERFLOW); }
                            let inner = p[i - 1];
                            let data = p[0:i - 1].to_list();
                            return (inner, data);
                        },
                        none => throw proto("bad record MAC", ALERT_BAD_RECORD_MAC),
                    }
                },
                none => {
                    if len > MAX_PLAINTEXT { throw proto("record too long", ALERT_RECORD_OVERFLOW); }
                    return (typ, body);
                },
            }
        }
    }

    /// Write one record of `typ` (encrypted once keys are set).
    fn send_record(ref self, typ: u8, data: Slice<u8>) throws (TlsError) {
        let out: List<u8> = [];
        match self.wr.aead {
            a: Aead => {
                let inner = data.to_list();
                inner.push(typ);
                out.push(APPLICATION_DATA);
                out.push(3u8);
                out.push(3u8);
                put_u16(out, inner.len() + 16);
                let d = self.wr;
                let n = nonce(d);
                let ct = try a.seal(n, out, inner) catch _ { throw proto("AEAD failure", ALERT_INTERNAL_ERROR); };
                put_list(out, ct);
                self.wr.seq = self.wr.seq.wrapping_add(1u64);
            },
            none => {
                out.push(typ);
                out.push(3u8);
                // ClientHello's record version is 0x0301 for old middleboxes.
                out.push(if typ == HANDSHAKE && self.is_client { 1u8 } else { 3u8 });
                put_u16(out, data.len());
                put(out, data);
            },
        }
        let s = self.sock;
        try s.write_all(out) catch e { throw io_tls(e); };
    }

    /// Write `data` as records of at most 16 KiB.
    fn send(ref self, typ: u8, data: List<u8>) throws (TlsError) {
        let at = 0usize;
        loop {
            let end = if data.len() - at > MAX_PLAINTEXT { at + MAX_PLAINTEXT } else { data.len() };
            try self.send_record(typ, data[at:end]);
            at = end;
            if at >= data.len() { return; }
        }
    }

    /// Send a fatal alert for `e` (best effort) and remember the failure.
    pub(pkg) fn fail(ref self, e: TlsError) {
        if self.failed is none {
            self.failed = e.msg;
            if e.kind != TlsErrorKind::PeerAlert && e.kind != TlsErrorKind::Io {
                try self.send_record(ALERT, [2u8, e.alert][0:2]) catch _ {};
            }
        }
    }

    /// An alert record: close_notify sets `eof`; anything else is fatal.
    fn alert(ref self, data: List<u8>) throws (TlsError) {
        if data.len() != 2 { throw decode_err("alert"); }
        if data[1] == ALERT_CLOSE_NOTIFY {
            self.eof = true;
            return;
        }
        throw TlsError { kind: TlsErrorKind::PeerAlert, msg: f"peer sent alert {data[1]}", alert: data[1] };
    }

    // ---- handshake messages ----

    /// The next handshake message `(type, body, whole message)`.
    fn message(ref self) throws (TlsError) -> (u8, List<u8>, List<u8>) {
        loop {
            if self.hs.len() >= 4 {
                let n = ((self.hs[1] as usize) << 16) | ((self.hs[2] as usize) << 8) | (self.hs[3] as usize);
                if n > 65536 { throw proto("handshake message too long", ALERT_DECODE_ERROR); }
                if self.hs.len() >= 4 + n {
                    let whole = self.hs[0:4 + n].to_list();
                    self.hs = self.hs[4 + n:self.hs.len()].to_list();
                    return (whole[0], whole[4:whole.len()].to_list(), whole);
                }
            }
            let (typ, data) = try self.record();
            if typ == ALERT {
                try self.alert(data);
                throw proto("connection closed during the handshake", ALERT_UNEXPECTED_MESSAGE);
            }
            if typ != HANDSHAKE { throw proto("unexpected record during the handshake", ALERT_UNEXPECTED_MESSAGE); }
            if data.len() == 0 { throw decode_err("handshake record"); }
            let h = self.hs;
            put_list(h, data);
        }
    }

    /// The next message, which must be of type `want`.
    fn expect(ref self, want: u8, what: str) throws (TlsError) -> (List<u8>, List<u8>) {
        let (t, body, whole) = try self.message();
        if t != want { throw proto(f"expected {what}, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
        (body, whole)
    }

    /// Keys change only on a message boundary (RFC 8446 5.1).
    fn boundary(self) throws (TlsError) {
        if self.hs.len() != 0 { throw proto("handshake message spans a key change", ALERT_UNEXPECTED_MESSAGE); }
    }

    // ---- application data ----

    /// Up to `buf.len()` bytes of application data into `buf`; 0 after
    /// close_notify.
    pub(pkg) fn read_app(ref self, buf: List<u8>) throws (TlsError) -> usize {
        while self.plain_at >= self.plain.len() {
            if self.eof { return 0; }
            let (typ, data) = try self.record();
            if typ == APPLICATION_DATA {
                self.plain = data;
                self.plain_at = 0;
            } else if typ == ALERT {
                try self.alert(data);
            } else if typ == HANDSHAKE {
                let h = self.hs;
                put_list(h, data);
                try self.post_handshake();
            } else {
                throw proto("unexpected record", ALERT_UNEXPECTED_MESSAGE);
            }
        }
        let n = buf.len();
        let left = self.plain.len() - self.plain_at;
        if left < n { n = left; }
        for i in 0..n { buf[i] = self.plain[self.plain_at + i]; }
        self.plain_at += n;
        n
    }

    /// Handle the complete post-handshake messages in `hs`.
    fn post_handshake(ref self) throws (TlsError) {
        while self.hs.len() >= 4 {
            let n = ((self.hs[1] as usize) << 16) | ((self.hs[2] as usize) << 8) | (self.hs[3] as usize);
            if self.hs.len() < 4 + n { return; }
            let (t, body, _) = try self.message();
            if t == KEY_UPDATE {
                if body.len() != 1 || body[0] > 1u8 { throw decode_err("KeyUpdate"); }
                try self.boundary();
                let next = self.next_secret(self.rd.secret);
                self.rd = dir_of(self.suite, next);
                if body[0] == 1u8 { try self.key_update(false); }
            } else if t == NEW_SESSION_TICKET && self.is_client {
                // No resumption: tickets are dropped.
            } else {
                throw proto(f"unexpected post-handshake message {t}", ALERT_UNEXPECTED_MESSAGE);
            }
        }
    }

    fn next_secret(self, secret: List<u8>) -> List<u8> {
        let h = suite_hash(self.suite);
        expand_label(h, secret, "traffic upd", [], h.output_len())
    }

    /// Send a KeyUpdate and switch to the next write key.
    pub(pkg) fn key_update(ref self, request: bool) throws (TlsError) {
        try self.send(HANDSHAKE, message(KEY_UPDATE, [if request { 1u8 } else { 0u8 }]));
        let next = self.next_secret(self.wr.secret);
        self.wr = dir_of(self.suite, next);
    }

    pub(pkg) fn write_app(ref self, data: Slice<u8>) throws (TlsError) {
        if self.closed { throw proto("write after close_notify", ALERT_INTERNAL_ERROR); }
        let at = 0usize;
        while at < data.len() {
            if self.wr.seq >= UPDATE_AFTER { try self.key_update(false); }
            let end = if data.len() - at > MAX_PLAINTEXT { at + MAX_PLAINTEXT } else { data.len() };
            try self.send_record(APPLICATION_DATA, data[at:end]);
            at = end;
        }
    }

    pub(pkg) fn close_notify(ref self) throws (TlsError) {
        if self.closed { return; }
        self.closed = true;
        try self.send_record(ALERT, [1u8, ALERT_CLOSE_NOTIFY][0:2]);
    }

    // ---- client handshake ----

    pub(pkg) fn client_handshake(ref self, host: str, ip: List<u8> | none, roots: List<Certificate>, suites: List<CipherSuite>, alpn: List<List<u8>>, pq: bool) throws (TlsError) {
        if suites.len() == 0 { throw proto("no cipher suites configured", ALERT_INTERNAL_ERROR); }
        let random32 = random::bytes(32);
        let session_id = random::bytes(32);
        let groups: List<u16> = if pq { [HYBRID_GROUP, X25519_GROUP] } else { [X25519_GROUP] };
        // Key shares: the first group's (and X25519's, so a server
        // without the hybrid needs no HelloRetryRequest).
        let shares = Shares::new(groups);
        let cookie: List<u8> | none = none;
        let ch = client_hello(random32, session_id, suites, groups, shares, host, ip, alpn, cookie);
        try self.send(HANDSHAKE, ch);
        let (sbody, sh) = try self.expect(SERVER_HELLO, "ServerHello");
        let hello = try parse_server_hello(sbody, session_id);
        let transcript = Digest::new(HashAlgorithm::Sha256);
        let retried = hello.hrr;
        if hello.hrr {
            // HelloRetryRequest (RFC 8446 4.1.4): one retry with the
            // group the server asked for and / or its cookie.
            let suite = try pick_offered(hello.suite, suites);
            let h = suite_hash(suite);
            let g = hello.group;
            if g != 0u16 {
                if !groups.contains(g) || shares.has(g) { throw proto("HelloRetryRequest for an unusable group", ALERT_ILLEGAL_PARAMETER); }
                shares = Shares::new([g]);
            } else if hello.cookie is none {
                throw proto("HelloRetryRequest that changes nothing", ALERT_ILLEGAL_PARAMETER);
            }
            transcript = Digest::new(h);
            transcript.update(message(MESSAGE_HASH, h.digest(ch)));
            transcript.update(sh);
            cookie = hello.cookie;
            ch = client_hello(random32, session_id, suites, groups, shares, host, ip, alpn, cookie);
            try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]);
            try self.send(HANDSHAKE, ch);
            let (b2, sh2) = try self.expect(SERVER_HELLO, "ServerHello");
            hello = try parse_server_hello(b2, session_id);
            if hello.hrr { throw proto("second HelloRetryRequest", ALERT_UNEXPECTED_MESSAGE); }
            if hello.suite != suite_code(suite) { throw proto("cipher suite changed after HelloRetryRequest", ALERT_ILLEGAL_PARAMETER); }
            transcript.update(ch);
            transcript.update(sh2);
        } else {
            let suite = try pick_offered(hello.suite, suites);
            transcript = Digest::new(suite_hash(suite));
            transcript.update(ch);
            transcript.update(sh);
        }
        let suite = try pick_offered(hello.suite, suites);
        self.suite = suite;
        let h = suite_hash(suite);
        let shared = try shares.finish(hello.group, hello.share);

        let early = Hkdf::extract(h, "", zeros(h.output_len()));
        let empty = Digest::new(h);
        let hs_secret = Hkdf::extract(h, derive_secret(h, early, "derived", empty), shared);
        let c_hs = derive_secret(h, hs_secret, "c hs traffic", transcript);
        let s_hs = derive_secret(h, hs_secret, "s hs traffic", transcript);
        try self.boundary();
        self.rd = dir_of(suite, s_hs);

        // EncryptedExtensions
        let (ee, ee_all) = try self.expect(ENCRYPTED_EXTENSIONS, "EncryptedExtensions");
        transcript.update(ee_all);
        let er = Rd::new(ee[0:ee.len()], "EncryptedExtensions");
        let eexts = try extensions(try er.vec16(), "EncryptedExtensions");
        try er.end();
        match find_ext(eexts, EXT_ALPN) {
            b: Slice<u8> => {
                let r = Rd::new(b, "ALPN");
                let list = Rd::new(try r.vec16(), "ALPN");
                let p = (try list.vec8()).to_list();
                try list.end();
                try r.end();
                let offered = false;
                for a in alpn {
                    if a == p { offered = true; }
                }
                if !offered || p.len() == 0 { throw proto("server chose an ALPN protocol not offered", ALERT_ILLEGAL_PARAMETER); }
                self.alpn = p;
            },
            none => {},
        }

        // CertificateRequest (answered with no certificate), Certificate.
        let (t, body, all) = try self.message();
        let cert_requested: List<u8> | none = none;
        if t == CERTIFICATE_REQUEST {
            transcript.update(all);
            let cr = Rd::new(body[0:body.len()], "CertificateRequest");
            cert_requested = (try cr.vec8()).to_list();
            let _ = try cr.vec16();
            try cr.end();
            let (t2, b2, a2) = try self.message();
            t = t2;
            body = b2;
            all = a2;
        }
        if t != CERTIFICATE { throw proto(f"expected Certificate, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
        transcript.update(all);
        let certs = try parse_certificate_msg(body);
        self.peer = certs;
        let infos: List<CertInfo> = [];
        for c in certs { infos.push(c.info); }
        let anchors: List<CertInfo> = [];
        for r in roots { anchors.push(r.info); }
        let now = (try SystemTime::now().unix_seconds() catch _ { 0i64 });
        try x509::verify_server(infos, anchors, now, host, ip) catch e {
            throw TlsError { kind: TlsErrorKind::Certificate, msg: e.msg, alert: ALERT_BAD_CERTIFICATE };
        };

        // CertificateVerify
        let (cv, cv_all) = try self.expect(CERTIFICATE_VERIFY, "CertificateVerify");
        let signed = verify_input("TLS 1.3, server CertificateVerify", transcript.finish());
        try check_cert_verify(cv, infos[0].key, signed);
        transcript.update(cv_all);

        // Finished
        let (fin, fin_all) = try self.expect(FINISHED, "Finished");
        let fk = expand_label(h, s_hs, "finished", [], h.output_len());
        if !constant_time_eq(Hmac::mac(h, fk, transcript.finish()), fin) {
            throw proto("bad server Finished", ALERT_DECRYPT_ERROR);
        }
        transcript.update(fin_all);
        let master = Hkdf::extract(h, derive_secret(h, hs_secret, "derived", empty), zeros(h.output_len()));
        let c_ap = derive_secret(h, master, "c ap traffic", transcript);
        let s_ap = derive_secret(h, master, "s ap traffic", transcript);

        // Client flight.
        try self.boundary();
        if !retried { try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]); }
        self.wr = dir_of(suite, c_hs);
        match cert_requested {
            ctx: List<u8> => {
                let cm: List<u8> = [];
                vec8(cm, ctx);
                put_u24(cm, 0);
                let m = message(CERTIFICATE, cm);
                try self.send(HANDSHAKE, m);
                transcript.update(m);
            },
            none => {},
        }
        let cfk = expand_label(h, c_hs, "finished", [], h.output_len());
        try self.send(HANDSHAKE, message(FINISHED, Hmac::mac(h, cfk, transcript.finish())));
        self.wr = dir_of(suite, c_ap);
        self.rd = dir_of(suite, s_ap);
        self.done = true;
    }

    // ---- server handshake ----

    pub(pkg) fn server_handshake(ref self, chain: List<Certificate>, key: PrivateKey, suites: List<CipherSuite>, alpn: List<List<u8>>) throws (TlsError) {
        let (body, ch_all) = try self.expect(CLIENT_HELLO, "ClientHello");
        let hello = try parse_client_hello(body);
        let suite = try pick_suite(suites, hello.suites);
        let h = suite_hash(suite);
        self.suite = suite;
        if !hello.sig_algs.contains(ED25519_SCHEME) {
            throw proto("client does not accept Ed25519 signatures", ALERT_HANDSHAKE_FAILURE);
        }
        self.sni = hello.sni;
        let transcript = Digest::new(h);
        let group = choose_group(hello);
        if group == 0u16 { throw proto("no common key exchange group", ALERT_HANDSHAKE_FAILURE); }
        let share: Slice<u8> | none = hello.share_for(group);
        let retried = false;
        let missing = share is none;
        if missing {
            // HelloRetryRequest for a group the client supports.
            transcript.update(message(MESSAGE_HASH, h.digest(ch_all)));
            let hrr = server_hello(HRR_RANDOM[0:32].to_list(), hello.session_id, suite, group, none);
            transcript.update(hrr);
            try self.send(HANDSHAKE, hrr);
            try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]);
            let (b2, ch2) = try self.expect(CLIENT_HELLO, "ClientHello");
            let hello2 = try parse_client_hello(b2);
            if hello2.session_id != hello.session_id || !hello2.suites.contains(suite_code(suite)) {
                throw proto("second ClientHello does not match", ALERT_ILLEGAL_PARAMETER);
            }
            share = hello2.share_for(group);
            if share is none { throw proto("second ClientHello without the requested key share", ALERT_ILLEGAL_PARAMETER); }
            transcript.update(ch2);
            retried = true;
            hello = hello2;
        } else {
            transcript.update(ch_all);
        }
        let (reply, shared) = try server_share(group, share ?? body[0:0]);
        let sh = server_hello(random::bytes(32), hello.session_id, suite, group, reply);
        transcript.update(sh);
        try self.send(HANDSHAKE, sh);
        if !retried { try self.send_record(CHANGE_CIPHER_SPEC, [1u8][0:1]); }

        let early = Hkdf::extract(h, "", zeros(h.output_len()));
        let empty = Digest::new(h);
        let hs_secret = Hkdf::extract(h, derive_secret(h, early, "derived", empty), shared);
        let c_hs = derive_secret(h, hs_secret, "c hs traffic", transcript);
        let s_hs = derive_secret(h, hs_secret, "s hs traffic", transcript);
        self.wr = dir_of(suite, s_hs);

        // EncryptedExtensions with the ALPN choice (server preference).
        let ee_exts: List<u8> = [];
        if hello.alpn.len() > 0 && alpn.len() > 0 {
            let pick: List<u8> | none = none;
            for mine in alpn {
                let open = pick is none;
                if open {
                    for theirs in hello.alpn {
                        if theirs == mine { pick = mine; }
                    }
                }
            }
            match pick {
                p: List<u8> => {
                    let l: List<u8> = [];
                    vec8(l, p);
                    let b: List<u8> = [];
                    vec16(b, l);
                    ext(ee_exts, EXT_ALPN, b);
                    self.alpn = p;
                },
                none => throw proto("no common ALPN protocol", ALERT_NO_APPLICATION_PROTOCOL),
            }
        }
        let ee_body: List<u8> = [];
        vec16(ee_body, ee_exts);
        let flight: List<u8> = [];
        let ee = message(ENCRYPTED_EXTENSIONS, ee_body);
        transcript.update(ee);
        put_list(flight, ee);

        // Certificate
        let cl: List<u8> = [];
        for c in chain {
            put_u24(cl, c.der.len());
            put_list(cl, c.der);
            put_u16(cl, 0);
        }
        let cb: List<u8> = [0u8];
        put_u24(cb, cl.len());
        put_list(cb, cl);
        let cm = message(CERTIFICATE, cb);
        transcript.update(cm);
        put_list(flight, cm);

        // CertificateVerify (Ed25519)
        let signed = verify_input("TLS 1.3, server CertificateVerify", transcript.finish());
        let sig = try Ed25519::sign(key.seed, signed) catch _ { throw proto("bad server key", ALERT_INTERNAL_ERROR); };
        let cvb: List<u8> = [];
        put_u16(cvb, ED25519_SCHEME as usize);
        vec16(cvb, sig);
        let cv = message(CERTIFICATE_VERIFY, cvb);
        transcript.update(cv);
        put_list(flight, cv);

        // Finished
        let sfk = expand_label(h, s_hs, "finished", [], h.output_len());
        let fin = message(FINISHED, Hmac::mac(h, sfk, transcript.finish()));
        transcript.update(fin);
        put_list(flight, fin);
        try self.send(HANDSHAKE, flight);

        let master = Hkdf::extract(h, derive_secret(h, hs_secret, "derived", empty), zeros(h.output_len()));
        let c_ap = derive_secret(h, master, "c ap traffic", transcript);
        let s_ap = derive_secret(h, master, "s ap traffic", transcript);
        self.wr = dir_of(suite, s_ap);

        // The client's Finished.
        try self.boundary();
        self.rd = dir_of(suite, c_hs);
        let (t, cfin, _) = try self.message();
        if t == CERTIFICATE { throw proto("client certificates are not supported", ALERT_UNEXPECTED_MESSAGE); }
        if t != FINISHED { throw proto(f"expected Finished, got handshake message {t}", ALERT_UNEXPECTED_MESSAGE); }
        let cfk = expand_label(h, c_hs, "finished", [], h.output_len());
        if !constant_time_eq(Hmac::mac(h, cfk, transcript.finish()), cfin) {
            throw proto("bad client Finished", ALERT_DECRYPT_ERROR);
        }
        try self.boundary();
        self.rd = dir_of(suite, c_ap);
        self.done = true;
    }
}

// ---- messages ----

fn suite_code(s: CipherSuite) -> u16 {
    match s {
        CipherSuite::Aes128GcmSha256 => 0x1301u16,
        CipherSuite::Aes256GcmSha384 => 0x1302u16,
        CipherSuite::ChaCha20Poly1305Sha256 => 0x1303u16,
    }
}

/// The configured suite with code `code` (one the client offered).
fn pick_offered(code: u16, suites: List<CipherSuite>) throws (TlsError) -> CipherSuite {
    for s in suites {
        if suite_code(s) == code { return s; }
    }
    throw proto("server chose a cipher suite not offered", ALERT_ILLEGAL_PARAMETER);
}

/// The first configured suite the client offers (server preference).
fn pick_suite(suites: List<CipherSuite>, offered: List<u16>) throws (TlsError) -> CipherSuite {
    for s in suites {
        if offered.contains(suite_code(s)) { return s; }
    }
    throw proto("no common cipher suite", ALERT_HANDSHAKE_FAILURE);
}

/// The client's key-exchange secrets for the groups it offers shares of.
struct Shares {
    x25519: List<u8> | none;
    mlkem_dk: List<u8> | none;
    mlkem_ek: List<u8>;
    groups: List<u16>;
}

impl Shares {
    /// Shares for `groups` (the hybrid's X25519 half reuses the X25519
    /// secret).
    fn new(groups: List<u16>) -> Shares {
        let s = Shares { x25519: none, mlkem_dk: none, mlkem_ek: [], groups: [] };
        for g in groups {
            if g == HYBRID_GROUP {
                let seed = random::bytes(64);
                let (ek, dk) = try MlKem768::keygen(seed[0:32], seed[32:64]) catch _ { panic("ML-KEM seed length") };
                s.mlkem_dk = dk;
                s.mlkem_ek = ek;
                s.groups.push(HYBRID_GROUP);
            }
        }
        s.x25519 = random::bytes(32);
        if groups.contains(X25519_GROUP) { s.groups.push(X25519_GROUP); }
        s
    }

    fn has(self, g: u16) -> bool { self.groups.contains(g) }

    fn x_secret(self) -> List<u8> { self.x25519 ?? [] }

    /// The key_share extension body.
    fn entries(self) -> List<u8> {
        let all: List<u8> = [];
        for g in self.groups {
            let k: List<u8> = [];
            if g == HYBRID_GROUP { put_list(k, self.mlkem_ek); }
            put_list(k, try X25519::public_key(self.x_secret()) catch _ { [] });
            put_u16(all, g as usize);
            vec16(all, k);
        }
        let out: List<u8> = [];
        vec16(out, all);
        out
    }

    /// The shared secret from the server's share for `group`.
    fn finish(self, group: u16, share: List<u8>) throws (TlsError) -> List<u8> {
        if !self.has(group) { throw proto("server chose a key share not offered", ALERT_ILLEGAL_PARAMETER); }
        let bad = proto("bad key share", ALERT_ILLEGAL_PARAMETER);
        if group == HYBRID_GROUP {
            if share.len() != MlKem768::CIPHERTEXT_LEN + 32 { throw bad; }
            let ss = try MlKem768::decapsulate(self.mlkem_dk ?? [], share[0:MlKem768::CIPHERTEXT_LEN]) catch _ { throw bad; };
            let x = try X25519::shared_secret(self.x_secret(), share[MlKem768::CIPHERTEXT_LEN:share.len()]) catch _ { throw bad; };
            match x {
                v: List<u8> => {
                    put_list(ss, v);
                    return ss;
                },
                none => throw bad,
            }
        }
        if share.len() != 32 { throw bad; }
        match try X25519::shared_secret(self.x_secret(), share) catch _ { throw bad; } {
            v: List<u8> => v,
            none => throw bad,
        }
    }
}

fn host_is_name(ip: List<u8> | none) -> bool { ip is none }

fn client_hello(random32: List<u8>, session_id: List<u8>, suites: List<CipherSuite>, groups: List<u16>, shares: Shares, host: str, ip: List<u8> | none, alpn: List<List<u8>>, cookie: List<u8> | none) -> List<u8> {
    let b: List<u8> = [3u8, 3u8];
    put_list(b, random32);
    vec8(b, session_id);
    let cs: List<u8> = [];
    for s in suites { put_u16(cs, suite_code(s) as usize); }
    vec16(b, cs);
    b.push(1u8);
    b.push(0u8);
    let exts: List<u8> = [];
    if host_is_name(ip) {
        let name: List<u8> = [0u8];
        vec16(name, host.as_bytes().to_list());
        let sn: List<u8> = [];
        vec16(sn, name);
        ext(exts, EXT_SERVER_NAME, sn);
    }
    let g: List<u8> = [];
    for x in groups { put_u16(g, x as usize); }
    let gl: List<u8> = [];
    vec16(gl, g);
    ext(exts, EXT_SUPPORTED_GROUPS, gl);
    let sa: List<u8> = [];
    for x in [ED25519_SCHEME, ECDSA_P256_SHA256, ECDSA_P384_SHA384, RSA_PSS_SHA256, RSA_PSS_SHA384, RSA_PSS_SHA512, RSA_PKCS1_SHA256, RSA_PKCS1_SHA384, RSA_PKCS1_SHA512] {
        put_u16(sa, x as usize);
    }
    let sal: List<u8> = [];
    vec16(sal, sa);
    ext(exts, EXT_SIGNATURE_ALGORITHMS, sal);
    if alpn.len() > 0 {
        let al: List<u8> = [];
        for p in alpn { vec8(al, p); }
        let a: List<u8> = [];
        vec16(a, al);
        ext(exts, EXT_ALPN, a);
    }
    ext(exts, EXT_SUPPORTED_VERSIONS, [2u8, 3u8, 4u8]);
    match cookie {
        c: List<u8> => {
            let cb: List<u8> = [];
            vec16(cb, c);
            ext(exts, EXT_COOKIE, cb);
        },
        none => {},
    }
    ext(exts, EXT_KEY_SHARE, shares.entries());
    vec16(b, exts);
    message(CLIENT_HELLO, b)
}

/// A parsed ServerHello or HelloRetryRequest.
struct Hello {
    hrr: bool;
    suite: u16;
    group: u16;
    share: List<u8>;
    cookie: List<u8> | none;
}

fn parse_server_hello(body: List<u8>, session_id: List<u8>) throws (TlsError) -> Hello {
    let r = Rd::new(body[0:body.len()], "ServerHello");
    let version = try r.u16();
    let random32 = try r.bytes(32);
    let sid = try r.vec8();
    let suite = (try r.u16()) as u16;
    let comp = try r.u8();
    let exts = try extensions(try r.vec16(), "ServerHello");
    try r.end();
    let hrr = random32 == HRR_RANDOM[0:32];
    match find_ext(exts, EXT_SUPPORTED_VERSIONS) {
        v: Slice<u8> => {
            if v.len() != 2 || v[0] != 3u8 || v[1] != 4u8 { throw proto("server chose a version other than TLS 1.3", ALERT_ILLEGAL_PARAMETER); }
        },
        none => throw proto("server does not support TLS 1.3", ALERT_PROTOCOL_VERSION),
    }
    if version != 0x0303 || comp != 0u8 { throw proto("bad ServerHello", ALERT_ILLEGAL_PARAMETER); }
    if sid.to_list() != session_id { throw proto("ServerHello session id mismatch", ALERT_ILLEGAL_PARAMETER); }
    if find_ext(exts, EXT_PRE_SHARED_KEY) is Slice<u8> { throw proto("pre_shared_key not offered", ALERT_ILLEGAL_PARAMETER); }
    let ks = find_ext(exts, EXT_KEY_SHARE);
    let h = Hello { hrr, suite, group: 0u16, share: [], cookie: none };
    match ks {
        k: Slice<u8> => {
            let kr = Rd::new(k, "key_share");
            h.group = (try kr.u16()) as u16;
            if !hrr { h.share = (try kr.vec16()).to_list(); }
            try kr.end();
        },
        none => {
            // An HRR may carry only a cookie.
            if !hrr { throw proto("ServerHello without key_share", ALERT_MISSING_EXTENSION); }
        },
    }
    if hrr {
        match find_ext(exts, EXT_COOKIE) {
            c: Slice<u8> => {
                let cr = Rd::new(c, "cookie");
                h.cookie = (try cr.vec16()).to_list();
                try cr.end();
            },
            none => {},
        }
    }
    h
}

/// The certificates of a Certificate message.
fn parse_certificate_msg(body: List<u8>) throws (TlsError) -> List<Certificate> {
    let r = Rd::new(body[0:body.len()], "Certificate");
    let ctx = try r.vec8();
    if ctx.len() != 0 { throw proto("server Certificate with a request context", ALERT_ILLEGAL_PARAMETER); }
    let list = Rd::new(try r.vec24(), "Certificate");
    try r.end();
    let out: List<Certificate> = [];
    while list.left() > 0 {
        let der = try list.vec24();
        let _ = try list.vec16();
        let c = try Certificate::from_der(der) catch e {
            throw TlsError { kind: TlsErrorKind::Certificate, msg: e.msg, alert: ALERT_BAD_CERTIFICATE };
        };
        out.push(c);
    }
    if out.len() == 0 { throw proto("empty server Certificate", ALERT_DECODE_ERROR); }
    out
}

/// The CertificateVerify signing input (RFC 8446 4.4.3).
fn verify_input(context: str, hash: List<u8>) -> List<u8> {
    let m: List<u8> = [];
    for _ in 0..64 { m.push(0x20u8); }
    put(m, context.as_bytes());
    m.push(0u8);
    put_list(m, hash);
    m
}

/// Check the server's CertificateVerify against its key.
fn check_cert_verify(body: List<u8>, key: PubKey, signed: List<u8>) throws (TlsError) {
    let r = Rd::new(body[0:body.len()], "CertificateVerify");
    let scheme = (try r.u16()) as u16;
    let sig = try r.vec16();
    try r.end();
    let alg = SigAlg::Other("");
    let curve_ok = true;
    if scheme == ED25519_SCHEME {
        alg = SigAlg::EdDsa;
    } else if scheme == ECDSA_P256_SHA256 || scheme == ECDSA_P384_SHA384 {
        // In TLS 1.3 the scheme fixes the curve.
        let want = if scheme == ECDSA_P256_SHA256 { rok::core::crypto::ecdsa::EcCurve::P256 } else { rok::core::crypto::ecdsa::EcCurve::P384 };
        curve_ok = match key {
            PubKey::Ec(c, _) => c == want,
            _ => false,
        };
        alg = SigAlg::Ecdsa(if scheme == ECDSA_P256_SHA256 { HashAlgorithm::Sha256 } else { HashAlgorithm::Sha384 });
    } else if scheme == RSA_PSS_SHA256 {
        alg = SigAlg::RsaPss(HashAlgorithm::Sha256);
    } else if scheme == RSA_PSS_SHA384 {
        alg = SigAlg::RsaPss(HashAlgorithm::Sha384);
    } else if scheme == RSA_PSS_SHA512 {
        alg = SigAlg::RsaPss(HashAlgorithm::Sha512);
    } else {
        throw proto(f"unsupported CertificateVerify scheme {scheme:#06x}", ALERT_ILLEGAL_PARAMETER);
    }
    if !curve_ok || !x509::verify_sig(key, alg, signed[0:signed.len()], sig) {
        throw proto("bad CertificateVerify signature", ALERT_DECRYPT_ERROR);
    }
}

/// A parsed ClientHello.
struct ClientHelloInfo {
    session_id: List<u8>;
    suites: List<u16>;
    groups: List<u16>;
    shares: List<(u16, Slice<u8>)>;
    sig_algs: List<u16>;
    alpn: List<List<u8>>;
    sni: str | none;
}

impl ClientHelloInfo {
    fn share_for(self, g: u16) -> Slice<u8> | none {
        for (x, k) in self.shares {
            if x == g { return k; }
        }
        none
    }
}

fn u16_list(b: Slice<u8>, what: str) throws (TlsError) -> List<u16> {
    let r = Rd::new(b, what);
    let l = Rd::new(try r.vec16(), what);
    try r.end();
    let out: List<u16> = [];
    if l.left() % 2 != 0 { throw decode_err(what); }
    while l.left() > 0 { out.push((try l.u16()) as u16); }
    out
}

fn parse_client_hello(body: List<u8>) throws (TlsError) -> ClientHelloInfo {
    let r = Rd::new(body[0:body.len()], "ClientHello");
    let _version = try r.u16();
    let _random = try r.bytes(32);
    let sid = (try r.vec8()).to_list();
    if sid.len() > 32 { throw decode_err("ClientHello"); }
    let cs = Rd::new(try r.vec16(), "ClientHello");
    let suites: List<u16> = [];
    if cs.left() % 2 != 0 { throw decode_err("ClientHello"); }
    while cs.left() > 0 { suites.push((try cs.u16()) as u16); }
    let comp = try r.vec8();
    if comp.len() != 1 || comp[0] != 0u8 { throw proto("compression offered", ALERT_ILLEGAL_PARAMETER); }
    let exts = try extensions(try r.vec16(), "ClientHello");
    try r.end();
    let info = ClientHelloInfo { session_id: sid, suites, groups: [], shares: [], sig_algs: [], alpn: [], sni: none };
    match find_ext(exts, EXT_SUPPORTED_VERSIONS) {
        v: Slice<u8> => {
            let vr = Rd::new(v, "supported_versions");
            let vl = Rd::new(try vr.vec8(), "supported_versions");
            let ok = false;
            while vl.left() >= 2 {
                if (try vl.u16()) == 0x0304 { ok = true; }
            }
            if !ok { throw proto("client does not offer TLS 1.3", ALERT_PROTOCOL_VERSION); }
        },
        none => throw proto("client does not offer TLS 1.3", ALERT_PROTOCOL_VERSION),
    }
    match find_ext(exts, EXT_SUPPORTED_GROUPS) {
        g: Slice<u8> => { info.groups = try u16_list(g, "supported_groups"); },
        none => {},
    }
    match find_ext(exts, EXT_SIGNATURE_ALGORITHMS) {
        s: Slice<u8> => { info.sig_algs = try u16_list(s, "signature_algorithms"); },
        none => throw proto("ClientHello without signature_algorithms", ALERT_MISSING_EXTENSION),
    }
    match find_ext(exts, EXT_KEY_SHARE) {
        k: Slice<u8> => {
            let kr = Rd::new(k, "key_share");
            let kl = Rd::new(try kr.vec16(), "key_share");
            try kr.end();
            while kl.left() > 0 {
                let g = (try kl.u16()) as u16;
                let key = try kl.vec16();
                info.shares.push((g, key));
            }
        },
        none => throw proto("ClientHello without key_share", ALERT_MISSING_EXTENSION),
    }
    match find_ext(exts, EXT_ALPN) {
        a: Slice<u8> => {
            let ar = Rd::new(a, "ALPN");
            let al = Rd::new(try ar.vec16(), "ALPN");
            try ar.end();
            while al.left() > 0 {
                let p = try al.vec8();
                if p.len() == 0 { throw decode_err("ALPN"); }
                info.alpn.push(p.to_list());
            }
        },
        none => {},
    }
    match find_ext(exts, EXT_SERVER_NAME) {
        s: Slice<u8> => {
            let sr = Rd::new(s, "server_name");
            let sl = Rd::new(try sr.vec16(), "server_name");
            try sr.end();
            while sl.left() > 0 {
                let t = try sl.u8();
                let n = try sl.vec16();
                if t == 0u8 { info.sni = try str::from_utf8(n) catch _ { throw decode_err("server_name"); }; }
            }
        },
        none => {},
    }
    if find_ext(exts, EXT_PRE_SHARED_KEY) is Slice<u8> {
        // Resumption is not offered by this server: the PSK is ignored
        // (a full handshake follows).
    }
    info
}

/// The group to use: the hybrid if the client supports it, else X25519;
/// 0 if neither.
fn choose_group(c: ClientHelloInfo) -> u16 {
    if c.groups.contains(HYBRID_GROUP) { return HYBRID_GROUP; }
    if c.groups.contains(X25519_GROUP) { return X25519_GROUP; }
    0u16
}

/// The server's share for `group` given the client's: `(reply, shared)`.
fn server_share(group: u16, client: Slice<u8>) throws (TlsError) -> (List<u8>, List<u8>) {
    let bad = proto("bad client key share", ALERT_ILLEGAL_PARAMETER);
    let secret = random::bytes(32);
    let public_key = try X25519::public_key(secret) catch _ { throw bad; };
    if group == HYBRID_GROUP {
        let ek_len = MlKem768::ENCAPSULATION_KEY_LEN;
        if client.len() != ek_len + 32 { throw bad; }
        let (ss, ct) = try MlKem768::encapsulate(client[0:ek_len], random::bytes(32)) catch _ { throw bad; };
        let x = try X25519::shared_secret(secret, client[ek_len:client.len()]) catch _ { throw bad; };
        match x {
            v: List<u8> => {
                put_list(ss, v);
                put_list(ct, public_key);
                return (ct, ss);
            },
            none => throw bad,
        }
    }
    if client.len() != 32 { throw bad; }
    match try X25519::shared_secret(secret, client) catch _ { throw bad; } {
        v: List<u8> => (public_key, v),
        none => throw bad,
    }
}

/// A ServerHello (`share` none: a HelloRetryRequest naming `group`).
fn server_hello(random32: List<u8>, session_id: List<u8>, suite: CipherSuite, group: u16, share: List<u8> | none) -> List<u8> {
    let b: List<u8> = [3u8, 3u8];
    put_list(b, random32);
    vec8(b, session_id);
    put_u16(b, suite_code(suite) as usize);
    b.push(0u8);
    let exts: List<u8> = [];
    ext(exts, EXT_SUPPORTED_VERSIONS, [3u8, 4u8]);
    let ks: List<u8> = [];
    put_u16(ks, group as usize);
    match share {
        s: List<u8> => vec16(ks, s),
        none => {},
    }
    ext(exts, EXT_KEY_SHARE, ks);
    vec16(b, exts);
    message(SERVER_HELLO, b)
}
