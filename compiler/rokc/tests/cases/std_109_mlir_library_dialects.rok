// spec: std 109-mlir §1.9.3; refs-lang 8.7.5
// rokc-arg: --mlir-pass lower-affine --mlir-pass convert-vector-to-llvm
// expect-exit: 0
// expect-stdout:
// 22 28

// stdlib 1.9.3: the library dialects (`affine`, `vector`) through
// `__mlir_op`, lowered by their passes named with `--mlir-pass`.
use rok::bare::mlir::{__mlir_attr, __mlir_op, __mlir_type};

type Index = __mlir_type<"index">;
type V4 = __mlir_type<"vector<4xi64>">;

// 3 * n + 1 as an affine map.
fn affine(n: i64) -> i64 {
    unsafe {
        let i = __mlir_op::<"arith.index_cast", Index>(n);
        let r = __mlir_op::<"affine.apply", Index>(
            i,
            attributes = { "map": __mlir_attr::<"affine_map<(d0) -> (d0 * 3 + 1)>"> },
        );
        __mlir_op::<"arith.index_cast", i64>(r)
    }
}

// n broadcast to four lanes, summed.
fn lanes(n: i64) -> i64 {
    unsafe {
        let v = __mlir_op::<"vector.broadcast", V4>(n);
        __mlir_op::<"vector.reduction", i64>(
            v,
            attributes = { "kind": __mlir_attr::<"#vector.kind<add>"> },
        )
    }
}

fn main() {
    println(f"{affine(7)} {lanes(7)}");
}
