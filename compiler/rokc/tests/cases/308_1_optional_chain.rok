// spec: 003.08.1-optional-chain
// expect-exit: 0
// expect-stdout:
// 7
// none

// spec 3.8.1: `x?.field` on `T | none`: none if `x` is none, else the field.
struct P {
    n: i32;
}

fn maybe(b: i32) -> P | none {
    if b == 1 {
        return P { n: 7 };
    }
    return none;
}

fn main() -> i32 {
    let a = maybe(1);
    let b = maybe(0);
    let r1 = a?.n;
    let r2 = b?.n;
    match r1 {
        v: i32 => println(f"{v}"),
        none => println("(none)"),
    }
    match r2 {
        v: i32 => println(f"{v}"),
        none => println("none"),
    }
    return 0;
}
// spec: §3.5.5
