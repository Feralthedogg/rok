// rokc-arg: -C overflow-checks=on
// expect-exit: 101
// expect-stdout: 1s
// expect-stderr: overflow

// spec: 3.3.5
// With overflow checks (debug) `Duration` overflow panics.
use rok::std::time::Duration;

fn main() {
    println(f"{Duration::sec(1)}");
    let d = Duration::MAX + Duration::ns(1);
    println(f"{d}");
}
