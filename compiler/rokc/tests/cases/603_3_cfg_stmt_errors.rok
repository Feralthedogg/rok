// spec: §6.1.3 §6.3.3
// expect-error: `#[inline]` cannot be attached to a statement; only `#[cfg]` can (spec 6.1.3)
// expect-error: unknown cfg combinator `either` (`all`, `any`, `not`)
// expect-error: `not(..)` takes exactly one predicate
// expect-error: `#[cold]` cannot be attached to a tuple variant field; only `#[cfg]` can
// expect-error: the value of cfg key `feature` must be a string

// Only `#[cfg]` goes on a statement or a tuple variant field, and a
// malformed predicate is an error whether the statement stays or not.
enum E {
    A(#[cold] i32),
    B(#[cfg(feature = 1)] i32),
}

fn main() {
    #[inline]
    println("a");
    #[cfg(either(test))]
    println("b");
    #[cfg(not(test, test))]
    println("c");
}
