// expect-exit: 0
// expect-stdout: 7 true false 14 3.5

// Stdlib bare 1.9: `__mlir_op::<"dialect.op", R>(..)` writes one op in
// MLIR's generic form into the module (`attributes = {..}` verbatim;
// `_` takes the result type from the expected one; `()` has no result).
use rok::bare::mlir::{__mlir_op, __mlir_attr};

fn add(a: i32, b: i32) -> i32 {
    unsafe { __mlir_op::<"arith.addi", i32>(a, b) }
}

fn eq(a: i32, b: i32) -> bool {
    unsafe {
        __mlir_op::<"arith.cmpi", bool>(
            a, b,
            attributes = { "predicate": __mlir_attr::<"0 : i64"> },
        )
    }
}

fn main() -> i32 {
    let s = add(3, 4);
    let twice: i32 = unsafe { __mlir_op::<"arith.muli", _>(s, 2i32) };
    let h: f64 = unsafe { __mlir_op::<"arith.divf", f64>(7.0, 2.0) };
    println(f"{s} {eq(s, 7)} {eq(s, 8)} {twice} {h}");
    0
}
// spec: std 109-mlir §1.9.2
