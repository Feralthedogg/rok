// needs: threads
// spec: std 213-marker §2.13.9 / std 216-sync §2.16.3
// A value other threads reach without the hand-off (a thread-local's
// value) can't be handed over, and a value the lock protects can't be
// returned out of its `using` block.
use rok::std::thread;

static TL: thread::ThreadLocal<List<i32>> = thread::local(|| { let l: List<i32> = []; l });
static M: Mutex<List<i32>> = Mutex::new([]);

fn grab() -> List<i32> {
    using g = M.lock() { return g.get(); }
}

fn main() {
    let (tx, rx) = channel::<List<i32>>();
    try! tx.send(TL.get());
    grab().push(1);
    let _ = rx.recv();
}

// expect-error: handoff_shared_errors.rok:12:26: this returns a value out of the `Mutex`, and `g`'s `using` block releases the lock before the caller uses it
// expect-error: handoff_shared_errors.rok:17:18: `TL.get()` can't be sent through a channel: other code reaches it through `TL` (a thread-local or a `Sync` object), so it would be used from two threads
