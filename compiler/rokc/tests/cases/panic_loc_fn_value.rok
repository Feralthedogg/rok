// expect-exit: 101
// expect-stderr: panic_loc_fn_value.rok:11:13:
// expect-stderr: assertion failed: positive

// A `fn` value of a `#[track_caller]` function reports where the value
// was taken.
#[track_caller]
fn check(x: i32) { assert(x > 0, "positive"); }

fn main() {
    let f = check;
    f(1);
    f(0);
}
