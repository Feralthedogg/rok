// expect-exit: 0
// expect-stdout:
// 3

// A named fn passed to an `extern "C"` function's `fn` parameter goes as
// a plain C function pointer (spec 5.9.10); rok `fn` values are
// `{code, env}` pairs everywhere else.
extern "C" {
    fn rok_par_for(start: i64, end: i64, step: i64, callback: fn(i64));
}

// `rok_par_for` runs the iterations in parallel: sum, don't print.
static TOTAL: Atomic<i64> = Atomic::new(0);

fn show(i: i64) {
    TOTAL.fetch_add(i);
}

fn main() -> i32 {
    unsafe { rok_par_for(0i64, 3i64, 1i64, show) };
    rok_print_i64(TOTAL.load());
    return 0;
}
