// expect-exit: 27

fn main() -> i32 {
    let xs: [i32; 5] = [3, 7, 12, 20, 27];
    let target = 27;
    let i = 0;
    let result = loop {
        if i >= 5 {
            break -1;
        }
        if xs[i] == target {
            break xs[i];
        }
        i += 1;
    };
    return result;
}
