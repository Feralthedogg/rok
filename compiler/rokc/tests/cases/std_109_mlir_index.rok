// spec: std 109-mlir §1.9.3
// expect-exit: 0
// expect-stdout:
// 42 3 true

// stdlib 1.9.3: `index` dialect ops through `__mlir_op` on values of
// the opaque `index` type, lowered to LLVM at the target's word size.
use rok::bare::mlir::{__mlir_op, __mlir_attr, __mlir_type};

type Index = __mlir_type<"index">;

fn mul_add(a: i64, b: i64, c: i64) -> i64 {
    unsafe {
        let x = __mlir_op::<"index.castu", Index>(a);
        let y = __mlir_op::<"index.castu", Index>(b);
        let z = __mlir_op::<"index.castu", Index>(c);
        let p = __mlir_op::<"index.mul", Index>(x, y);
        __mlir_op::<"index.castu", i64>(__mlir_op::<"index.add", Index>(p, z))
    }
}

fn shr(a: i64) -> i64 {
    unsafe {
        let x = __mlir_op::<"index.castu", Index>(a);
        let two = __mlir_op::<"index.constant", Index>(attributes = { "value": __mlir_attr::<"2 : index"> });
        __mlir_op::<"index.castu", i64>(__mlir_op::<"index.shru", Index>(x, two))
    }
}

fn lt(a: i64, b: i64) -> bool {
    unsafe {
        let x = __mlir_op::<"index.castu", Index>(a);
        let y = __mlir_op::<"index.castu", Index>(b);
        __mlir_op::<"index.cmp", bool>(x, y, attributes = { "pred": __mlir_attr::<"#index<cmp_predicate ult>"> })
    }
}

fn main() {
    println(f"{mul_add(5, 8, 2)} {shr(13)} {lt(1, 2)}");
}
