pub mod b;

use pkg::{P, Q, K as Kay, Tr, helper, geo::{Pt, area}};
use pkg::{geo::*};

impl Tr for P {
    fn t(self) -> i32 { self.x }
}

pub fn get(p: P, q: Q) -> i32 { p.x + q.y }
pub fn kay() -> i32 { Kay }
pub fn help() -> i32 { helper() }
pub fn ar() -> i32 { area(Pt { v: 1 }) }
pub fn dp() -> i32 { deep() }
pub fn tr<T: Tr>(x: T) -> i32 { x.t() }
