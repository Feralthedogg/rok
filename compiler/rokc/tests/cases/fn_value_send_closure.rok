// expect-exit: 0
// expect-stdout:
// 42
// 7

// A capturing closure goes into a `fn() -> T + Send` slot when its
// captures are `Send` (spec 4.4.6); the fat `{code, env}` value carries
// them.
fn spawn<T: Send>(f: fn() -> T + Send) -> T { return f(); }

fn main() -> i32 {
    let base = 40;
    rok_print_i32(spawn(|| base + 2));
    let xs: List<i32> = [3, 4];
    let g: fn() -> i32 + Send = || xs[0] + xs[1];
    rok_print_i32(g());
    return 0;
}
