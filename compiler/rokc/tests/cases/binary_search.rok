// expect-exit: 5

fn search(xs: [i32; 8], target: i32) -> i32 {
    let lo = 0;
    let hi = 8;
    while lo < hi {
        let mid = (lo + hi) / 2;
        if xs[mid] == target {
            return mid;
        }
        if xs[mid] < target {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return -1;
}

fn main() -> i32 {
    let xs: [i32; 8] = [1, 3, 5, 8, 13, 21, 34, 55];
    let i = search(xs, 21);
    return i;
}
