// spec: std 109-mlir §1.9.3 §1.9.5
// expect-exit: 0
// expect-stdout:
// max 9 min -3 neg 2.5
// sum 6
// sqrt 3 pow 8 erf 0.8427

// stdlib 1.9.3 / 1.9.5: base dialect ops (`arith`) through
// `__mlir_op` (and `math`, lowered to LLVM intrinsics or libm calls),
// behind a safe library surface that ordinary code calls.
mod fastmath {
    use rok::bare::mlir::__mlir_op;
    pub fn neg(x: f64) -> f64 { unsafe { __mlir_op::<"arith.negf", f64>(x) } }
    pub fn min(a: i64, b: i64) -> i64 { unsafe { __mlir_op::<"arith.minsi", i64>(a, b) } }
    pub fn max(a: i64, b: i64) -> i64 { unsafe { __mlir_op::<"arith.maxsi", i64>(a, b) } }
    pub fn sqrt(x: f64) -> f64 { unsafe { __mlir_op::<"math.sqrt", f64>(x) } }
    pub fn pow(a: f64, b: f64) -> f64 { unsafe { __mlir_op::<"math.powf", f64>(a, b) } }
    pub fn erf(x: f64) -> f64 { unsafe { __mlir_op::<"math.erf", f64>(x) } }
}

fn main() {
    println(f"max {fastmath::max(-3, 9)} min {fastmath::min(-3, 9)} neg {fastmath::neg(-2.5)}");
    let xs: List<f32> = [1.0, 2.0, 3.0];
    let sum: f32 = xs.iter().sum();
    println(f"sum {sum}");
    println(f"sqrt {fastmath::sqrt(9.0)} pow {fastmath::pow(2.0, 3.0)} erf {fastmath::erf(1.0):.4}");
}
