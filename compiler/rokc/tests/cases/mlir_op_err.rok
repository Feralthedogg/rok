// expect-error: call to unsafe function `__mlir_op` outside an `unsafe` block
// expect-error: `__mlir_op` is called as `__mlir_op::<"dialect.op", R>(operands..)`
// expect-error: `attributes` of `__mlir_op` is
// expect-error: a region of `__mlir_op` is a closure
// expect-error: region argument `i` of `__mlir_op` needs a type
// expect-error: a region of `__mlir_op` is straight-line ops

use rok::bare::mlir::__mlir_op;

fn main() -> i32 {
    let a: i32 = __mlir_op::<"arith.addi", i32>(1i32, 2i32);
    let b: i32 = unsafe { __mlir_op::<i32>(1i32) };
    let c: i32 = unsafe { __mlir_op::<"arith.addi", i32>(1i32, 2i32, attributes = { "x": 3 }) };
    let d: i32 = unsafe { __mlir_op::<"scf.if", i32>(true, regions = [1i32]) };
    let e: i32 = unsafe {
        __mlir_op::<"scf.if", i32>(true, regions = [|i| { __mlir_op::<"scf.yield", ()>(1i32); }])
    };
    let f: i32 = unsafe {
        __mlir_op::<"scf.if", i32>(true, regions = [|| {
            if a > 0 { __mlir_op::<"scf.yield", ()>(1i32); }
        }])
    };
    a + b + c + d + e + f
}
// spec: std 109-mlir §1.9.2 §1.9.7
