// spec: std 308-path §3.8.2 / §3.8.3 / §3.8.6
// expect-exit: 0
// expect-stdout:
// /etc/nginx/nginx.conf
// parent /etc/nginx name nginx.conf stem nginx ext conf
// with_ext /etc/nginx/nginx.bak
// starts true ends true
// strip nginx/nginx.conf
// normalize /a/c
// div-assign x/y/z
// ancestors /a/b /a /
// root parent none

// 3.8.2: decomposition and manipulation return new paths; 3.8.3: `/`
// and `/=`; 3.8.6: `normalize` is lexical.
use rok::std::path::Path;

fn main() {
    let p = Path::from("/etc") / "nginx" / "nginx.conf";
    println(p.as_str());
    let parent = p.parent() ?? Path::new();
    println(f"parent {parent.as_str()} name {p.file_name() ?? "-"} stem {p.file_stem() ?? "-"} ext {p.extension() ?? "-"}");
    println(f"with_ext {p.with_extension("bak").as_str()}");
    println(f"starts {p.starts_with(Path::from("/etc"))} ends {p.ends_with(Path::from("nginx.conf"))}");
    let s = try! p.strip_prefix(Path::from("/etc"));
    println(f"strip {s.as_str()}");
    println(f"normalize {Path::from("/a/b/../c").normalize().as_str()}");
    let q = Path::from("x");
    q /= "y";
    q /= Path::from("z");
    println(f"div-assign {q.as_str()}");
    let line = "ancestors";
    for a in Path::from("/a/b").ancestors() {
        line = line + f" {a.as_str()}";
    }
    println(line);
    let r = Path::from("/").parent();
    println(f"root parent {if r == none { "none" } else { "some" }}");
}
