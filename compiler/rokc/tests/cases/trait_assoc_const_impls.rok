// expect-exit: 0
// expect-stdout:
// 32
// 64
// 7
// 7
// 2
// 32
// 1
// 9

// Spec 2.8.3a: an associated const comes from the impl covering the
// concrete type — per instantiation (`Box<i32>` vs `Box<f64>`), from a
// blanket impl, and through `<T as Tr>::N`.
trait Width {
    const BITS: i32;
}

struct Box<T> { v: T; }

impl Width for Box<i32> { const BITS: i32 = 32; }
impl Width for Box<f64> { const BITS: i32 = 64; }

trait Named {}
trait Tagged {
    const TAG: i32 = 1;
}
trait Lucky {
    const N: i32;
}

struct A { x: i32; }
struct B { x: i32; }
impl Named for A {}
impl Named for B {}

// Blanket impl: every `Named` type is `Lucky`.
impl<T: Named> Lucky for T {
    const N: i32 = 7;
}

impl Tagged for A { const TAG: i32 = 2; }
impl Tagged for B {}

trait Other {
    const N: i32;
}
impl Other for A { const N: i32 = 9; }

fn bits<T: Width>(x: T) -> i32 { return T::BITS; }
fn lucky<T: Lucky>(x: T) -> i32 { return T::N; }
fn tag<T: Tagged>(x: T) -> i32 { return <T as Tagged>::TAG; }

fn main() -> i32 {
    rok_print_i32(bits(Box { v: 1 }));
    rok_print_i32(bits(Box { v: 1.5 }));
    rok_print_i32(lucky(A { x: 1 }));
    rok_print_i32(lucky(B { x: 1 }));
    rok_print_i32(tag(A { x: 1 }));
    rok_print_i32(<Box<i32> as Width>::BITS);
    rok_print_i32(tag(B { x: 1 }));
    rok_print_i32(<A as Other>::N);
    return 0;
}
