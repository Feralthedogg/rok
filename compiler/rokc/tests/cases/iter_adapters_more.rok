// expect-exit: 0
// expect-stdout:
// 0
// 6
// 24
// 1
// 1
// 4
// 2
// 1
// 9
// 7
// 3
// 12
// 21

// The rest of stdlib 2.7.1's adapters: enumerate / chain / take / skip
// (lazy), sum / product (empty sum = 0) / any / all / find / position /
// min / max / last / nth (eager), with capturing closures.

fn main() -> i32 {
    let xs: List<i32> = [4, 1, 9, 2, 7];
    let none_left: List<i32> = [];
    rok_print_i32(none_left.iter().sum());
    let small: List<i32> = [1, 2, 3];
    rok_print_i32(small.iter().sum());
    rok_print_i32(xs.iter().take(2).product() + 20);
    let lim = 8;
    rok_print_i32(if xs.iter().any(|x| x > lim) && !xs.iter().all(|x| x > 1) { 1 } else { 0 });
    match xs.iter().find(|x| x > 4) {
        v: i32 => rok_print_i32(if v == 9 { 1 } else { 0 }),
        none => rok_print_i32(-1),
    }
    match xs.iter().position(|x| x == 7) {
        p: usize => rok_print_i32(p as i32),
        none => rok_print_i32(-1),
    }
    match xs.iter().min() {
        m: i32 => rok_print_i32(m + 1),
        none => rok_print_i32(-1),
    }
    match xs.iter().skip(1).min() {
        m: i32 => rok_print_i32(m),
        none => rok_print_i32(-1),
    }
    match xs.iter().max() {
        m: i32 => rok_print_i32(m),
        none => rok_print_i32(-1),
    }
    match xs.iter().last() {
        m: i32 => rok_print_i32(m),
        none => rok_print_i32(-1),
    }
    let it = xs.iter();
    match it.nth(1) {
        m: i32 => rok_print_i32(m + 2),
        none => rok_print_i32(-1),
    }
    let weighted = 0;
    for (i, x) in xs.iter().enumerate() {
        if i < 2 { weighted = weighted + x * 2; }
    }
    rok_print_i32(weighted + 2);
    rok_print_i32(xs.iter().chain(small.iter()).skip(4).sum() + 8);
    return 0;
}
