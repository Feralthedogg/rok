// expect-exit: 0
// expect-stdout:
// 42
// 7777777777

// Heap roundtrip: alloc -> typed store -> typed load -> free.
// Pointers cross the FFI boundary as `usize` since rok doesn't
// surface raw pointers; the runtime helpers re-narrow them to
// the right C pointer type.
extern "C" {
    fn rok_alloc(size: usize, align: usize) -> usize;
    fn rok_free(ptr: usize);
    fn rok_store_i32(ptr: usize, val: i32);
    fn rok_load_i32(ptr: usize) -> i32;
    fn rok_store_i64(ptr: usize, val: i64);
    fn rok_load_i64(ptr: usize) -> i64;
}

fn main() -> i32 {
    let p32 = unsafe { rok_alloc(4usize, 4usize) };
    unsafe { rok_store_i32(p32, 42) };
    println(f"{unsafe { rok_load_i32(p32) }}");
    unsafe { rok_free(p32) };

    let p64 = unsafe { rok_alloc(8usize, 8usize) };
    unsafe { rok_store_i64(p64, 7777777777i64) };
    println(f"{unsafe { rok_load_i64(p64) }}");
    unsafe { rok_free(p64) };

    return 0;
}
