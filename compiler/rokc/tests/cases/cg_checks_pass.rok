// expect-exit: 0
// Runtime checks must not fire on valid operands.

fn main() -> i32 {
    let a = [10, 20, 30];
    let i: i32 = 2;
    let q: i32 = -7 / 2;
    let r: i32 = -7 % 2;
    let s: i32 = 1 << 31;
    if a[i] != 30 { return 1; }
    if q != -3 { return 2; }
    if r != -1 { return 3; }
    if s >= 0 { return 4; }
    return 0;
}
