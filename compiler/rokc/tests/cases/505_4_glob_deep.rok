// spec: 005.05.4-glob-deep
// expect-exit: 30
// expect-stdout:

// spec 5.5.4: deep recursive glob `use foo::**`.
mod outer {
    pub mod inner {
        pub fn ten() -> i32 { return 10i32; }
    }
    pub fn one() -> i32 { return 1i32; }
}

use outer::**;

fn main() -> i32 {
    return ten() * one() + one() + 19i32;   // 10 + 1 + 19 = 30
}
// spec: §5.5.5
