// expect-error: cannot derive `Copy` for `File`: it implements `Drop`
// Stdlib 2.13.3: a `Drop` type can't be `Copy`.
#[derive(Clone, Copy)]
struct File { fd: i32; }

impl Drop for File {
    fn drop(ref self) {}
}

fn main() -> i32 {
    return 0;
}

// spec: 006.02-built-in-attributes
// spec: std §2.13.3
// spec: §6.2.1
