// expect-exit: 0
// expect-stdout: 14

// Passing an i32 to a fixed-arity C function. (This used to call `printf`
// declared as `fn printf(fmt: str, value: i32)`: a C variadic called through
// a fixed-arity prototype is UB, and on arm64 Darwin `%d` read stack garbage.
// C variadic externs (spec 8.6.10) are a TODOS.md §4 gap.)
extern "C" {
    fn abs(value: i32) -> i32;
}

fn main() {
    let total = 0;
    let i = 1;
    while i <= 3 {
        total += i * i;
        i += 1;
    }
    println(f"{unsafe { abs(-total) }}");
}
