// spec: 002.02.6-narrowing
// expect-exit: 0
// expect-stdout:
// 3
// 9
// 7 i32
// 3 x

// Spec 2.2.6: inside `x is T` an assignment of a `T` keeps the narrowing;
// one of another member of the declared type writes the declared slot and
// ends the narrowing for the rest of that scope, so `x` reads as the
// declared type afterwards.
fn show(v: i32 | str) -> str {
    match v { n: i32 => f"{n} i32", s: str => f"{s} str" }
}

fn main() -> i32 {
    let end: usize | none = none;
    for i in 0usize..5 {
        if end is none && i == 3 { end = i; }
    }
    println(f"{end ?? 0}");
    let other: usize | none = none;
    if other is none {
        other = none;
        other = 9;
        let back: usize | none = other;
        println(f"{back ?? 0}");
    }
    let v: i32 | str = 1;
    if v is i32 {
        v = v + 6;
        println(show(v));
    }
    let a: any = 1;
    let n = 0;
    while a is i32 {
        n += a;
        a = a + 1;
        if n > 1 { a = "x"; }
    }
    match a { s: str => println(f"{n} {s}"), _ => println("?") }
    return 0;
}
