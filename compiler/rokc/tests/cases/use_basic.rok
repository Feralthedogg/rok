// expect-exit: 50

mod a {
    pub fn one() -> i32 { 1i32 }
    pub fn two() -> i32 { 2i32 }
    pub fn three() -> i32 { 3i32 }
}

use a::one;                 // single
use a::two as second;       // alias
use a::{three};             // group with one element

fn main() -> i32 {
    return one() + second() + three() + 44i32;  // 1 + 2 + 3 + 44 = 50
}

// spec: 005.05-use
