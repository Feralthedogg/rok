// spec: 003.08.8-short-circuit-evaluation-of-optional-chaining
// Parentheses end an optional chain: the link after them applies to
// the `T | none` value.
// expect-error: no method `len` found for type `str | none`

fn get(b: bool) -> str | none { if b { "hi" } else { none } }

fn main() {
    let n = (get(true)?.trim()).len();
}
