// expect-exit: 0
// expect-stdout:
// alloc ok

// `rok_alloc` is a libc-malloc-backed runtime hook.
// `rok_free` returns the memory. No GC, no tracing — short-running
// programs only. Pointers cross the FFI boundary as `usize`.
extern "C" {
    fn rok_alloc(size: usize, align: usize) -> usize;
    fn rok_free(ptr: usize);
}

fn main() -> i32 {
    let p = unsafe { rok_alloc(64usize, 8usize) };
    if p != 0usize {
        println("alloc ok");
    } else {
        println("alloc fail");
    }
    unsafe { rok_free(p) };
    return 0;
}
