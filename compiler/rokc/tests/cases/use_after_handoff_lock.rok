// expect-exit: 0
// expect-stdout: 3 1 1 2 1 6 1 1 2
// expect-lint: 17:5 `xs` is used after it was handed over to `Mutex::new`
// expect-lint: 23:5 `ys` is used after it was handed over to `RwLock::new`
// expect-lint: 31:5 `xs` is used after it was handed over to `Mutex::new`
// expect-lint: 38:29 `xs` is used after it was handed over to `Mutex::new`
// spec: std 213-marker §2.13.9 / std 216-sync §2.16.3 / §2.16.4

// rok has no move semantics: after `Mutex::new(xs)` the caller's `xs`
// still points at the object the lock now guards, so a later use on
// any path races with the lock's users (lint `use_after_handoff`).
// Reassigning, a clone, a `Sync` value or `#[allow]` keeps it quiet.

fn after() -> i64 {
    let xs: List<i32> = [1, 2];
    let _m = Mutex::new(xs);
    xs.push(3);
    xs.len() as i64
}

fn rw(ys: List<i32>) -> i64 {
    let _l = RwLock::new(ys);
    ys.len() as i64
}

fn one_branch(c: bool) -> i64 {
    let xs: List<i32> = [1];
    if c {
        let _m = Mutex::new(xs);
    }
    xs.len() as i64
}

fn each_iteration() {
    let xs: List<i32> = [1];
    let i = 0;
    while i < 2 {
        let _m = Mutex::new(xs);
        i += 1;
    }
}

fn reassigned() -> i64 {
    let xs: List<i32> = [1];
    let _m = Mutex::new(xs);
    xs = [1, 2];
    xs.len() as i64
}

fn fresh_each_iteration() {
    for i in 0..2 {
        let xs: List<i32> = [i];
        let _m = Mutex::new(xs);
    }
}

fn returned_first(c: bool) -> i64 {
    let xs: List<i32> = [1];
    if c {
        let _m = Mutex::new(xs);
        return 0;
    }
    xs.len() as i64
}

fn cloned() -> i64 {
    let xs: List<i32> = [1];
    let _m = Mutex::new(xs.clone());
    xs.len() as i64
}

fn shareable() -> i64 {
    let n = 4i64;
    let s = "ab";
    let _a = Mutex::new(n);
    let _b = Mutex::new(s);
    n + s.len() as i64
}

#[allow(use_after_handoff)]
fn allowed() -> i64 {
    let xs: List<i32> = [1];
    let _m = Mutex::new(xs);
    xs.len() as i64
}

fn main() {
    each_iteration();
    fresh_each_iteration();
    let a = f"{after()} {rw([1])} {one_branch(false)} {reassigned()} {returned_first(false)}";
    println(f"{a} {shareable()} {cloned()} {allowed()} {returned_first(true) + 2}");
}
