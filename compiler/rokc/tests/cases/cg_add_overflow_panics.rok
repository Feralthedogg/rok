// spec: std §2.3.1
// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/cg_add_overflow_panics.rok:10:40:
// expect-stderr: attempt to add with overflow
// debug-only
// expect-stdout:
// 2147483647

// stdlib spec 0.5: fixed-width overflow panics in debug builds.
fn add(a: i32, b: i32) -> i32 { return a + b; }
println(f"{add(2147483646, 1)}");
println(f"{add(2147483647, 1)}");
