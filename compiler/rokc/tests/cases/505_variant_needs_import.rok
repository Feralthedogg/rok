// spec: 005.05-variant-needs-import
// expect-error: Blue

// spec 5.5: a user enum's variants are not bare names until imported
// (`use Color::*` / `use Color::{Blue}`); only the implicit
// `rok::core::**` brings core variants (`Ok` / `Err`) in.
enum Color { Red, Blue(i32) }

fn main() -> i32 {
    let c = Blue(3);
    return 0;
}
// spec: §5.5.7
