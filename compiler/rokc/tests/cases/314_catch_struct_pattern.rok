// expect-exit: 0
// expect-stdout:
// nf
// 404
// 1

// 3.14.4: `catch HttpError { code, msg } { .. }` — a struct pattern
// when a second block follows; it covers the error type.
struct HttpError { code: i32; msg: str; }
impl Error for HttpError {}

fn get(fail: bool) throws (HttpError) -> i32 {
    if fail { throw HttpError { code: 404, msg: "nf" }; }
    1
}

fn main() {
    let n = try get(true) catch HttpError { code, msg } { println(msg); code };
    println(f"{n}");
    let m = try get(false) catch e { e.code };
    println(f"{m}");
}
