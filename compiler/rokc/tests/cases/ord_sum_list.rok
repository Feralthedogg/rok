// expect-exit: 0
// expect-stdout:
// sum: true false true true false true
// cmp: Less Equal Greater Less
// list: true true false true false true
// lcmp: Less Equal Greater
// derive: true false
// eq: true true false
// generic: 1 1

// `PartialOrd` / `Ord` for sum types (canonical variant order, spec
// 2.6.4: structural with `none` last; then the payload), compiler-dispatched
// like the sum's Clone / Eq / Hash, and for `List<T>` (lexicographic,
// stdlib 2.5.7).
fn name(o: Ordering) -> str {
    match o { Ordering::Less => "Less", Ordering::Equal => "Equal", Ordering::Greater => "Greater" }
}

// With `T = i32 | none`, `next()` is the nested `(i32 | none)?` (spec
// 2.6.4): the loop sees the stored `none`.
fn smallest<T: Ord>(xs: List<T>) -> T {
    let m = xs[0];
    for x in xs { if x < m { m = x; } }
    m
}

#[derive(PartialEq, PartialOrd)]
struct Rec { k: i32 | none; tag: List<i32>; }

fn main() -> i32 {
    let a: i32 | str = 1;
    let b: i32 | str = 2;
    let s: i32 | str = "x";
    let n: i32 | none = none;
    let m: i32 | none = 5;
    println(f"sum: {a < b} {b < a} {a < s} {s >= s} {s < a} {m < n}");
    println(f"cmp: {name(a.cmp(b))} {name(n.cmp(n))} {name(s.cmp(b))} {name(m.cmp(n))}");

    let x: List<i32> = [1, 2, 3];
    let y: List<i32> = [1, 2, 4];
    let z: List<i32> = [1, 2];
    println(f"list: {x < y} {z < x} {y <= x} {x >= z} {x > x} {x <= x}");
    println(f"lcmp: {name(x.cmp(y))} {name(x.cmp(x))} {name(x.cmp(z))}");

    let r1 = Rec { k: 1, tag: x };
    let r2 = Rec { k: 1, tag: y };
    println(f"derive: {r1 < r2} {r2 < r1}");
    println(f"eq: {a == a} {a != s} {n == m}");

    let opts: List<i32 | none> = [3, none, 1];
    let low = smallest(opts);
    let ls: List<List<i32>> = [y, x, z];
    println(f"generic: {smallest(ls).len() - 1} {low.debug()}");
    0
}
