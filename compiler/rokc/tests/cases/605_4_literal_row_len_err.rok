// spec: 006.05-literal-magic
// expect-error: 10:15: mismatched types: variadic argument expects `[i64; 2]`, found `[i64; 1]`

// Spec 6.5.4: rows of a `...[T; C]` matrix literal share one length.
#[literal("w" "[" {{expr} % "," +} % ";" + "]")]
fn w_literal<const C: usize>(rows: ...[i64; C]) -> usize { C }

fn main() -> i32 {
    let ok = w[1, 2; 3, 4];
    let bad = w[1, 2; 3];
    return 0;
}
