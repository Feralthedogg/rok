// expect-exit: 0
// expect-stdout:
// 5
// 0
// match
// nomatch

// `rok_str_len` / `rok_str_eq` give rok code basic null-terminated
// string introspection without a real `String` / `str` story.
extern "rok" {
    fn rok_str_len(s: str) -> usize;
    fn rok_str_eq(a: str, b: str) -> i32;
}

fn main() -> i32 {
    println(f"{unsafe { rok_str_len("hello") } as i64}");
    println(f"{unsafe { rok_str_len("") } as i64}");

    if unsafe { rok_str_eq("foo", "foo") } != 0 {
        println("match");
    } else {
        println("nope");
    }

    if unsafe { rok_str_eq("foo", "bar") } != 0 {
        println("match");
    } else {
        println("nomatch");
    }

    return 0;
}
