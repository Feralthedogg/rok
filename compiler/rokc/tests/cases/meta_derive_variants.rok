// expect-exit: 0
// expect-stdout:
// Circle(2)
// Rect { w: 3, h: 4 }
// Empty
// 1 2 0
// unit tuple named
// enum

// Spec 6.9.4: `@for_variants`, `@variant.pattern` / `.name` /
// `.is_unit` / `.is_tuple` / `.is_named`, `@for_variant_fields`,
// `@if_enum` / `@if_struct`.
trait Show {
    fn show(self) -> str;
    fn payload(self) -> i32;
    fn shape(self) -> str;
    fn kind() -> str;
}

#[impl_derive(Show)]
pub @derive {
    impl Show for @Self {
        fn show(self) -> str {
            return match self {
                @for_variants {
                    @variant.pattern => {
                        let s = @variant.name.as_str();
                        @apply_if(@variant.is_tuple) {
                            s = s + "(";
                            @for_variant_fields {
                                s = s + @field.display();
                            }
                            s = s + ")";
                        }
                        @apply_if(@variant.is_named) {
                            let first = true;
                            s = s + " { ";
                            @for_variant_fields {
                                if !first { s = s + ", "; }
                                s = s + @field.name.as_str() + ": " + @field.display();
                                first = false;
                            }
                            s = s + " }";
                        }
                        s
                    },
                }
            };
        }
        fn payload(self) -> i32 {
            return match self {
                @for_variants {
                    @variant.pattern => {
                        let n = 0;
                        @for_fields { n = n + 1; }
                        n
                    },
                }
            };
        }
        fn shape(self) -> str {
            return match self {
                @for_variants {
                    @variant.pattern => {
                        @apply_if(@variant.is_unit) { "unit" }
                        @apply_if(@variant.is_tuple) { "tuple" }
                        @apply_if(!@variant.is_unit && !@variant.is_tuple) { "named" }
                    },
                }
            };
        }
        fn kind() -> str {
            @if_enum { return "enum"; }
            @if_struct { return "struct"; }
        }
    }
}

#[derive(Show)]
enum Shape {
    Circle(i32),
    Rect { w: i32; h: i32 },
    Empty,
}

fn main() -> i32 {
    let a = Shape::Circle(2);
    let b = Shape::Rect { w: 3, h: 4 };
    let c = Shape::Empty;
    rok_print_str(a.show());
    rok_print_str(b.show());
    rok_print_str(c.show());
    rok_print_str(f"{a.payload()} {b.payload()} {c.payload()}");
    rok_print_str(f"{c.shape()} {a.shape()} {b.shape()}");
    rok_print_str(Shape::kind());
    return 0;
}
