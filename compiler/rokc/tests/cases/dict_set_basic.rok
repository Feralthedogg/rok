// expect-exit: 0
// expect-stdout:
// 3
// 20
// -1
// 1
// 200
// 2
// 1000
// 4950
// 3
// 1
// 4
// 2
// 1
// 1

// `Dict<K, V>` / `Set<T>` (stdlib 2.9.3-4) and their literals (6.5.6):
// `{k: v}` is a dict, `{a, b}` a set. Keys hash through `Hash`.

fn main() -> i32 {
    let d: Dict<i32, i32> = {1: 10, 2: 20, 3: 30};
    rok_print_i32(d.len() as i32);
    rok_print_i32(d[2]);
    match d.get(7) {
        v: i32 => rok_print_i32(v),
        none => rok_print_i32(-1),
    }
    rok_print_i32(if d.contains_key(3) { 1 } else { 0 });
    d[2] = 200;
    rok_print_i32(d[2]);
    match d.remove(1) {
        v: i32 => rok_print_i32(d.len() as i32),
        none => rok_print_i32(-1),
    }
    // Growth: many keys, removals, re-inserts.
    let big: Dict<i64, i32> = Dict::new();
    let i = 0;
    while i < 1000 {
        big.insert(i as i64 * 7i64, i);
        i = i + 1;
    }
    rok_print_i32(big.len() as i32);
    let total = 0;
    for (k, v) in big {
        if v < 100 { total = total + v; }
    }
    rok_print_i32(total);

    // Inferred from the first entry: `Dict<i32, bool>` / `Set<i32>`.
    let flags = {1: true, 2: false, 3: true};
    rok_print_i32(flags.len() as i32);
    let s = {1, 2, 3};
    rok_print_i32(if s.contains(2) && !s.contains(9) { 1 } else { 0 });
    let t: Set<i32> = {3, 4};
    rok_print_i32(s.union(t).len() as i32);
    rok_print_i32(s.difference(t).len() as i32);
    rok_print_i32(s.intersection(t).len() as i32);
    let n = 0;
    for x in t {
        n = n + x;
    }
    rok_print_i32(if n == 7 && !s.insert(1) && s.insert(5) { 1 } else { 0 });
    return 0;
}
