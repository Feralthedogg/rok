// spec: std §2.3.5 / refs-lang §0.4.3
// expect-error: operator `&` cannot be applied to `f32`: it needs `impl BitAnd for f32`
// expect-error: cannot index into a value of type `str`
// expect-error: cannot index into a value of type `(i32, i32)`

// Stdlib 2.3.5: floats have no bitwise traits, `str` has no
// `Index<usize>` and a tuple no `Index` (`.0` only); 0.4.3: an operation
// with no trait impl is a compile error naming the impl it needs.
fn bits() { let a = 1.0f32 & 2.0f32; }
fn byte() { let s = "abc"; let c = s[0]; }
fn slot() { let t = (1, 2); let i = 0; let c = t[i]; }
fn main() { bits(); byte(); slot(); }
