// spec: §6.7.5
// expect-error: operator `+` is bound twice (`rok::core::ops::Add::add` and `MyAdd::add2`)

// Spec 6.7.5: one (token, position) pair binds to one trait method; a
// user trait cannot take core's binary `+`.
struct V { x: i32; }

trait MyAdd {
    #[infix("+")]
    fn add2(self, rhs: Self) -> V;
}

println("unreached");
// spec: §3.2.4 §3.1.7
