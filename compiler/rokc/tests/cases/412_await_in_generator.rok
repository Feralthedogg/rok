// spec: 004.12-async §4.12.10
// expect-error: `await` outside an async body

// spec 4.12.10: `await` is an error in a (non-async) `yield` body.
async fn one() -> i32 { 1 }

yield fn bad() -> i32 {
    yield await one();
}

fn main() -> i32 {
    for x in bad() { println(f"{x}"); }
    return 0;
}
