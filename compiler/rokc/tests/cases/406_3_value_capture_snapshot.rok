// spec: 004.06.1-value-capture-snapshot
// expect-exit: 21

// spec 4.6: closures capture a value snapshot at creation: f1 binds i=1,
// f2 binds i=2, and later setting i to 99 changes neither.
fn main() -> i32 {
    let i = 1;
    let f1 = || { i };
    i = 2;
    let f2 = || { i };
    i = 99;
    return f1() + f2() * 10;
}
