// only-target: wasm32-wasi
// wasm-plug: plug/main.rok
// expect-exit: 0
// expect-stdout:
// Pair { a: 42, b: "twice" }
// twice=42

// Stdlib 1.8: worlds. `wit/` is one package in three files; naming a
// file binds only what it defines (world `consumer` here, `provider` in
// the plug). A world-level function is imported under module `$root`
// (`test::w::consumer::answer` here), an inline interface by its plain
// name (`tools`), and a world's `use` brings a type of another
// interface into it.
ffi::wit::import { "wit/consumer.wit" }

use test::w::consumer;
use test::w::consumer::tools;

fn main() {
    let p = tools::double(21);
    println(f"{p:?}");
    println(consumer::answer(p));
}
