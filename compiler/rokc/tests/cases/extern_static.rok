// only-os: macos linux
// (POSIX environ / optind)
// expect-exit: 0
// expect-stdout: true 7
// Spec 5.9.3: `extern "C" { static .. }` names a C global; `static mut`
// can be written. `environ` and `optind` are libc globals.
extern "C" {
    static environ: usize;
    static mut optind: i32;
}

fn main() {
    let set = environ != 0usize;
    optind = 6;
    println(f"{set} {optind + 1}");
}

// spec: 005.09-extern-block
