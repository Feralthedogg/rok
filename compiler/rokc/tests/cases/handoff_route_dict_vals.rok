// needs: threads
// expect-error: `d` may hold one object twice
// spec: std 213-marker §2.13.9
// One list under two keys.
use rok::std::thread;
fn main() {
    let (tx, rx) = channel::<List<i32>>();
    let t = thread::spawn(|| { if let l: List<i32> = rx.recv() { for i in 0..200000 { l.push(i); } } 0 });
    let d: Dict<str, List<i32>> = Dict::new();
    let a: List<i32> = [];
    d.insert("x", a);
    d.insert("y", a);
    if let e: List<i32> = d.remove("x") { try! tx.send(e); }
    if let f: List<i32> = d.remove("y") { for i in 0..200000 { f.push(i); } let _ = try! t.join(); println(f"len {f.len()}"); }
}
