// expect-exit: 101
// A failed GC allocation ends in the `oom_fn` path (Fatal, exit 101),
// the same one `rok::core::panic::oom()` takes. The declaration repeats
// the runtime's own (spec 5.9.4).
extern "C" {
    fn rok_gc_alloc_slow(size: usize, align: usize, type_id: u32) -> GcBuf<u8>;
}
fn main() -> i32 {
    let p = unsafe { rok_gc_alloc_slow(usize::MAX / 2 + 1, 8usize, 0u32) };
    return 0;
}
