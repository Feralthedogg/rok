// expect-exit: 101
// expect-stderr: panic_loc_track_caller_nested.rok:22:5:
// expect-stderr: assertion `left == right` failed

// A `#[track_caller]` chain (user `outer` → user `inner` → library
// `assert_eq` → `panic`) reports the first caller outside it; a check
// in a `#[track_caller]` function reports its caller too.
#[track_caller]
fn inner(x: i32) {
    assert_eq(x, 1);
}

#[track_caller]
fn outer(x: i32) {
    inner(x);
}

fn helper(x: i32) { outer(x); }

fn main() {
    helper(1);
    outer(2);
}
