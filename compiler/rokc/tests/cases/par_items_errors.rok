// spec: std 219-par / std 213-marker §2.13.9
// `par` gives each item to a worker: two items must not share an object
// that is not `Sync`.

struct Job { items: List<i32>; id: i32; }

yield fn twice(xs: List<i32>) -> List<i32> {
    yield xs;
    yield xs;
}

fn main() {
    let xs: List<i32> = [];
    let all: List<List<i32>> = [xs, xs];
    par::for_each(all, |l: List<i32>| { l.push(1); });

    let ys: List<i32> = [];
    let jobs: List<Job> = [];
    jobs.push(Job { items: ys, id: 1 });
    jobs.push(Job { items: ys, id: 2 });
    let n = par::map(jobs, |j: Job| { j.items.push(1); j.id });

    par::for_each(twice(xs), |l: List<i32>| { l.push(1); });
    println(f"{n.len()}");
}

// expect-error: par_items_errors.rok:15:19: `all` may hold one object twice, and `par::for_each` would give it to two workers at once
// expect-error: par_items_errors.rok:21:22: `jobs` may hold one object twice, and `par::map` would give it to two workers at once
// expect-error: par_items_errors.rok:23:19: `par::for_each` needs items it can tell apart: the items may give it one object twice, and two workers would change it at once
