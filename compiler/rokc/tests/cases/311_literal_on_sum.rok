// spec: 3.11.1
// expect-exit: 0
// A literal / range pattern on a sum scrutinee tests the member it can match.

fn f(c: char | none) -> i32 {
    match c {
        'a' => 1,
        'b' | 'c' => 2,
        none => 3,
        _ => 4,
    }
}

fn g(x: i32 | str) -> i32 {
    match x {
        1 => 10,
        2..=5 => 15,
        "hi" => 20,
        _ => 30,
    }
}

fn h(s: str | none) -> i32 {
    match s {
        "x" => 1,
        v: str => v.len() as i32 + 10,
        none => 0,
    }
}

fn main() -> i32 {
    if f('a') != 1 { return 1; }
    if f('c') != 2 { return 2; }
    if f(none) != 3 { return 3; }
    if f('z') != 4 { return 4; }
    if g(1) != 10 { return 5; }
    if g("hi") != 20 { return 6; }
    if g(9) != 30 { return 7; }
    if g("x") != 30 { return 8; }
    if g(4) != 15 { return 9; }
    if h("x") != 1 { return 10; }
    if h("abc") != 13 { return 11; }
    if h(none) != 0 { return 12; }
    0
}
