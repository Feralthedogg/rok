// expect-exit: 101
// expect-stderr: thread 'main' panicked at tests/cases/str_slice_clamp_boundary_panics.rok:11:13:
// expect-stderr: string slice is not on a char boundary
// expect-stdout: a세b

// stdlib 2.15.3: `str` bounds are byte offsets clamped to the length;
// a clamped bound inside a UTF-8 sequence still panics.
fn main() {
    let s = "a세b";
    println(s[-10:100]);
    println(s[-3:]);
}

// spec: std 215-string
