// expect-exit: 0
// expect-stdout:
// sequential 200 sum 19900 reused true
// concurrent 1000 sum 499500 bounded true
// cancelled job finished true

// `task::spawn_blocking` runs jobs on a persistent pool: awaited one at
// a time they reuse a thread (a job can race the previous thread going
// idle, so allow a few); 1000 at once stay within the pool's cap
// (512 threads) and all complete.
use rok::std::thread;
use rok::std::time::Duration;

fn tid() -> u64 {
    thread::current().id().as_u64()
}

let ids: Set<u64> = Set::new();
let sum = 0;
for i in 0..200 {
    let r = await task::spawn_blocking(|| (i, tid()));
    sum += r.0;
    ids.insert(r.1);
}
println(f"sequential 200 sum {sum} reused {ids.len() <= 4}");

let jobs: List<task::Blocking<(i32, u64)>> = List::new();
for i in 0..1000 {
    jobs.push(task::spawn_blocking(|| {
        thread::sleep(Duration::ms(1));
        (i, tid())
    }));
}
let all: Set<u64> = Set::new();
let total = 0;
for j in jobs {
    let r = await j;
    total += r.0;
    all.insert(r.1);
}
println(f"concurrent 1000 sum {total} bounded {all.len() <= 512}");

// Cancelled once the job runs (a loaded machine may take long to start
// it); then the job finishes all the same.
let started = Atomic::new(0);
let flag: Mutex<bool> = Mutex::new(false);
let t = task::spawn(async {
    await task::spawn_blocking(|| {
        started.store(1);
        thread::sleep(Duration::ms(20));
        using g = flag.lock() { g.set(true); }
        0
    });
});
let deadline = Instant::now() + Duration::sec(60);
while started.load() == 0 && Instant::now() < deadline { await task::yield_now(); }
t.cancel();
let seen = false;
while !seen && Instant::now() < deadline {
    using g = flag.lock() { seen = g.get(); }
    if !seen { thread::sleep(Duration::ms(2)); }
}
println(f"cancelled job finished {seen}");

// spec: std 218-task
