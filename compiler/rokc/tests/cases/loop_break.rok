// expect-exit: 128

fn first_double_over(start: i32, limit: i32) -> i32 {
    let v: i32 = start;
    let r: i32 = loop {
        if v > limit {
            break v;
        }
        v = v * 2i32;
    };
    return r;
}

fn main() -> i32 {
    return first_double_over(1i32, 100i32);
}

// spec: 003.13-loop-expressions
