// spec: §5.8.10
// expect-error: 6:13: circular re-export: `a::Item` -> `b::Item` -> `a::Item` (spec 5.8.10)

// 5.8.10: re-exports that point at each other are an error.
mod a {
    pub use pkg::b::Item;
}
mod b {
    pub use pkg::a::Item;
}

println("unreached");
// expect-error: 9:13: circular re-export: `b::Item` -> `a::Item` -> `b::Item` (spec 5.8.10)
