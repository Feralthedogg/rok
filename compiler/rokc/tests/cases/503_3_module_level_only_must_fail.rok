// spec: refs-lang §5.3.3 §5.3.8 §5.4.10 §5.9.8
// expect-error: 13:5: a `static` (spec 5.3.3) is declared only at module level, not in a function body
// expect-error: 17:5: a `mod` (spec 5.4.10) is declared only at module level, not in a function body
// expect-error: 21:5: an `extern` block (spec 5.9.8) is declared only at module level, not in a function body
// expect-error: 26:5: a `static` is declared only at module level, not in an `impl`; an associated `const` goes there (spec 5.3.8)

// `static`, `mod` and `extern` blocks are module-level items: one in a
// function body or an `impl` is an error (an associated `const` is not).
struct Counter { n: i32; }
static APP_NAME: str = "rok";

fn f() {
    static COUNTER: i32 = 0;
}

fn g() {
    mod inner { pub fn h() {} }
}

fn k() {
    extern "C" { fn abs(x: i32) -> i32; }
}

impl Counter {
    const ZERO: i32 = 0;
    static GLOBAL: i32 = 0;
}

fn main() { f(); g(); k(); }
