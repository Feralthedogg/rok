// expect-error: `task::spawn` needs a `Send` future: it captures `xs: List<i32>`, which is not `Sync`

// An `async` block captures by copying the handle, so a spawned task
// would share the list with the spawner. A list made inside a task,
// or one an `async fn` gets as an argument and awaits within the same
// task, is fine (`async_spawn_capture_local`).
async fn grow(xs: List<i32>) -> usize {
    xs.push(1);
    xs.len()
}

fn main() {
    let xs: List<i32> = [];
    let t = task::spawn(async { xs.push(1); xs.len() });
    let u = task::spawn(async {
        let mine: List<i32> = [];
        await grow(mine)
    });
    println(f"{task::block_on(t)} {task::block_on(u)}");
}
