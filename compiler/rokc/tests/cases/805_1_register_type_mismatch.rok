// spec: refs-lang §8.5.1 §5.9.4
// expect-error: extern function `rok_gc_register_type` is declared twice with different signatures: `fn(u32, usize) -> ()` here, `fn(u32, ConstPtr<u8>) -> ()` elsewhere; `rok_*` symbols are the runtime's, with the signatures of spec 8.5 (spec 5.9.4)
// `rok::core::rt` declares the runtime symbols codegen calls on its own:
// a program's declaration of one must have the spec 8.5 signature.
extern "C" {
    fn rok_gc_register_type(type_id: u32, table: usize);
}

fn main() {
    unsafe { rok_gc_register_type(70000u32, 0usize); }
}
