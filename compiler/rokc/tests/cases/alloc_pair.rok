// expect-exit: 0
// expect-stdout:
// 100
// 200

// Two i64 slots in a single heap allocation, addressed by offset.
// The same idiom expresses any record-of-primitives layout.
extern "C" {
    fn rok_alloc(size: usize, align: usize) -> usize;
    fn rok_free(ptr: usize);
    fn rok_store_i64(ptr: usize, val: i64);
    fn rok_load_i64(ptr: usize) -> i64;
}

fn main() -> i32 {
    let p = unsafe { rok_alloc(16usize, 8usize) };
    unsafe { rok_store_i64(p, 100i64) };
    unsafe { rok_store_i64(p + 8usize, 200i64) };
    println(f"{unsafe { rok_load_i64(p) }}");
    println(f"{unsafe { rok_load_i64(p + 8usize) }}");
    unsafe { rok_free(p) };
    return 0;
}
