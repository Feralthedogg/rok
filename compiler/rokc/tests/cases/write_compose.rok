// expect-exit: 0
// expect-stdout:
// x=42, y=3.14
// answer: 0xff

// `rok_write_*` is the no-newline counterpart to `rok_print_*` — lets
// programs compose multi-segment output on a single line. Without these
// each value would land on its own line.
extern "C" {
    fn rok_write_str(s: str) -> i32;
    fn rok_write_i64(n: i64) -> i32;
    fn rok_write_f64(d: f64) -> i32;
    fn rok_write_hex(n: i64) -> i32;
}

fn main() -> i32 {
    rok_write_str("x=");
    rok_write_i64(42i64);
    rok_write_str(", y=");
    rok_write_f64(3.14f64);
    rok_print_str("");

    rok_write_str("answer: ");
    rok_write_hex(255i64);
    rok_print_str("");

    return 0;
}
