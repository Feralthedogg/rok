// expect-exit: 101
// expect-stderr: panic_loc_div_zero.rok:10:17:
// expect-stderr: attempt to divide by zero

// A compiler-generated check reports the operation's own position, not
// the start of its statement.
fn zero() -> i32 { 0 }

fn main() {
    let x = 1 + (7 / zero());
    println(f"{x}");
}
