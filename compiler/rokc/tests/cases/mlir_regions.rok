// expect-exit: 0
// expect-stdout: 1 2 15 42

// Stdlib bare 1.9: `regions = [..]` gives an op its regions — each
// closure is one region, its parameters the entry block's arguments; the
// body ends in the terminator op and may use the enclosing values.
// `__mlir_type<"..">` names an MLIR type that has no rok type.
use rok::bare::mlir::{__mlir_op, __mlir_type};

fn idx(n: i64) -> __mlir_type<"index"> {
    unsafe { __mlir_op::<"arith.index_cast", __mlir_type<"index">>(n) }
}

fn pick(cond: bool, a: i32, b: i32) -> i32 {
    unsafe {
        __mlir_op::<"scf.if", i32>(
            cond,
            regions = [
                || -> i32 {
                    __mlir_op::<"scf.yield", ()>(a);
                    a
                },
                || -> i32 {
                    __mlir_op::<"scf.yield", ()>(b);
                    b
                },
            ],
        )
    }
}

fn sum_to(n: i64, x: i32) -> i32 {
    let init = 0i32;
    unsafe {
        __mlir_op::<"scf.for", i32>(
            idx(0), idx(n), idx(1), init,
            regions = [
                |i: __mlir_type<"index">, acc: i32| -> i32 {
                    let next = __mlir_op::<"arith.addi", i32>(acc, x);
                    __mlir_op::<"scf.yield", ()>(next);
                    next
                },
            ],
        )
    }
}

fn main() -> i32 {
    let a: __mlir_type::<"index"> = idx(40);
    let s = unsafe { __mlir_op::<"arith.addi", __mlir_type<"index">>(a, idx(2)) };
    let r: i64 = unsafe { __mlir_op::<"arith.index_cast", i64>(s) };
    println(f"{pick(true, 1, 2)} {pick(false, 1, 2)} {sum_to(5, 3)} {r}");
    0
}
// spec: std 109-mlir §1.9.2
