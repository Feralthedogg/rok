// spec: std §1.8.2
// expect-error: imported interface `test:lend/inspect` uses types of `test:lend/res`, which this component exports

// Stdlib 1.8: an import's types are imports. An imported interface that
// uses a resource of an interface this component exports would name a
// distinct, imported copy of it (as `wit-parser` elaborates the world),
// never the component's own value: a `borrow` of an exported resource
// cannot reach an import, so the world is refused.
ffi::wit::import { "lend.wit" }

#[wit::export]
pub struct Thing {
    n: u32;
}

impl Thing {
    pub fn new(n: u32) -> Thing { Thing { n } }
    pub fn get(self) -> u32 { self.n }
}

fn main() {}
