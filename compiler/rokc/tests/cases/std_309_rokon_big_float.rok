// spec: std §3.9.4
// expect-exit: 0
// expect-stdout:
// 1.2345678901234568e600 true
// 3.3333333333333336e-601 true
// -1.2345678901234568e600 true
// 0.1 true
// 1.0e20 true

// Std 3.9.4: a `float` past the `f64` exponent range is written in the
// shortest form that reads back to the same value.
use rok::std::rokon;

fn main() {
    let big: float = 1.0e300;
    let x = big * big * 1.2345678901234567;
    let tiny: float = 1.0e-300;
    let y = tiny * tiny / 3.0;
    for v in [x, y, -x, 0.1 as float, 1.0e20 as float] {
        let s = rokon::to_string(v);
        let back: float = try rokon::from_str(s) catch e { println(f"err {e}"); 0.0 };
        println(f"{s} {back == v}");
    }
}
