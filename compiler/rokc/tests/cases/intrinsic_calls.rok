// expect-exit: 0
// expect-stdout:
// 7
// 6
// 20
// 1
// -6
// 1

// Stdlib spec 0.3: core's primitive trait methods are
// `#[intrinsic("rok.OP.TYPE")]` — calling them by name lowers to the
// machine op (method call, path call, through a type parameter).

fn twice<T: Mul>(x: T, k: T) -> T { return T::mul(x, k); }

fn main() -> i32 {
    rok_print_i32(3.add(4));
    rok_print_i32(i32::sub(10, 4));
    rok_print_i32(twice(10, 2));
    rok_print_i32(if true.not() == false && 3.lt(4) { 1 } else { 0 });
    rok_print_i32(5.bitnot());
    rok_print_i32(if 2.5f64.ge(2.5f64) { 1 } else { 0 });
    return 0;
}
