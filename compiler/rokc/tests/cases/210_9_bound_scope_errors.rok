// spec: §2.10.9
// expect-error: no method `area` on type parameter `B::Elem`: it has no bounds (spec 2.10.9)
// expect-error: operator `+` cannot be applied to `i64` and `I::Item`
// expect-error: mismatched types: the return value expects `T`, found `T::Output`
// expect-error: no method `title` on type parameter `Self`: its bounds (`Greet`) do not declare it (spec 2.10.9)
// expect-error: no method `clone` on type parameter `B`: it has no bounds (spec 2.10.9)
// expect-error: operator `*` on `T` needs a `Mul` bound on `T` (spec 2.10.9)
// expect-error: type `T` does not satisfy trait bound `rok::core::cmp::Ord` required by `rok::core::collections::list::List__sort`
// expect-error: type `T` does not satisfy trait bound `rok::core::marker::Send` required by `rok::core::task::spawn`
// expect-error: mismatched types: the body of `resize` expects `[T; M]`, found `[T; N]`
// expect-error: mismatched types: the right operand of `<` expects `T`, found `U`
// expect-error: no method `len` on type parameter `T`: it has no bounds (spec 2.10.9)
// forbid-error: found `usize`
// forbid-error: no method `title` found for type `Plain`

// What a generic body may use is fixed by its declaration (spec
// 2.10.9): associated types are opaque unless a bound binds or bounds
// them, `Add`'s result is `T::Output` unless bound to `T`, a trait's
// default body sees `Self` only through that trait, a generic impl's
// method only through the impl's bounds, closures in a generic body
// the same; calls into other generic code need their bounds met. A
// template that fails its check reports nothing more at its calls.

use rok::core::ops::Add;

trait Shape { fn area(self) -> f64; }
trait Bag {
    type Elem;
    fn first(self) -> Elem;
}

fn elem_area<B: Bag>(b: B) -> f64 { b.first().area() }
fn sum_items<I: Iterator>(it: I) -> i64 {
    let s = 0i64;
    for x in it { s = s + x; }
    s
}
fn add_out<T: Add>(a: T, b: T) -> T { return a + b; }

trait Greet {
    fn name(self) -> str;
    fn greet(self) -> str { self.name() + self.title() }
}
struct Plain;
impl Greet for Plain { fn name(self) -> str { "p" } }

struct Pair<A, B> { a: A; b: B; }
impl<A: Clone, B> Pair<A, B> {
    fn left(self) -> A { self.a.clone() }
    fn right(self) -> B { self.b.clone() }
}

fn scaled<T>(xs: List<T>, k: T) -> List<T> { xs.iter().map(|x| x * k).collect() }
fn sorted<T>(xs: List<T>) { xs.sort(); }
async fn sent<T>(x: T) -> T { await task::spawn(async { x }) }
fn resize<T, const N: usize, const M: usize>(a: [T; N]) -> [T; M] { a }
fn mixed<T: Ord, U: Ord>(a: T, b: U) -> bool { a < b }

fn bad<T>(x: T) -> i32 { x.len() }

println(f"{bad("s")} {Plain.greet()}");
