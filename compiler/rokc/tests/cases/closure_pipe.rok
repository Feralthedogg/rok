// expect-exit: 21

fn pipeline(x: i32, fns: [fn(i32) -> i32; 3]) -> i32 {
    let acc = x;
    for f in fns {
        acc = f(acc);
    }
    return acc;
}

fn main() -> i32 {
    let fns: [fn(i32) -> i32; 3] = [
        |n: i32| -> i32 { n + 1 },
        |n: i32| -> i32 { n * 2 },
        |n: i32| -> i32 { n - 3 },
    ];
    return pipeline(5, fns) + 12;
}
