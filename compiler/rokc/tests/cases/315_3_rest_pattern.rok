// spec: 003.15.3-rest-pattern
// expect-exit: 0
// expect-stdout:
// 1
// 4

// spec 3.15.3: `..rest` binds the remaining tuple elements.
fn main() -> i32 {
    let (first, ..rest) = (1, 2, 3, 4);
    let (..init, last) = (1, 2, 3, 4);
    println(f"{first}");
    println(f"{last}");
    return 0;
}
