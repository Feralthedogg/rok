// spec: std 218 §2.18.3
// expect-exit: 0
// expect-stdout:
// block_on: 1
// local tasks finished: 3
// on this thread: true

// 2.18.3: tasks still running when `block_on` returns keep running. A
// `spawn_local` task is pinned to the worker that made it: on a
// `block_on` caller, that thread, which no other thread can stand in
// for (its future need not be `Send`). So `block_on` returns once those
// are done too (it does not wait for its `spawn` tasks).
static DONE: Atomic<i32> = Atomic::new(0);

let here = rok::std::thread::current().id();
let same = Mutex::new(true);
let r = task::block_on(async {
    for i in 1..4 {
        task::spawn_local(async {
            await task::sleep(Duration::ms(20 * i as i64));
            if rok::std::thread::current().id() != here {
                using g = same.lock() { g.set(false); }
            }
            DONE.fetch_add(1);
            0
        });
    }
    1
});
println(f"block_on: {r}");
println(f"local tasks finished: {DONE.load()}");
using g = same.lock() { println(f"on this thread: {g.get()}"); }
